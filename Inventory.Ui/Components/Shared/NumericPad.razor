<div class="numpad">
    <div class="display">@Value</div>
    <div class="keys">
        @foreach (var key in Keys)
        {
            <button class="key-btn" @onclick="() => Press(key)">@key</button>
        }
        <button class="key-btn clear" @onclick="Clear">C</button>
        <button class="key-btn submit" @onclick="Submit">OK</button>
    </div>
</div>

<style>
    .numpad {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .display {
        background: #f5f5f5;
        border: 2px solid #e0e0e0;
        border-radius: 4px;
        padding: 15px;
        text-align: right;
        font-size: 24px;
        font-weight: bold;
        min-height: 50px;
        color: #333;
    }

    .keys {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .key-btn {
        padding: 20px;
        font-size: 18px;
        font-weight: 600;
        border: 1px solid #e0e0e0;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .key-btn:hover {
            background: #f0f0f0;
            border-color: #5A6ACF;
        }

        .key-btn:active {
            transform: scale(0.95);
        }

        .key-btn.clear {
            background: #fff3cd;
            border-color: #ffc107;
        }

            .key-btn.clear:hover {
                background: #ffe69c;
            }

        .key-btn.submit {
            background: #5A6ACF;
            color: white;
            border-color: #5A6ACF;
            grid-column: span 3;
        }

            .key-btn.submit:hover {
                background: #4a5abf;
            }
</style>

@code {
    [Parameter] public EventCallback<int> OnSubmit { get; set; }

    private string Value = "";
    private readonly string[] Keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" };

    void Press(string key) => Value += key;

    void Clear() => Value = "";

    async Task Submit()
    {
        if (int.TryParse(Value, out var quantity))
        {
            await OnSubmit.InvokeAsync(quantity);
        }
        Value = "";
    }
}