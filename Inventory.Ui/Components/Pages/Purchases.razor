@page "/purchases"

@using System.Globalization
@using Inventory.Dto.Enums
@using Inventory.Dto.Products.Results
@using Inventory.Dto.Suppliers.Results
@using Inventory.LocalDB.Enums
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.LocalDB.Services.Requests
@using Inventory.Ui.Services
@using Microsoft.JSInterop


@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@implements IAsyncDisposable

@inject ILocalPurchaseService LocalPurchaseService
@inject ILocalPurchaseDraftService LocalPurchaseDraftService
@inject ILocalProductService LocalProductService
@inject ILocalSupplierService LocalSupplierService
@inject AppState State
@inject ILogger<Purchases> Logger
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="purchase-container">

    <!-- LEFT COLUMN: CART AND TOTALS -->
    <div class="purchase-left"
         @onclick="FocusBarcodeInput">

        <!-- PURCHASE HEADER -->
        <div class="card header-section">
            <div class="purchase-info">
                <div>
                    <strong class="title">Purchase</strong>
                    <span class="muted">@PurchaseCount</span>
                </div>
            </div>

            <div class="supplier-section">
                <label>Supplier</label>

                <button type="button"
                        class="supplier-select-btn"
                        @onclick="OpenSupplierModal"
                        @onclick:stopPropagation="true"
                        disabled="@IsSaving">
                    @(SelectedSupplier?.Name ?? "-- Select supplier --")
                </button>
            </div>
        </div>

        <!-- CART TABLE -->
        <div class="card cart-table">
            @if (Lines.Count == 0)
            {
                <div class="empty-state">
                    <p>No products added yet</p>
                    <p class="muted">
                        Scan a barcode or select a local product.
                    </p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 200px;">Quantity</th>
                            <th>Name</th>
                            <th style="width: 110px;">Unit price</th>
                            <th style="width: 110px;">Excl. VAT</th>
                            <th style="width: 100px;">VAT</th>
                            <th style="width: 80px;">Rate</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in Lines)
                        {
                            <tr class="@(line == SelectedLine ? "selected" : string.Empty)"
                                @onclick="() => OnLineClicked(line)">

                                <td>
                                    <div class="qty-controls">
                                        <button type="button"
                                                class="qty-btn"
                                                @onclick="() => Decrement(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            −
                                        </button>

                                        <span class="qty-value">
                                            @FormatQuantity(line.Quantity)
                                        </span>

                                        <button type="button"
                                                class="qty-btn"
                                                @onclick="() => Increment(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            +
                                        </button>
                                    </div>
                                </td>

                                <td>@line.ProductName</td>

                                <td class="text-right">
                                    €@line.EffectiveUnitPrice.ToString("F2")
                                </td>

                                <td class="text-right">
                                    €@line.AmountExclVat.ToString("F2")
                                </td>

                                <td class="text-right">
                                    €@line.TaxAmount.ToString("F2")
                                </td>

                                <td class="text-right">
                                    @line.TaxRate.ToString("0.##")%
                                </td>
                            </tr>

                            @if (line.IsExpanded)
                            {
                                @foreach (var adjustment in line.Adjustments)
                                {
                                    <tr class="sub-line">
                                        <td></td>
                                        <td colspan="5">
                                            <span class="adjustment">
                                                @adjustment.Display
                                            </span>
                                        </td>
                                    </tr>
                                }

                                <tr class="sub-actions">
                                    <td></td>
                                    <td colspan="5">
                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddPriceOverride(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            Change price
                                        </button>

                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddDiscountPercent(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            Discount %
                                        </button>

                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddDiscountAmount(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            Discount €
                                        </button>

                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => ClearAdjustments(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@(IsSaving || line.Adjustments.Count == 0)">
                                            Clear adjustments
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- TOTALS -->
        <div class="totals-row">
            <div class="total-item">
                <span class="total-label">Total quantity</span>
                <strong class="total-value primary">
                    @FormatQuantity(TotalQuantity)
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Number of lines</span>
                <strong class="total-value primary">
                    @Lines.Count
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Total incl. VAT</span>
                <strong class="total-value primary">
                    €@TotalAmountInclVat.ToString("F2")
                </strong>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="actions-footer">
            <div class="tax-info">
                <strong>
                    Excl. VAT: €@TotalAmountExclVat.ToString("F2")
                    &nbsp;|&nbsp;
                    VAT: €@TotalTax.ToString("F2")
                </strong>
            </div>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="ResetPurchaseAsync"
                    @onclick:stopPropagation="true"
                    disabled="@(IsSaving ||
                                                                                                                (Lines.Count == 0 &&
                                                                                                                 SelectedSupplier == null))">
                Reset
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="RemoveSelected"
                    @onclick:stopPropagation="true"
                    disabled="@(IsSaving || SelectedLine == null)">
                Delete
            </button>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="SavePurchase"
                    @onclick:stopPropagation="true"
                    disabled="@(!CanSave)">
                @(IsSaving ? "Saving locally..." : "Add")
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="NavigateToSalesAsync"
                    @onclick:stopPropagation="true"
                    disabled="@IsSaving">
                Sales
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="NavigateToDashboardAsync"
                    @onclick:stopPropagation="true"
                    disabled="@IsSaving">
                Close
            </button>
        </div>
    </div>

    <!-- RIGHT COLUMN: LOCAL PRODUCT SEARCH -->
    <div class="purchase-right">

        <!-- BARCODE -->
        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Scan barcode or type product code..."
                       @bind="BarcodeInput"
                       @bind:event="oninput"
                       @onkeydown="OnBarcodeKeyDown"
                       @ref="barcodeInputRef"
                       disabled="@IsSaving"
                       autofocus />

                <span class="search-icon">🔍</span>
            </div>
        </div>

        <!-- MANUAL SEARCH -->
        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Search local products..."
                       @bind="SearchText"
                       @bind:event="oninput"
                       @bind:after="UpdateFilter"
                       disabled="@IsSaving" />

                <span class="search-icon">🔍</span>
            </div>
        </div>

        <!-- LOCAL PRODUCTS -->
        <div class="card product-list-container">
            @if (IsLoadingData)
            {
                <div class="loading-state">
                    Loading local products and suppliers...
                </div>
            }
            else if (FilteredProducts.Count == 0)
            {
                <div class="empty-state">
                    <p>No local products found</p>
                </div>
            }
            else
            {
                <ul class="product-list">
                    @foreach (var product in FilteredProducts)
                    {
                        <li class="product-item"
                            @onclick="() => SelectAndAddProduct(product)">

                            <strong>
                                @(string.IsNullOrWhiteSpace(product.CatalogName)
                                                        ? "Unknown product"
                                                        : product.CatalogName)
                    </strong>

                    @if (!string.IsNullOrWhiteSpace(product.CatalogBarcode))
                            {
                                <span class="muted">
                                    @product.CatalogBarcode
                                </span>
                            }

                            @if (product.IsPack)
                            {
                                <span class="muted">
                                    Pack de @FormatQuantity(product.PackSize) unités
                                </span>
                            }

                            <span class="muted price">
                                €@product.PurchasePrice.ToString("F2")
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- NUMPAD -->
        <div class="card numpad-container"
             @onclick:stopPropagation="true">
            <div class="numpad">
                <div class="display">
                    @NumpadValue
                </div>

                <div class="keys">
                    @foreach (var key in NumpadKeys)
                    {
                        <button type="button"
                                class="key-btn"
                                @onmousedown:preventDefault="true"
                                @onclick="() => PressKey(key)"
                                disabled="@IsSaving">
                            @key
                        </button>
                    }

                    <button type="button"
                            class="key-btn clear"
                            @onmousedown:preventDefault="true"
                            @onclick="ClearNumpad"
                            disabled="@IsSaving">
                        C
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SUPPLIER MODAL -->
@if (ShowSupplierModal)
{
    <div class="modal-overlay"
         @onclick="CloseSupplierModal">

        <div class="modal-content"
             @onclick:stopPropagation="true">

            <div class="modal-header">
                <h3>Select local supplier</h3>

                <button type="button"
                        class="modal-close"
                        @onclick="CloseSupplierModal">
                    ×
                </button>
            </div>

            <div class="modal-body">
                <div class="search-box">
                    <input type="text"
                           class="search-input"
                           placeholder="Search suppliers..."
                           @bind="SupplierSearchText"
                           @bind:event="oninput"
                           autofocus />

                    <span class="search-icon">🔍</span>
                </div>

                <ul class="supplier-list">
                    @if (FilteredSuppliers.Count == 0)
                    {
                        <li class="empty-state">
                            No local suppliers found
                        </li>
                    }
                    else
                    {
                        @foreach (var supplier in FilteredSuppliers)
                        {
                            <li class="supplier-item @(TempSelectedSupplier?.Id == supplier.Id ? "selected" : string.Empty)"
                                @onclick="() => TempSelectedSupplier = supplier">

                                <strong>@supplier.Name</strong>

                                @if (!string.IsNullOrWhiteSpace(supplier.Phone))
                                {
                                    <span class="muted">
                                        📞 @supplier.Phone
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(supplier.Email))
                                {
                                    <span class="muted">
                                        ✉ @supplier.Email
                                    </span>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CloseSupplierModal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="ConfirmSupplierSelection"
                        disabled="@(TempSelectedSupplier == null)">
                    OK
                </button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="toast-success">
        <span class="toast-icon"></span>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="toast-error">
        <span class="toast-icon"></span>
        <span>@errorMessage</span>
    </div>
}

@code {
    private readonly List<CartLine> Lines = new();

    private List<ProductResult> Products = new();
    private List<ProductResult> FilteredProducts = new();
    private List<SupplierResult> Suppliers = new();

    private Dictionary<string, ProductResult> BarcodeMap =
        new(StringComparer.OrdinalIgnoreCase);

    private SupplierResult? SelectedSupplier;
    private SupplierResult? TempSelectedSupplier;
    private CartLine? SelectedLine;

    private string BarcodeInput = string.Empty;
    private string SearchText = string.Empty;
    private string SupplierSearchText = string.Empty;
    private string NumpadValue = string.Empty;

    private bool IsLoadingData;
    private bool ShowSupplierModal;

    private string? successMessage;
    private string? errorMessage;

    private ElementReference barcodeInputRef;

    private IJSObjectReference? barcodeScannerModule;

    private DotNetObjectReference<Purchases>? barcodeScannerReference;

    private CancellationTokenSource? toastCancellation;
    private CancellationTokenSource? draftSaveCancellation;

    private readonly SemaphoreSlim barcodeScanGate = new(1, 1);
    private readonly SemaphoreSlim draftSaveGate = new(1, 1);

    private Guid? CurrentDraftId;

    private bool IsSaving;
    private bool IsRestoringDraft;
    private bool IsFinalizingPurchase;
    private bool IsDisposed;
    private bool HasSavedBeforeNavigation;


    private static readonly string[] NumpadKeys =
    {
        "1", "2", "3",
        "4", "5", "6",
        "7", "8", "9",
        "0", "."
    };

    private string PurchaseCount =>
        $"Lines: {Lines.Count}";

    private decimal TotalQuantity =>
        Lines.Sum(line => line.Quantity);

    private decimal TotalAmountExclVat =>
        RoundMoney(
            Lines.Sum(line =>
                line.AmountExclVat));

    private decimal TotalTax =>
        RoundMoney(
            Lines.Sum(line =>
                line.TaxAmount));

    private decimal TotalAmountInclVat =>
        RoundMoney(
            TotalAmountExclVat +
            TotalTax);

    private bool CanSave =>
        !IsSaving &&
        SelectedSupplier != null &&
        Lines.Count > 0;

    private List<SupplierResult> FilteredSuppliers =>
        string.IsNullOrWhiteSpace(
            SupplierSearchText)
            ? Suppliers
            : Suppliers
                .Where(supplier =>
                    Contains(
                        supplier.Name,
                        SupplierSearchText) ||
                    Contains(
                        supplier.Phone,
                        SupplierSearchText) ||
                    Contains(
                        supplier.Email,
                        SupplierSearchText) ||
                    Contains(
                        supplier.City,
                        SupplierSearchText))
                .ToList();




    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
        await RestoreActiveDraftAsync();
    }


    [JSInvokable]
    public async Task OnHardwareScan(string? rawBarcode)
    {
        if (string.IsNullOrWhiteSpace(
                rawBarcode))
        {
            return;
        }

        var barcode =
            rawBarcode.Trim();

        await barcodeScanGate.WaitAsync();

        try
        {
            BarcodeInput =
                string.Empty;

            if (IsLoadingData)
            {
                await ShowErrorAsync(
                    "Product data is still loading.");

                return;
            }

            if (IsSaving)
            {
                await ShowErrorAsync(
                    "A purchase operation is currently in progress.");

                return;
            }

            if (ShowSupplierModal)
            {
                await ShowErrorAsync(
                    "Product scanning is unavailable while a dialog is open.");

                return;
            }

            Logger.LogDebug(
                "Barcode scanned: {Barcode}",
                barcode);

            await AddProductByBarcodeAsync(barcode);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to process barcode {Barcode}.",
                barcode);

            await ShowErrorAsync(
                "The barcode could not be processed.");
        }
        finally
        {
            barcodeScanGate.Release();
        }
    }

    protected override async Task OnAfterRenderAsync(
    bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            barcodeScannerReference =
                DotNetObjectReference.Create(this);

            barcodeScannerModule =
                await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/barcodeScanner.js");

            await barcodeScannerModule.InvokeVoidAsync(
                "initialize",
                barcodeScannerReference);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to initialize the barcode scanner.");

            errorMessage =
                "The barcode scanner could not be initialized.";

            await InvokeAsync(
                StateHasChanged);
        }

        await FocusBarcodeInput();
    }

    public async ValueTask DisposeAsync()
    {
        draftSaveCancellation?.Cancel();
        draftSaveCancellation?.Dispose();

        if (!IsFinalizingPurchase &&
            !HasSavedBeforeNavigation)
        {
            try
            {
                await SaveCurrentDraftAsync();
            }
            catch (Exception exception)
            {
                Logger.LogError(
                    exception,
                    "Failed to save the purchase draft while leaving the page.");
            }
        }

        IsDisposed = true;

        toastCancellation?.Cancel();
        toastCancellation?.Dispose();

        if (barcodeScannerModule != null)
        {
            try
            {
                await barcodeScannerModule.InvokeVoidAsync(
                    "dispose");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }

            try
            {
                await barcodeScannerModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }

        barcodeScannerReference?.Dispose();

        barcodeScannerModule = null;
        barcodeScannerReference = null;
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            IsLoadingData = true;
            errorMessage = null;

            /*
             * These services read SQLite.
             * ProductResult.Id and SupplierResult.Id are local IDs.
             */
            var productsTask =
                LocalProductService.GetAllAsync();

            var suppliersTask =
                LocalSupplierService.GetAllAsync();

            await Task.WhenAll(
                productsTask,
                suppliersTask);

            Products =
                productsTask.Result
                    .Where(product =>
                        product.Status ==
                            ProductStatus.Active)
                    .OrderBy(product =>
                        product.CatalogName)
                    .ToList();

            Suppliers =
                suppliersTask.Result
                    .Where(supplier =>
                        supplier.IsActive)
                    .OrderBy(supplier =>
                        supplier.Name)
                    .ToList();

            BuildBarcodeMap();

            UpdateFilter();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load local purchase data.");

            Products = new();
            FilteredProducts = new();
            Suppliers = new();
            BarcodeMap =
                new Dictionary<string, ProductResult>
(
StringComparer.OrdinalIgnoreCase);

            await ShowErrorAsync(
            $"Failed to load local purchase data: " +
            $"{exception.GetBaseException().Message}");
        }
        finally
        {
            IsLoadingData = false;
        }
    }

    private async Task RestoreActiveDraftAsync()
    {
        try
        {
            IsRestoringDraft =
                true;

            var draft =
                await LocalPurchaseDraftService
                    .GetActiveAsync();

            if (draft == null)
            {
                return;
            }

            CurrentDraftId =
                draft.Id;

            SelectedSupplier =
                draft.SupplierLocalId.HasValue
                    ? Suppliers.FirstOrDefault(supplier =>
                        supplier.Id ==
                        draft.SupplierLocalId.Value)
                    : null;

            Lines.Clear();

            foreach (var draftLine in
                     draft.Lines.OrderBy(line =>
                         line.DisplayOrder))
            {
                var product =
                    Products.FirstOrDefault(item =>
                        item.Id ==
                        draftLine.ProductLocalId);

                var adjustments =
                    draftLine.Adjustments
                        .OrderBy(adjustment =>
                            adjustment.DisplayOrder)
                        .Select(adjustment =>
                            new CartAdjustment
                            {
                                Type =
                                    ToCartAdjustmentType(
                                        adjustment.Type),

                                Value =
                                    adjustment.Value
                            })
                        .ToList();

                /*
                 * Compatibility with drafts created before adjustment
                 * persistence was introduced.
                 */
                if (adjustments.Count == 0 &&
                    RoundMoney(
                        draftLine.EffectiveUnitPrice) !=
                    RoundMoney(
                        draftLine.BasePurchasePrice))
                {
                    adjustments.Add(
                        new CartAdjustment
                        {
                            Type =
                                AdjustmentType.PriceOverride,

                            Value =
                                RoundMoney(
                                    draftLine.EffectiveUnitPrice)
                        });
                }

                Lines.Add(
                    new CartLine
                    {
                        ProductId =
                            draftLine.ProductLocalId,

                        ProductName =
                            string.IsNullOrWhiteSpace(
                                product?.CatalogName)
                                ? "Unavailable local product"
                                : product.CatalogName,

                        ProductBarcode =
                            product?.CatalogBarcode,

                        Quantity =
                            RoundQuantity(
                                draftLine.Quantity),

                        BasePurchasePrice =
                            RoundMoney(
                                draftLine.BasePurchasePrice),

                        TaxRate =
                            draftLine.VatRate,

                        IsPack =
                            product?.IsPack ?? false,

                        PackSize =
                            product?.PackSize ?? 1m,

                        Adjustments =
                            adjustments
                    });
            }

            SelectedLine =
                null;

            Logger.LogInformation(
                "Purchase draft {DraftId} restored with {LineCount} lines.",
                draft.Id,
                Lines.Count);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to restore the active purchase draft.");

            await ShowErrorAsync(
                "The saved purchase draft could not be restored.");
        }
        finally
        {
            IsRestoringDraft =
                false;
        }
    }

    private void ScheduleDraftSave()
    {
        if (IsRestoringDraft ||
            IsFinalizingPurchase ||
            IsDisposed)
        {
            return;
        }

        draftSaveCancellation?.Cancel();
        draftSaveCancellation?.Dispose();

        var source =
            new CancellationTokenSource();

        draftSaveCancellation =
            source;

        _ = SaveDraftAfterDelayAsync(
            source);
    }

    private async Task SaveDraftAfterDelayAsync(
        CancellationTokenSource source)
    {
        try
        {
            await Task.Delay(
                300,
                source.Token);

            await SaveCurrentDraftAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to automatically save the purchase draft.");

            if (!IsDisposed)
            {
                var rootException = exception.GetBaseException();

                await ShowErrorAsync(
                    $"Draft save failed: {rootException.Message}");
            }
        }
        finally
        {
            if (ReferenceEquals(
                    draftSaveCancellation,
                    source))
            {
                draftSaveCancellation =
                    null;
            }

            source.Dispose();
        }
    }

    private async Task SaveCurrentDraftAsync()
    {
        if (IsRestoringDraft ||
            IsDisposed)
        {
            return;
        }

        await draftSaveGate.WaitAsync();

        try
        {
            if (Lines.Count == 0 &&
                SelectedSupplier == null)
            {
                if (CurrentDraftId.HasValue)
                {
                    await LocalPurchaseDraftService
                        .DeleteAsync(
                            CurrentDraftId.Value);

                    CurrentDraftId =
                        null;
                }

                return;
            }

            var request =
                CreateDraftRequest();

            CurrentDraftId =
                await LocalPurchaseDraftService
                    .SaveAsync(
                        request);
        }
        finally
        {
            draftSaveGate.Release();
        }
    }

    private SaveLocalPurchaseDraftRequest CreateDraftRequest()
    {
        return new SaveLocalPurchaseDraftRequest
        {
            DraftId =
                CurrentDraftId,

            SupplierLocalId =
                SelectedSupplier?.Id,

            Lines =
                Lines
                    .Select((line, lineIndex) =>
                        new SaveLocalPurchaseDraftLineRequest
                        {
                            ProductLocalId =
                                line.ProductId,

                            Quantity =
                                RoundQuantity(
                                    line.Quantity),

                            BasePurchasePrice =
                                RoundMoney(
                                    line.BasePurchasePrice),

                            VatRate =
                                Math.Round(
                                    line.TaxRate,
                                    2,
                                    MidpointRounding.AwayFromZero),

                            DisplayOrder =
                                lineIndex,

                            Adjustments =
                                line.Adjustments
                                    .Select((
                                        adjustment,
                                        adjustmentIndex) =>
                                        new SaveLocalPurchaseDraftAdjustmentRequest
                                        {
                                            Type =
                                                ToDraftAdjustmentType(
                                                    adjustment.Type),

                                            Value =
                                                adjustment.Value,

                                            DisplayOrder =
                                                adjustmentIndex
                                        })
                                    .ToList()
                        })
                    .ToList()
        };
    }

    private async Task SaveAndSuspendDraftAsync()
    {
        draftSaveCancellation?.Cancel();
        draftSaveCancellation?.Dispose();
        draftSaveCancellation = null;

        await SaveCurrentDraftAsync();

        if (CurrentDraftId.HasValue)
        {
            await LocalPurchaseDraftService
                .SuspendAsync(
                    CurrentDraftId.Value);
        }
    }

