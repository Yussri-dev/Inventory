@page "/purchases"

@using System.Globalization
@using Inventory.Dto.Enums
@using Inventory.Dto.Products.Results
@using Inventory.Dto.Suppliers.Results
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.LocalDB.Services.Requests
@using Inventory.Ui.Services

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable

@inject ILocalPurchaseService LocalPurchaseService
@inject ILocalProductService LocalProductService
@inject ILocalSupplierService LocalSupplierService
@inject AppState State
@inject ILogger<Purchases> Logger
@inject NavigationManager Nav

<div class="purchase-container">

    <!-- LEFT COLUMN: CART AND TOTALS -->
    <div class="purchase-left"
         @onclick="FocusBarcodeInput">

        <!-- PURCHASE HEADER -->
        <div class="card header-section">
            <div class="purchase-info">
                <div>
                    <strong class="title">Purchase</strong>
                    <span class="muted">@PurchaseCount</span>
                </div>
            </div>

            <div class="supplier-section">
                <label>Supplier</label>

                <button type="button"
                        class="supplier-select-btn"
                        @onclick="OpenSupplierModal"
                        @onclick:stopPropagation="true"
                        disabled="@IsSaving">
                    @(SelectedSupplier?.Name ?? "-- Select supplier --")
                </button>
            </div>
        </div>

        <!-- CART TABLE -->
        <div class="card cart-table">
            @if (Lines.Count == 0)
            {
                <div class="empty-state">
                    <p>No products added yet</p>
                    <p class="muted">
                        Scan a barcode or select a local product.
                    </p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 200px;">Quantity</th>
                            <th>Name</th>
                            <th style="width: 110px;">Unit price</th>
                            <th style="width: 110px;">Excl. VAT</th>
                            <th style="width: 100px;">VAT</th>
                            <th style="width: 80px;">Rate</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in Lines)
                        {
                            <tr class="@(line == SelectedLine ? "selected" : string.Empty)"
                                @onclick="() => OnLineClicked(line)">

                                <td>
                                    <div class="qty-controls">
                                        <button type="button"
                                                class="qty-btn"
                                                @onclick="() => Decrement(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            −
                                        </button>

                                        <span class="qty-value">
                                            @FormatQuantity(line.Quantity)
                                        </span>

                                        <button type="button"
                                                class="qty-btn"
                                                @onclick="() => Increment(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            +
                                        </button>
                                    </div>
                                </td>

                                <td>@line.ProductName</td>

                                <td class="text-right">
                                    €@line.EffectiveUnitPrice.ToString("F2")
                                </td>

                                <td class="text-right">
                                    €@line.AmountExclVat.ToString("F2")
                                </td>

                                <td class="text-right">
                                    €@line.TaxAmount.ToString("F2")
                                </td>

                                <td class="text-right">
                                    @line.TaxRate.ToString("0.##")%
                                </td>
                            </tr>

                            @if (line.IsExpanded)
                            {
                                @foreach (var adjustment in line.Adjustments)
                                {
                                    <tr class="sub-line">
                                        <td></td>
                                        <td colspan="5">
                                            <span class="adjustment">
                                                @adjustment.Display
                                            </span>
                                        </td>
                                    </tr>
                                }

                                <tr class="sub-actions">
                                    <td></td>
                                    <td colspan="5">
                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddPriceOverride(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            Change price
                                        </button>

                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddDiscountPercent(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            Discount %
                                        </button>

                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddDiscountAmount(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            Discount €
                                        </button>

                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => ClearAdjustments(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@(IsSaving || line.Adjustments.Count == 0)">
                                            Clear adjustments
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- TOTALS -->
        <div class="totals-row">
            <div class="total-item">
                <span class="total-label">Total quantity</span>
                <strong class="total-value primary">
                    @FormatQuantity(TotalQuantity)
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Number of lines</span>
                <strong class="total-value primary">
                    @Lines.Count
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Total incl. VAT</span>
                <strong class="total-value primary">
                    €@TotalAmountInclVat.ToString("F2")
                </strong>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="actions-footer">
            <div class="tax-info">
                <strong>
                    Excl. VAT: €@TotalAmountExclVat.ToString("F2")
                    &nbsp;|&nbsp;
                    VAT: €@TotalTax.ToString("F2")
                </strong>
            </div>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="Reset"
                    @onclick:stopPropagation="true"
                    disabled="@(IsSaving || Lines.Count == 0)">
                Reset
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="RemoveSelected"
                    @onclick:stopPropagation="true"
                    disabled="@(IsSaving || SelectedLine == null)">
                Delete
            </button>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="SavePurchase"
                    @onclick:stopPropagation="true"
                    disabled="@(!CanSave)">
                @(IsSaving ? "Saving locally..." : "Add")
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="NavigateToDashboard"
                    @onclick:stopPropagation="true"
                    disabled="@IsSaving">
                Close
            </button>
        </div>
    </div>

    <!-- RIGHT COLUMN: LOCAL PRODUCT SEARCH -->
    <div class="purchase-right">

        <!-- BARCODE -->
        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Scan barcode or type product code..."
                       @bind="BarcodeInput"
                       @bind:event="oninput"
                       @onkeydown="OnBarcodeKeyDown"
                       @ref="barcodeInputRef"
                       disabled="@IsSaving"
                       autofocus />

                <span class="search-icon">🔍</span>
            </div>
        </div>

        <!-- MANUAL SEARCH -->
        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Search local products..."
                       @bind="SearchText"
                       @bind:event="oninput"
                       @bind:after="UpdateFilter"
                       disabled="@IsSaving" />

                <span class="search-icon">🔍</span>
            </div>
        </div>

        <!-- LOCAL PRODUCTS -->
        <div class="card product-list-container">
            @if (IsLoadingData)
            {
                <div class="loading-state">
                    Loading local products and suppliers...
                </div>
            }
            else if (FilteredProducts.Count == 0)
            {
                <div class="empty-state">
                    <p>No local products found</p>
                </div>
            }
            else
            {
                <ul class="product-list">
                   @foreach (var product in FilteredProducts)
                    {
                        <li class="product-item"
                            @onclick="() => SelectAndAddProduct(product)">

                            <strong>
                                @(string.IsNullOrWhiteSpace(product.CatalogName)
                                    ? "Unknown product"
                                    : product.CatalogName)
                            </strong>

                            @if (!string.IsNullOrWhiteSpace(product.CatalogBarcode))
                            {
                                <span class="muted">
                                    @product.CatalogBarcode
                                </span>
                            }

                            @if (product.IsPack)
                            {
                                <span class="muted">
                                    Pack de @FormatQuantity(product.PackSize) unités
                                </span>
                            }

                            <span class="muted price">
                                €@product.PurchasePrice.ToString("F2")
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- NUMPAD -->
        <div class="card numpad-container"
             @onclick:stopPropagation="true">
            <div class="numpad">
                <div class="display">
                    @NumpadValue
                </div>

                <div class="keys">
                    @foreach (var key in NumpadKeys)
                    {
                        <button type="button"
                                class="key-btn"
                                @onclick="() => PressKey(key)"
                                disabled="@IsSaving">
                            @key
                        </button>
                    }

                    <button type="button"
                            class="key-btn clear"
                            @onclick="ClearNumpad"
                            disabled="@IsSaving">
                        C
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SUPPLIER MODAL -->
@if (ShowSupplierModal)
{
    <div class="modal-overlay"
         @onclick="CloseSupplierModal">

        <div class="modal-content"
             @onclick:stopPropagation="true">

            <div class="modal-header">
                <h3>Select local supplier</h3>

                <button type="button"
                        class="modal-close"
                        @onclick="CloseSupplierModal">
                    ×
                </button>
            </div>

            <div class="modal-body">
                <div class="search-box">
                    <input type="text"
                           class="search-input"
                           placeholder="Search suppliers..."
                           @bind="SupplierSearchText"
                           @bind:event="oninput"
                           autofocus />

                    <span class="search-icon">🔍</span>
                </div>

                <ul class="supplier-list">
                    @if (FilteredSuppliers.Count == 0)
                    {
                        <li class="empty-state">
                            No local suppliers found
                        </li>
                    }
                    else
                    {
                        @foreach (var supplier in FilteredSuppliers)
                        {
                            <li class="supplier-item @(TempSelectedSupplier?.Id == supplier.Id ? "selected" : string.Empty)"
                                @onclick="() => TempSelectedSupplier = supplier">

                                <strong>@supplier.Name</strong>

                                @if (!string.IsNullOrWhiteSpace(supplier.Phone))
                                {
                                    <span class="muted">
                                        📞 @supplier.Phone
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(supplier.Email))
                                {
                                    <span class="muted">
                                        ✉ @supplier.Email
                                    </span>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CloseSupplierModal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="ConfirmSupplierSelection"
                        disabled="@(TempSelectedSupplier == null)">
                    OK
                </button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="toast-success">
        <span class="toast-icon"></span>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="toast-error">
        <span class="toast-icon"></span>
        <span>@errorMessage</span>
    </div>
}

@code {
    private readonly List<CartLine> Lines = new();

    private List<ProductResult> Products = new();
    private List<ProductResult> FilteredProducts = new();
    private List<SupplierResult> Suppliers = new();

    private Dictionary<string, ProductResult> BarcodeMap =
        new(StringComparer.OrdinalIgnoreCase);

    private SupplierResult? SelectedSupplier;
    private SupplierResult? TempSelectedSupplier;
    private CartLine? SelectedLine;

    private string BarcodeInput = string.Empty;
    private string SearchText = string.Empty;
    private string SupplierSearchText = string.Empty;
    private string NumpadValue = string.Empty;

    private bool IsSaving;
    private bool IsLoadingData;
    private bool ShowSupplierModal;

    private string? successMessage;
    private string? errorMessage;

    private ElementReference barcodeInputRef;

    private CancellationTokenSource? toastCancellation;

    private static readonly string[] NumpadKeys =
    {
        "1", "2", "3",
        "4", "5", "6",
        "7", "8", "9",
        "0", "."
    };

    private string PurchaseCount =>
        $"Lines: {Lines.Count}";

    private decimal TotalQuantity =>
        Lines.Sum(line => line.Quantity);

    private decimal TotalAmountExclVat =>
        RoundMoney(
            Lines.Sum(line =>
                line.AmountExclVat));

    private decimal TotalTax =>
        RoundMoney(
            Lines.Sum(line =>
                line.TaxAmount));

    private decimal TotalAmountInclVat =>
        RoundMoney(
            TotalAmountExclVat +
            TotalTax);

    private bool CanSave =>
        !IsSaving &&
        SelectedSupplier != null &&
        Lines.Count > 0;

    private List<SupplierResult> FilteredSuppliers =>
        string.IsNullOrWhiteSpace(
            SupplierSearchText)
            ? Suppliers
            : Suppliers
                .Where(supplier =>
                    Contains(
                        supplier.Name,
                        SupplierSearchText) ||
                    Contains(
                        supplier.Phone,
                        SupplierSearchText) ||
                    Contains(
                        supplier.Email,
                        SupplierSearchText) ||
                    Contains(
                        supplier.City,
                        SupplierSearchText))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await FocusBarcodeInput();
    }

    public void Dispose()
    {
        toastCancellation?.Cancel();
        toastCancellation?.Dispose();
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            IsLoadingData = true;
            errorMessage = null;

            /*
             * These services read SQLite.
             * ProductResult.Id and SupplierResult.Id are local IDs.
             */
            var productsTask =
                LocalProductService.GetAllAsync();

            var suppliersTask =
                LocalSupplierService.GetAllAsync();

            await Task.WhenAll(
                productsTask,
                suppliersTask);

            Products =
                productsTask.Result
                    .Where(product =>
                        product.Status ==
                            ProductStatus.Active)
                    .OrderBy(product =>
                        product.CatalogName)
                    .ToList();

            Suppliers =
                suppliersTask.Result
                    .Where(supplier =>
                        supplier.IsActive)
                    .OrderBy(supplier =>
                        supplier.Name)
                    .ToList();

            BuildBarcodeMap();

            UpdateFilter();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load local purchase data.");

            Products = new();
            FilteredProducts = new();
            Suppliers = new();
            BarcodeMap =
                new Dictionary<string, ProductResult>(
                    StringComparer.OrdinalIgnoreCase);

            await ShowErrorAsync(
                $"Failed to load local purchase data: " +
                $"{exception.GetBaseException().Message}");
        }
        finally
        {
            IsLoadingData = false;
        }
    }

    private void BuildBarcodeMap()
    {
        BarcodeMap =
            Products
                .Where(product =>
                    !string.IsNullOrWhiteSpace(
                        product.CatalogBarcode))
                .GroupBy(
                    product =>
                        product.CatalogBarcode!.Trim(),
                    StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    group => group.Key,
                    group => group.First(),
                    StringComparer.OrdinalIgnoreCase);
    }

    private void UpdateFilter()
    {
        var search =
            SearchText.Trim();

        FilteredProducts =
            string.IsNullOrWhiteSpace(search)
                ? Products.ToList()
                : Products
                    .Where(product =>
                        Contains(
                            product.CatalogName,
                            search) ||
                        Contains(
                            product.CatalogBarcode,
                            search) ||
                        Contains(
                            product.CatalogBrand,
                            search))
                    .ToList();
    }

    private void OpenSupplierModal()
    {
        TempSelectedSupplier =
            SelectedSupplier;

        SupplierSearchText =
            string.Empty;

        ShowSupplierModal =
            true;
    }

    private void CloseSupplierModal()
    {
        ShowSupplierModal =
            false;

        TempSelectedSupplier =
            null;

        SupplierSearchText =
            string.Empty;
    }

    private void ConfirmSupplierSelection()
    {
        if (TempSelectedSupplier == null)
        {
            return;
        }

        SelectedSupplier =
            TempSelectedSupplier;

        CloseSupplierModal();

        _ = FocusBarcodeInput();
    }

    private async Task OnBarcodeScanned(
        string code)
    {
        var normalizedCode =
            code.Trim();

        if (!BarcodeMap.TryGetValue(
                normalizedCode,
                out var product))
        {
            await ShowErrorAsync(
                $"Unknown local barcode: {normalizedCode}");

            return;
        }

        AddProduct(
            product,
            GetQuantityFromNumpad());

        NumpadValue =
            string.Empty;

        await FocusBarcodeInput();
    }

    private async Task OnBarcodeKeyDown(
        KeyboardEventArgs args)
    {
        if (!string.Equals(
                args.Key,
                "Enter",
                StringComparison.OrdinalIgnoreCase) ||
            string.IsNullOrWhiteSpace(
                BarcodeInput))
        {
            return;
        }

        var code =
            BarcodeInput.Trim();

        BarcodeInput =
            string.Empty;

        await OnBarcodeScanned(code);
    }

    private void PressKey(
        string key)
    {
        if (key == "." &&
            NumpadValue.Contains(
                '.',
                StringComparison.Ordinal))
        {
            return;
        }

        NumpadValue +=
            key;
    }

    private void ClearNumpad()
    {
        NumpadValue =
            string.Empty;

        _ = FocusBarcodeInput();
    }

    private void SelectAndAddProduct(
        ProductResult product)
    {
        AddProduct(
            product,
            GetQuantityFromNumpad());

        NumpadValue =
            string.Empty;

        _ = FocusBarcodeInput();
    }

    private decimal GetQuantityFromNumpad()
    {
        return TryReadNumpadDecimal(
            out var quantity) &&
            quantity > 0m
                ? RoundQuantity(quantity)
                : 1m;
    }

    private void AddProduct(
        ProductResult product,
        decimal quantity = 1m)
    {
        if (quantity <= 0m)
        {
            _ = ShowErrorAsync(
                "Quantity must be greater than zero.");

            return;
        }

        if (product.PurchasePrice <= 0m)
        {
            _ = ShowErrorAsync(
                $"Product '{product.CatalogName}' has no valid " +
                "purchase price.");

            return;
        }

        var existingLine =
            Lines.FirstOrDefault(line =>
                line.ProductId == product.Id);

        if (existingLine != null)
        {
            existingLine.Quantity =
                RoundQuantity(
                    existingLine.Quantity +
                    quantity);

            SelectedLine =
                existingLine;
        }
        else
        {
            var newLine =
                new CartLine
                {
                    ProductId =
                        product.Id,

                    ProductName =
                        string.IsNullOrWhiteSpace(
                            product.CatalogName)
                            ? "Unknown product"
                            : product.CatalogName,

                    ProductBarcode =
                        product.CatalogBarcode,

                    BasePurchasePrice =
                        product.PurchasePrice,

                    Quantity =
                        RoundQuantity(quantity),

                    TaxRate =
                        product.VatRate,

                    IsPack =
                        product.IsPack,

                    PackSize =
                        product.PackSize
                };

            Lines.Add(newLine);

            SelectedLine =
                newLine;
        }

        _ = FocusBarcodeInput();
    }

    private void Increment(
        CartLine line)
    {
        line.Quantity =
            RoundQuantity(
                line.Quantity + 1m);

        SelectedLine =
            line;

        _ = FocusBarcodeInput();
    }

    private void Decrement(
        CartLine line)
    {
        if (line.Quantity > 1m)
        {
            line.Quantity =
                RoundQuantity(
                    line.Quantity - 1m);

            SelectedLine =
                line;

            _ = FocusBarcodeInput();

            return;
        }

        Lines.Remove(line);

        if (ReferenceEquals(
                SelectedLine,
                line))
        {
            SelectedLine =
                null;
        }

        _ = FocusBarcodeInput();
    }

    private void RemoveSelected()
    {
        if (SelectedLine == null)
        {
            return;
        }

        Lines.Remove(
            SelectedLine);

        SelectedLine =
            null;

        _ = FocusBarcodeInput();
    }

    private void Reset()
    {
        Lines.Clear();

        SelectedLine =
            null;

        SelectedSupplier =
            null;

        SearchText =
            string.Empty;

        BarcodeInput =
            string.Empty;

        NumpadValue =
            string.Empty;

        UpdateFilter();

        _ = FocusBarcodeInput();
    }

    private void OnLineClicked(
        CartLine line)
    {
        if (ReferenceEquals(
                SelectedLine,
                line))
        {
            line.IsExpanded =
                !line.IsExpanded;

            return;
        }

        if (SelectedLine != null)
        {
            SelectedLine.IsExpanded =
                false;
        }

        SelectedLine =
            line;

        line.IsExpanded =
            true;
    }

    private void AddPriceOverride(
        CartLine line)
    {
        if (!TryReadNumpadDecimal(
                out var price) ||
            price <= 0m)
        {
            _ = ShowErrorAsync(
                "Enter a valid unit purchase price.");

            return;
        }

        line.Adjustments.RemoveAll(
            adjustment =>
                adjustment.Type ==
                    AdjustmentType.PriceOverride);

        line.Adjustments.Add(
            new CartAdjustment
            {
                Type =
                    AdjustmentType.PriceOverride,

                Value =
                    RoundMoney(price)
            });

        NumpadValue =
            string.Empty;
    }

    private void AddDiscountPercent(
        CartLine line)
    {
        if (!TryReadNumpadDecimal(
                out var value) ||
            value <= 0m ||
            value > 100m)
        {
            _ = ShowErrorAsync(
                "Discount percentage must be greater than zero " +
                "and not exceed 100.");

            return;
        }

        RemoveDiscountAdjustments(
            line);

        line.Adjustments.Add(
            new CartAdjustment
            {
                Type =
                    AdjustmentType.DiscountPercent,

                Value =
                    Math.Round(
                        value,
                        2,
                        MidpointRounding.AwayFromZero)
            });

        NumpadValue =
            string.Empty;
    }

    private void AddDiscountAmount(
        CartLine line)
    {
        if (!TryReadNumpadDecimal(
                out var value) ||
            value <= 0m)
        {
            _ = ShowErrorAsync(
                "Enter a valid discount amount.");

            return;
        }

        var priceBeforeDiscount =
            line.PriceBeforeDiscount;

        if (value >= priceBeforeDiscount)
        {
            _ = ShowErrorAsync(
                "Discount amount must be lower than the unit price.");

            return;
        }

        RemoveDiscountAdjustments(
            line);

        line.Adjustments.Add(
            new CartAdjustment
            {
                Type =
                    AdjustmentType.DiscountAmount,

                Value =
                    RoundMoney(value)
            });

        NumpadValue =
            string.Empty;
    }

    private static void RemoveDiscountAdjustments(
        CartLine line)
    {
        line.Adjustments.RemoveAll(
            adjustment =>
                adjustment.Type ==
                    AdjustmentType.DiscountPercent ||
                adjustment.Type ==
                    AdjustmentType.DiscountAmount);
    }

    private void ClearAdjustments(
        CartLine line)
    {
        line.Adjustments.Clear();

        NumpadValue =
            string.Empty;
    }

    private async Task SavePurchase()
    {
        if (IsSaving)
        {
            return;
        }

        if (SelectedSupplier == null)
        {
            await ShowErrorAsync(
                "Select a supplier.");

            return;
        }

        if (Lines.Count == 0)
        {
            await ShowErrorAsync(
                "Add at least one product.");

            return;
        }

        var invalidLine =
            Lines.FirstOrDefault(line =>
                line.ProductId == Guid.Empty ||
                line.Quantity <= 0m ||
                line.EffectiveUnitPrice < 0m ||
                line.TaxRate < 0m ||
                line.TaxRate > 100m);

        if (invalidLine != null)
        {
            await ShowErrorAsync(
                $"Purchase line '{invalidLine.ProductName}' is invalid.");

            return;
        }

        try
        {
            IsSaving =
                true;

            var request =
                new CreateLocalPurchaseRequest
                {
                    SupplierLocalId =
                        SelectedSupplier.Id,

                    PurchaseDateUtc =
                        DateTime.UtcNow,

                    Lines =
                        Lines
                            .Select(line =>
                                new CreateLocalPurchaseLineRequest
                                {
                                    ProductLocalId =
                                        line.ProductId,

                                    Quantity =
                                        RoundQuantity(
                                            line.Quantity),

                                    /*
                                     * The local model stores the effective
                                     * unit price. The discount must not be
                                     * applied a second time by the uploader.
                                     */
                                    UnitPurchasePrice =
                                        RoundMoney(
                                            line.EffectiveUnitPrice),

                                    VatRate =
                                        Math.Round(
                                            line.TaxRate,
                                            2,
                                            MidpointRounding.AwayFromZero)
                                })
                            .ToList()
                };

            var purchase =
                await LocalPurchaseService
                    .CreateCompleteAsync(
                        request);

            /*
             * The service already:
             * - creates LocalPurchase and lines;
             * - increases LocalStock;
             * - creates local StockMovements;
             * - adds Purchase/Create to SyncQueue.
             */
            State.InvalidatePos();

            Logger.LogInformation(
                "Local purchase {PurchaseNumber} created with " +
                "{LineCount} lines.",
                purchase.LocalPurchaseNumber,
                purchase.Lines.Count);

            Reset();

            await ShowSuccessAsync(
                $"Purchase {purchase.LocalPurchaseNumber} saved " +
                "locally and queued for synchronization.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to create the local purchase.");

            await ShowErrorAsync(
                exception
                    .GetBaseException()
                    .Message);
        }
        finally
        {
            IsSaving =
                false;

            await FocusBarcodeInput();
        }
    }

    private void NavigateToDashboard()
    {
        Nav.NavigateTo("/");
    }

    private async Task FocusBarcodeInput()
    {
        try
        {
            await Task.Delay(50);

            await barcodeInputRef
                .FocusAsync();
        }
        catch
        {
            /*
             * The element may not be rendered yet or the page may
             * already be navigating away.
             */
        }
    }

    private bool TryReadNumpadDecimal(
        out decimal value)
    {
        var normalized =
            NumpadValue
                .Trim()
                .Replace(',', '.');

        return decimal.TryParse(
            normalized,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out value);
    }

    private async Task ShowSuccessAsync(
        string message)
    {
        errorMessage =
            null;

        successMessage =
            message;

        await StartToastTimerAsync(
            clearSuccess: true);
    }

    private async Task ShowErrorAsync(
        string message)
    {
        successMessage =
            null;

        errorMessage =
            message;

        await StartToastTimerAsync(
            clearSuccess: false);
    }

    private async Task StartToastTimerAsync(
        bool clearSuccess)
    {
        toastCancellation?.Cancel();
        toastCancellation?.Dispose();

        toastCancellation =
            new CancellationTokenSource();

        var currentSource =
            toastCancellation;

        await InvokeAsync(
            StateHasChanged);

        try
        {
            await Task.Delay(
                3000,
                currentSource.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ReferenceEquals(
                toastCancellation,
                currentSource))
        {
            return;
        }

        if (clearSuccess)
        {
            successMessage =
                null;
        }
        else
        {
            errorMessage =
                null;
        }

        await InvokeAsync(
            StateHasChanged);
    }

    private static bool Contains(
        string? source,
        string value)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(
                   value,
                   StringComparison.OrdinalIgnoreCase);
    }

    private static decimal RoundMoney(
        decimal value)
    {
        return Math.Round(
            value,
            2,
            MidpointRounding.AwayFromZero);
    }

    private static decimal RoundQuantity(
        decimal value)
    {
        return Math.Round(
            value,
            3,
            MidpointRounding.AwayFromZero);
    }

    private static string FormatQuantity(
        decimal quantity)
    {
        return quantity.ToString(
            "0.###",
            CultureInfo.InvariantCulture);
    }

    private sealed class CartAdjustment
    {
        public AdjustmentType Type { get; set; }

        public decimal Value { get; set; }

        public decimal Apply(
            decimal basePrice)
        {
            return Type switch
            {
                AdjustmentType.PriceOverride =>
                    Value,

                AdjustmentType.DiscountPercent =>
                    basePrice *
                    (1m - Value / 100m),

                AdjustmentType.DiscountAmount =>
                    basePrice - Value,

                AdjustmentType.Fee =>
                    basePrice + Value,

                _ =>
                    basePrice
            };
        }

        public string Display =>
            Type switch
            {
                AdjustmentType.PriceOverride =>
                    $"Price changed → €{Value:0.00}",

                AdjustmentType.DiscountPercent =>
                    $"Discount → -{Value:0.##}%",

                AdjustmentType.DiscountAmount =>
                    $"Discount → -€{Value:0.00}",

                AdjustmentType.Fee =>
                    $"Fee → +€{Value:0.00}",

                _ =>
                    string.Empty
            };
    }

    private sealed class CartLine
    {
        public Guid ProductId { get; set; }

        public string ProductName { get; set; } =
            string.Empty;

        public string? ProductBarcode { get; set; }

        public decimal Quantity { get; set; }

        public decimal BasePurchasePrice { get; set; }

        public decimal TaxRate { get; set; }

        public bool IsPack { get; set; }

        public decimal PackSize { get; set; }

        public bool IsExpanded { get; set; }

        public List<CartAdjustment> Adjustments { get; set; } =
            new();

        public decimal PriceBeforeDiscount
        {
            get
            {
                var overrideAdjustment =
                    Adjustments.LastOrDefault(
                        adjustment =>
                            adjustment.Type ==
                                AdjustmentType.PriceOverride);

                return overrideAdjustment?.Value ??
                       BasePurchasePrice;
            }
        }

        public decimal EffectiveUnitPrice
        {
            get
            {
                var price =
                    BasePurchasePrice;

                foreach (var adjustment in Adjustments)
                {
                    price =
                        adjustment.Apply(price);
                }

                return RoundMoney(
                    Math.Max(
                        0m,
                        price));
            }
        }

        public decimal AmountExclVat =>
            RoundMoney(
                Quantity *
                EffectiveUnitPrice);

        public decimal TaxAmount =>
            RoundMoney(
                AmountExclVat *
                TaxRate /
                100m);

        public decimal AmountInclVat =>
            AmountExclVat +
            TaxAmount;
    }
}
