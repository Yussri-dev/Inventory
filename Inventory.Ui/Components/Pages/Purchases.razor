    private static PurchaseDraftAdjustmentType
        ToDraftAdjustmentType(
            AdjustmentType type)
    {
        return type switch
        {
            AdjustmentType.PriceOverride =>
                PurchaseDraftAdjustmentType.PriceOverride,

            AdjustmentType.DiscountPercent =>
                PurchaseDraftAdjustmentType.DiscountPercent,

            AdjustmentType.DiscountAmount =>
                PurchaseDraftAdjustmentType.DiscountAmount,

            AdjustmentType.Fee =>
                PurchaseDraftAdjustmentType.Fee,

            _ =>
                throw new InvalidOperationException(
                    $"Unsupported cart adjustment type: {type}.")
        };
    }

    private static AdjustmentType ToCartAdjustmentType(
        PurchaseDraftAdjustmentType type)
    {
        return type switch
        {
            PurchaseDraftAdjustmentType.PriceOverride =>
                AdjustmentType.PriceOverride,

            PurchaseDraftAdjustmentType.DiscountPercent =>
                AdjustmentType.DiscountPercent,

            PurchaseDraftAdjustmentType.DiscountAmount =>
                AdjustmentType.DiscountAmount,

            PurchaseDraftAdjustmentType.Fee =>
                AdjustmentType.Fee,

            _ =>
                throw new InvalidOperationException(
                    $"Unsupported draft adjustment type: {type}.")
        };
    }

    private void BuildBarcodeMap()
    {
        BarcodeMap =
        Products
        .Where(product =>
        !string.IsNullOrWhiteSpace(
        product.CatalogBarcode))
        .GroupBy(
        product =>
        product.CatalogBarcode!.Trim(),
        StringComparer.OrdinalIgnoreCase)
        .ToDictionary(
        group => group.Key,
        group => group.First(),
        StringComparer.OrdinalIgnoreCase);
    }

    private void UpdateFilter()
    {
        var search =
        SearchText.Trim();

        FilteredProducts =
        string.IsNullOrWhiteSpace(search)
        ? Products.ToList()
        : Products
        .Where(product =>
        Contains(
        product.CatalogName,
        search) ||
        Contains(
        product.CatalogBarcode,
        search) ||
        Contains(
        product.CatalogBrand,
        search))
        .ToList();
    }

    private void OpenSupplierModal()
    {
        TempSelectedSupplier =
        SelectedSupplier;

        SupplierSearchText =
        string.Empty;

        ShowSupplierModal =
        true;
    }

    private void CloseSupplierModal()
    {
        ShowSupplierModal =
        false;

        TempSelectedSupplier =
        null;

        SupplierSearchText =
        string.Empty;
    }

    private void ConfirmSupplierSelection()
    {
        if (TempSelectedSupplier == null)
        {
            return;
        }

        SelectedSupplier =
        TempSelectedSupplier;

        CloseSupplierModal();

        ScheduleDraftSave();

        _ = FocusBarcodeInput();
    }

    private async Task OnBarcodeScanned(
    string code)
    {
        var normalizedCode =
        code.Trim();

        if (!BarcodeMap.TryGetValue(
        normalizedCode,
        out var product))
        {
            await ShowErrorAsync(
            $"Unknown local barcode: {normalizedCode}");

            return;
        }

        await AddProductAsync(product, GetQuantityFromNumpad());

        NumpadValue =
        string.Empty;

        await FocusBarcodeInput();
    }

    private async Task OnBarcodeKeyDown(
     KeyboardEventArgs args)
    {
        var isSubmitKey =
            string.Equals(
                args.Key,
                "Enter",
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(
                args.Key,
                "Tab",
                StringComparison.OrdinalIgnoreCase);

        if (!isSubmitKey)
        {
            return;
        }

        var barcode =
            BarcodeInput.Trim();

        if (string.IsNullOrWhiteSpace(barcode))
        {
            return;
        }

        BarcodeInput =
            string.Empty;

        await OnHardwareScan(barcode);
    }

    private async Task AddProductByBarcodeAsync(
        string barcode)
    {
        if (!BarcodeMap.TryGetValue(
                barcode,
                out var product))
        {
            await ShowErrorAsync(
                $"Unknown local barcode: {barcode}");

            return;
        }

        await AddProductAsync(
            product,
            GetQuantityFromNumpad());
    }

    private async Task PressKey(
    string key)
    {
        if (key == "." &&
            NumpadValue.Contains(
                '.',
                StringComparison.Ordinal))
        {
            await FocusBarcodeInput();
            return;
        }

        NumpadValue += key;

        await FocusBarcodeInput();
    }

    private async Task ClearNumpad()
    {
        NumpadValue =
            string.Empty;

        await FocusBarcodeInput();
    }

    private async Task SelectAndAddProduct(
    ProductResult product)
    {
        await AddProductAsync(product, GetQuantityFromNumpad());

        NumpadValue =
        string.Empty;

        _ = FocusBarcodeInput();
    }

    private decimal GetQuantityFromNumpad()
    {
        return TryReadNumpadDecimal(
        out var quantity) &&
        quantity > 0m
        ? RoundQuantity(quantity)
        : 1m;
    }

    private async Task AddProductAsync(ProductResult product, decimal quantity)
    {
        if (quantity <= 0m)
        {
            await ShowErrorAsync(
            "Quantity must be greater than zero.");

            return;
        }

        if (product.PurchasePrice <= 0m)
        {
            await ShowErrorAsync(
            $"Product '{product.CatalogName}' has no valid " +
            "purchase price.");

            return;
        }

        var existingLine =
        Lines.FirstOrDefault(line =>
        line.ProductId == product.Id);

        if (existingLine != null)
        {
            existingLine.Quantity =
                RoundQuantity(
                    existingLine.Quantity +
                    quantity);

            SelectedLine =
                existingLine;
        }
        else
        {
            var newLine =
                new CartLine
                {
                    ProductId = product.Id,

                    ProductName =
                        string.IsNullOrWhiteSpace(
                            product.CatalogName)
                            ? "Unknown product"
                            : product.CatalogName,

                    ProductBarcode =
                        product.CatalogBarcode,

                    BasePurchasePrice =
                        product.PurchasePrice,

                    Quantity =
                        RoundQuantity(quantity),

                    TaxRate =
                        product.VatRate,

                    IsPack =
                        product.IsPack,

                    PackSize =
                        product.PackSize
                };

            Lines.Add(newLine);

            SelectedLine =
                newLine;
        }

        NumpadValue =
            string.Empty;

        ScheduleDraftSave();

        await FocusBarcodeInput();
    }

    private void Increment(
    CartLine line)
    {
        line.Quantity =
        RoundQuantity(
        line.Quantity + 1m);

        SelectedLine =
        line;

        ScheduleDraftSave();

        _ = FocusBarcodeInput();
    }

    private void Decrement(
    CartLine line)
    {
        if (line.Quantity > 1m)
        {
            line.Quantity =
            RoundQuantity(
            line.Quantity - 1m);

            SelectedLine =
            line;

            ScheduleDraftSave();

            _ = FocusBarcodeInput();

            return;
        }

        Lines.Remove(line);

        if (ReferenceEquals(
        SelectedLine,
        line))
        {
            SelectedLine =
            null;
        }

        ScheduleDraftSave();

        _ = FocusBarcodeInput();
    }

    private void RemoveSelected()
    {
        if (SelectedLine == null)
        {
            return;
        }

        Lines.Remove(
        SelectedLine);

        SelectedLine =
        null;

        ScheduleDraftSave();

        _ = FocusBarcodeInput();
    }

    private async Task ResetPurchaseAsync()
    {
        draftSaveCancellation?.Cancel();
        draftSaveCancellation?.Dispose();
        draftSaveCancellation = null;

        await draftSaveGate.WaitAsync();

        try
        {
            if (CurrentDraftId.HasValue)
            {
                await LocalPurchaseDraftService
                    .DeleteAsync(
                        CurrentDraftId.Value);
            }

            CurrentDraftId =
                null;

            ClearPurchaseState();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to delete the purchase draft.");

            var rootException = exception.GetBaseException();

            await ShowErrorAsync($"Draft reset failed: {rootException.Message}");

            return;
        }
        finally
        {
            draftSaveGate.Release();
        }

        await FocusBarcodeInput();
    }

    private void ClearPurchaseState()
    {
        Lines.Clear();

        SelectedLine =
        null;

        SelectedSupplier =
        null;

        SearchText =
        string.Empty;

        BarcodeInput =
        string.Empty;

        NumpadValue =
        string.Empty;

        UpdateFilter();
    }

    private void OnLineClicked(
    CartLine line)
    {
        if (ReferenceEquals(
        SelectedLine,
        line))
        {
            line.IsExpanded =
            !line.IsExpanded;

            return;
        }

        if (SelectedLine != null)
        {
            SelectedLine.IsExpanded =
            false;
        }

        SelectedLine =
        line;

        line.IsExpanded =
        true;
    }

    private void AddPriceOverride(
    CartLine line)
    {
        if (!TryReadNumpadDecimal(
        out var price) ||
        price <= 0m)
        {
            _ = ShowErrorAsync(
            "Enter a valid unit purchase price.");

            return;
        }

        line.Adjustments.RemoveAll(
        adjustment =>
        adjustment.Type ==
        AdjustmentType.PriceOverride);

        line.Adjustments.Add(
        new CartAdjustment
        {
            Type =
        AdjustmentType.PriceOverride,

            Value =
        RoundMoney(price)
        });

        NumpadValue =
        string.Empty;

        ScheduleDraftSave();
    }

    private void AddDiscountPercent(
    CartLine line)
    {
        if (!TryReadNumpadDecimal(
        out var value) ||
        value <= 0m ||
        value > 100m)
        {
            _ = ShowErrorAsync(
            "Discount percentage must be greater than zero " +
            "and not exceed 100.");

            return;
        }

        RemoveDiscountAdjustments(
        line);

        line.Adjustments.Add(
        new CartAdjustment
        {
            Type =
        AdjustmentType.DiscountPercent,

            Value =
        Math.Round(
        value,
        2,
        MidpointRounding.AwayFromZero)
        });

        NumpadValue =
        string.Empty;

        ScheduleDraftSave();
    }

    private void AddDiscountAmount(
    CartLine line)
    {
        if (!TryReadNumpadDecimal(
        out var value) ||
        value <= 0m)
        {
            _ = ShowErrorAsync(
            "Enter a valid discount amount.");

            return;
        }

        var priceBeforeDiscount =
        line.PriceBeforeDiscount;

        if (value >= priceBeforeDiscount)
        {
            _ = ShowErrorAsync(
            "Discount amount must be lower than the unit price.");

            return;
        }

        RemoveDiscountAdjustments(
        line);

        line.Adjustments.Add(
        new CartAdjustment
        {
            Type =
        AdjustmentType.DiscountAmount,

            Value =
        RoundMoney(value)
        });

        NumpadValue =
        string.Empty;

        ScheduleDraftSave();
    }

    private static void RemoveDiscountAdjustments(
    CartLine line)
    {
        line.Adjustments.RemoveAll(
        adjustment =>
        adjustment.Type ==
        AdjustmentType.DiscountPercent ||
        adjustment.Type ==
        AdjustmentType.DiscountAmount);
    }

    private void ClearAdjustments(
    CartLine line)
    {
        line.Adjustments.Clear();

        NumpadValue =
        string.Empty;

        ScheduleDraftSave();
    }

    private async Task SavePurchase()
    {
        if (IsSaving)
        {
            return;
        }

        if (SelectedSupplier == null)
        {
            await ShowErrorAsync(
            "Select a supplier.");

            return;
        }

        if (Lines.Count == 0)
        {
            await ShowErrorAsync(
            "Add at least one product.");

            return;
        }

        var invalidLine =
        Lines.FirstOrDefault(line =>
        line.ProductId == Guid.Empty ||
        line.Quantity <= 0m ||
        line.EffectiveUnitPrice < 0m ||
        line.TaxRate < 0m ||
        line.TaxRate > 100m);

        if (invalidLine != null)
        {
            await ShowErrorAsync(
            $"Purchase line '{invalidLine.ProductName}' is invalid.");

            return;
        }

        try
        {
            IsSaving =
            true;

            draftSaveCancellation?.Cancel();
            draftSaveCancellation?.Dispose();
            draftSaveCancellation = null;

            /*
             * Persist the last cart state first. If final creation fails,
             * the complete draft remains available.
             */
            await SaveCurrentDraftAsync();

            IsFinalizingPurchase =
                true;

            var request =
            new CreateLocalPurchaseRequest
            {
                SupplierLocalId =
            SelectedSupplier.Id,

                PurchaseDateUtc =
            DateTime.UtcNow,

                Lines =
            Lines
            .Select(line =>
            new CreateLocalPurchaseLineRequest
            {
                ProductLocalId =
            line.ProductId,

                Quantity =
            RoundQuantity(
            line.Quantity),

                /*
                * The local model stores the effective
                * unit price. The discount must not be
                * applied a second time by the uploader.
                */
                UnitPurchasePrice =
            RoundMoney(
            line.EffectiveUnitPrice),

                VatRate =
            Math.Round(
            line.TaxRate,
            2,
            MidpointRounding.AwayFromZero)
            })
            .ToList()
            };

            var purchase =
            await LocalPurchaseService
            .CreateCompleteAsync(
            request);

            /*
            * The service already:
            * - creates LocalPurchase and lines;
            * - increases LocalStock;
            * - creates local StockMovements;
            * - adds Purchase/Create to SyncQueue.
            */
            State.InvalidatePos();

            Logger.LogInformation(
            "Local purchase {PurchaseNumber} created with " +
            "{LineCount} lines.",
            purchase.LocalPurchaseNumber,
            purchase.Lines.Count);

            var draftCleanupSucceeded =
                true;

            if (CurrentDraftId.HasValue)
            {
                try
                {
                    await LocalPurchaseDraftService
                        .DeleteAsync(
                            CurrentDraftId.Value);

                    CurrentDraftId =
                        null;
                }
                catch (Exception cleanupException)
                {
                    draftCleanupSucceeded =
                        false;

                    Logger.LogError(
                        cleanupException,
                        "Purchase {PurchaseNumber} was saved, but draft " +
                        "{DraftId} could not be deleted.",
                        purchase.LocalPurchaseNumber,
                        CurrentDraftId);
                }
            }

            ClearPurchaseState();

            if (draftCleanupSucceeded)
            {
                await ShowSuccessAsync(
                    $"Purchase {purchase.LocalPurchaseNumber} saved " +
                    "locally and queued for synchronization.");
            }
            else
            {
                await ShowErrorAsync(
                    $"Purchase {purchase.LocalPurchaseNumber} was saved, " +
                    "but the old draft could not be removed.");
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(
            exception,
            "Failed to create the local purchase.");

            await ShowErrorAsync(
            exception
            .GetBaseException()
            .Message);
        }
        finally
        {
            IsFinalizingPurchase =
                false;

            IsSaving =
            false;

            await FocusBarcodeInput();
        }
    }

    private async Task FocusBarcodeInput()
    {
        if (ShowSupplierModal ||
            IsSaving)
        {
            return;
        }

        try
        {
            await barcodeInputRef.FocusAsync();
        }
        catch (Exception exception)
        {
            Logger.LogDebug(
                exception,
                "Barcode input could not receive focus.");
        }
    }

    private bool TryReadNumpadDecimal(
    out decimal value)
    {
        var normalized =
        NumpadValue
        .Trim()
        .Replace(',', '.');

        return decimal.TryParse(
        normalized,
        NumberStyles.Number,
        CultureInfo.InvariantCulture,
        out value);
    }

    private Task ShowSuccessAsync(
     string message)
    {
        errorMessage = null;
        successMessage = message;

        RestartToastTimer(
            clearSuccess: true);

        return InvokeAsync(
            StateHasChanged);
    }

    private Task ShowErrorAsync(
        string message)
    {
        successMessage = null;
        errorMessage = message;

        RestartToastTimer(
            clearSuccess: false);

        return InvokeAsync(
            StateHasChanged);
    }

    private void RestartToastTimer(
        bool clearSuccess)
    {
        toastCancellation?.Cancel();
        toastCancellation?.Dispose();

        var source =
            new CancellationTokenSource();

        toastCancellation =
            source;

        _ = ClearToastLaterAsync(
            source,
            clearSuccess);
    }

    private async Task ClearToastLaterAsync(
        CancellationTokenSource source,
        bool clearSuccess)
    {
        try
        {
            await Task.Delay(
                3000,
                source.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!ReferenceEquals(
                        toastCancellation,
                        source))
                {
                    return;
                }

                if (clearSuccess)
                {
                    successMessage = null;
                }
                else
                {
                    errorMessage = null;
                }

                toastCancellation = null;
                source.Dispose();

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task StartToastTimerAsync(
    bool clearSuccess)
    {
        toastCancellation?.Cancel();
        toastCancellation?.Dispose();

        toastCancellation =
        new CancellationTokenSource();

        var currentSource =
        toastCancellation;

        await InvokeAsync(
        StateHasChanged);

        try
        {
            await Task.Delay(
            3000,
            currentSource.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ReferenceEquals(
        toastCancellation,
        currentSource))
        {
            return;
        }

        if (clearSuccess)
        {
            successMessage =
            null;
        }
        else
        {
            errorMessage =
            null;
        }

        await InvokeAsync(
        StateHasChanged);
    }

    private static bool Contains(
    string? source,
    string value)
    {
        return !string.IsNullOrWhiteSpace(source) &&
        source.Contains(
        value,
        StringComparison.OrdinalIgnoreCase);
    }

    private static decimal RoundMoney(
    decimal value)
    {
        return Math.Round(
        value,
        2,
        MidpointRounding.AwayFromZero);
    }

    private static decimal RoundQuantity(
    decimal value)
    {
        return Math.Round(
        value,
        3,
        MidpointRounding.AwayFromZero);
    }

    private static string FormatQuantity(
    decimal quantity)
    {
        return quantity.ToString(
        "0.###",
        CultureInfo.InvariantCulture);
    }

    private sealed class CartAdjustment
    {
        public AdjustmentType Type { get; set; }

        public decimal Value { get; set; }

        public decimal Apply(
        decimal basePrice)
        {
            return Type switch
            {
                AdjustmentType.PriceOverride =>
                Value,

                AdjustmentType.DiscountPercent =>
                basePrice *
                (1m - Value / 100m),

                AdjustmentType.DiscountAmount =>
                basePrice - Value,

                AdjustmentType.Fee =>
                basePrice + Value,

                _ =>
                basePrice
            };
        }

        public string Display =>
        Type switch
        {
            AdjustmentType.PriceOverride =>
            $"Price changed → €{Value:0.00}",

            AdjustmentType.DiscountPercent =>
            $"Discount → -{Value:0.##}%",

            AdjustmentType.DiscountAmount =>
            $"Discount → -€{Value:0.00}",

            AdjustmentType.Fee =>
            $"Fee → +€{Value:0.00}",

            _ =>
            string.Empty
        };
    }

    private sealed class CartLine
    {
        public Guid ProductId { get; set; }

        public string ProductName { get; set; } =
        string.Empty;

        public string? ProductBarcode { get; set; }

        public decimal Quantity { get; set; }

        public decimal BasePurchasePrice { get; set; }

        public decimal TaxRate { get; set; }

        public bool IsPack { get; set; }

        public decimal PackSize { get; set; }

        public bool IsExpanded { get; set; }

        public List<CartAdjustment>
            Adjustments
        { get; set; } =
            new();

        public decimal PriceBeforeDiscount
        {
            get
            {
                var overrideAdjustment =
                Adjustments.LastOrDefault(
                adjustment =>
                adjustment.Type ==
                AdjustmentType.PriceOverride);

                return overrideAdjustment?.Value ??
                BasePurchasePrice;
            }
        }

        public decimal EffectiveUnitPrice
        {
            get
            {
                var price =
                BasePurchasePrice;

                foreach (var adjustment in Adjustments)
                {
                    price =
                    adjustment.Apply(price);
                }

                return RoundMoney(
                Math.Max(
                0m,
                price));
            }
        }

        public decimal AmountExclVat =>
        RoundMoney(
        Quantity *
        EffectiveUnitPrice);

        public decimal TaxAmount =>
        RoundMoney(
        AmountExclVat *
        TaxRate /
        100m);

        public decimal AmountInclVat =>
        AmountExclVat +
        TaxAmount;
    }
}