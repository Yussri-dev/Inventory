@page "/login"
@layout AuthLayout

@using System.Security.Claims
@using System.Text.Json
@using Inventory.Dto.Auth.Requests
@using Inventory.Dto.Auth.Results
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.Ui.Authentification
@using Inventory.Ui.Interfaces
@using Inventory.Ui.Services
@using Inventory.Ui.Services.Sync
@using Inventory.Ui.State
@using Microsoft.AspNetCore.Components.Authorization
@using Refit

@inject IAuthApiOpen AuthApi
@inject ISecureStorageService SecureStorage
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject AppState State

@inject ILocalUserSessionService LocalUserSessionService
@inject ILocalTenantContext LocalTenantContext

@inject ILocalProductCategoryQueryService LocalCategoryQuery
@inject ILocalProductCatalogQueryService LocalCatalogQuery
@inject ILocalProductSyncService ProductSync
@inject ILocalStockSyncService StockSync
@inject ILocalStoreProfileService LocalStoreProfileService

@inject LocalDataBootstrapService LocalDataBootstrap
@inject IBackgroundSyncCoordinator BackgroundSync

<div class="login-card">

    <div class="login-header">

        <div class="logo-circle">
            <span class="logo-icon">🏪</span>
        </div>

        <h2>Welcome Back</h2>

        <p class="subtitle">
            Sign in to your account
        </p>

    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-error">

            <span class="alert-icon">⚠️</span>

            <span>@Error</span>

        </div>
    }

    @if (IsSynchronizing)
    {
        <div class="alert">

            <span class="spinner"></span>

            <span>
                First synchronization in progress.
                Preparing products and offline data...
            </span>

        </div>
    }

    <form class="login-form"
          @onsubmit="LoginAsync"
          @onsubmit:preventDefault>

        <div class="form-group">

            <label class="form-label">
                Email Address
            </label>

            <div class="input-wrapper">

                <span class="input-icon">
                    📧
                </span>

                <input class="form-input"
                       type="email"
                       @bind="Model.Email"
                       @bind:event="oninput"
                       placeholder="your@email.com"
                       autocomplete="username"
                       disabled="@IsLoading" />

            </div>

        </div>

        <div class="form-group">

            <label class="form-label">
                Password
            </label>

            <div class="input-wrapper">

                <span class="input-icon">
                    🔒
                </span>

                <input class="form-input"
                       type="password"
                       @bind="Model.Password"
                       @bind:event="oninput"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       disabled="@IsLoading" />

            </div>

        </div>

        <button class="btn-login"
                type="submit"
                disabled="@IsLoading">

            @if (IsLoading)
            {
                <span class="spinner"></span>

                <span>
                    @(IsSynchronizing
                                    ? "Preparing offline data..."
                                    : "Logging in...")
            </span>
                        }
            else
            {
                <span>Sign In</span>

                <span class="btn-arrow">
                    →
                </span>
            }

        </button>

    </form>

    <div class="login-footer">

        @if (DaysLeft.HasValue)
        {
            <div class="trial-info">

                Trial ends in

                <strong>
                    @DaysLeft.Value
                </strong>

                days

            </div>
        }

        <p class="footer-text">

            Forgot your password?

            <a href="/forgot-password">
                Reset it
            </a>

        </p>

        <p class="footer-text">
            Offline access is available after the first successful synchronization.
        </p>

    </div>

</div>

@code {
    private const string SuperAdminRole =
        "SuperAdmin";

    /*
     * La première initialisation ne doit pas rester
     * bloquée indéfiniment.
     */
    private static readonly TimeSpan CriticalSyncTimeout =
        TimeSpan.FromMinutes(2);

    private LoginRequest Model =
        new();

    private bool IsLoading;

    private bool IsSynchronizing;

    private string Error =
        string.Empty;

    private int? DaysLeft;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthStateProvider
                .GetAuthenticationStateAsync();

        var user =
            authenticationState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var role =
            GetRole(user);

        /*
         * Une session SuperAdmin sans tenant est valide.
         *
         * Le SuperAdmin ne démarre pas la synchronisation
         * des données locales d'un tenant.
         */
        if (IsSuperAdmin(role))
        {
            LocalTenantContext.Clear();

            Nav.NavigateTo(
                "/",
                replace: true);

            return;
        }

        var tenantIdClaim =
            GetTenantIdClaim(user);

        if (!Guid.TryParse(
                tenantIdClaim,
                out var tenantId) ||
            tenantId == Guid.Empty)
        {
            await ClearAuthenticationAsync();

            Error =
                "Your local session could not be restored. " +
                "Please sign in again.";

            return;
        }

        LocalTenantContext.SetTenant(
            tenantId);

        try
        {
            /*
             * Cette vérification est rapide si SQLite est déjà
             * initialisé.
             *
             * Une synchronisation minimale ne sera lancée que si
             * les données essentielles sont absentes.
             */
            await EnsureCriticalDataAfterOnlineLoginAsync();

            /*
             * Le coordinateur possède son propre scope.
             * La synchronisation complète ne bloque pas la navigation.
             */
            _ = BackgroundSync.StartAsync();

            Nav.NavigateTo(
                "/",
                replace: true);
        }
        catch (Exception exception)
        {
            await ClearAuthenticationAsync();

            Error =
                exception
                    .GetBaseException()
                    .Message;

            System.Diagnostics.Debug.WriteLine(
                $"Session restoration failed: {exception}");
        }
    }

    private async Task LoginAsync()
    {
        if (IsLoading)
        {
            return;
        }

        NormalizeForm();

        if (string.IsNullOrWhiteSpace(Model.Email) ||
            string.IsNullOrWhiteSpace(Model.Password))
        {
            Error =
                "Please enter your email and password.";

            return;
        }

        Error =
            string.Empty;

        IsLoading =
            true;

        IsSynchronizing =
            false;

        try
        {
            await LoginOnlineAsync();
        }
        catch (TaskCanceledException)
        {
            await TryLoginOfflineAsync(
                "The server request timed out.");
        }
        catch (HttpRequestException)
        {
            await TryLoginOfflineAsync(
                "The API server is unavailable.");
        }
        catch (ApiException exception)
        {
            Error =
                ParseApiError(
                    exception.Content)
                ?? exception.ReasonPhrase
                ?? "Login failed.";
        }
        catch (Exception exception)
        {
            Error =
                exception
                    .GetBaseException()
                    .Message;

            System.Diagnostics.Debug.WriteLine(
                $"Login failed: {exception}");
        }
        finally
        {
            IsSynchronizing =
                false;

            IsLoading =
                false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private async Task LoginOnlineAsync()
    {
        var authenticationPrepared =
            false;

        try
        {
            var result =
                await AuthApi.Login(
                    Model);

            ValidateAuthResult(
                result);

            var accessToken =
                NormalizeBearerToken(
                    result!.AccessToken);

            SetTrialInformation(
                result.TrialEndDate);

            /*
             * Le JWT doit être enregistré avant les appels
             * vers les API sécurisées de synchronisation.
             */
            await SecureStorage.SaveTokenAsync(
                accessToken);

            authenticationPrepared =
                true;

            /*
             * Le SuperAdmin est global :
             *
             * - aucun TenantId requis ;
             * - aucun contexte SQLite tenant ;
             * - aucune synchronisation produits/stocks/ventes ;
             * - accès aux données globales autorisées.
             */
            if (IsSuperAdmin(result.Role))
            {
                LocalTenantContext.Clear();

                if (AuthStateProvider
                    is JwtAuthStateProvider superAdminJwt)
                {
                    superAdminJwt.NotifyUserLoggedIn(
                        accessToken);
                }

                State.InvalidatePos();

                Nav.NavigateTo(
                    "/",
                    replace: true);

                return;
            }

            /*
             * ValidateAuthResult garantit que le TenantId
             * est présent pour un utilisateur normal.
             */
            var tenantId =
                result.TenantId!.Value;

            await LocalUserSessionService
                .SaveFromAuthResultAsync(
                    result,
                    Model.Password);

            LocalTenantContext.SetTenant(
                tenantId);

            /*
             * Bloquant uniquement lors de la première connexion
             * de cet appareil.
             *
             * Les connexions suivantes utilisent immédiatement
             * les données SQLite déjà présentes.
             */
            await EnsureCriticalDataAfterOnlineLoginAsync();

            if (AuthStateProvider
                is JwtAuthStateProvider jwt)
            {
                jwt.NotifyUserLoggedIn(
                    accessToken);
            }

            State.InvalidatePos();

            /*
             * Démarrer la synchronisation complète avant la navigation,
             * mais ne pas l'attendre.
             */
            _ = BackgroundSync.StartAsync();

            Nav.NavigateTo(
                "/",
                replace: true);
        }
        catch
        {
            /*
             * Lorsque le login API a réussi mais que la première
             * synchronisation obligatoire échoue, il ne faut pas
             * laisser un JWT incomplet dans SecureStorage.
             */
            if (authenticationPrepared)
            {
                await ClearAuthenticationAsync();
            }

            throw;
        }
    }

    private async Task EnsureCriticalDataAfterOnlineLoginAsync()
    {
        /*
         * Vérification locale rapide.
         *
         * Aucun appel HTTP lorsque les données essentielles
         * existent déjà.
         */
        var hasCriticalData =
            await HasCriticalOfflineDataAsync();

        if (hasCriticalData)
        {
            return;
        }

        IsSynchronizing =
            true;

        await InvokeAsync(
            StateHasChanged);

        using var timeoutCancellation =
            new CancellationTokenSource(
                CriticalSyncTimeout);

        try
        {
            /*
             * Première connexion :
             *
             * - profil du magasin ;
             * - catégories ;
             * - catalogue ;
             * - produits ;
             * - stocks.
             */
            await LocalDataBootstrap
                .EnsureCriticalDataAsync(
                    timeoutCancellation.Token);

            hasCriticalData =
                await HasCriticalOfflineDataAsync();

            if (!hasCriticalData)
            {
                throw new InvalidOperationException(
                    "The first synchronization completed, but the required " +
                    "offline data is still incomplete.");
            }
        }
        catch (Exception exception)
            when (IsNetworkFailure(exception))
        {
            /*
             * La connexion peut tomber après qu'une partie des données
             * a été téléchargée.
             *
             * On vérifie donc une dernière fois SQLite.
             */
            hasCriticalData =
                await HasCriticalOfflineDataAsync();

            if (!hasCriticalData)
            {
                throw new InvalidOperationException(
                    "The first synchronization could not be completed. " +
                    "Connect to the server and try again.",
                    exception);
            }

            System.Diagnostics.Debug.WriteLine(
                "The server became unavailable during the critical " +
                "synchronization. Existing SQLite data will be used.");
        }
        finally
        {
            IsSynchronizing =
                false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private async Task TryLoginOfflineAsync(
        string networkMessage)
    {
        /*
         * Le mot de passe reste obligatoire en mode offline.
         */
        var localUser =
            await LocalUserSessionService
                .ValidateOfflineLoginAsync(
                    Model.Email,
                    Model.Password);

        if (localUser == null)
        {
            Error =
                $"{networkMessage} " +
                "Offline login failed. " +
                "Check your email and password, " +
                "or log in online first.";

            return;
        }

        Guid? tenantIdCandidate =
            localUser.TenantId;

        if (!tenantIdCandidate.HasValue ||
            tenantIdCandidate.Value == Guid.Empty)
        {
            Error =
                "The local account is not associated with a tenant.";

            return;
        }

        var tenantId =
            tenantIdCandidate.Value;

        /*
         * Le contexte tenant doit être défini avant toutes
         * les requêtes SQLite.
         */
        LocalTenantContext.SetTenant(
            tenantId);

        var hasOfflineData =
            await HasCriticalOfflineDataAsync();

        if (!hasOfflineData)
        {
            LocalTenantContext.Clear();

            Error =
                "This device has not completed its first synchronization. " +
                "Connect to the API and log in online before using offline mode.";

            return;
        }

        if (AuthStateProvider
            is JwtAuthStateProvider jwt)
        {
            jwt.NotifyUserLoggedInOffline(
                localUser.UserId,
                localUser.Email,
                localUser.FullName,
                localUser.Role,
                tenantId);
        }

        State.InvalidatePos();

        Nav.NavigateTo(
            "/",
            replace: true);
    }

    private async Task<bool> HasCriticalOfflineDataAsync()
    {
        try
        {
            /*
             * Le profil du magasin est nécessaire pour les tickets.
             */
            var storeProfile =
                await LocalStoreProfileService
                    .GetCurrentAsync();

            if (storeProfile == null)
            {
                return false;
            }

            var hasCategories =
                await LocalCategoryQuery
                    .HasLocalDataAsync();

            if (!hasCategories)
            {
                return false;
            }

            var hasCatalogs =
                await LocalCatalogQuery
                    .HasLocalDataAsync();

            if (!hasCatalogs)
            {
                return false;
            }

            var productsInitialized =
                await ProductSync
                    .HasInitialSyncCompletedAsync();

            if (!productsInitialized)
            {
                return false;
            }

            var stocksInitialized =
                await StockSync
                    .HasInitialSyncCompletedAsync();

            return stocksInitialized;
        }
        catch (Exception exception)
        {
            System.Diagnostics.Debug.WriteLine(
                $"Critical offline data verification failed: {exception}");

            return false;
        }
    }

    private async Task ClearAuthenticationAsync()
    {
        try
        {
            await SecureStorage
                .RemoveTokenAsync();
        }
        catch (Exception exception)
        {
            System.Diagnostics.Debug.WriteLine(
                $"Unable to remove access token: {exception}");
        }

        LocalTenantContext.Clear();

        if (AuthStateProvider
            is JwtAuthStateProvider jwt)
        {
            jwt.NotifyUserLoggedOut();
        }

        State.InvalidatePos();
    }

    private static void ValidateAuthResult(
        AuthResult? result)
    {
        if (result == null)
        {
            throw new InvalidOperationException(
                "Invalid login response.");
        }

        if (string.IsNullOrWhiteSpace(
                result.AccessToken))
        {
            throw new InvalidOperationException(
                "Invalid login response: missing access token.");
        }

        if (result.UserId == Guid.Empty)
        {
            throw new InvalidOperationException(
                "Invalid login response: missing user id.");
        }

        if (string.IsNullOrWhiteSpace(
                result.Email))
        {
            throw new InvalidOperationException(
                "Invalid login response: missing email.");
        }

        if (string.IsNullOrWhiteSpace(
                result.Role))
        {
            throw new InvalidOperationException(
                "Invalid login response: missing role.");
        }

        /*
         * Le SuperAdmin est global et peut ne pas avoir de TenantId.
         *
         * Tous les autres rôles appartiennent obligatoirement
         * à un tenant.
         */
        if (!IsSuperAdmin(result.Role) &&
            (!result.TenantId.HasValue ||
             result.TenantId.Value == Guid.Empty))
        {
            throw new InvalidOperationException(
                "This account is not associated with a tenant.");
        }
    }

    private void NormalizeForm()
    {
        Model.Email =
            Model.Email?.Trim()
            ?? string.Empty;
    }

    private void SetTrialInformation(
        DateTime? trialEndDate)
    {
        if (!trialEndDate.HasValue)
        {
            DaysLeft =
                null;

            return;
        }

        DaysLeft =
            Math.Max(
                0,
                (int)Math.Ceiling(
                    (trialEndDate.Value - DateTime.UtcNow)
                    .TotalDays));
    }

    private static string? GetRole(
        ClaimsPrincipal user)
    {
        return user.FindFirst(
                   ClaimTypes.Role)?.Value
               ?? user.FindFirst(
                   "role")?.Value
               ?? user.FindFirst(
                   "Role")?.Value;
    }

    private static string? GetTenantIdClaim(
        ClaimsPrincipal user)
    {
        return user.FindFirst(
                   "TenantId")?.Value
               ?? user.FindFirst(
                   "tenantId")?.Value
               ?? user.FindFirst(
                   "tenant_id")?.Value;
    }

    private static bool IsSuperAdmin(
        string? role)
    {
        return string.Equals(
            role?.Trim(),
            SuperAdminRole,
            StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsNetworkFailure(
        Exception exception)
    {
        Exception? currentException =
            exception;

        while (currentException != null)
        {
            if (currentException
                    is HttpRequestException ||
                currentException
                    is TaskCanceledException ||
                currentException
                    is TimeoutException)
            {
                return true;
            }

            currentException =
                currentException.InnerException;
        }

        return false;
    }

    private static string NormalizeBearerToken(
        string accessToken)
    {
        if (string.IsNullOrWhiteSpace(
                accessToken))
        {
            return string.Empty;
        }

        return accessToken.StartsWith(
                "Bearer ",
                StringComparison.OrdinalIgnoreCase)
            ? accessToken["Bearer ".Length..]
                .Trim()
            : accessToken.Trim();
    }

    private static string? ParseApiError(
        string? json)
    {
        if (string.IsNullOrWhiteSpace(
                json))
        {
            return null;
        }

        try
        {
            using var document =
                JsonDocument.Parse(
                    json);

            var root =
                document.RootElement;

            if (root.TryGetProperty(
                    "errors",
                    out var errors) &&
                errors.ValueKind ==
                    JsonValueKind.Object)
            {
                var messages =
                    new List<string>();

                foreach (var field
                         in errors.EnumerateObject())
                {
                    if (field.Value.ValueKind !=
                        JsonValueKind.Array)
                    {
                        continue;
                    }

                    foreach (var messageElement
                             in field.Value.EnumerateArray())
                    {
                        var message =
                            messageElement.GetString();

                        if (!string.IsNullOrWhiteSpace(
                                message))
                        {
                            messages.Add(
                                message);
                        }
                    }
                }

                if (messages.Count > 0)
                {
                    return string.Join(
                        " • ",
                        messages);
                }
            }

            foreach (var key in new[]
                     {
                         "detail",
                         "message",
                         "title"
                     })
            {
                if (!root.TryGetProperty(
                        key,
                        out var property))
                {
                    continue;
                }

                if (property.ValueKind !=
                    JsonValueKind.String)
                {
                    continue;
                }

                var value =
                    property.GetString();

                if (!string.IsNullOrWhiteSpace(
                        value))
                {
                    return value;
                }
            }
        }
        catch (JsonException)
        {
            return json.Length > 120
                ? json[..120] + "…"
                : json;
        }

        return null;
    }
}