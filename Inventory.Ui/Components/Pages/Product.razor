    private async Task HandleSubmit()
    {
        /*
         * A catalog product already provides its canonical name.
         *
         * A custom product must provide its own name.
         */
        if (!form.CatalogProductId.HasValue &&
            string.IsNullOrWhiteSpace(form.Name))
        {
            ShowError(
                "Product name is required when no catalog product is selected.");

            return;
        }

        if (form.PurchasePrice > form.SalePrice ||
            form.PurchasePrice > form.SalePrice2 ||
            form.PurchasePrice > form.SalePrice3)
        {
            ShowError(
                "Purchase price cannot be greater than sale prices.");

            return;
        }

        if (form.MinStockLevel > form.MaxStockLevel)
        {
            ShowError(
                "Minimum stock cannot be greater than maximum stock.");

            return;
        }

        if (editingId == null)
        {
            await Create();
        }
        else
        {
            await Update();
        }
    }

