@page "/products"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IJSRuntime JS
@inject IProductApi ProductApi
@inject IProductCatalogApi CatalogApi
@inject IAdminProductApi AdminProductApi
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AppState State
@inject PosBootstrapService Bootstrap
@using Inventory.Ui.Services
@implements IDisposable

<h3>Products</h3>

<div class="page-container">

    @if (showProduct)
    {
        <div class="product-modal-overlay" @onclick="CloseProductModal">
            <div class="product-modal" @onclick:stopPropagation="true">
                <div class="card">
                    <h4>@(editingId == null ? "Create Product" : "Edit Product")</h4>
                    <EditForm Model="form" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="form-grid">

                            <!-- PRODUCT CATALOG SELECTION -->
                            <div class="form-field">
                                <label>Product Catalog *</label>
                                <MudAutocomplete T="ProductCatalogResult"
                                                 Label="Search Product Catalog"
                                                 @bind-Value="selectedCatalog"
                                                 SearchFunc="SearchCatalogLocal"
                                                 ToStringFunc="FormatCatalog"
                                                 Clearable="true"
                                                 Disabled="@(isLoading || editingId != null)" />

                                @if (editingId != null)
                                {
                                    <small class="text-muted">Cannot change product catalog when editing</small>
                                }
                            </div>

                            <!-- PRICING -->
                            <div class="form-row">
                                <div class="form-field">
                                    <label>Purchase Price *</label>
                                    <InputNumber placeholder="0.00" class="inputText"
                                                 @bind-Value="form.PurchasePrice" disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.PurchasePrice)" />
                                </div>
                                <div class="form-field">
                                    <label>Sale Price *</label>
                                    <InputNumber placeholder="0.00" class="inputText"
                                                 @bind-Value="form.SalePrice" disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.SalePrice)" />
                                </div>
                                <div class="form-field">
                                    <label>Sale Price 2 *</label>
                                    <InputNumber placeholder="0.00" class="inputText"
                                                 @bind-Value="form.SalePrice2" disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.SalePrice2)" />
                                </div>
                                <div class="form-field">
                                    <label>Sale Price 3 *</label>
                                    <InputNumber placeholder="0.00" class="inputText"
                                                 @bind-Value="form.SalePrice3" disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.SalePrice3)" />
                                </div>
                                <div class="form-field">
                                    <label>VAT Rate (%) *</label>
                                    <InputNumber placeholder="0-100" class="inputText"
                                                 @bind-Value="form.VatRate" disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.VatRate)" />
                                </div>
                                <div class="form-field">
                                    <label>Status</label>
                                    <InputSelect @bind-Value="form.Status" class="inputText" disabled="@isLoading">
                                        <option value="@ProductStatus.Active">Active</option>
                                        <option value="@ProductStatus.Inactive">Inactive</option>
                                        <option value="@ProductStatus.Discontinued">Discontinued</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => form.Status)" />
                                </div>
                            </div>

                            <!-- STOCK LEVELS -->
                            <div class="form-row">
                                <div class="form-field">
                                    <label>Min Stock Level *</label>
                                    <InputNumber placeholder="0" class="inputText"
                                                 @bind-Value="form.MinStockLevel" disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.MinStockLevel)" />
                                </div>
                                <div class="form-field">
                                    <label>Max Stock Level *</label>
                                    <InputNumber placeholder="0" class="inputText"
                                                 @bind-Value="form.MaxStockLevel" disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.MaxStockLevel)" />
                                </div>
                            </div>

                            <!-- TRACKING -->
                            <div class="form-row">
                                <div class="form-field">
                                    <label>
                                        <InputCheckbox @bind-Value="form.IsTracked"
                                                       class="inputText" disabled="@isLoading" />
                                        Track inventory for this product
                                    </label>
                                </div>
                            </div>

                            <div class="actions-end">
                                @if (editingId == null)
                                {
                                    <button type="submit" class="btn primary" disabled="@isLoading">
                                        @(isLoading ? "Creating..." : "Create")
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn primary" disabled="@isLoading">
                                        @(isLoading ? "Updating..." : "Update")
                                    </button>
                                    <button type="button" class="btn ghost" @onclick="CancelEdit" disabled="@isLoading">
                                        Cancel
                                    </button>
                                }
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <h4>Search Products</h4>
        <div class="search-grid">
            <input type="text"
                   placeholder="Search by name, SKU, or barcode..."
                   value="@searchTerm"
                   @oninput="OnSearchInput"
                   disabled="@isLoading" />
            <div class="search-actions">
                <button class="btn primary" @onclick="Search" disabled="@isLoading">Search</button>
                <button class="btn ghost" @onclick="ClearSearch" disabled="@isLoading">Clear</button>
                <button class="btn btn-warning" @onclick="AddProduct">Add</button>
            </div>
        </div>
    </div>

    @if (isLoadingData)
    {
        <div class="loading-container">
            <p>Loading products...</p>
        </div>
    }
    else if (items == null || items.Count == 0)
    {
        <p>@(isSearching ? "No products found matching your search." : "No products.")</p>
    }
    else
    {
        <div class="pager">
            <button class="btn ghost" disabled="@(Page == 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>
            <span class="muted">
                Page @Page / @(Math.Ceiling((double)TotalCount / PageSize))
            </span>
            <button class="btn ghost"
                    disabled="@(Page* PageSize >= TotalCount)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>
        </div>

        <div class="results-header">
            <span>@items.Count product(s) found</span>
            @if (isSearching)
            {
                <button class="btn small ghost" @onclick="ClearSearch">Show All</button>
            }
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Product Info</th>
                    <th>Manufacturer</th>
                    <th>Barcode</th>
                    <th>Pricing</th>
                    <th>Stock Levels</th>
                    <th>Status</th>
                    <th style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in items)
                {
                    var catalogProduct = State.GetCatalog(p.CatalogProductId);
                    var productName = GetProductDisplayName(p, catalogProduct);
                    var productBarcode = GetProductBarcode(p, catalogProduct);
                    var productBrand = GetProductBrand(p, catalogProduct);

                    <tr>
                        <td>
                            <div class="product-name">
                                @productName
                                @if (catalogProduct?.IsPack == true)
                                {
                                    <span class="badge"
                                          style="background:#6f42c1; color:white; font-size:10px; padding:2px 6px; border-radius:4px; margin-left:6px;">
                                        PACK
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(catalogProduct?.Description))
                            {
                                <div class="product-desc">@catalogProduct.Description</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(productBrand))
                            {
                                <div class="product-desc">Brand: @productBrand</div>
                            }

                            @if (catalogProduct?.IsPack == true && catalogProduct.PackComponents.Any())
                            {
                                var comp = catalogProduct.PackComponents.First();
                                <div class="product-desc" style="color:#6f42c1;">
                                    📦 @comp.Quantity × @comp.ComponentName
                                </div>
                            }
                        </td>

                        <td>@(catalogProduct?.Manufacturer ?? "-")</td>
                        <td><code>@(productBarcode ?? "-")</code></td>

                        <td>
                            <div><strong>Sale:</strong> €@p.SalePrice.ToString("F2")</div>
                            <div><small>Purchase: €@p.PurchasePrice.ToString("F2")</small></div>
                            <div><small>VAT: @p.VatRate%</small></div>
                        </td>

                        <td>
                            <small>Min: @p.MinStockLevel</small><br />
                            <small>Max: @p.MaxStockLevel</small>
                        </td>

                        <td>
                            <span class="badge @GetStatusClass(p.Status)">@p.Status</span>
                            @if (!p.IsTracked)
                            {
                                <br />
                    
                                <small class="text-muted">Not tracked</small>
                            }
                        </td>

                        <td class="actions-end">
                            <button class="btn small ghost" @onclick="() => StartEdit(p)" disabled="@isLoading">
                                Edit
                            </button>
                            <button class="btn small ghost" @onclick="() => PrintLabel(p.Id)">
                                Label
                            </button>
                            <button class="btn small danger" @onclick="() => ConfirmDelete(p)" disabled="@isLoading">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (showDeleteConfirm && productToDelete != null)
    {
        var catalogProduct = State.GetCatalog(productToDelete.CatalogProductId);
        <div class="modal-overlay" @onclick="CancelDelete">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h4>Confirm Delete</h4>
                <p>Are you sure you want to delete <strong>@(catalogProduct?.Name ?? "this product")</strong>?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <div class="modal-actions">
                    <button class="btn ghost" @onclick="CancelDelete">Cancel</button>
                    <button class="btn danger" @onclick="ConfirmDeleteAction">Delete</button>
                </div>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="toast-success">
        <span class="toast-icon"></span>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="toast-error">
        <span class="toast-icon"></span>
        <span>@errorMessage</span>
    </div>
}

@code {
    // ── Local display state ──────────────────────────────────────────────────
    private List<ProductResult>? items;
    private Guid? editingId;
    private ProductForm form = new();
    private bool isLoading;
    private bool isLoadingData;
    private string? errorMessage;
    private string? successMessage;
    private bool showDeleteConfirm;
    private ProductResult? productToDelete;
    private string searchTerm = string.Empty;
    private bool isSearching;
    private CancellationTokenSource? _debounceCts;
    private bool isSuperAdmin;

    int Page = 1;
    int PageSize = 10;
    int TotalCount;
    bool showProduct;

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChange;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var role = authState.User.FindFirst(ClaimTypes.Role)?.Value
                   ?? authState.User.FindFirst("role")?.Value;
        isSuperAdmin = role == "SuperAdmin";

        await Bootstrap.EnsureLoadedAsync();

        Page = 1;
        await LoadData();
    }

    public void Dispose()
    {
        State.OnChange -= HandleStateChange;
        _debounceCts?.Dispose();
    }

    private void HandleStateChange()
    {
        // Re-render so the MudAutocomplete source (State.ProductCatalogMap)
        // reflects any cache update without the user needing to navigate away.
        InvokeAsync(StateHasChanged);
    }

    private ProductCatalogResult? selectedCatalog
    {
        get => _selectedCatalog;
        set
        {
            _selectedCatalog = value;
            form.CatalogProductId = value?.Id ?? Guid.Empty;
        }
    }
    private ProductCatalogResult? _selectedCatalog;

    private string FormatCatalog(ProductCatalogResult c)
    {
        if (c == null) return "";
        return $"{c.Name} " +
               $"{(string.IsNullOrEmpty(c.Brand) ? "" : "- " + c.Brand)} " +
               $"{(string.IsNullOrEmpty(c.Barcode) ? "" : "[" + c.Barcode + "]")}";
    }

    private Task<IEnumerable<ProductCatalogResult>> SearchCatalogLocal(string value, CancellationToken token)
    {
        var source = State.ProductCatalogMap?.Values
                     ?? Enumerable.Empty<ProductCatalogResult>();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(source.Take(20));

        var result = source.Where(c =>
            (!string.IsNullOrEmpty(c.Name) && c.Name.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.Barcode) && c.Barcode.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.Brand) && c.Brand.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(c.Manufacturer) && c.Manufacturer.Contains(value, StringComparison.OrdinalIgnoreCase))
        ).Take(20);

        return Task.FromResult(result);
    }

    // ── Display helpers ──────────────────────────────────────────────────────

    private string GetProductDisplayName(ProductResult product, ProductCatalogResult? catalog)
    {
        if (!string.IsNullOrWhiteSpace(product.CatalogName)) return product.CatalogName;
        if (!string.IsNullOrWhiteSpace(catalog?.Name)) return catalog.Name;
        return "Unknown Product";
    }

    private string? GetProductBarcode(ProductResult product, ProductCatalogResult? catalog)
    {
        if (!string.IsNullOrWhiteSpace(product.CatalogBarcode)) return product.CatalogBarcode;
        return catalog?.Barcode;
    }

    private string? GetProductBrand(ProductResult product, ProductCatalogResult? catalog)
    {
        if (!string.IsNullOrWhiteSpace(product.CatalogBrand)) return product.CatalogBrand;
        return catalog?.Brand;
    }

    private string GetStatusClass(ProductStatus status) => status switch
    {
        ProductStatus.Active => "success",
        ProductStatus.Inactive => "warning",
        ProductStatus.Discontinued => "error",
        _ => ""
    };

    // ── Data loading ─────────────────────────────────────────────────────────

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new ProductQuery
            {
                Page = Page,
                PageSize = PageSize,
                Search = isSearching ? searchTerm.Trim() : null
            };

            var response = isSuperAdmin
                ? await AdminProductApi.Search(query)
                : await ProductApi.Search(query);

            items = response.Items?.ToList() ?? new();
            TotalCount = response.TotalCount;
        }
        catch (Exception ex)
        {
            ShowError($"Failed to load products: {ex.Message}");
            items = new();
        }
        finally
        {
            isLoadingData = false;
        }
    }

    async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadData();
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            isSearching = false;
            Page = 1;
            await LoadData();
            return;
        }
        isSearching = true;
        Page = 1;
        await LoadData();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        isSearching = false;
        Page = 1;
        await LoadData();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, _debounceCts.Token);
            isSearching = !string.IsNullOrWhiteSpace(searchTerm);
            Page = 1;
            await LoadData();
        }
        catch (TaskCanceledException) { }
    }

    // ── Form actions ─────────────────────────────────────────────────────────

    private void AddProduct()
    {
        editingId = null;
        form = new ProductForm();
        selectedCatalog = null;
        errorMessage = null;
        successMessage = null;
        showProduct = true;
    }

    private void CloseProductModal() => ResetForm();

    private async Task HandleSubmit()
    {
        if (form.PurchasePrice > form.SalePrice ||
            form.PurchasePrice > form.SalePrice2 ||
            form.PurchasePrice > form.SalePrice3)
        {
            ShowError("Purchase price cannot be greater than sale prices.");
            return;
        }

        if (form.MinStockLevel > form.MaxStockLevel)
        {
            ShowError("Min stock cannot be greater than max stock.");
            return;
        }

        if (form.CatalogProductId == Guid.Empty)
        {
            ShowError("Please select a product from the catalog.");
            return;
        }

        if (editingId == null) await Create();
        else await Update();
    }

    private async Task Create()
    {
        try
        {
            isLoading = true;

            var request = new CreateProductRequest
            {
                CatalogProductId = form.CatalogProductId,
                SalePrice = form.SalePrice,
                SalePrice2 = form.SalePrice2,
                SalePrice3 = form.SalePrice3,
                PurchasePrice = form.PurchasePrice,
                VatRate = form.VatRate,
                MinStockLevel = form.MinStockLevel,
                MaxStockLevel = form.MaxStockLevel,
                IsTracked = form.IsTracked,
                IsActive = form.Status
            };

            await ProductApi.Create(request);

            State.InvalidatePos();
            await Bootstrap.EnsureLoadedAsync();

            var catalogName = State.GetCatalog(form.CatalogProductId)?.Name ?? "Product";
            ShowSuccess($"'{catalogName}' created successfully.");
            ResetForm();

            if (isSearching) await Search();
            else await LoadData();
        }
        catch
        {
            ShowError("Failed to create product.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Update()
    {
        if (editingId == null) return;

        try
        {
            isLoading = true;

            var request = new UpdateProductRequest
            {
                SalePrice = form.SalePrice,
                SalePrice2 = form.SalePrice2,
                SalePrice3 = form.SalePrice3,
                PurchasePrice = form.PurchasePrice,
                VatRate = form.VatRate,
                MinStockLevel = form.MinStockLevel,
                MaxStockLevel = form.MaxStockLevel,
                IsActive = form.Status,
                IsTracked = form.IsTracked
            };

            await ProductApi.Update(editingId.Value, request);

            // CHANGE 6 (same pattern)
            State.InvalidatePos();
            await Bootstrap.EnsureLoadedAsync();

            var catalogName = State.GetCatalog(form.CatalogProductId)?.Name ?? "Product";
            ShowSuccess($"'{catalogName}' updated successfully.");
            ResetForm();

            if (isSearching) await Search();
            else await LoadData();
        }
        catch
        {
            ShowError("Failed to update product.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmDelete(ProductResult product)
    {
        productToDelete = product;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        productToDelete = null;
        showDeleteConfirm = false;
    }

    private async Task ConfirmDeleteAction()
    {
        if (productToDelete == null) return;

        try
        {
            isLoading = true;
            showDeleteConfirm = false;

            var catalogName = State.GetCatalog(productToDelete.CatalogProductId)?.Name ?? "Unknown product";
            await ProductApi.Delete(productToDelete.Id);

            // CHANGE 6 (same pattern)
            State.InvalidatePos();
            await Bootstrap.EnsureLoadedAsync();

            ShowSuccess($"'{catalogName}' deleted successfully.");
            productToDelete = null;

            if (isSearching) await Search();
            else await LoadData();
        }
        catch
        {
            ShowError("Failed to delete product.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit(ProductResult p)
    {
        editingId = p.Id;
        form = new ProductForm
        {
            CatalogProductId = p.CatalogProductId,
            SalePrice = p.SalePrice,
            SalePrice2 = p.SalePrice2,
            SalePrice3 = p.SalePrice3,
            PurchasePrice = p.PurchasePrice,
            VatRate = p.VatRate,
            MinStockLevel = p.MinStockLevel,
            MaxStockLevel = p.MaxStockLevel,
            Status = p.Status,
            IsTracked = p.IsTracked
        };

        selectedCatalog = State.GetCatalog(p.CatalogProductId);

        showProduct = true;
        errorMessage = null;
        successMessage = null;
    }

    private void CancelEdit() => ResetForm();

    private void ResetForm()
    {
        editingId = null;
        showProduct = false;
        form = new ProductForm();
        selectedCatalog = null;
    }

    // ── Label print ──────────────────────────────────────────────────────────

    private async Task PrintLabel(Guid productId)
    {
        try
        {
            var response = await ProductApi.GetLabel(productId);

            if (!response.IsSuccessStatusCode)
            {
                ShowError("Label generation failed.");
                return;
            }

            var pdf = await response.Content.ReadAsByteArrayAsync();

            if (pdf == null || pdf.Length == 0)
            {
                ShowError("Empty label received.");
                return;
            }

            await JS.InvokeVoidAsync("downloadFile",
                $"label-{productId}.pdf", "application/pdf", Convert.ToBase64String(pdf));
        }
        catch (Exception ex)
        {
            ShowError($"Label generation failed: {ex.Message}");
        }
    }

    // ── Toast helpers ────────────────────────────────────────────────────────

    // CHANGE 8: Made both helpers void (they were async Task but never awaited
    // at call sites in the original — that causes fire-and-forget warnings).
    void ShowError(string message)
    {
        errorMessage = null;
        StateHasChanged();
        errorMessage = message;
        StateHasChanged();
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            errorMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    void ShowSuccess(string message)
    {
        successMessage = null;
        StateHasChanged();
        successMessage = message;
        StateHasChanged();
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            successMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    // ── Form model ───────────────────────────────────────────────────────────

    private sealed class ProductForm
    {
        [Required(ErrorMessage = "Product catalog is required")]
        public Guid CatalogProductId { get; set; } = Guid.Empty;

        [Range(0, double.MaxValue, ErrorMessage = "Sale price must be positive")]
        public decimal SalePrice { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Sale2 price must be positive")]
        public decimal SalePrice2 { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Sale3 price must be positive")]
        public decimal SalePrice3 { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Purchase price must be positive")]
        public decimal PurchasePrice { get; set; }

        [Range(0, 100, ErrorMessage = "VAT rate must be between 0 and 100")]
        public decimal VatRate { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Min stock level must be positive")]
        public decimal MinStockLevel { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Max stock level must be positive")]
        public decimal MaxStockLevel { get; set; }

        public bool IsTracked { get; set; } = true;
        public ProductStatus Status { get; set; } = ProductStatus.Active;
    }
}
