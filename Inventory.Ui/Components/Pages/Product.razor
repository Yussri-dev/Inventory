    private async Task StartEditAsync(
     ProductResult product)
    {
        if (isLoading)
            return;

        try
        {
            isLoading = true;

            editingId =
                product.Id;

            form =
                new ProductForm
                {
                    CatalogProductId =
                        product.CatalogProductId,

                    Name =
                        product.Name,

                    Sku =
                        product.Sku,

                    Barcode =
                        product.Barcode,

                    Description =
                        product.Description,

                    Category =
                        product.Category,

                    Brand =
                        product.Brand,

                    Unit =
                        string.IsNullOrWhiteSpace(
                            product.Unit)
                            ? "pcs"
                            : product.Unit,

                    SalePrice =
                        product.SalePrice,

                    SalePrice2 =
                        product.SalePrice2,

                    SalePrice3 =
                        product.SalePrice3,

                    PurchasePrice =
                        product.PurchasePrice,

                    VatRate =
                        product.VatRate,

                    MinStockLevel =
                        product.MinStockLevel,

                    MaxStockLevel =
                        product.MaxStockLevel,

                    Status =
                        product.Status,

                    IsTracked =
                        product.IsTracked
                };

            selectedCatalog =
                GetCatalog(
                    product.CatalogProductId);

            if (selectedCatalog == null &&
                product.CatalogProductId.HasValue &&
                product.CatalogProductId.Value != Guid.Empty)
            {
                selectedCatalog =
                    await LocalCatalogQuery
                        .GetByIdAsync(
                            product.CatalogProductId.Value);

                if (selectedCatalog != null)
                {
                    catalogCache[
                        selectedCatalog.Id] =
                            selectedCatalog;
                }
            }

            ClearMessages();

            showProduct =
                true;
        }
        catch (Exception exception)
        {
            ResetForm();

            ShowError(
                $"Failed to load local product: " +
                $"{exception.GetBaseException().Message}");

            System.Diagnostics.Debug
                .WriteLine(
                    exception);
        }
        finally
        {
            isLoading =
                false;
        }
    }

