    private async Task ConfirmDeleteAction()
    {
        if (productToDelete == null || isLoading)
            return;

        var productId =
            productToDelete.Id;

        var catalog =
            GetCatalog(productToDelete.CatalogProductId);

        var productName =
    !string.IsNullOrWhiteSpace(
        productToDelete.Name)
        ? productToDelete.Name
        : catalog?.Name ??
          "Unknown product";

        try
        {
            isLoading = true;
            showDeleteConfirm = false;

            ClearMessages();

            await LocalProductService.DeleteAsync(productId);

            SyncCoordinator.RequestSync();

            productToDelete = null;

            if (items.Count == 1 && Page > 1)
            {
                Page--;
            }

            await LoadData();

            ShowSuccess($"'{productName}' deleted locally.");
        }
        catch (Exception exception)
        {
            showDeleteConfirm = true;

            ShowError(
                $"Failed to delete local product: " +
                $"{exception.GetBaseException().Message}");

            System.Diagnostics.Debug.WriteLine(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

