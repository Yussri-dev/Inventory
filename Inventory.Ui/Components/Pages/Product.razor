    private async Task PrintLabel(
        Guid localProductId)
    {
        if (isLoading)
            return;

        try
        {
            isLoading = true;
            ClearMessages();

            var pdf =
                await LocalLabelService.GenerateAsync(
                    localProductId);

            if (pdf.Length == 0)
            {
                ShowError(
                    "The generated label is empty.");

                return;
            }

            var fileName =
                $"label-{localProductId}.pdf";

            var filePath =
                Path.Combine(
                    Microsoft.Maui.Storage.FileSystem.CacheDirectory,
                    fileName);

            await File.WriteAllBytesAsync(
                filePath,
                pdf);

            await Microsoft.Maui.ApplicationModel.Launcher.Default
                .OpenAsync(
                    new Microsoft.Maui.ApplicationModel.OpenFileRequest(
                        "Product label",
                        new Microsoft.Maui.Storage.ReadOnlyFile(
                            filePath)));

            ShowSuccess(
                "The local product label was generated.");
        }
        catch (Exception exception)
        {
            ShowError(
                $"Local label generation failed: " +
                $"{exception.GetBaseException().Message}");

            System.Diagnostics.Debug.WriteLine(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    private void ShowError(
        string message)
    {
        errorMessage = message;
        successMessage = null;

        StartToastTimer();
    }

    private void ShowSuccess(
        string message)
    {
        successMessage = message;
        errorMessage = null;

        StartToastTimer();
    }

    private void StartToastTimer()
    {
        toastCts?.Cancel();
        toastCts?.Dispose();

        toastCts =
            new CancellationTokenSource();

        _ = ClearToastLaterAsync(
            toastCts.Token);
    }

    private async Task ClearToastLaterAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(
                3000,
                cancellationToken);

            errorMessage = null;
            successMessage = null;

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Un nouveau message a remplacé le précédent.
        }
    }

    private sealed class ProductForm
    {
        public Guid? CatalogProductId { get; set; }

        [StringLength(
            200,
            ErrorMessage = "Name cannot exceed 200 characters.")]
        public string? Name { get; set; }

        [StringLength(
            100,
            ErrorMessage = "SKU cannot exceed 100 characters.")]
        public string? Sku { get; set; }

        [StringLength(
            100,
            ErrorMessage = "Barcode cannot exceed 100 characters.")]
        public string? Barcode { get; set; }

        [StringLength(
            1000,
            ErrorMessage = "Description cannot exceed 1000 characters.")]
        public string? Description { get; set; }

        [StringLength(
            100,
            ErrorMessage = "Category cannot exceed 100 characters.")]
        public string? Category { get; set; }

        [StringLength(
            100,
            ErrorMessage = "Brand cannot exceed 100 characters.")]
        public string? Brand { get; set; }

        [StringLength(
            50,
            ErrorMessage = "Unit cannot exceed 50 characters.")]
        public string? Unit { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Sale price cannot be negative.")]
        public decimal SalePrice { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Sale price 2 cannot be negative.")]
        public decimal SalePrice2 { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Sale price 3 cannot be negative.")]
        public decimal SalePrice3 { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Purchase price cannot be negative.")]
        public decimal PurchasePrice { get; set; }

        [Range(
            0,
            100,
            ErrorMessage = "VAT rate must be between 0 and 100.")]
        public decimal VatRate { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Minimum stock cannot be negative.")]
        public decimal MinStockLevel { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Maximum stock cannot be negative.")]
        public decimal MaxStockLevel { get; set; }

        public bool IsTracked { get; set; } = true;

        public ProductStatus Status { get; set; } =
            ProductStatus.Active;
    }
