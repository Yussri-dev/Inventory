@page "/products"

@using System.ComponentModel.DataAnnotations
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.Ui.Services.Labels
@using Inventory.Ui.Services.Sync
@using Microsoft.JSInterop

@implements IAsyncDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject SyncCoordinator SyncCoordinator
@inject ILocalProductService LocalProductService
@inject ILocalProductCatalogQueryService LocalCatalogQuery
@inject ILocalBarcodeLabelService LocalLabelService
@inject ILogger<Product> Logger

@inject IJSRuntime JS

<h3>Products</h3>

<div class="page-container">

    @if (showProduct)
    {
        <div class="product-modal-overlay"
             @onclick="CloseProductModal">

            <div class="product-modal"
                 @onclick:stopPropagation="true">

                <div class="card">
                    <h4>
                        @(editingId == null
                                            ? "Create Product"
                                            : "Edit Product")
                </h4>

                    <EditForm Model="form"
                              OnValidSubmit="HandleSubmit">

                        <DataAnnotationsValidator />

                        <div class="form-grid">

                            <!-- PRODUCT CATALOG -->
                            <div class="form-field">
                                <label>Product Catalog (optional)</label>

                                <MudAutocomplete T="ProductCatalogResult"
                                                 Label="Search Product Catalog"
                                                 @bind-Value="selectedCatalog"
                                                 SearchFunc="SearchCatalogLocal"
                                                 ToStringFunc="FormatCatalog"
                                                 Clearable="true"
                                                 Dense="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 CoerceValue="false"
                                                 MinCharacters="0"
                                                 MaxItems="20"
                                                 Disabled="@(isLoading || editingId != null)"
                                                 Placeholder="Search by name, barcode or brand" />

                            @if (editingId != null)
                                {
                                    <small class="text-muted">
                                        Product catalog cannot be changed while editing.
                                    </small>
                                }


                            </div>

                            @if (!form.CatalogProductId.HasValue)
                            {
                                <div class="form-row">

                                    <div class="form-field">
                                        <label>Name *</label>

                                        <InputText class="inputText"
                                                   placeholder="Product name"
                                                   @bind-Value="form.Name"
                                                   disabled="@isLoading" />

                                        <ValidationMessage For="@(() => form.Name)" />
                                    </div>

                                    <div class="form-field">
                                        <label>Barcode</label>

                                        <InputText class="inputText"
                                                   placeholder="Barcode"
                                                   @bind-Value="form.Barcode"
                                                   disabled="@isLoading" />

                                        <ValidationMessage For="@(() => form.Barcode)" />
                                    </div>

                                    <div class="form-field">
                                        <label>SKU</label>

                                        <InputText class="inputText"
                                                   placeholder="SKU"
                                                   @bind-Value="form.Sku"
                                                   disabled="@isLoading" />

                                        <ValidationMessage For="@(() => form.Sku)" />
                                    </div>

                                </div>

                                <div class="form-row">

                                    <div class="form-field">
                                        <label>Brand</label>

                                        <InputText class="inputText"
                                                   placeholder="Brand"
                                                   @bind-Value="form.Brand"
                                                   disabled="@isLoading" />

                                        <ValidationMessage For="@(() => form.Brand)" />
                                    </div>

                                    <div class="form-field">
                                        <label>Category</label>

                                        <InputText class="inputText"
                                                   placeholder="Category"
                                                   @bind-Value="form.Category"
                                                   disabled="@isLoading" />

                                        <ValidationMessage For="@(() => form.Category)" />
                                    </div>

                                    <div class="form-field">
                                        <label>Unit</label>

                                        <InputText class="inputText"
                                                   placeholder="pcs"
                                                   @bind-Value="form.Unit"
                                                   disabled="@isLoading" />

                                        <ValidationMessage For="@(() => form.Unit)" />
                                    </div>

                                </div>

                                <div class="form-field">
                                    <label>Description</label>

                                    <InputTextArea class="inputText"
                                                   placeholder="Product description"
                                                   @bind-Value="form.Description"
                                                   disabled="@isLoading" />

                                    <ValidationMessage For="@(() => form.Description)" />
                                </div>
                            }

                            <!-- PRICES -->
                            <div class="form-row">

                                <div class="form-field">
                                    <label>Purchase Price *</label>

                                    <InputNumber placeholder="0.00"
                                                 class="inputText"
                                                 @bind-Value="form.PurchasePrice"
                                                 disabled="@isLoading" />

                                    <ValidationMessage For="@(() => form.PurchasePrice)" />
                                </div>

                                <div class="form-field">
                                    <label>Sale Price *</label>

                                    <InputNumber placeholder="0.00"
                                                 class="inputText"
                                                 @bind-Value="form.SalePrice"
                                                 disabled="@isLoading" />

                                    <ValidationMessage For="@(() => form.SalePrice)" />
                                </div>

                                <div class="form-field">
                                    <label>Sale Price 2 *</label>

                                    <InputNumber placeholder="0.00"
                                                 class="inputText"
                                                 @bind-Value="form.SalePrice2"
                                                 disabled="@isLoading" />

                                    <ValidationMessage For="@(() => form.SalePrice2)" />
                                </div>

                                <div class="form-field">
                                    <label>Sale Price 3 *</label>

                                    <InputNumber placeholder="0.00"
                                                 class="inputText"
                                                 @bind-Value="form.SalePrice3"
                                                 disabled="@isLoading" />

                                    <ValidationMessage For="@(() => form.SalePrice3)" />
                                </div>

                                <div class="form-field">
                                    <label>VAT Rate (%) *</label>

                                    <InputNumber placeholder="0-100"
                                                 class="inputText"
                                                 @bind-Value="form.VatRate"
                                                 disabled="@isLoading" />

                                    <ValidationMessage For="@(() => form.VatRate)" />
                                </div>

                                <div class="form-field">
                                    <label>Status</label>

                                    <InputSelect @bind-Value="form.Status"
                                                 class="inputText"
                                                 disabled="@isLoading">

                                        <option value="@ProductStatus.Active">
                                            Active
                                        </option>

                                        <option value="@ProductStatus.Inactive">
                                            Inactive
                                        </option>

                                        <option value="@ProductStatus.Discontinued">
                                            Discontinued
                                        </option>

                                    </InputSelect>

                                    <ValidationMessage For="@(() => form.Status)" />
                                </div>

                            </div>

                            <!-- STOCK LEVELS -->
                            <div class="form-row">

                                <div class="form-field">
                                    <label>Min Stock Level *</label>

                                    <InputNumber placeholder="0"
                                                 class="inputText"
                                                 @bind-Value="form.MinStockLevel"
                                                 disabled="@isLoading" />

                                    <ValidationMessage For="@(() => form.MinStockLevel)" />
                                </div>

                                <div class="form-field">
                                    <label>Max Stock Level *</label>

                                    <InputNumber placeholder="0"
                                                 class="inputText"
                                                 @bind-Value="form.MaxStockLevel"
                                                 disabled="@isLoading" />

                                    <ValidationMessage For="@(() => form.MaxStockLevel)" />
                                </div>

                            </div>

                            <!-- TRACKING -->
                            <div class="form-row">
                                <div class="form-field">
                                    <label>
                                        <InputCheckbox @bind-Value="form.IsTracked"
                                                       disabled="@isLoading" />

                                        Track inventory for this product
                                    </label>
                                </div>
                            </div>

                            <!-- ACTIONS -->
                            <div class="actions-end">

                                <button type="submit"
                                        class="btn primary"
                                        disabled="@isLoading">

                                    @if (isLoading)
                                    {
                                        <span>Saving...</span>
                                    }
                                    else if (editingId == null)
                                    {
                                        <span>Create</span>
                                    }
                                    else
                                    {
                                        <span>Update</span>
                                    }

                                </button>

                                @if (editingId != null)
                                {
                                    <button type="button"
                                            class="btn ghost"
                                            @onclick="CancelEdit"
                                            disabled="@isLoading">
                                        Cancel
                                    </button>
                                }

                            </div>

                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <!-- SEARCH -->
    <div class="card">
        <h4>Search Products</h4>

        <div class="search-grid">

            <input type="text"
                   class="barcode-input"
                   placeholder="Search by name, SKU or barcode..."
                   value="@searchTerm"
                   @onchange="OnBarcodeChanged"
                   @ref="searchInputRef"
                   disabled="@(isLoading || isLoadingData)" />

            <div class="search-actions">

                <button class="btn primary"
                        @onclick="Search"
                        disabled="@(isLoading || isLoadingData)">
                    Search
                </button>

                <button class="btn ghost"
                        @onclick="ClearSearch"
                        disabled="@(isLoading || isLoadingData)">
                    Clear
                </button>

                <button class="btn btn-warning"
                        @onclick="AddProduct"
                        disabled="@isLoading">
                    Add
                </button>

            </div>
        </div>
    </div>

    <!-- PRODUCTS -->
    @if (isLoadingData)
    {
        <div class="loading-container">
            <p>Loading products from SQLite...</p>
        </div>
    }
    else if (items.Count == 0)
    {
        <p>
            @(isSearching
                    ? "No products found matching your search."
                    : "No products are stored locally.")
    </p>
        }
    else
    {
        <div class="pager">

            <button class="btn ghost"
                    disabled="@(Page <= 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>

            <span class="muted">
                Page @Page / @TotalPages
            </span>

            <button class="btn ghost"
                    disabled="@(Page >= TotalPages)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>

        </div>

        <div class="results-header">

            <span>
                @ItemsCount / @TotalCount product(s) found
            </span>

            @if (isSearching)
            {
                <button class="btn small ghost"
                        @onclick="ClearSearch">
                    Show All
                </button>
            }

        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Product Info</th>
                    <th>Manufacturer</th>
                    <th>Barcode</th>
                    <th>Pricing</th>
                    <th>Stock Levels</th>
                    <th>Status</th>
                    <th style="width:210px">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var product in items)
                {
                    var catalog =
                    GetCatalog(product.CatalogProductId);

                    var productName =
                    GetProductDisplayName(product, catalog);

                    var productBarcode =
                    GetProductBarcode(product, catalog);

                    var productBrand =
                    GetProductBrand(product, catalog);

                    <tr>
                        <td>
                            <div class="product-name">
                                @productName

                                @if (catalog?.IsPack == true)
                                {
                                    <span class="badge"
                                          style="
                                                                                                                                                                                                                                  background:#6f42c1;
                                                                                                                                                                                                                                  color:white;
                                                                                                                                                                                                                                  font-size:10px;
                                                                                                                                                                                                                                  padding:2px 6px;
                                                                                                                                                                                                                                  border-radius:4px;
                                                                                                                                                                                                                                  margin-left:6px;">
                                        PACK
                                    </span>
                                }
                            </div>
                            @{
                                var productDescription =
                                !string.IsNullOrWhiteSpace(product.Description)
                                ? product.Description
                                : catalog?.Description;
                            }

                            @if (!string.IsNullOrWhiteSpace(
                                                productDescription))
                            {
                                <div class="product-desc">
                                    @productDescription
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(
                                                productBrand))
                            {
                                <div class="product-desc">
                                    Brand: @productBrand
                                </div>
                            }

                            @if (catalog?.IsPack == true &&
                                                catalog.PackComponents?.Any() == true)
                            {
                                var component =
                                catalog.PackComponents.First();

                                <div class="product-desc"
                                     style="color:#6f42c1;">

                                    @component.Quantity
                                    ×
                                    @(string.IsNullOrWhiteSpace(
                                                            component.ComponentName)
                                                            ? "Unknown product"
                                                            : component.ComponentName)

                    </div>
                                        }
                            else if (catalog?.IsPack == true)
                            {
                                <div class="product-desc">
                                    Pack without local component details
                                </div>
                            }
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(
                                            catalog?.Manufacturer)
                                            ? "-"
                                            : catalog.Manufacturer)
                                                               </td>

                    <td>
                        <code>
                            @(string.IsNullOrWhiteSpace(
                                                    productBarcode)
                                                    ? "-"
                                                    : productBarcode)
                    </code>
                </td>

                        <td>
                            <div>
                                <strong>Sale:</strong>
                                €@product.SalePrice.ToString("F2")
                            </div>

                            <div>
                                <small>
                                    Sale 2:
                                    €@product.SalePrice2.ToString("F2")
                                </small>
                            </div>

                            <div>
                                <small>
                                    Sale 3:
                                    €@product.SalePrice3.ToString("F2")
                                </small>
                            </div>

                            <div>
                                <small>
                                    Purchase:
                                    €@product.PurchasePrice.ToString("F2")
                                </small>
                            </div>

                            <div>
                                <small>
                                    VAT: @product.VatRate%
                                </small>
                            </div>
                        </td>

                        <td>
                            <small>
                                Min: @product.MinStockLevel
                            </small>

                            <br />

                            <small>
                                Max: @product.MaxStockLevel
                            </small>
                        </td>

                        <td>
                            <span class="badge @GetStatusClass(product.Status)">
                                @product.Status
                            </span>

                    @if (!product.IsTracked)
                            {
                                <br />

                                <small class="text-muted">
                                    Not tracked
                                </small>
                            }
                        </td>

                        <td class="actions-end">

                            <button class="btn small ghost"
                                    @onclick="() => StartEditAsync(product)"
                                    disabled="@isLoading">
                                Edit
                            </button>

                            <button class="btn small ghost"
                                    @onclick="() => PrintLabel(product.Id)"
                                    disabled="@isLoading">
                                Label
                            </button>

                            <button class="btn small danger"
                                    @onclick="() => ConfirmDelete(product)"
                                    disabled="@isLoading">
                                Delete
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- DELETE MODAL -->
    @if (showDeleteConfirm &&
        productToDelete != null)
    {
        var deleteCatalog =
        GetCatalog(productToDelete.CatalogProductId);

        <div class="modal-overlay"
             @onclick="CancelDelete">

            <div class="modal-content"
                 @onclick:stopPropagation="true">

                <h4>Confirm Delete</h4>

                <p>
                    Are you sure you want to delete
                    <strong>
                        @(!string.IsNullOrWhiteSpace(
                                            productToDelete.Name)
                                            ? productToDelete.Name
                                            : deleteCatalog?.Name ??
                                            "this product"                                            )
                </strong>?
            </p>

                <p class="text-muted">
                    This action cannot be undone.
                </p>

                <div class="modal-actions">

                    <button class="btn ghost"
                            @onclick="CancelDelete"
                            disabled="@isLoading">
                        Cancel
                    </button>

                    <button class="btn danger"
                            @onclick="ConfirmDeleteAction"
                            disabled="@isLoading">
                        @(isLoading ? "Deleting..." : "Delete")
                    </button>

                </div>
            </div>
        </div>
        }

</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="toast-success">
        <span class="toast-icon"></span>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="toast-error">
        <span class="toast-icon"></span>
        <span>@errorMessage</span>
    </div>
}

@code {
    private readonly Dictionary<Guid, ProductCatalogResult>
    catalogCache = new();

    private List<ProductResult> items = new();

    private ProductCatalogResult? _selectedCatalog;
    private ProductResult? productToDelete;

    private ProductForm form = new();

    private Guid? editingId;

    private bool showProduct;
    private bool showDeleteConfirm;

    private bool isLoading;
    private bool isLoadingData;
    private bool isSearching;

    private string searchTerm = string.Empty;

    private string? errorMessage;
    private string? successMessage;

    private CancellationTokenSource? debounceCts;
    private CancellationTokenSource? toastCts;

    private readonly SemaphoreSlim barcodeScanGate = new(1, 1);

    private int Page = 1;
    private int PageSize = 10;
    private int TotalCount;
    private int ItemsCount;

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                TotalCount / (double)PageSize));


    private ElementReference searchInputRef;
    private IJSObjectReference? barcodeScannerModule;
    private DotNetObjectReference<Product>? barcodeScannerReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            barcodeScannerReference = DotNetObjectReference.Create(this);

            barcodeScannerModule =
                await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/barcodeScanner.js");

            await barcodeScannerModule.InvokeVoidAsync(
                "initialize",
                barcodeScannerReference);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to initialize the barcode scanner.");
            ShowError("The barcode scanner could not be initialized.");
        }
    }

    private ProductCatalogResult? selectedCatalog
    {
        get => _selectedCatalog;

        set
        {
            _selectedCatalog = value;

            form.CatalogProductId = value?.Id;

            if (value != null)
            {
                catalogCache[value.Id] = value;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Page = 1;

        // SQLite uniquement.
        // Aucun appel à PosBootstrapService ou à localhost:7190.
        await LoadData();
    }

    public async ValueTask DisposeAsync()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();

        toastCts?.Cancel();
        toastCts?.Dispose();

        toastCancellation?.Cancel();
        toastCancellation?.Dispose();

        if (barcodeScannerModule != null)
        {
            try { await barcodeScannerModule.InvokeVoidAsync("dispose"); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }

            try { await barcodeScannerModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }

        barcodeScannerReference?.Dispose();
        barcodeScannerModule = null;
        barcodeScannerReference = null;
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new ProductQuery
            {
                Page = Page,
                PageSize = PageSize,

                Search = isSearching
                    ? searchTerm.ToUpper().Trim()
                    : null
            };

            var response =
                await LocalProductService.QueryAsync(query);

            items = response.Items?.ToList()
                ?? new List<ProductResult>();

            TotalCount = response.TotalCount;

            ItemsCount = items.Count == 0
                ? 0
                : Math.Min(
                    ((Page - 1) * PageSize) + items.Count,
                    TotalCount);

            await LoadCatalogsForCurrentPageAsync();
        }
        catch (Exception exception)
        {
            items = new List<ProductResult>();

            TotalCount = 0;
            ItemsCount = 0;

            ShowError(
                $"Failed to load local products: " +
                $"{exception.GetBaseException().Message}");

            System.Diagnostics.Debug.WriteLine(exception);
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task LoadCatalogsForCurrentPageAsync(
        CancellationToken cancellationToken = default)
    {
        if (items.Count == 0)
            return;

        var catalogIds = items
            .Where(x =>
                x.CatalogProductId.HasValue &&
                x.CatalogProductId.Value != Guid.Empty)
            .Select(x =>
                x.CatalogProductId!.Value)
            .Distinct()
    .ToList();

        foreach (var catalogId in catalogIds)
        {
            cancellationToken.ThrowIfCancellationRequested();

            if (catalogCache.ContainsKey(catalogId))
                continue;

            var catalog =
                await LocalCatalogQuery.GetByIdAsync(
                    catalogId,
                    cancellationToken);

            if (catalog != null)
            {
                catalogCache[catalog.Id] = catalog;
            }
        }
    }

    private ProductCatalogResult? GetCatalog(
        Guid? catalogProductId)
    {
        if (!catalogProductId.HasValue ||
            catalogProductId.Value == Guid.Empty)
        {
            return null;
        }

        return catalogCache.TryGetValue(
            catalogProductId.Value,
            out var catalog)
                ? catalog
                : null;
    }

    private async Task<IEnumerable<ProductCatalogResult>>
        SearchCatalogLocal(
            string? value,
            CancellationToken cancellationToken)
    {
        var response =
            await LocalCatalogQuery.QueryAsync(
                new ProductCatalogQuery
                {
                    Page = 1,
                    PageSize = 20,

                    Search = string.IsNullOrWhiteSpace(value)
                        ? null
                        : value.Trim(),

                    SortBy = "Name",
                    Desc = false
                },
                cancellationToken);

        var catalogs = response.Items?.ToList()
            ?? new List<ProductCatalogResult>();

        foreach (var catalog in catalogs)
        {
            catalogCache[catalog.Id] = catalog;
        }

        return catalogs;
    }

    private static string FormatCatalog(
        ProductCatalogResult? catalog)
    {
        if (catalog == null)
            return string.Empty;

        var parts = new List<string>
        {
            catalog.Name
        };

        if (!string.IsNullOrWhiteSpace(catalog.Brand))
        {
            parts.Add($"- {catalog.Brand}");
        }

        if (!string.IsNullOrWhiteSpace(catalog.Barcode))
        {
            parts.Add($"[{catalog.Barcode}]");
        }
        else if (!string.IsNullOrWhiteSpace(
                     catalog.InternalCode))
        {
            parts.Add($"[{catalog.InternalCode}]");
        }

        return string.Join(" ", parts);
    }

    private static string GetProductDisplayName(
    ProductResult product,
    ProductCatalogResult? catalog)
    {
        if (!string.IsNullOrWhiteSpace(product.Name))
        {
            return product.Name;
        }

        if (!string.IsNullOrWhiteSpace(catalog?.Name))
        {
            return catalog.Name;
        }

        return "Unknown Product";
    }

    private static string? GetProductBarcode(
        ProductResult product,
        ProductCatalogResult? catalog)
    {
        if (!string.IsNullOrWhiteSpace(product.Barcode))
        {
            return product.Barcode;
        }

        return catalog?.Barcode;
    }

    private static string? GetProductBrand(
        ProductResult product,
        ProductCatalogResult? catalog)
    {
        if (!string.IsNullOrWhiteSpace(product.Brand))
        {
            return product.Brand;
        }

        return catalog?.Brand;
    }

    private static string GetStatusClass(
        ProductStatus status)
    {
        return status switch
        {
            ProductStatus.Active => "success",
            ProductStatus.Inactive => "warning",
            ProductStatus.Discontinued => "error",
            _ => string.Empty
        };
    }

    private async Task ChangePage(
        int newPage)
    {
        Page = Math.Clamp(
            newPage,
            1,
            TotalPages);

        await LoadData();
    }

    private async Task Search()
    {
        searchTerm = searchTerm.ToUpper().Trim();

        isSearching =
            !string.IsNullOrWhiteSpace(searchTerm);

        Page = 1;

        await LoadData();
    }

    private async Task ClearSearch()
    {
        debounceCts?.Cancel();

        searchTerm = string.Empty;
        isSearching = false;
        Page = 1;

        await LoadData();
    }


    private async Task OnBarcodeChanged(ChangeEventArgs args)
    {
        if (isLoading || isLoadingData)
            return;

        searchTerm = (args.Value?.ToString() ?? string.Empty).Trim().ToUpperInvariant();
        isSearching = !string.IsNullOrWhiteSpace(searchTerm);
        Page = 1;

        await LoadData();
    }

    private string BarcodeInput = string.Empty;
    private bool IsLoading;

    private CancellationTokenSource? toastCancellation;


    private async Task ShowSuccessAsync(
    string message)
    {
        errorMessage =
            null;

        successMessage =
            message;

        await StartToastTimerAsync(
            clearSuccess: true);
    }
    private async Task StartToastTimerAsync(
        bool clearSuccess)
    {
        toastCancellation?.Cancel();
        toastCancellation?.Dispose();

        toastCancellation =
            new CancellationTokenSource();

        var source =
            toastCancellation;

        await InvokeAsync(
            StateHasChanged);

        try
        {
            await Task.Delay(
                3000,
                source.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ReferenceEquals(
                toastCancellation,
                source))
        {
            return;
        }

        if (clearSuccess)
        {
            successMessage =
                null;
        }
        else
        {
            errorMessage =
                null;
        }

        await InvokeAsync(
            StateHasChanged);
    }

    private async Task ShowErrorAsync(
        string message)
    {
        successMessage =
            null;

        errorMessage =
            message;

        await StartToastTimerAsync(
            clearSuccess: false);
    }

    [JSInvokable]
    public async Task OnHardwareScan(string? rawBarcode)
    {
        if (string.IsNullOrWhiteSpace(rawBarcode))
            return;

        var barcode = rawBarcode.Trim();

        await barcodeScanGate.WaitAsync();

        try
        {
            if (isLoading || isLoadingData)
                return;

            if (showProduct || showDeleteConfirm)
                return;

            searchTerm = barcode;
            isSearching = true;
            Page = 1;

            Logger.LogDebug("Barcode scanned: {Barcode}", barcode);

            await LoadData();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to process barcode {Barcode}.", barcode);
            ShowError("The barcode could not be processed.");
        }
        finally
        {
            barcodeScanGate.Release();

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;

        debounceCts?.Cancel();
        debounceCts?.Dispose();

        debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, debounceCts.Token);

            isSearching = !string.IsNullOrWhiteSpace(searchTerm);

            Page = 1;

            await LoadData();
        }
        catch (OperationCanceledException)
        {
            // Une nouvelle saisie a remplacé la précédente.
        }
    }

