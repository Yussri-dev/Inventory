    // ADJUSTMENTS
    void OnLineClicked(CartLine line)
    {
        if (SelectedLine == line)
        {
            line.IsExpanded = !line.IsExpanded;
        }
        else
        {
            if (SelectedLine != null)
                SelectedLine.IsExpanded = false;

            SelectedLine = line;
            line.IsExpanded = true;
        }
