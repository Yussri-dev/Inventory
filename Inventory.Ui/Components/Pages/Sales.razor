@page "/sales"

@using System.Globalization
@using Inventory.LocalDB.Context
@using Inventory.LocalDB.Models
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.Ui.Services
@using Microsoft.EntityFrameworkCore

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable

@inject PosLocalDbContext Db
@inject ILocalSaleService LocalSaleService
@inject ILocalCashSessionService LocalCashSessionService
@inject ILocalTenantContext LocalTenantContext
@inject AppState State
@inject NavigationManager Nav
@inject ILogger<Sales> Logger
@inject IReceiptService ReceiptService

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="toast-success">
        <span class="toast-icon"></span>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="toast-error">
        <span class="toast-icon"></span>
        <span>@errorMessage</span>
    </div>
}

<div class="sale-container"
     @onclick="FocusBarcodeInput">

    <!-- LEFT: CART -->
    <div class="sale-left">

        <div class="card header-section">
            <div class="sale-info">
                <div>
                    <strong class="title">Sale</strong>
                    <span class="muted">Lines: @Lines.Count</span>
                </div>
            </div>

            <div class="customer-section">
                <label>Customer</label>

                <button type="button"
                        class="customer-select-btn"
                        @onclick="OpenCustomerModal"
                        @onclick:stopPropagation="true"
                        disabled="@IsSaving">
                    @(SelectedCustomer?.Name ?? "-- Walk-in customer --")
                </button>
            </div>
        </div>

        <div class="card cart-table">
            @if (Lines.Count == 0)
            {
                <div class="empty-state">
                    <p>No products added yet</p>
                    <p class="muted">
                        Scan a barcode or select a local product.
                    </p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 190px;">Quantity</th>
                            <th>Name</th>
                            <th style="width: 110px;">Price</th>
                            <th style="width: 110px;">Amount</th>
                            <th style="width: 100px;">VAT</th>
                            <th style="width: 80px;">Rate</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in Lines)
                        {
                            var availableQuantity =
                            GetAvailableSaleQuantity(line.Product);

                            var isOverStock =
                            line.Quantity > availableQuantity;

                            <tr class="@(ReferenceEquals(line, SelectedLine) ? "selected" : string.Empty)
                                                                       @(isOverStock ? "overstock" : string.Empty)"
                                @onclick="() => OnLineClicked(line)"
                                title="@(isOverStock
                                                                                                                                                                    ? $"Only {FormatQuantity(availableQuantity)} available"
                                                                                                                                                                    : string.Empty)">

                        <td>
                            <div class="qty-controls">
                                <button type="button"
                                        class="qty-btn"
                                        @onclick="() => Decrement(line)"
                                        @onclick:stopPropagation="true"
                                        disabled="@IsSaving">
                                    −
                                </button>

                                        <span class="qty-value">
                                            @FormatQuantity(line.Quantity)
                                        </span>

                                        <button type="button"
                                                class="qty-btn"
                                                @onclick="() => Increment(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            +
                                        </button>
                                    </div>

                            @if (isOverStock)
                                    {
                                        <div class="stock-warning"
                                             style="color:#dc3545;font-size:11px;margin-top:3px;">
                                            Only @FormatQuantity(availableQuantity) available
                                        </div>
                                    }
                                </td>

                                <td>
                                    @line.Product.Name

                                    @if (line.Product.IsPack)
                                    {
                                        <span class="muted"
                                              style="display:block;font-size:11px;">
                                            Pack —
                                            @FormatQuantity(line.Quantity)
                                            ×
                                            @FormatQuantity(GetUnitsPerPack(line.Product))
                                            =
                                            @FormatQuantity(line.StockQuantity)
                                            stock units
                                        </span>
                                    }

                                    <span class="stock-available"
                                          style="display:block;font-size:11px;color:#28a745;">
                                        Available:
                                        @FormatQuantity(availableQuantity)
                                        @(line.Product.IsPack ? "pack(s)" : "unit(s)")
                                    </span>
                                </td>

                                <td class="text-right">
                                    €@line.PriceBeforeDiscount.ToString("F2")
                                </td>

                                <td class="text-right">
                                    €@line.NetAmountInclVat.ToString("F2")
                                </td>

                                <td class="text-right">
                                    €@line.VatAmount.ToString("F2")
                                </td>

                                <td class="text-right">
                                    @line.Product.VatRate.ToString("0.##")%
                                </td>
                            </tr>

                            @if (line.IsExpanded)
                            {
                                @foreach (var adjustment in line.Adjustments)
                                {
                                    <tr class="sub-line">
                                        <td></td>

                                        <td colspan="5">
                                            <span class="adjustment">
                                                @adjustment.Display
                                            </span>

                                            <button type="button"
                                                    class="item-delete"
                                                    @onclick="() => RemoveAdjustment(line, adjustment)"
                                                    @onclick:stopPropagation="true">
                                                ×
                                            </button>
                                        </td>
                                    </tr>
                                }

                                <tr class="sub-actions">
                                    <td></td>

                                    <td colspan="5">
                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddPriceOverride(line)"
                                                @onclick:stopPropagation="true">
                                            Change price
                                        </button>

                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddDiscountPercent(line)"
                                                @onclick:stopPropagation="true">
                                            Discount %
                                        </button>

                                        <button type="button"
                                                class="btn small"
                                                @onclick="() => AddDiscountAmount(line)"
                                                @onclick:stopPropagation="true">
                                            Discount €
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="totals-row">
            <div class="total-item">
                <span class="total-label">Total quantity</span>
                <strong class="total-value primary">
                    @FormatQuantity(TotalQuantity)
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Number of lines</span>
                <strong class="total-value primary">
                    @Lines.Count
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Total</span>
                <strong class="total-value primary">
                    €@TotalAmount.ToString("F2")
                </strong>
            </div>
        </div>

        <div class="actions-footer">
            <div class="tax-info">
                <strong>
                    Excl. VAT: €@SubtotalExclVat.ToString("F2")
                    &nbsp;|&nbsp;
                    VAT: €@TotalVat.ToString("F2")
                </strong>
            </div>

            <button type="button"
                    class="btn btn-warning"
                    @onclick="OpenPendingModalAsync"
                    @onclick:stopPropagation="true"
                    disabled="@IsSaving">
                Pending tickets
            </button>

            <button type="button"
                    class="btn btn-warning"
                    @onclick="SavePendingSaleAsync"
                    @onclick:stopPropagation="true"
                    disabled="@(IsSaving || Lines.Count == 0)">
                @(CurrentPendingSaleId.HasValue
                                ? "Update pending"
                                : "Save pending")
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="ResetSale"
                    @onclick:stopPropagation="true"
                    disabled="@(IsSaving || Lines.Count == 0)">
                Reset
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="RemoveSelected"
                    @onclick:stopPropagation="true"
                    disabled="@(IsSaving || SelectedLine == null)">
                Delete
            </button>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="OpenPaymentModal"
                    @onclick:stopPropagation="true"
                    disabled="@(IsSaving || Lines.Count == 0)">
                Complete sale
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="NavigateToDashboard"
                    @onclick:stopPropagation="true"
                    disabled="@IsSaving">
                Close
            </button>
        </div>
    </div>

    <!-- CENTER: PRODUCTS -->
    <div class="sale-center">

        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Scan barcode..."
                       @bind="BarcodeInput"
                       @bind:event="oninput"
                       @onkeydown="OnBarcodeKeyDown"
                       @ref="barcodeInputRef"
                       disabled="@IsSaving"
                       autofocus />

                <span class="search-icon">🔍</span>
            </div>
        </div>

        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Search local products..."
                       @bind="SearchText"
                       @bind:event="oninput"
                       @bind:after="UpdateProductFilter"
                       disabled="@IsSaving" />

                <span class="search-icon">🔍</span>
            </div>
        </div>

        <div class="card product-list-container">
            @if (IsLoading)
            {
                <div class="loading-state">
                    Loading local POS data...
                </div>
            }
            else if (FilteredProducts.Count == 0)
            {
                <div class="empty-state">
                    <p>No local products found</p>
                </div>
            }
            else
            {
                <ul class="product-list">
                    @foreach (var product in FilteredProducts)
                    {
                        var available =
                        GetAvailableSaleQuantity(product);

                        var isOutOfStock =
                        available <= 0m;

                        var lowStock =
                        available > 0m &&
                        available <= 5m;

                        var packValid =
                        !product.IsPack ||
                        ResolveUnitProduct(product) != null;

                        <li class="product-item @((isOutOfStock || !packValid)
                                                                                                                                                ? "out-of-stock"
                                                                                                                                                : string.Empty)"
                    @onclick="() => SelectAndAddProduct(product)"
                    @onclick:stopPropagation="true"
                    title="@GetProductTitle(product, available, packValid)">

                            <strong>@product.Name</strong>

                    @if (!string.IsNullOrWhiteSpace(product.Barcode))
                            {
                                <span class="muted">
                                    @product.Barcode
                                </span>
                            }

                            @if (product.IsPack)
                            {
                                <span class="muted">
                                    Pack de
                                    @FormatQuantity(GetUnitsPerPack(product))
                                    unités
                                </span>
                            }

                        <span class="muted price">
                            €@product.SalePrice.ToString("F2")
                        </span>

                        <span class="stock-indicator @((isOutOfStock || !packValid)
                                                                                                                                                        ? "out"
                                                                                                                                                        : lowStock
                                                                                                                                                            ? "low"
                                                                                                                                                            : "in")">

                        @if (!packValid)
                                {
                                    <span>Pack configuration missing</span>
                                }
                                else if (isOutOfStock)
                                {
                                    <span>Out of stock</span>
                                }
                                else if (lowStock)
                                {
                                    <span>
                                        Low:
                                        @FormatQuantity(available)
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        In stock:
                                        @FormatQuantity(available)
                                    </span>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card numpad-container"
             @onclick:stopPropagation="true">
            <div class="numpad">
                <div class="display">@NumpadValue</div>

                <div class="keys">
                    @foreach (var key in NumpadKeys)
                    {
                        <button type="button"
                                class="key-btn"
                                @onclick="() => PressKey(key)"
                                disabled="@IsSaving">
                            @key
                        </button>
                    }

                    <button type="button"
                            class="key-btn clear"
                            @onclick="ClearNumpad"
                            disabled="@IsSaving">
                        C
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT: CATEGORIES -->
    <div class="sale-right">
        <div class="card category-panel">
            <div class="category-grid">
                <label class="category-label">Categories</label>

                <button type="button"
                        class="category-btn @(SelectedCategory == null ? "active" : string.Empty)"
                        @onclick="() => SelectCategory(null)"
                        @onclick:stopPropagation="true"
                        disabled="@IsSaving">
                    All
                </button>

                @foreach (var category in Categories)
                {
                    <button type="button"
                            class="category-btn @(string.Equals(
                                            SelectedCategory,
                                            category,
                                            StringComparison.OrdinalIgnoreCase)
                                                ? "active"
                                                : string.Empty)"
                        @onclick="() => SelectCategory(category)"
                        @onclick:stopPropagation="true"
                        disabled="@IsSaving">
                    @category
                </button>
                                }
            </div>
        </div>
    </div>
</div>

<!-- CUSTOMER MODAL -->
@if (ShowCustomerModal)
{
    <div class="modal-overlay"
         @onclick="CloseCustomerModal">

        <div class="modal-content"
             @onclick:stopPropagation="true">

            <div class="modal-header">
                <h3>Select local customer</h3>

                <button type="button"
                        class="modal-close"
                        @onclick="CloseCustomerModal">
                    ×
                </button>
            </div>

            <div class="modal-body">
                <div class="search-box">
                    <input type="text"
                           class="search-input"
                           placeholder="Search customers..."
                           @bind="CustomerSearchText"
                           @bind:event="oninput"
                           autofocus />

                    <span class="search-icon">🔍</span>
                </div>

                <ul class="customer-list">
                    <li class="customer-item @(TempSelectedCustomer == null ? "selected" : string.Empty)"
                        @onclick="() => TempSelectedCustomer = null">
                        <strong>Walk-in customer</strong>
                        <span class="muted">No customer tracking</span>
                    </li>

                    @foreach (var customer in FilteredCustomers)
                    {
                        <li class="customer-item @(TempSelectedCustomer?.Id == customer.Id ? "selected" : string.Empty)"
                            @onclick="() => TempSelectedCustomer = customer">

                            <strong>@customer.Name</strong>

                            @if (!string.IsNullOrWhiteSpace(customer.Phone))
                            {
                                <span class="muted">
                                    @customer.Phone
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(customer.Email))
                            {
                                <span class="muted">
                                    @customer.Email
                                </span>
                            }

                            @if (!customer.ServerId.HasValue ||
                                                customer.ServerId.Value == Guid.Empty)
                            {
                                <span class="muted">
                                    Pending synchronization
                                </span>
                            }
                        </li>
                    }
                </ul>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CloseCustomerModal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="ConfirmCustomerSelection">
                    OK
                </button>
            </div>
        </div>
    </div>
}

<!-- PENDING SALES MODAL -->
@if (ShowPendingModal)
{
    <div class="pending-modal-overlay"
         @onclick="ClosePendingModal">

        <div class="pending-modal"
             @onclick:stopPropagation="true">

            <div class="pending-modal-header">
                <div>
                    <h3>Local pending tickets</h3>
                    <p>Select a ticket to resume or delete it.</p>
                </div>

                <button type="button"
                        class="pending-close-btn"
                        @onclick="ClosePendingModal">
                    ×
                </button>
            </div>

            <div class="pending-modal-body">
                @if (IsLoadingPending)
                {
                    <div class="pending-empty">
                        Loading pending tickets...
                    </div>
                }
                else if (PendingSales.Count == 0)
                {
                    <div class="pending-empty">
                        No local pending tickets found.
                    </div>
                }
                else
                {
                    <div class="pending-ticket-list">
                        @foreach (var pendingSale in PendingSales)
                        {
                            <div class="pending-ticket-card">
                                <div class="pending-ticket-left"
                                     @onclick="() => ResumePendingSaleAsync(pendingSale.Id)">

                                    <span class="pending-ticket-label">
                                        Invoice
                                    </span>

                                    <strong class="pending-ticket-number">
                                        @pendingSale.LocalInvoiceNumber
                                    </strong>

                                    <span class="muted">
                                        @pendingSale.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        ·
                                        @pendingSale.Lines.Count line(s)
                                    </span>
                                </div>

                                <div class="pending-ticket-right"
                                     @onclick="() => ResumePendingSaleAsync(pendingSale.Id)">

                                    <span class="pending-ticket-label">
                                        Total
                                    </span>

                                    <strong class="pending-ticket-total">
                                        €@pendingSale.TotalAmount.ToString("F2")
                                    </strong>
                                </div>

                                <button type="button"
                                        class="item-delete"
                                        title="Delete pending ticket"
                                        @onclick="() => DeletePendingSaleAsync(pendingSale.Id)"
                                        @onclick:stopPropagation="true">
                                    ×
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="pending-modal-footer">
                <button type="button"
                        class="pending-footer-btn"
                        @onclick="ClosePendingModal">
                    Close
                </button>
            </div>
        </div>
    </div>
}

<!-- PAYMENT MODAL -->
@if (ShowPaymentModal)
{
    <div class="modal-overlay"
         @onclick="ClosePaymentModal">

        <div class="modal-content payment-modal-right-numpad"
             @onclick:stopPropagation="true">

            <div class="modal-header">
                <h3>Payment</h3>

                <button type="button"
                        class="modal-close"
                        @onclick="ClosePaymentModal"
                        disabled="@IsSaving">
                    ×
                </button>
            </div>

            <div class="modal-body">
                @if (SaleCompleted)
                {
                    <div class="summary-badge success"
                         style="margin-bottom:16px;padding:14px;">
                        <strong>Sale saved locally.</strong>

                        @if (!string.IsNullOrWhiteSpace(
                                        CompletedInvoiceNumber))
                        {
                            <div>
                                Invoice: @CompletedInvoiceNumber
                            </div>
                        }

                        <div>
                            The sale is queued for synchronization.
                        </div>
                    </div>

                    <button type="button"
                            class="btn btn-primary"
                            style="width:100%;margin-bottom:16px;"
                            @onclick="ShareCompletedReceiptAsync"
                            disabled="@(!CompletedReceiptId.HasValue)">
                        Download / share ticket PDF
                    </button>
                }

                <div class="payment-layout">

                    <div class="payment-left">

                        <div class="payment-summary">
                            <div class="summary-item">
                                <span class="label">Total:</span>
                                <span class="value total">
                                    €@TotalAmount.ToString("F2")
                                </span>
                            </div>

                            <div class="summary-item">
                                <span class="label">Applied:</span>
                                <span class="value paid">
                                    €@AppliedPaymentTotal.ToString("F2")
                                </span>
                            </div>

                            <div class="summary-item">
                                <span class="label">Remaining:</span>
                                <span class="value remaining">
                                    €@RemainingAmount.ToString("F2")
                                </span>
                            </div>

                            @if (ChangeAmount > 0m)
                            {
                                <div class="summary-item">
                                    <span class="label">Change:</span>
                                    <span class="value"
                                          style="color:#28a745;">
                                        €@ChangeAmount.ToString("F2")
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="method-selection">
                            <h4>Payment method</h4>

                            <div class="method-buttons">
                                @foreach (var paymentType in
                                                            Enum.GetValues<PaymentType>())
                                {
                                    var disabled =
                                    paymentType ==
                                    PaymentType.Credit &&
                                    SelectedCustomer == null;

                                    <button type="button"
                                            class="method-btn @(CurrentPaymentType == paymentType ? "active" : string.Empty)"
                                            @onclick="() => SelectPaymentType(paymentType)"
                                            disabled="@(disabled || IsSaving)">
                                        <span class="method-icon">
                                            @GetPaymentIcon(paymentType)
                                        </span>

                                        <span class="method-name">
                                            @paymentType
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="payments-list-section">
                            <h4>Payments (@PaymentEntries.Count)</h4>

                            @if (PaymentEntries.Count == 0)
                            {
                                <div class="no-payments">
                                    No payments added yet
                                </div>
                            }
                            else
                            {
                                <div class="payments-list">
                                    @foreach (var payment in PaymentEntries)
                                    {
                                        <div class="payment-item">
                                            <span class="item-icon">
                                                @GetPaymentIcon(payment.Type)
                                            </span>

                                            <div class="item-details">
                                                <span class="item-type">
                                                    @payment.Type
                                                </span>

                                                <span class="item-time">
                                                    @payment.TimestampUtc.ToString("HH:mm")
                                                </span>
                                            </div>

                                            @if (payment.ReceivedAmount >
                                                                            payment.AppliedAmount)
                                            {
                                                <span class="item-amount">
                                                    Received:
                                                    €@payment.ReceivedAmount.ToString("F2")
                                                    /
                                                    Applied:
                                                    €@payment.AppliedAmount.ToString("F2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="item-amount">
                                                    €@payment.AppliedAmount.ToString("F2")
                                                </span>
                                            }

                                            <button type="button"
                                                    class="item-delete"
                                                    @onclick="() => RemovePayment(payment)"
                                                    disabled="@IsSaving">
                                                ×
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="payment-right">
                        <div class="numpad-section">
                            <h4>Amount received</h4>

                            <div class="amount-display">
                                <span class="currency">€</span>

                                <input type="text"
                                       class="amount-input"
                                       value="@PaymentInput"
                                       @oninput="HandlePaymentInput"
                                       placeholder="0.00"
                                       disabled="@IsSaving" />

                                <button type="button"
                                        class="btn-clear"
                                        @onclick="ClearPaymentInput"
                                        disabled="@IsSaving">
                                    ×
                                </button>
                            </div>

                            <div class="quick-amount-grid">
                                <button type="button"
                                        class="quick-btn"
                                        @onclick="() => SetPaymentAmount(RemainingAmount / 2m)">
                                    1/2
                                </button>

                                <button type="button"
                                        class="quick-btn"
                                        @onclick="() => SetPaymentAmount(RemainingAmount)">
                                    Full
                                </button>
                            </div>

                            <div class="numpad-grid">
                                @foreach (var key in PaymentKeys)
                                {
                                    <button type="button"
                                            class="numpad-btn"
                                            @onclick="() => PressPaymentKey(key)"
                                            disabled="@IsSaving">
                                        @key
                                    </button>
                                }

                            <button type="button"
                                    class="numpad-btn clear"
                                    @onclick="ClearPaymentInput"
                                    disabled="@IsSaving">
                                C
                            </button>
                        </div>

                        <button type="button"
                                class="exact-payment-btn"
                                @onclick="PayExactAmount"
                                disabled="@(RemainingAmount <= 0m || IsSaving)">
                            Pay €@RemainingAmount.ToString("F2")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button"
                    class="btn btn-secondary"
                    @onclick="ResetPayments"
                    disabled="@IsSaving">
                Reset payments
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="ClosePaymentModal"
                    disabled="@IsSaving">
                Close
            </button>

            <button type="button"
                    class="btn btn-success btn-complete"
                    @onclick="HandleCompleteOrAddPayment"
                    disabled="@(IsSaving || SaleCompleted)">
                @(IsSaving
                                ? "Saving locally..."
                                : GetCompleteButtonLabel())
            </button>
        </div>
    </div>
</div>
}

@code {
