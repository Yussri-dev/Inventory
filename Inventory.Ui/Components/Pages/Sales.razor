    private async Task AddProductAsync(
        LocalProduct product,
        decimal quantity)
    {
        if (quantity <= 0m)
        {
            await ShowErrorAsync(
                "Quantity must be greater than zero.");

            return;
        }

        if (product.SalePrice <= 0m)
        {
            await ShowErrorAsync(
                $"Product '{product.Name}' has no valid sale price.");

            return;
        }

        if (product.IsPack &&
            ResolveUnitProduct(product) == null)
        {
            await ShowErrorAsync(
                $"The unit product linked to pack " +
                $"'{product.Name}' was not found locally.");

            return;
        }

        var existingLine =
            Lines.FirstOrDefault(line =>
                line.Product.Id == product.Id);

        var available =
            GetAvailableSaleQuantity(product);

        var requested =
            RoundQuantity(
                (existingLine?.Quantity ?? 0m) +
                quantity);

        if (requested >
            available)
        {
            await ShowErrorAsync(
                $"Insufficient stock for '{product.Name}'. " +
                $"Available: {FormatQuantity(available)}.");

            return;
        }

        if (existingLine == null)
        {
            existingLine =
                new CartLine(product)
                {
                    Quantity =
                        RoundQuantity(quantity)
                };

            Lines.Add(
                existingLine);
        }
        else
        {
            existingLine.Quantity =
                requested;
        }

        SelectedLine =
            existingLine;

        NumpadValue =
            string.Empty;

        await FocusBarcodeInput();
    }

