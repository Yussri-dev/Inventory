    private void UpdateProductFilter()
    {
        var search =
            SearchText?.Trim() ??
            string.Empty;

        var selectedCategory =
            SelectedCategory?.Trim();

        FilteredProducts =
            Products
                .Where(product =>
                    product.IsActive &&
                    !product.IsDeletedLocally)
                .Where(product =>
                    string.IsNullOrWhiteSpace(
                        selectedCategory) ||
                    string.Equals(
                        product.Category?.Trim(),
                        selectedCategory,
                        StringComparison.OrdinalIgnoreCase))
                .Where(product =>
                    string.IsNullOrWhiteSpace(search) ||
                    Contains(
                        product.Name,
                        search) ||
                    Contains(
                        product.Barcode,
                        search) ||
                    Contains(
                        product.Sku,
                        search) ||
                    Contains(
                        product.Brand,
                        search))
                .OrderBy(product =>
                    product.Name)
                .ToList();

        Logger.LogInformation(
            "Product filter updated. Category={Category}, Search={Search}, " +
            "TotalProducts={TotalProducts}, FilteredProducts={FilteredProducts}.",
            selectedCategory ?? "All",
            search,
            Products.Count,
            FilteredProducts.Count);
