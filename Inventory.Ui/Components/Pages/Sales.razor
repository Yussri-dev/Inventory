    private async Task HandleCompleteOrAddPayment()
    {
        if (SaleCompleted ||
            IsSaving)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(
                PaymentInput))
        {
            if (!TryParsePaymentInput(
                    out var receivedAmount) ||
                receivedAmount <= 0m)
            {
                await ShowErrorAsync(
                    "Enter a valid payment amount.");

                return;
            }

            if (CurrentPaymentType !=
                    PaymentType.Cash &&
                receivedAmount >
                    RemainingAmount)
            {
                await ShowErrorAsync(
                    "A non-cash payment cannot exceed the remaining amount.");

                return;
            }

            AddPayment(
                CurrentPaymentType,
                receivedAmount);
        }

        if (RemainingAmount > 0m)
        {
            if (SelectedCustomer == null)
            {
                await ShowErrorAsync(
                    "A walk-in customer must pay the full amount.");

                return;
            }

            AddPayment(
                PaymentType.Credit,
                RemainingAmount);
        }

        await CompleteSaleAsync();
    }

    private void AddPayment(
        PaymentType paymentType,
        decimal receivedAmount)
    {
        var remainingBeforePayment =
            RemainingAmount;

        var appliedAmount =
            paymentType ==
                PaymentType.Cash
                ? Math.Min(
                    receivedAmount,
                    remainingBeforePayment)
                : receivedAmount;

        PaymentEntries.Add(
            new PaymentEntry
            {
                Type =
                    paymentType,

                AppliedAmount =
                    RoundMoney(
                        appliedAmount),

                ReceivedAmount =
                    paymentType ==
                        PaymentType.Cash
                        ? RoundMoney(
                            receivedAmount)
                        : RoundMoney(
                            appliedAmount),

                TimestampUtc =
                    DateTime.UtcNow
            });

        PaymentInput =
            string.Empty;
    }

    private void RemovePayment(
        PaymentEntry payment)
    {
        PaymentEntries.Remove(
            payment);
    }

    private void ResetPayments()
    {
        PaymentEntries.Clear();

        PaymentInput =
            string.Empty;

        CurrentPaymentType =
            PaymentType.Cash;
    }

    private async Task CompleteSaleAsync()
    {
        if (IsSaving)
        {
            return;
        }

        /*
         * Bloquer immédiatement un deuxième clic.
         */
        IsSaving =
            true;

        try
        {
            if (Lines.Count == 0)
            {
                await ShowErrorAsync(
                    "Sale contains no lines.");

                return;
            }

            if (PaymentEntries.Count == 0)
            {
                await ShowErrorAsync(
                    "Sale contains no payments.");

                return;
            }

            if (RemainingAmount > 0.01m)
            {
                await ShowErrorAsync(
                    "The payment does not cover the sale total.");

                return;
            }

            var pendingSaleId =
                CurrentPendingSaleId;

            var localSale =
                BuildLocalSale();

            var savedSale =
                pendingSaleId.HasValue
                    ? await LocalSaleService
                        .CompletePendingAsync(
                            pendingSaleId.Value,
                            localSale)
                    : await LocalSaleService
                        .CreateAsync(
                            localSale);

            var receipt =
                await ReceiptService.CreateReceiptAsync(
                    savedSale.Id);

            CompletedReceiptId =
                receipt.Id;

            await ReloadStockAsync();

            State.InvalidatePos();

            CompletedInvoiceNumber =
                savedSale.LocalInvoiceNumber;

            SaleCompleted =
                true;

            Logger.LogInformation(
                "Local sale {InvoiceNumber} saved with " +
                "{LineCount} lines. PendingSaleId: {PendingSaleId}",
                savedSale.LocalInvoiceNumber,
                savedSale.Lines.Count,
                pendingSaleId);

            Lines.Clear();

            SelectedLine =
                null;

            SelectedCustomer =
                null;

            CurrentPendingSaleId =
                null;

            PaymentEntries.Clear();

            PaymentInput =
                string.Empty;

            await ShowSuccessAsync(
                $"Sale {savedSale.LocalInvoiceNumber} saved locally " +
                "and queued for synchronization.");

            StartClosePaymentModalTimer();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to complete the local sale. " +
                "PendingSaleId: {PendingSaleId}",
                CurrentPendingSaleId);

            /*
             * Important :
             * ne pas utiliser GetBaseException(), sinon le détail
             * Entity/State/Key du conflit est perdu.
             */
            await ShowErrorAsync(
                exception.Message);
        }
        finally
        {
            IsSaving =
                false;
        }
    }

    private async Task<string> SaveReceiptPdfAsync(
    Guid receiptId,
    bool duplicate)
    {
        var pdfBytes =
            await ReceiptService.GeneratePdfAsync(
                receiptId,
                duplicate);

        var prefix =
            duplicate
                ? "DUPLICATA"
                : "TICKET";

        var safeInvoiceNumber =
            string.IsNullOrWhiteSpace(
                CompletedInvoiceNumber)
                    ? DateTime.Now.ToString(
                        "yyyyMMdd-HHmmss")
                    : CompletedInvoiceNumber
                        .Replace("/", "-")
                        .Replace("\\", "-")
                        .Replace(":", "-");

        var fileName =
            $"{prefix}-{safeInvoiceNumber}.pdf";

        var filePath =
            Path.Combine(
                FileSystem.CacheDirectory,
                fileName);

        await File.WriteAllBytesAsync(
            filePath,
            pdfBytes);

        return filePath;
    }

    private async Task ShareReceiptPdfAsync(
        Guid receiptId,
        bool duplicate)
    {
        try
        {
            var filePath =
                await SaveReceiptPdfAsync(
                    receiptId,
                    duplicate);

            await Share.Default.RequestAsync(
                new ShareFileRequest
                {
                    Title =
                        duplicate
                            ? "Partager le duplicata"
                            : "Partager le ticket",

                    File =
                        new ShareFile(
                            filePath,
                            "application/pdf")
                });
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to share receipt PDF {ReceiptId}.",
                receiptId);

            await ShowErrorAsync(
                exception
                    .GetBaseException()
                    .Message);
        }
    }

    private async Task ShareCompletedReceiptAsync()
    {
        if (!CompletedReceiptId.HasValue ||
            CompletedReceiptId.Value == Guid.Empty)
        {
            await ShowErrorAsync(
                "No receipt is available for this sale.");

            return;
        }

        await ShareReceiptPdfAsync(
            CompletedReceiptId.Value,
            duplicate: false);
    }

    private LocalSale BuildLocalSale(
        bool includePayments = true)
    {
        var now =
            DateTime.UtcNow;

        var localSale =
            new LocalSale
            {
                Id =
                    CurrentPendingSaleId ??
                    (includePayments
                        ? Guid.NewGuid()
                        : Guid.Empty),

                ServerId =
                    null,

                ClientOperationId =
                    Guid.NewGuid(),

                LocalInvoiceNumber =
                    string.Empty,

                CustomerLocalId =
                    SelectedCustomer?.Id,

                CustomerServerId =
                    SelectedCustomer?.ServerId,

                SaleDateUtc =
                    now,

                Notes =
                    "Created from local-first POS.",

                Status =
                    includePayments
                        ? LocalSaleStatus.Completed
                        : "Pending",

                PaymentStatus =
                    includePayments
                        ? LocalPaymentStatus.Paid
                        : LocalPaymentStatus.Unpaid,

                SyncStatus =
                    SyncQueueStatus.Pending,

                CreatedAtUtc =
                    now
            };

        foreach (var cartLine in Lines)
        {
            var soldProduct =
                cartLine.Product;

            var stockProduct =
                soldProduct.IsPack
                    ? ResolveUnitProduct(soldProduct)
                        ?? throw new InvalidOperationException(
                            $"The unit product linked to pack " +
                            $"'{soldProduct.Name}' was not found.")
                    : soldProduct;

            var unitsPerPack =
                GetUnitsPerPack(
                    soldProduct);

            var stockQuantity =
                soldProduct.IsPack
                    ? RoundQuantity(
                        cartLine.Quantity *
                        unitsPerPack)
                    : RoundQuantity(
                        cartLine.Quantity);

            localSale.Lines.Add(
                new LocalSaleLine
                {
                    Id =
                        Guid.NewGuid(),

                    ProductLocalId =
                        soldProduct.Id,

                    ProductServerId =
                        soldProduct.ServerId,

                    ProductName =
                        soldProduct.Name,

                    ProductBarcode =
                        soldProduct.Barcode,

                    Quantity =
                        RoundQuantity(
                            cartLine.Quantity),

                    UnitProductLocalId =
                        stockProduct.Id,

                    UnitProductServerId =
                        stockProduct.ServerId ??
                        Guid.Empty,

                    UnitQuantity =
                        stockQuantity,

                    IsPack =
                        soldProduct.IsPack,

                    UnitsPerPack =
                        unitsPerPack,

                    /*
                     * Price override is stored in UnitPrice.
                     * Discounts remain separate so LocalSaleService
                     * calculates the same total.
                     */
                    UnitPrice =
                        RoundMoney(
                            cartLine.PriceBeforeDiscount),

                    VatRate =
                        RoundPercentage(
                            soldProduct.VatRate),

                    DiscountPercent =
                        RoundPercentage(
                            cartLine.DiscountPercent),

                    /*
                     * Cart fixed discount is per unit, while the local
                     * entity stores a fixed discount for the complete
                     * line.
                     */
                    DiscountAmount =
                        RoundMoney(
                            cartLine.DiscountAmountPerUnit *
                            cartLine.Quantity),

                    /*
                     * Cost belongs to the actual stock product.
                     * For a pack this is the linked unit product.
                     */
                    UnitCostPrice =
                        RoundMoney(
                            stockProduct.PurchasePrice),

                    Notes =
                        soldProduct.IsPack
                            ? $"Pack sale: {cartLine.Quantity:0.###} x " +
                              $"{unitsPerPack:0.###}."
                            : null
                });
        }

        if (includePayments)
        {
            foreach (var paymentEntry in PaymentEntries)
            {
                /*
                 * For cash, persist the amount physically received.
                 * LocalSaleService calculates ChangeAmount from the
                 * difference between PaidAmount and TotalAmount.
                 */
                var amount =
                    paymentEntry.Type ==
                        PaymentType.Cash
                        ? paymentEntry.ReceivedAmount
                        : paymentEntry.AppliedAmount;

                localSale.Payments.Add(
                    new LocalPayment
                    {
                        Id =
                            Guid.NewGuid(),

                        ServerId =
                            null,

                        ServerSaleId =
                            null,

                        Amount =
                            RoundMoney(
                                amount),

                        Method =
                            paymentEntry.Type.ToString(),

                        TransactionRef =
                            $"Local POS {paymentEntry.TimestampUtc:yyyy-MM-dd HH:mm:ss}",

                        PaidAtUtc =
                            paymentEntry.TimestampUtc,

                        Notes =
                            paymentEntry.ReceivedAmount >
                            paymentEntry.AppliedAmount
                                ? $"Applied {paymentEntry.AppliedAmount:F2}; " +
                                  $"received {paymentEntry.ReceivedAmount:F2}."
                                : null,

                        SyncStatus =
                            SyncQueueStatus.Pending
                    });
            }
        }

        return localSale;
    }

    private LocalProduct? ResolveUnitProduct(
        LocalProduct product)
    {
        if (!product.IsPack)
        {
            return product;
        }

        if (product.UnitProductLocalId.HasValue &&
            product.UnitProductLocalId.Value != Guid.Empty &&
            ProductMap.TryGetValue(
                product.UnitProductLocalId.Value,
                out var byLocalId))
        {
            return byLocalId;
        }

        if (product.UnitProductServerId.HasValue &&
            product.UnitProductServerId.Value != Guid.Empty)
        {
            return Products.FirstOrDefault(candidate =>
                candidate.ServerId ==
                    product.UnitProductServerId.Value);
        }

        return null;
    }

    private Guid GetStockProductLocalId(
        LocalProduct product)
    {
        return product.IsPack
            ? ResolveUnitProduct(product)?.Id ??
              Guid.Empty
            : product.Id;
    }

    private decimal GetUnitsPerPack(
        LocalProduct product)
    {
        return product.IsPack
            ? RoundQuantity(
                product.UnitsPerPack)
            : 1m;
    }

    private decimal GetAvailableSaleQuantity(
        LocalProduct product)
    {
        var stockProductLocalId =
            GetStockProductLocalId(
                product);

        if (stockProductLocalId ==
            Guid.Empty)
        {
            return 0m;
        }

        var totalAvailableUnits =
            StockMap.TryGetValue(
                stockProductLocalId,
                out var stock)
                ? stock.AvailableQuantity
                : 0m;

        var usedUnits =
            Lines
                .Where(line =>
                    line.Product.Id !=
                    product.Id)
                .Where(line =>
                    GetStockProductLocalId(
                        line.Product) ==
                    stockProductLocalId)
                .Sum(line =>
                    line.StockQuantity);

        var remainingUnits =
            RoundQuantity(
                Math.Max(
                    0m,
                    totalAvailableUnits -
                    usedUnits));

        if (!product.IsPack)
        {
            return remainingUnits;
        }

        var unitsPerPack =
            GetUnitsPerPack(
                product);

        return unitsPerPack > 0m
            ? Math.Floor(
                remainingUnits /
                unitsPerPack)
            : 0m;
    }

    private string GetProductTitle(
        LocalProduct product,
        decimal available,
        bool packValid)
    {
        if (!packValid)
        {
            return "The linked unit product is missing.";
        }

        return available <= 0m
            ? "Out of stock"
            : $"Available: {FormatQuantity(available)}";
    }

    private decimal GetQuantityFromNumpad()
    {
        return TryParseNumpad(
            out var quantity) &&
            quantity > 0m
                ? RoundQuantity(
                    quantity)
                : 1m;
    }

    private void PressKey(
        string key)
    {
        if (key == "." &&
            NumpadValue.Contains(
                '.',
                StringComparison.Ordinal))
        {
            return;
        }

        NumpadValue +=
            key;
    }

    private void ClearNumpad()
    {
        NumpadValue =
            string.Empty;

        _ = FocusBarcodeInput();
    }

    private bool TryParseNumpad(
        out decimal value)
    {
        return TryParseDecimal(
            NumpadValue,
            out value);
    }

    private bool TryParsePaymentInput(
        out decimal value)
    {
        return TryParseDecimal(
            PaymentInput,
            out value);
    }

    private static bool TryParseDecimal(
        string input,
        out decimal value)
    {
        var normalized =
            input
                .Trim()
                .Replace(',', '.');

        return decimal.TryParse(
            normalized,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out value);
    }

    private string GetCompleteButtonLabel()
    {
        if (!string.IsNullOrWhiteSpace(
                PaymentInput))
        {
            return "Add payment and complete";
        }

        if (RemainingAmount > 0m &&
            SelectedCustomer != null)
        {
            return "Complete with credit";
        }

        return "Complete sale";
    }

    private static string GetPaymentIcon(
        PaymentType paymentType)
    {
        return paymentType switch
        {
            PaymentType.Cash =>
                "💵",

            PaymentType.Card =>
                "💳",

            PaymentType.Credit =>
                "📝",

