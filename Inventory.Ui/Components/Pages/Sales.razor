    private async Task LoadLocalDataAsync()
    {
        try
        {
            IsLoading =
                true;

            var tenantId =
                LocalTenantContext.GetRequiredTenantId();

            /*
             * Use the same local cash-session service as the
             * CashSessions page. This prevents two screens from using
             * different definitions of an open session.
             */
            var openSession =
                await LocalCashSessionService
                    .GetOpenSessionAsync();

            if (openSession == null)
            {
                await ShowErrorAsync(
                    "No open local cash session was found for the " +
                    "current tenant.");

                Nav.NavigateTo(
                    "/cashsessions");

                return;
            }

            if (openSession.TenantId != tenantId)
            {
                Logger.LogError(
                    "Local cash session tenant mismatch. " +
                    "Session {SessionId} belongs to {SessionTenantId}, " +
                    "but the authenticated tenant is {CurrentTenantId}.",
                    openSession.Id,
                    openSession.TenantId,
                    tenantId);

                await ShowErrorAsync(
                    "The displayed cash session belongs to another " +
                    "tenant. Open a new local cash session for the " +
                    "current tenant.");

                Nav.NavigateTo(
                    "/cashsessions");

                return;
            }

            if (!string.Equals(
                    openSession.Status,
                    LocalCashSessionStatus.Open,
                    StringComparison.OrdinalIgnoreCase))
            {
                await ShowErrorAsync(
                    $"Cash session {openSession.SessionNumber} is not " +
                    $"open. Current status: {openSession.Status}.");

                Nav.NavigateTo(
                    "/cashsessions");

                return;
            }

            Products =
                await Db.Products
                    .AsNoTracking()
                    .Where(product =>
                        product.TenantId == tenantId &&
                        product.IsActive &&
                        !product.IsDeletedLocally)
                    .OrderBy(product =>
                        product.Name)
                    .ToListAsync();

            Customers =
                await Db.Customers
                    .AsNoTracking()
                    .Where(customer =>
                        customer.TenantId == tenantId &&
                        customer.IsActive &&
                        !customer.IsDeleted)
                    .OrderBy(customer =>
                        customer.Name)
                    .ToListAsync();

            var stocks =
                await Db.Stocks
                    .AsNoTracking()
                    .Where(stock =>
                        stock.TenantId == tenantId)
                    .ToListAsync();

            ProductMap =
                Products.ToDictionary(product =>
                    product.Id);

            StockMap =
                stocks
                    .GroupBy(stock =>
                        stock.ProductLocalId)
                    .ToDictionary(
                        group => group.Key,
                        group => group.First());

            BarcodeMap =
                Products
                    .Where(product =>
                        !string.IsNullOrWhiteSpace(
                            product.Barcode))
                    .GroupBy(
                        product =>
                            product.Barcode!.Trim(),
                        StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(
                        group => group.Key,
                        group => group.First(),
                        StringComparer.OrdinalIgnoreCase);

            UpdateProductFilter();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load the local sale page.");

            // await ShowErrorAsync(
            //     exception
            //         .GetBaseException()
            //         .Message);

            await ShowErrorAsync(exception.Message);
        }
        finally
        {
            IsLoading =
                false;
        }
    }

