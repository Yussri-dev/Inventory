    private bool ValidatePaymentState()
    {
        var calculatedPaid = Math.Round(paymentEntries.Sum(p => p.Amount), 2);

        if (Math.Abs(paidAmount - calculatedPaid) > 0.01m)
        {
            Console.WriteLine($"ERROR: paidAmount mismatch. UI: {paidAmount}, Calculated: {calculatedPaid}");
            return false;
        }

        var calculatedRemaining = Math.Round(Math.Max(0, TotalAmount - paidAmount), 2);

        if (Math.Abs(remainingAmount - calculatedRemaining) > 0.01m)
        {
            Console.WriteLine($"ERROR: remainingAmount mismatch. UI: {remainingAmount}, Calculated: {calculatedRemaining}");
            return false;
        }

        var cashReceived = paymentEntries
            .Where(p => p.Type == PaymentType.Cash)
            .Sum(p => p.AmountReceived);

        var nonCashApplied = paymentEntries
            .Where(p => p.Type != PaymentType.Cash)
            .Sum(p => p.Amount);

        var expectedCashNeeded = Math.Max(0, TotalAmount - nonCashApplied);
        var expectedChange = cashReceived > expectedCashNeeded
            ? cashReceived - expectedCashNeeded
            : 0m;

        if (Math.Abs(changeAmount - expectedChange) > 0.01m)
        {
            Console.WriteLine($"ERROR: changeAmount mismatch. UI: {changeAmount}, Expected: {expectedChange}");
            return false;
        }

        return true;
    }

    // COMPLETE PAYMENT - MODIFIED FOR CREDIT LOGIC
    async Task CompletePayment()
    {
        if (Pos.Lines.Count == 0)
        {
            // await JS.InvokeVoidAsync("alert", "No products in sale.");
            await ShowError($"No products in sale !");

            return;
        }

        // Walk-in: paiement obligatoire
        if (SelectedCustomer == null)
        {
            if (paymentEntries.Count == 0)
            {
                // await JS.InvokeVoidAsync("alert", "Walk-in customer must pay before completing the sale.");
                await ShowError($"Walk-in customer must pay before completing the sale.");

                return;
            }

            if (!ValidatePaymentState())
            {
                // await JS.InvokeVoidAsync("alert", "Payment state is invalid.");
                await ShowError($"Payment state is invalid.");

                return;
            }

            if (remainingAmount > 0)
            {
                // await JS.InvokeVoidAsync("alert", "Walk-in customer must pay the full amount.");
                await ShowError($"Walk-in customer must pay the full amount.");

                return;
            }
        }
        else
        {
            // Client sélectionné: si rien n'est payé, tout passe en crédit
            if (paymentEntries.Count == 0)
            {
                paymentEntries.Add(new PaymentEntry
                {
                    Type = PaymentType.Credit,
                    Amount = TotalAmount,
                    Timestamp = DateTime.UtcNow
                });

                RecalculateAll();
            }
            // Client sélectionné: s'il reste un montant, ajouter le restant en crédit
            else if (remainingAmount > 0)
            {
                paymentEntries.Add(new PaymentEntry
                {
                    Type = PaymentType.Credit,
                    Amount = remainingAmount,
                    Timestamp = DateTime.UtcNow
                });

                RecalculateAll();
            }

            if (!ValidatePaymentState())
            {
                // await JS.InvokeVoidAsync("alert", "Payment state is invalid.");
                await ShowError($"Payment state is invalid.");

                return;
            }
        }

        IsSaving = true;

        try
        {
            var request = new CreateCompleteSaleRequest
            {
                PendingSaleId = CurrentPendingSaleId,
                CustomerId = SelectedCustomer?.Id,
                SaleDate = DateTime.UtcNow,
                ChangeAmount = changeAmount,
                Lines = Pos.Lines.Select(l => new SaleLineItem
                {
                    ProductId = l.ProductId,
                    Quantity = l.Quantity,
                    UnitPrice = l.BaseSalePrice,
                    VatRate = l.TaxRate,
                    DiscountPercent = l.CalculateDiscountPercent()
                }).ToList(),
                Payments = paymentEntries.Select(entry => new PaymentInfo
                {
                    Amount = entry.Amount,
                    PaymentMethod = entry.Type.ToString(),
                    Reference = $"{entry.Type} - {entry.Timestamp:HH:mm:ss}"
                }).ToList()
            };

            var soldLines = Pos.Lines.ToList(); // snapshot avant reset
            var result = await SaleApi.CreateComplete(request);

            ShowSuccess("Sale Saved !");

            DeductStockLocally(soldLines); 

            await JS.InvokeVoidAsync(
                "downloadFile",
                $"{result.Sale.InvoiceNumber}.pdf",
                "application/pdf",
                result.PdfBase64
            );



            ResetPayments();
            await Reset();
            CurrentPendingSaleId = null;
            pendingLoaded = false;
            ClosePaymentModal();

            // PendingTickets = await SaleApi.GetPending();
        }
        finally
        {
            IsSaving = false;
        }
    }

