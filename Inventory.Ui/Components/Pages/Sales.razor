        };
    }

    private void StartClosePaymentModalTimer()
    {
        closeModalCancellation?.Cancel();
        closeModalCancellation?.Dispose();

        closeModalCancellation =
            new CancellationTokenSource();

        var token =
            closeModalCancellation.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(
                    TimeSpan.FromSeconds(10),
                    token);

                await InvokeAsync(() =>
                {
                    if (!token.IsCancellationRequested &&
                        SaleCompleted)
                    {
                        ClosePaymentModal();
                    }
                });
            }
            catch (OperationCanceledException)
            {
                // Expected when the modal is closed manually.
            }
        }, token);
    }

    private async Task FocusBarcodeInput()
    {
        if (ShowCustomerModal ||
            ShowPendingModal ||
            ShowPaymentModal)
        {
            return;
        }

        try
        {
            await Task.Delay(50);

            await barcodeInputRef
                .FocusAsync();
        }
        catch
        {
            // The element may not be rendered or the page is navigating.
        }
    }

