        };
    }
    private bool ValidatePaymentState()
    {
        // Check 1: paidAmount should equal sum of all payment entries
        var calculatedPaid = paymentEntries.Sum(p => p.Amount);
        if (Math.Abs(paidAmount - calculatedPaid) > 0.01m)
        {
            Console.WriteLine($"ERROR: paidAmount mismatch. UI: {paidAmount}, Calculated: {calculatedPaid}");
            return false;
        }

        // Check 2: remainingAmount should be TotalAmount - paidAmount
        var calculatedRemaining = TotalAmount - paidAmount;
        if (Math.Abs(remainingAmount - calculatedRemaining) > 0.01m)
        {
            Console.WriteLine($"ERROR: remainingAmount mismatch. UI: {remainingAmount}, Calculated: {calculatedRemaining}");
            return false;
        }

        // Check 3: changeAmount logic
        var cashTotal = paymentEntries.Where(p => p.Type == PaymentType.Cash).Sum(p => p.Amount);
        var nonCashTotal = paidAmount - cashTotal;
        var expectedCashNeeded = TotalAmount - nonCashTotal;

        if (cashTotal > expectedCashNeeded)
        {
            var expectedChange = cashTotal - expectedCashNeeded;
            if (Math.Abs(changeAmount - expectedChange) > 0.01m)
            {
                Console.WriteLine($"ERROR: changeAmount mismatch. UI: {changeAmount}, Expected: {expectedChange}");
                return false;
            }
        }
        else if (changeAmount > 0)
        {
            Console.WriteLine($"ERROR: changeAmount should be 0 when cash payment is not excessive");
            return false;
        }

        return true;
    }

    // COMPLETE PAYMENT - MODIFIED FOR CREDIT LOGIC
    async Task CompletePayment()
    {
        AddPayment();
        // CREDIT MODE
        if (currentPaymentType == PaymentType.Credit)
        {
            if (SelectedCustomer == null)
            {
                await JS.InvokeVoidAsync("alert", "Credit requires a customer.");
                return;
            }
            paymentEntries.Clear();
            paidAmount = 0;
            remainingAmount = TotalAmount;
        }
        // WALK-IN MUST PAY FULL
        if (SelectedCustomer == null && remainingAmount > 0)
        {
            await JS.InvokeVoidAsync("alert",
                "Walk-in customer must pay the full amount.");
            return;
        }
        // SANITY CHECK
        if (paidAmount + remainingAmount != TotalAmount)
        {
            await JS.InvokeVoidAsync("alert", "Invalid payment state.");
            return;
        }
        IsSaving = true;
        try
        {
            var cashAmount = paymentEntries
                .Where(p => p.Type == PaymentType.Cash)
                .Sum(p => p.Amount);
            var cardAmount = paymentEntries
                .Where(p => p.Type == PaymentType.Card)
                .Sum(p => p.Amount);

            var request = new CreateCompleteSaleRequest
            {
                CustomerId = SelectedCustomer?.Id,
                SaleDate = DateTime.UtcNow,
                ChangeAmount = changeAmount,
                Lines = Lines.Select(l => new SaleLineItem
                {
                    ProductId = l.ProductId,
                    Quantity = l.Quantity,
                    UnitPrice = l.BaseSalePrice,
                    VatRate = l.TaxRate,
                    DiscountPercent = l.CalculateDiscountPercent()
                }).ToList(),

                Payments = paymentEntries.Count > 0
                    ? paymentEntries.Select(entry => new PaymentInfo
                    {
                        Amount = entry.Amount,
                        PaymentMethod = entry.Type.ToString(), // "Cash", "Card", ou "Credit"
                        Reference = $"{GetPaymentTypeName(entry.Type)} - {entry.Timestamp:HH:mm:ss}"
                    }).ToList()
                    : null
            };

            var result = await SaleApi.CreateComplete(request);

            await JS.InvokeVoidAsync(
                     "downloadFile",
                     $"{result.Sale.InvoiceNumber}.pdf",
                     "application/pdf",
                     result.PdfBase64
                 );

            Reset();
            ClosePaymentModal();
        }
        finally
        {
            IsSaving = false;
        }
    }
