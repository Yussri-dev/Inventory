    void HandleUnauthorized()
    {
        if (_redirectingToLogin)
            return;

        if (Nav.Uri.Contains("/login"))
            return;

        _redirectingToLogin = true;

        Logger.LogWarning("Unauthorized → redirecting to login");

        Nav.NavigateTo("/login", replace: true);
    }
    // ENUMS
    enum PaymentType
    {
        Cash,
        Card,
        Credit
    }

    // MODELS
    class PaymentEntry
    {
        public PaymentType Type { get; set; }
        public decimal Amount { get; set; }
        public DateTime Timestamp { get; set; }
    }

    enum AdjustmentType
    {
        PriceOverride,
        DiscountPercent,
        DiscountAmount,
        Fee,
        Note
    }

    class CartAdjustment
    {
        public AdjustmentType Type { get; set; }
        public decimal Value { get; set; }
        public string? Note { get; set; }

        public decimal Apply(decimal basePrice)
        {
            return Type switch
            {
                AdjustmentType.PriceOverride => Value,
                AdjustmentType.DiscountPercent => basePrice * (1 - Value / 100),
                AdjustmentType.DiscountAmount => basePrice - Value,
                AdjustmentType.Fee => basePrice + Value,
                _ => basePrice
            };
        }

        public string Display =>
            Type switch
            {
                AdjustmentType.PriceOverride => $"Prix modifié → {Value:0.00} €",
                AdjustmentType.DiscountPercent => $"Remise → -{Value} %",
                AdjustmentType.DiscountAmount => $"Remise → -{Value:0.00} €",
                AdjustmentType.Fee => $"Frais → +{Value:0.00} €",
                AdjustmentType.Note => $"Note → {Note}",
                _ => ""
            };
    }

    class CartLine
    {
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public int Quantity { get; set; }
        public decimal BaseSalePrice { get; set; }
        public decimal TaxRate { get; set; }
        public bool IsExpanded { get; set; }
        public List<CartAdjustment> Adjustments { get; set; } = new();

        public decimal EffectiveUnitPrice
        {
            get
            {
                decimal price = BaseSalePrice;
                foreach (var adj in Adjustments)
                    price = adj.Apply(price);
                return price;
            }
        }

        public decimal Amount => Quantity * EffectiveUnitPrice;
        public decimal TaxAmount => Amount * (TaxRate / 100);

        public decimal CalculateDiscountPercent()
        {
            var discountAdj = Adjustments.FirstOrDefault(a => a.Type == AdjustmentType.DiscountPercent);
            if (discountAdj != null)
                return discountAdj.Value;

            var discountAmount = Adjustments.FirstOrDefault(a => a.Type == AdjustmentType.DiscountAmount);
            if (discountAmount != null && BaseSalePrice > 0)
                return (discountAmount.Value / BaseSalePrice) * 100;

            return 0;
        }
    }
