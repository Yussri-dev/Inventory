    //deduct
    private void DeductStockLocally(List<CartLine> soldLines)
    {
        foreach (var line in soldLines)
        {
            if (!ProductMap.TryGetValue(line.ProductId, out var product))
                continue;

            if (product.IsPack && product.ComponentProductId.HasValue)
            {
                var unitProductId = product.ComponentProductId.Value;
                var unitsToDeduct = line.Quantity * product.PackSize;

                if (State.StockMap!.TryGetValue(unitProductId, out var unitStock))
                {
                    unitStock.Quantity = Math.Max(0, unitStock.Quantity - unitsToDeduct);
                }
            }
            else
            {
                if (State.StockMap!.TryGetValue(line.ProductId, out var stock))
                {
                    stock.Quantity = Math.Max(0, stock.Quantity - line.Quantity);
                }
            }
        }

        StockMap = State.StockMap!;
    }

