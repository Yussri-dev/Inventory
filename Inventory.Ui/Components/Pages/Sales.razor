    // CHANGE CALCULATION
    private Dictionary<decimal, int> CalculateChangeDenominations(decimal changeAmount)
    {
        var denominations = new Dictionary<decimal, int>();

        // sécurise valeur initiale
        var remaining = Math.Round(changeAmount, 2, MidpointRounding.AwayFromZero);

        var euroDenominations = new[]
        {
        500m, 200m, 100m, 50m, 20m, 10m, 5m,
        2m, 1m, 0.50m, 0.20m, 0.10m, 0.05m, 0.02m, 0.01m
    };

        foreach (var denom in euroDenominations)
        {
            if (remaining <= 0m)
                break;

            // division sécurisée
            var count = (int)Math.Floor(remaining / denom);

            if (count <= 0)
                continue;

            denominations[denom] = count;

            remaining -= count * denom;

            // élimine résidus flottants
            remaining = Math.Round(remaining, 2, MidpointRounding.AwayFromZero);

            if (remaining < 0.01m)
                break;
        }

        return denominations;
    }

