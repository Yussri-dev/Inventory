    async Task SavePending()
    {
        if (Pos.Lines.Count == 0)
            return;

        IsSaving = true;

        try
        {
            var request = new CreatePendingSaleRequest
            {
                CustomerId = SelectedCustomer?.Id,
                SaleDate = DateTime.UtcNow,
                SaleLines = Pos.Lines.Select(l => new SaleLineItem
                {
                    ProductId = l.ProductId,
                    Quantity = l.Quantity,
                    UnitPrice = l.BaseSalePrice,
                    VatRate = l.TaxRate,
                    DiscountPercent = l.CalculateDiscountPercent()
                }).ToList()
            };

            if (CurrentPendingSaleId.HasValue)
            {
                await SaleApi.UpdatePending(CurrentPendingSaleId.Value, request);
                // successMessage = $"Sale updated as Pending !";
                ShowSuccess("Sale Updated as Pending !");

                pendingLoaded = false;

            }
            else
            {
                var created = await SaleApi.CreatePending(request);
                // successMessage = $"Sale saved as Pending !";
                ShowSuccess("Sale saved as Pending !");

                CurrentPendingSaleId = created.Id;
                pendingLoaded = false;

            }

            // await JS.InvokeVoidAsync("alert", "Sale saved as pending.");
            // successMessage = $"Sale saved as Pending !";
            ShowSuccess("Sale saved as Pending !");
            // successMessage = $"Sale of €{paymentAmount:N2} issued to {selectedCustomer.Name}!";


            // RESET COMPLET
            Pos.Lines.Clear();
            SelectedCustomer = null;
            SelectedLine = null;
            CurrentPendingSaleId = null;
            pendingLoaded = false;
            StateHasChanged();
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void RecalculateChange()
    {
        changeAmount = 0;

        var cashReceived = Math.Round(paymentEntries
            .Where(p => p.Type == PaymentType.Cash)
            .Sum(p => p.AmountReceived), 2);

        var nonCashApplied = Math.Round(paymentEntries
            .Where(p => p.Type != PaymentType.Cash)
            .Sum(p => p.Amount), 2);

        var totalDueInCash = Math.Round(Math.Max(0, TotalAmount - nonCashApplied), 2);

        if (cashReceived > totalDueInCash)
        {
            changeAmount = Math.Round(cashReceived - totalDueInCash, 2);
        }
    }


    string GeneratePaymentReference(decimal cash, decimal card, decimal credit, decimal change)
    {
        var parts = new List<string>();

        if (cash > 0) parts.Add($"Cash: €{cash:F2}");
        if (card > 0) parts.Add($"Card: €{card:F2}");
        if (credit > 0) parts.Add($"Credit: €{credit:F2}");
        if (change > 0) parts.Add($"Change: €{change:F2}");

        return string.Join(" | ", parts);
    }

    string GeneratePaymentNotes(decimal cash, decimal card, decimal credit, decimal change)
    {
        var notes = new List<string>();

        if (paymentEntries.Count > 1)
            notes.Add($"Multiple payments ({paymentEntries.Count}):");

        if (cash > 0) notes.Add($"• €{cash:F2} in cash");
        if (card > 0) notes.Add($"• €{card:F2} by card");
        if (credit > 0) notes.Add($"• €{credit:F2} on credit");
        if (change > 0) notes.Add($"• €{change:F2} change given");

        return string.Join("\n", notes);
    }

