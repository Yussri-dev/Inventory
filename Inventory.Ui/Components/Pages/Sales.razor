    // PAYMENT ADDING METHODS
    void AddPayment()
    {
        if (string.IsNullOrEmpty(currentPaymentInput) ||
            !decimal.TryParse(currentPaymentInput, out var amount) ||
            amount <= 0)
            return;

        // Masquer le preview avant d'ajouter
        showPaymentPreview = false;

        // Logique différente selon le type de paiement et le montant
        if (currentPaymentType == PaymentType.Cash && amount > remainingAmount)
        {
            // CAS 1: Paiement cash avec trop d'argent
            AddPaymentWithChange(amount);
        }
        else
        {
            // CAS 2: Montant normal (inférieur ou égal au restant)
            AddNormalPayment(amount);
        }

        // Validate state after adding payment
        if (!ValidatePaymentState())
        {
            Console.WriteLine("WARNING: Payment state validation failed!");
        }
    }

    void AddNormalPayment(decimal amount)
    {
        var paymentEntry = new PaymentEntry
        {
            Type = currentPaymentType,
            Amount = amount,
            Timestamp = DateTime.Now
        };

        paymentEntries.Add(paymentEntry);
        remainingAmount -= amount;
        paidAmount += amount;

        // Réinitialiser l'input
        currentPaymentInput = "";
        showPaymentPreview = false;
        StateHasChanged();
    }

    void AddPaymentWithChange(decimal amountGiven)
    {
        // CALCULATE THE CORRECT CHANGE
        decimal change = amountGiven - remainingAmount;

        // Ensure change is not negative
        if (change < 0)
        {
            change = 0;
        }

        // Add payment for the full remaining amount
        var paymentEntry = new PaymentEntry
        {
            Type = currentPaymentType,
            Amount = remainingAmount,
            Timestamp = DateTime.Now
        };

        paymentEntries.Add(paymentEntry);
        paidAmount += remainingAmount;
        remainingAmount = 0;
        changeAmount = change;

        // AUTO-VALIDATE CHANGE FOR WALK-IN CUSTOMERS
        if (SelectedCustomer == null && changeAmount > 0)
        {
            isChangeValidated = true; // ADD THIS LINE
        }

        // Show change alert
        if (changeAmount > 0)
        {
            var denominations = CalculateChangeDenominations(changeAmount);
            var denominationText = string.Join(", ",
                denominations.Where(d => d.Value > 0)
                             .Select(d => $"{d.Value} × €{d.Key}"));

            ShowChangeAlert(change, denominationText);
        }

        currentPaymentInput = "";
        showPaymentPreview = false;
        StateHasChanged();
    }

    private async void ShowChangeAlert(decimal change, string denominationText)
    {
        var message = $"Payment added successfully!\n\n" +
                     $"Amount taken: €{paidAmount:F2}\n" +
                     $"Change due: €{change:F2}";

        if (!string.IsNullOrEmpty(denominationText))
        {
            message += $"\n\nGive change as:\n{denominationText}";
        }

        await JS.InvokeVoidAsync("alert", message);
    }

    void PayExactAmount()
    {
        currentPaymentInput = remainingAmount.ToString("F2");
        AddNormalPayment(remainingAmount);
    }

    // PAYMENT MANAGEMENT
    void RemovePaymentEntry(PaymentEntry entry)
    {
        // Remove the payment
        remainingAmount += entry.Amount;
        paidAmount -= entry.Amount;
        paymentEntries.Remove(entry);

        // Recalculate everything
        RecalculateAll();

        isChangeValidated = false;
        StateHasChanged();
    }

    private void RecalculateAll()
    {
        // Recalculate paid amount from scratch
        paidAmount = paymentEntries.Sum(p => p.Amount);
        remainingAmount = TotalAmount - paidAmount;

        // Recalculate change
        RecalculateChange();
    }

