    decimal GetQuantityFromNumpad(ProductResult product)
    {
        var catalog = ProductCatalogMap?.GetValueOrDefault(product.CatalogProductId);

        if (!decimal.TryParse(
            NumpadValue,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var q) || q <= 0)
        {
            return 1m;
        }

        if (catalog?.SellingMode == SellingMode.Unit)
        {
            if (q != Math.Truncate(q))
                return -1m;

            return q;
        }

        return q;
    }

    // CART OPERATIONS
    async Task AddProduct(ProductResult product, decimal quantity = 1)
    {
        var availableQty = GetAvailableQuantity(product.Id);

        if (availableQty <= 0)
        {
            await ShowError($"Out of Stock {product.CatalogName} !");
            return;
        }

        var existingLine = Pos.Lines.FirstOrDefault(l => l.ProductId == product.Id);
        var totalRequested = (existingLine?.Quantity ?? 0) + quantity;

        if (totalRequested > availableQty)
        {
            await ShowError($"Cannot add more of {product.CatalogName} !");

            return;
        }

        var salePrice = product.SalePrice;

        var displayName = product.IsPack && product.PackSize > 1
            ? $"{product.CatalogName} (x{product.PackSize})"
            : product.CatalogName ?? "Unknown Product";

        var catalog = ProductCatalogMap?.GetValueOrDefault(product.CatalogProductId);

        if (catalog == null)
        {
            ShowError($"Catalog not found for {product.CatalogName} !");
            return;
        }

        if (catalog.SellingMode == SellingMode.Unit)
        {
            if (quantity <= 0)
            {
                ShowError($"Quantity must be greater than 0 for {product.CatalogName}.");
                return;
            }

            if (quantity != Math.Truncate(quantity))
            {
                ShowError($"{product.CatalogName} is sold by piece only.");
                return;
            }
        }
        else if (catalog.SellingMode == SellingMode.Weight)
        {
            if (quantity <= 0)
            {
                ShowError($"Weight must be greater than 0 for {product.CatalogName}.");
                return;
            }
        }


        if (existingLine != null)
        {
            existingLine.Quantity += quantity;
        }
        else
        {
            Pos.Lines.Add(new CartLine
            {
                ProductId = product.Id,
                ProductName = displayName,
                BaseSalePrice = salePrice,
                Quantity = quantity,
                TaxRate = product.VatRate,
                IsPack = product.IsPack,
                PackSize = product.PackSize
            });
            Pos.Notify();
        }

        SelectedLine = Pos.Lines.Last();
        _ = FocusBarcodeInput();
    }


    async Task Increment(CartLine line)
    {
        var availableQty = GetAvailableQuantity(line.ProductId);
        var existingInCart = Pos.Lines.Where(l => l.ProductId == line.ProductId).Sum(l => l.Quantity);

        if (existingInCart >= availableQty)
        {
            // await JS.InvokeVoidAsync("alert",
            //     $"⚠️ Cannot add more of {line.ProductName}\n" +
            //     $"Available: {availableQty}\n" +
            //     $"Already in cart: {existingInCart}");

            await ShowError($"Cannot add more of {line.ProductName} !");

            return;
        }

        line.Quantity++;
        Pos.Notify();
        // _ = FocusBarcodeInput();
        await OnAfterRenderAsync(true);

    }

    async Task Decrement(CartLine line)
    {
        if (Pos.Lines.Count == 1 && line.Quantity == 1)
            return;

        if (line.Quantity > 1)
        {
            line.Quantity--;
            return;
        }

        Pos.Lines.Remove(line);

        if (SelectedLine == line)
            SelectedLine = null;

        Pos.Notify();

        await OnAfterRenderAsync(true);

        // _ = FocusBarcodeInput();
    }

    async Task RemoveSelected()
    {
        if (SelectedLine != null)
