    void AddPriceOverride(CartLine line)
    {
        if (decimal.TryParse(NumpadValue, out var price) && price > 0)
        {
            line.Adjustments.Add(new CartAdjustment
            {
                Type = AdjustmentType.PriceOverride,
                Value = price
            });
            NumpadValue = "";
        }
    }

    void AddDiscountPercent(CartLine line)
    {
        if (!decimal.TryParse(
            NumpadValue,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var value))
            return;

        if (value <= 0 || value > 100)
            return;

        RemoveDiscountAdjustments(line);

        line.Adjustments.Add(new CartAdjustment
        {
            Type = AdjustmentType.DiscountPercent,
            Value = value
        });

        NumpadValue = "";
        StateHasChanged();
    }

    void AddDiscountAmount(CartLine line)
    {
        if (!decimal.TryParse(
            NumpadValue,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var value))
            return;

        if (value <= 0)
            return;

        var maxDiscount = line.BaseSalePrice;
        if (value > maxDiscount)
            value = maxDiscount;

        RemoveDiscountAdjustments(line);

        line.Adjustments.Add(new CartAdjustment
        {
            Type = AdjustmentType.DiscountAmount,
            Value = value
        });

        NumpadValue = "";
        StateHasChanged();
    }

    void RemoveDiscountAdjustments(CartLine line)
    {
        line.Adjustments.RemoveAll(a =>
            a.Type == AdjustmentType.DiscountPercent ||
            a.Type == AdjustmentType.DiscountAmount);
    }
