    private void AddPriceOverride(
        CartLine line)
    {
        if (!TryParseNumpad(
                out var value) ||
            value <= 0m)
        {
            _ = ShowErrorAsync(
                "Enter a valid unit price.");

            return;
        }

        line.Adjustments.RemoveAll(adjustment =>
            adjustment.Type ==
                AdjustmentType.PriceOverride);

        line.Adjustments.Add(
            new CartAdjustment(
                AdjustmentType.PriceOverride,
                RoundMoney(value)));

        NumpadValue =
            string.Empty;
    }

    private void AddDiscountPercent(
        CartLine line)
    {
        if (!TryParseNumpad(
                out var value) ||
            value <= 0m ||
            value > 100m)
        {
            _ = ShowErrorAsync(
                "Discount percentage must be between 0 and 100.");

            return;
        }

        RemoveDiscountAdjustments(line);

        line.Adjustments.Add(
            new CartAdjustment(
                AdjustmentType.DiscountPercent,
                RoundPercentage(value)));

        NumpadValue =
            string.Empty;
    }

    private void AddDiscountAmount(
        CartLine line)
    {
        if (!TryParseNumpad(
                out var value) ||
            value <= 0m)
        {
            _ = ShowErrorAsync(
                "Enter a valid discount amount.");

            return;
        }

        if (value >=
            line.PriceBeforeDiscount)
        {
            _ = ShowErrorAsync(
                "The unit discount must be lower than the unit price.");

            return;
        }

        RemoveDiscountAdjustments(line);

        line.Adjustments.Add(
            new CartAdjustment(
                AdjustmentType.DiscountAmount,
                RoundMoney(value)));

        NumpadValue =
            string.Empty;
    }

    private static void RemoveDiscountAdjustments(
        CartLine line)
    {
        line.Adjustments.RemoveAll(adjustment =>
            adjustment.Type ==
                AdjustmentType.DiscountPercent ||
            adjustment.Type ==
                AdjustmentType.DiscountAmount);
    }

