@page "/sales"


@inject IJSRuntime JS
@inject AppState State
@inject ISaleApi SaleApi
@inject IPosApi PosApi
@inject NavigationManager Nav
@inject ILogger<Sales> Logger
@inject PosState Pos
@inject ICashSessionApi CashSessionApi

@if (!string.IsNullOrEmpty(UiAlertMessage))
{
    <div class="alert @UiAlertType">
        <span>@UiAlertMessage</span>
        <button @onclick="ClearAlert">×</button>
    </div>
}

<div class="sale-container" @onclick="FocusBarcodeInput">
    <!-- LEFT COLUMN: Cart & Totals -->
    <div class="sale-left">
        <!-- Header: Sale Info & Customer -->
        <div class="card header-section">
            <div class="sale-info">
                <div>
                    <strong class="title">Sale</strong>
                    <span class="muted">@SaleCount</span>
                </div>
            </div>
            <div class="customer-section">
                <label>Customer</label>
                <button class="customer-select-btn" @onclick="OpenCustomerModal" @onclick:stopPropagation="true">
                    @(SelectedCustomer?.Name ?? "-- Walk-in customer --")
                </button>
            </div>
        </div>

        <!-- Cart Table -->
        <div class="card cart-table">
            @if (Pos.Lines.Count == 0)
            {
                <div class="empty-state">
                    <p>No products added yet</p>
                    <p class="muted">Scan barcode or search products to add them</p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 200px;">Quantity</th>
                            <th>Name</th>
                            <th style="width: 100px;">Price</th>
                            <th style="width: 100px;">Amount</th>
                            <th style="width: 100px;">Tax</th>
                            <th style="width: 80px;">Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Pos.Lines)
                        {
                            var availableQty = GetAvailableQuantity(line.ProductId);
                            var isOverStock = line.Quantity > availableQty;

                            <tr class="@(line == SelectedLine ? "selected" : "") @(isOverStock ? "overstock" : "")"
                                @onclick="() => OnLineClicked(line)"
                                title="@(isOverStock ? $"Only {availableQty} available" : "")">
                                <td>
                                    <div class="qty-controls">
                                        <button class="qty-btn"
                                                @onclick="() => Decrement(line)"
                                                @onclick:stopPropagation="true">
                                            −
                                        </button>
                                        <span class="qty-value">@line.Quantity</span>
                                        <button class="qty-btn"
                                                @onclick="() => Increment(line)"
                                                @onclick:stopPropagation="true">
                                            +
                                        </button>
                                    </div>
                                    @if (isOverStock)
                                    {
                                        <div class="stock-warning" style="color: #dc3545; font-size: 11px; margin-top: 3px;">
                                            ⚠️ Only @availableQty available
                                        </div>
                                    }
                                </td>
                                <td>
                                    @line.ProductName
                                    @if (line.IsPack && line.PackSize > 1)
                                    {
                                        <span style="font-size: 11px; color: #6c757d; display: block;">
                                            📦 Pack — @line.Quantity × @line.PackSize units = @(line.Quantity* line.PackSize) units total
                                        </span>
                                    }
                                    @if (availableQty > 0 && !isOverStock)
                                    {
                                        <span class="stock-available" style="font-size: 11px; color: #28a745;">
                                            (Stock: @availableQty packs)
                                        </span>
                                    }
                                </td>
                                <td class="text-right">€@line.EffectiveUnitPrice.ToString("F2")</td>
                                <td class="text-right">€@line.Amount.ToString("F2")</td>
                                <td class="text-right">€@line.TaxAmount.ToString("F2")</td>
                                <td class="text-right">@(line.TaxRate)%</td>
                            </tr>

                            @if (line.IsExpanded)
                            {
                                @foreach (var adj in line.Adjustments)
                                {
                                    <tr class="sub-line">
                                        <td></td>
                                        <td colspan="5">
                                            <span class="adjustment">@adj.Display</span>
                                            <button>
                                                <span class="delete-icon" @onclick="() => RemoveAdjustment(line, adj)">
                                                    ×
                                                </span>
                                            </button>
                                        </td>
                                    </tr>
                                }

                                <tr class="sub-actions">
                                    <td></td>
                                    <td colspan="5">
                                        <button class="btn small"
                                                @onclick="() => AddPriceOverride(line)">
                                            Change price
                                        </button>
                                        <button class="btn small"
                                                @onclick="() => AddDiscountPercent(line)">
                                            Discount %
                                        </button>
                                        <button class="btn small"
                                                @onclick="() => AddDiscountAmount(line)">
                                            Discount €
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Totals Row -->
        <div class="totals-row">
            <div class="total-item">
                <span class="total-label">Total Qty</span>
                <strong class="total-value primary">@TotalQuantity</strong>
            </div>
            <div class="total-item">
                <span class="total-label">Number of Lines</span>
                <strong class="total-value primary">@Pos.Lines.Count</strong>
            </div>
            <div class="total-item">
                <span class="total-label">Total</span>
                <strong class="total-value primary">€@TotalAmount.ToString("F2")</strong>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="actions-footer">
            <div class="tax-info">
                <strong>Taxes: €@TotalTax.ToString("F2")</strong>
            </div>
            <button class="btn btn-warning" @onclick="LoadPendingTickets">
                Pending Tickets
            </button>
            <button class="btn btn-warning"
                    @onclick="SavePending"
                    disabled="@(Pos.Lines.Count == 0 || IsSaving)">
                Pending
            </button>
            <button class="btn btn-secondary" @onclick="Reset">Reset</button>
            <button class="btn btn-secondary" @onclick="RemoveSelected" disabled="@(SelectedLine == null)">
                Delete
            </button>
            <button class="btn btn-primary" @onclick="OpenPaymentModal" disabled="@IsSaving">
                @(IsSaving ? "Saving..." : "Complete Sale")
            </button>
            <button class="btn btn-secondary" @onclick="NavigateToDashboard">Close</button>

            @*  <button class="btn btn-secondary" @onclick="OpenCustomerDisplay">
                Open Customer Screen
            </button> *@
        </div>
    </div>

    <!-- RIGHT COLUMN: Product Search & Numpad -->
    <div class="sale-center">
        <!-- Barcode Scanner Section -->
        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Scan barcode or type product code..."
                       @bind="BarcodeInput"
                       @bind:event="oninput"
                       @onkeydown="OnBarcodeKeyDown"
                       @ref="barcodeInputRef"
                       autofocus />
                <span class="search-icon">🔍</span>
            </div>
        </div>

        <!-- Manual Search Section -->
        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Search products by name..."
                       @bind="SearchText"
                       @bind:event="oninput"
                       @bind:after="UpdateFilter" />
                <span class="search-icon">🔍</span>
            </div>
        </div>

        <!-- Products List -->
        <div class="card product-list-container" @onclick="() => FocusBarcodeInput()">
            @if (IsLoadingProducts)
            {
                <div class="loading-state">Loading products...</div>
            }
            else if (filteredProductsCache.Count == 0)
            {
                <div class="empty-state">
                    <p>No products found</p>
                </div>
            }
            else
            {
                <ul class="product-list">
                    @foreach (var product in filteredProductsCache)
                    {
                        var availableQty = GetAvailableQuantity(product.Id);
                        var isOutOfStock = availableQty <= 0;
                        var lowStock = availableQty > 0 && availableQty <= 5;

                        <li class="product-item @(isOutOfStock ? "out-of-stock" : "")"
                            @onclick="() => SelectAndAddProduct(product)"
                            @onclick:stopPropagation="true"
                            title="@(isOutOfStock ? "Out of stock" : $"Available: {availableQty}")">

                            <strong>@product.CatalogName</strong>
                            @*  @if (!string.IsNullOrEmpty(product.CatalogBarcode))
                            {
                                <span class="muted">@product.CatalogBarcode</span>
                            } *@
                            <span class="muted price">€@product.SalePrice.ToString("F2")</span>

                            <!-- Stock indicator -->
                            <span class="stock-indicator @(isOutOfStock ? "out" : lowStock ? "low" : "in")">
                                @if (isOutOfStock)
                                {
                                    <span>Out of stock</span>
                                }
                                else if (lowStock)
                                {
                                    <span>Low: @availableQty</span>
                                }
                                else
                                {
                                    <span>In stock: @availableQty</span>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- Numeric Pad -->
        <div class="card numpad-container">
            <div class="numpad">
                <div class="display">@NumpadValue</div>
                <div class="keys">
                    @foreach (var key in NumpadKeys)
                    {
                        <button class="key-btn" @onclick="() => PressKey(key)">@key</button>
                    }
                    <button class="key-btn clear" @onclick="ClearNumpad">C</button>
                </div>
            </div>
        </div>


    </div>

    <div class="sale-right">
        <div class="card category-panel">
            <div class="category-grid">
                <label class="category-label">Categories</label>
                @foreach (var cat in productCategories)
                {
                    <button class="category-btn @(SelectedCategory?.Id == cat.Id ? "active" : "")"
                            @onclick="() => SelectCategory(cat)">
                        @* <svg class="inv-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg> *@
                        @cat.Name
                    </button>
                }
            </div>
        </div>
    </div>

</div>

<!-- Customer Selection Modal -->
@if (ShowCustomerModal)
{
    <div class="modal-overlay" @onclick="CloseCustomerModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Select Customer</h3>
                <button class="modal-close" @onclick="CloseCustomerModal">×</button>
            </div>

            <div class="modal-body">
                <div class="search-box">
                    <input type="text"
                           class="search-input"
                           placeholder="Search customers..."
                           @bind="CustomerSearchText"
                           @bind:event="oninput"
                           autofocus />
                    <span class="search-icon">🔍</span>
                </div>

                <ul class="customer-list">
                    <li class="customer-item @(TempSelectedCustomer == null ? "selected" : "")"
                        @onclick="() => TempSelectedCustomer = null">
                        <strong>Walk-in Customer</strong>
                        <span class="muted">No customer tracking</span>
                    </li>
                    @if (FilteredCustomers.Count == 0)
                    {
                        <li class="empty-state">No customers found</li>
                    }
                    else
                    {
                        @foreach (var customer in FilteredCustomers)
                        {
                            <li class="customer-item @(TempSelectedCustomer?.Id == customer.Id ? "selected" : "")"
                                @onclick="() => TempSelectedCustomer = customer">
                                <strong>@customer.Name</strong>
                                @if (!string.IsNullOrEmpty(customer.Phone))
                                {
                                    <span class="muted">📞 @customer.Phone</span>
                                }
                                @if (!string.IsNullOrEmpty(customer.Email))
                                {
                                    <span class="muted">✉ @customer.Email</span>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseCustomerModal">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmCustomerSelection">
                    OK
                </button>
            </div>
        </div>
    </div>
}

<!-- PAYMENT MODAL -->
@if (ShowPaymentModal)
{
    <div class="modal-overlay" @onclick="ClosePaymentModal">
        <div class="modal-content payment-modal-right-numpad" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Payment</h3>
                <button class="modal-close" @onclick="ClosePaymentModal">×</button>
            </div>

            <div class="modal-body">
                <div class="payment-layout">
                    <!-- LEFT SIDE: Payment Details -->
                    <div class="payment-left">
                        <!-- TOTAL & PROGRESS -->
                        <div class="payment-summary">
                            <div class="summary-item">
                                <span class="label">Total:</span>
                                <span class="value total">€@TotalAmount.ToString("F2")</span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Paid:</span>
                                <span class="value paid">€@paidAmount.ToString("F2")</span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Remaining:</span>
                                <span class="value remaining">€@remainingAmount.ToString("F2")</span>
                            </div>
                            @if (changeAmount > 0)
                            {
                                <div class="summary-item">
                                    <span class="label">Change:</span>
                                    <span class="value" style="color: #28a745;">€@changeAmount.ToString("F2")</span>
                                </div>
                            }
                        </div>

                        <!-- PROGRESS BAR -->
                        <div class="progress-container">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @(TotalAmount == 0 ? "0" : ((paidAmount / TotalAmount * 100).ToString("F0")))%"></div>
                            </div>
                            <div class="progress-labels">
                                <span>Paid</span>
                                <span>Credit</span>
                            </div>
                        </div>

                        <div class="method-selection">
                            <h4>Payment Method:</h4>
                            <div class="method-buttons">
                                @foreach (PaymentType type in Enum.GetValues(typeof(PaymentType)))
                                {
                                    var isDisabled = type == PaymentType.Credit && SelectedCustomer == null;
                                    <button class="method-btn @(currentPaymentType == type ? "active" : "") @(isDisabled ? "disabled" : "")"
                                            @onclick="@(() => SelectPaymentType(type))"
                                            disabled="@isDisabled">
                                        <span class="method-icon">@GetPaymentTypeIcon(type)</span>
                                        <span class="method-name">@GetPaymentTypeName(type)</span>
                                        @if (isDisabled)
                                        {
                                            <span style="font-size: 10px; display: block; margin-top: 4px; color: #999;">Customer required</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                        <!-- AMOUNT INPUT SECTION -->
                        <div class="amount-input-section">
                            <!-- PREVIEW DU MONTANT SAISI -->
                            @if (showPaymentPreview && !string.IsNullOrEmpty(currentPaymentInput))
                            {
                                <div class="preview-details">
                                    <div class="preview-line">
                                        <span>Amount entered:</span>
                                        <span style="font-weight: 600;">€@currentPaymentInput</span>
                                    </div>

                                    @if (currentPaymentType == PaymentType.Cash && decimal.TryParse(
                                                                currentPaymentInput,
                                                                NumberStyles.Number,
                                                                CultureInfo.InvariantCulture,
                                                                out var amount) && amount > remainingAmount)
                                    {
                                        <div class="preview-line" style="color: #28a745;">
                                            <span>Will take:</span>
                                            <span style="font-weight: 600;">€@remainingAmount.ToString("F2")</span>
                                        </div>
                                        <div class="preview-line total" style="color: #28a745;">
                                            <span>Change to return:</span>
                                            <span style="font-size: 16px; font-weight: 700;">€@((amount - remainingAmount).ToString("F2"))</span>
                                        </div>
                                    }
                                    else if (decimal.TryParse(
                                    currentPaymentInput,
                                    NumberStyles.Number,
                                    CultureInfo.InvariantCulture,
                                    out var amount2) && amount2 < remainingAmount)
                                    {
                                        <div class="preview-line" style="color: #856404;">
                                            <span>Still due after this payment:</span>
                                            <span style="font-size: 16px; font-weight: 700;">€@((remainingAmount - amount2).ToString("F2"))</span>
                                        </div>
                                    }
                                    else if (decimal.TryParse(
                                    currentPaymentInput,
                                    NumberStyles.Number,
                                    CultureInfo.InvariantCulture,
                                    out var amount3) && amount3 == remainingAmount)
                                    {
                                        <div class="preview-line" style="color: #0c5460;">
                                            <span style="text-align: center; width: 100%;">Exact amount - no change needed</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- PAYMENTS LIST -->
                        <div class="payments-list-section">
                            <h4>Payments (@paymentEntries.Count):</h4>
                            @if (paymentEntries.Count == 0)
                            {
                                <div class="no-payments">
                                    <span>No payments added yet</span>
                                </div>
                            }
                            else
                            {
                                <div class="payments-list">
                                    @foreach (var entry in paymentEntries)
                                    {
                                        <div class="payment-item">
                                            <span class="item-icon">@GetPaymentTypeIcon(entry.Type)</span>
                                            <div class="item-details">
                                                <span class="item-type">@GetPaymentTypeName(entry.Type)</span>
                                                <span class="item-time">@entry.Timestamp.ToString("HH:mm")</span>
                                            </div>
                                            @if (entry.Type == PaymentType.Cash && entry.AmountReceived > entry.Amount)
                                            {
                                                <span class="item-amount">
                                                    Reçu: €@entry.AmountReceived.ToString("F2") / Appliqué: €@entry.Amount.ToString("F2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="item-amount">€@entry.Amount.ToString("F2")</span>
                                            }
                                            <button class="item-delete" @onclick="@(() => RemovePaymentEntry(entry))">
                                                ×
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- RIGHT SIDE: Numpad -->
                    <div class="payment-right">
                        <div class="numpad-section">
                            <h4>Amount to Pay:</h4>
                            <div class="amount-display">
                                <span class="currency">€</span>
                                <input type="text"
                                       class="amount-input"
                                       value="@currentPaymentInput"
                                       @oninput="HandlePaymentInput"
                                       placeholder="0.00"
                                       autofocus />
                                <button class="btn-clear" @onclick="ClearPaymentInput" title="Clear">
                                    <span>×</span>
                                </button>
                            </div>
                            <!-- QUICK AMOUNT BUTTONS -->
                            <div class="quick-amount-grid">
                                <button class="quick-btn" @onclick="@(() => SetPaymentAmount(remainingAmount * 0.25m))">
                                    25%
                                </button>
                                <button class="quick-btn" @onclick="@(() => SetPaymentAmount(remainingAmount / 3))">
                                    1/3
                                </button>
                                <button class="quick-btn" @onclick="@(() => SetPaymentAmount(remainingAmount / 2))">
                                    1/2
                                </button>
                                <button class="quick-btn" @onclick="@(() => SetPaymentAmount(remainingAmount))">
                                    Full
                                </button>
                            </div>

                            <!-- NUMPAD -->
                            <div class="numpad-grid">
                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("7"))">7</button>
                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("8"))">8</button>
                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("9"))">9</button>

                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("4"))">4</button>
                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("5"))">5</button>
                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("6"))">6</button>

                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("1"))">1</button>
                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("2"))">2</button>
                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("3"))">3</button>

                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("0"))">0</button>
                                <button class="numpad-btn" @onclick="@(() => PressPaymentKey("."))">.</button>
                                <button class="numpad-btn clear" @onclick="ClearPaymentInput">C</button>
                            </div>

                            <button class="exact-payment-btn"
                                    @onclick="PayExactAmount"
                                    disabled="@(remainingAmount <= 0)">
                                Pay €@remainingAmount.ToString("F2") (Exact)
                            </button>


                        </div>
                    </div>
                </div>
            </div>

            <!-- MODAL FOOTER -->
            <div class="modal-footer">
                <div class="payments-summary">
                    @if (changeAmount > 0)
                    {
                        <div class="summary-badge success">
                            <span style="font-weight: 600;">Change: €@changeAmount.ToString("F2")</span>
                        </div>
                    }
                    else if (remainingAmount > 0 && paidAmount > 0)
                    {
                        <div class="summary-badge warning">
                            <span style="font-weight: 600;">Remaining: €@remainingAmount.ToString("F2")</span>
                        </div>
                    }
                    else if (remainingAmount == TotalAmount)
                    {
                        <div class="summary-badge info">
                            <span>No payments yet</span>
                        </div>
                    }
                    else if (remainingAmount == 0 && changeAmount == 0)
                    {
                        <div class="summary-badge success">
                            <span style="font-weight: 600;">✅ Fully Paid</span>
                        </div>
                    }
                </div>

                <button class="btn btn-secondary" @onclick="ResetPayments" style="margin-right: 8px;">
                    Reset Payments
                </button>
                <button class="btn btn-secondary" @onclick="ClosePaymentModal">
                    Close
                </button>
                <!-- FOOTER : retirez le bouton Complete Sale existant, mettez: -->
                <button class="btn btn-success btn-complete"
                        @onclick="HandleCompleteOrAddPayment"
                        disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>@GetCompleteButtonLabel()</span>
                    }
                </button>
            </div>


        </div>
    </div>
}


@if (ShowPendingModal)
{
    <div class="pending-modal-overlay" @onclick="() => ShowPendingModal = false">
        <div class="pending-modal" @onclick:stopPropagation="true">
            <div class="pending-modal-header">
                <div>
                    <h3>Pending Tickets</h3>
                    <p>Select a ticket to resume the sale</p>
                </div>

                <button class="pending-close-btn"
                        @onclick="() => ShowPendingModal = false">
                    ×
                </button>
            </div>

            <div class="pending-modal-body">
                @if (PendingTickets == null || PendingTickets.Count == 0)
                {
                    <div class="pending-empty">
                        <span>No pending tickets found</span>
                    </div>
                }
                else
                {
                    <div class="pending-ticket-list">
                        @foreach (var sale in PendingTickets)
                        {
                            <div class="pending-ticket-card"
                                 @onclick="() => ResumePending(sale.Id)">
                                <div class="pending-ticket-left">
                                    <span class="pending-ticket-label">Invoice</span>
                                    <strong class="pending-ticket-number">@sale.InvoiceNumber</strong>
                                </div>

                                <div class="pending-ticket-right">
                                    <span class="pending-ticket-label">Total</span>
                                    <strong class="pending-ticket-total">€@sale.TotalAmount.ToString("F2")</strong>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="pending-modal-footer">
                <button class="pending-footer-btn"
                        @onclick="() => ShowPendingModal = false">
                    Close
                </button>
            </div>
        </div>
    </div>
}


@if (ShowCategoryModal)
{
    <div class="pending-modal-overlay" @onclick="CloseCategoryModal">
        <div class="pending-modal" @onclick:stopPropagation="true">

            <div class="pending-modal-header">
                <div>
                    <h3>@SelectedCategory?.Name</h3>
                    <p>Select a product to add</p>
                </div>
                <button class="pending-close-btn" @onclick="CloseCategoryModal">×</button>
            </div>

            <div class="pending-modal-body">
                <div class="search-box" style="margin-bottom: 16px;">
                    <input type="text"
                           class="search-input"
                           placeholder="Search..."
                           @bind="CategorySearch"
                           @bind:event="oninput" />
                    <span class="search-icon">🔍</span>
                </div>

                <div class="pending-ticket-list">

                    @if (FilteredCategoryProducts.Any())
                    {
                        @foreach (var product in FilteredCategoryProducts)
                        {
                            <div class="pending-ticket-card" @onclick="() => OnCategoryProductClick(product)">
                                <div class="pending-ticket-left">
                                    <span class="pending-ticket-label">Product</span>
                                    <strong class="pending-ticket-number">@product.CatalogName</strong>
                                </div>
                                <div class="pending-ticket-right">
                                    <span class="pending-ticket-label">Price</span>
                                    <strong class="pending-ticket-total">€@product.SalePrice.ToString("F2")</strong>
                                </div>
