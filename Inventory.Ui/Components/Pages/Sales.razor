    async Task ResumePending(Guid id)
    {
        var sale = await SaleApi.GetPendingById(id);

        Pos.Lines.Clear();

        foreach (var line in sale.SaleLines)
        {
            var product = ProductMap.GetValueOrDefault(line.ProductId);

            Pos.Lines.Add(new CartLine
            {
                ProductId = line.ProductId,
                ProductName = product?.CatalogName ?? "Unknown",
                Quantity = (int)line.Quantity,
                BaseSalePrice = line.UnitPrice,
                TaxRate = line.VatRate
            });
        }

        SelectedCustomer = sale.CustomerId.HasValue
            ? CustomerMap.GetValueOrDefault(sale.CustomerId.Value)
            : null;

        CurrentPendingSaleId = sale.Id;

        ShowPendingModal = false;
    }

