    private decimal GetAvailableQuantity(Guid productId)
    {
        if (!ProductMap.TryGetValue(productId, out var product))
            return 0;

        // STOCK RÉEL (en unités)
        decimal totalStockUnits;

        if (product.IsPack && product.ComponentProductId.HasValue)
        {
            var unitId = product.ComponentProductId.Value;

            totalStockUnits = StockMap.TryGetValue(unitId, out var s)
                ? s.AvailableQuantity
                : 0;
        }
        else
        {
            totalStockUnits = StockMap.TryGetValue(productId, out var s)
                ? s.AvailableQuantity
                : 0;
        }

        // CONSOMMATION ACTUELLE DU PANIER (EN UNITÉS)
        decimal usedUnits = 0;

        foreach (var line in Pos.Lines.Where(l => l.ProductId != productId))
        {
            if (!ProductMap.TryGetValue(line.ProductId, out var p))
                continue;

            if (p.IsPack && p.ComponentProductId.HasValue)
            {
                var unitId = p.ComponentProductId.Value;

                if (product.IsPack && product.ComponentProductId == unitId ||
                    !product.IsPack && product.Id == unitId)
                {
                    usedUnits += line.Quantity * p.PackSize;
                }
            }
            else
            {
                if (p.Id == productId)
                {
                    usedUnits += line.Quantity;
                }
            }
        }

        var remainingUnits = totalStockUnits - usedUnits;

        if (remainingUnits <= 0)
            return 0;

        // CONVERSION RETOUR
        if (product.IsPack && product.PackSize > 0)
        {
            return Math.Floor(remainingUnits / product.PackSize);
        }

        return remainingUnits;
    }

