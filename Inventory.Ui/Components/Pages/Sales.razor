    // PAYMENT MANAGEMENT
    void RemovePaymentEntry(PaymentEntry entry)
    {
        // Remove the payment
        remainingAmount += entry.Amount;
        paidAmount -= entry.Amount;
        paymentEntries.Remove(entry);

        // Recalculate everything
        RecalculateAll();

        isChangeValidated = false;
        StateHasChanged();
    }

    private void RecalculateAll()
    {
        paidAmount = Math.Round(paymentEntries.Sum(p => p.Amount), 2);
        remainingAmount = Math.Round(Math.Max(0, TotalAmount - paidAmount), 2);
        RecalculateChange();
    }

