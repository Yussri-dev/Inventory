    // CART OPERATIONS
    void AddProduct(ProductResult product, int quantity = 1)
    {
        // Get available quantity from stock
        var availableQty = GetAvailableQuantity(product.Id);

        // Check if product is out of stock
        if (availableQty <= 0)
        {
            // Show error message to user
            JS.InvokeVoidAsync("alert", $"⚠️ {product.CatalogName} is out of stock!");
            return;
        }

        // Check if adding more than available
        var existingLine = Lines.FirstOrDefault(l => l.ProductId == product.Id);
        var totalRequested = (existingLine?.Quantity ?? 0) + quantity;

        if (totalRequested > availableQty)
        {
            // Show error with details
            JS.InvokeVoidAsync("alert",
                $"⚠️ Cannot add {quantity} more of {product.CatalogName}\n" +
                $"Available: {availableQty}\n" +
                $"Already in cart: {existingLine?.Quantity ?? 0}\n" +
                $"Total requested: {totalRequested}");
            return;
        }

        // Use sale price for sales, not purchase price
        var salePrice = product.SalePrice; // Assuming ProductResult has SalePrice property

        if (existingLine != null)
        {
            existingLine.Quantity += quantity;
        }
        else
        {
            Lines.Add(new CartLine
            {
                ProductId = product.Id,
                ProductName = product.CatalogName ?? product.CatalogName ?? "Unknown Product",
                BaseSalePrice = salePrice, // Changed from BasePurchasePrice to BaseSalePrice
                Quantity = quantity,
                TaxRate = product.VatRate
            });
        }

        SelectedLine = Lines.Last();
        _ = FocusBarcodeInput();
    }

    void Increment(CartLine line)
    {
        var availableQty = GetAvailableQuantity(line.ProductId);
        var existingInCart = Lines.Where(l => l.ProductId == line.ProductId).Sum(l => l.Quantity);

        if (existingInCart >= availableQty)
        {
            JS.InvokeVoidAsync("alert",
                $"⚠️ Cannot add more of {line.ProductName}\n" +
                $"Available: {availableQty}\n" +
                $"Already in cart: {existingInCart}");
            return;
        }

        line.Quantity++;
        _ = FocusBarcodeInput();
    }

    void Decrement(CartLine line)
    {
        if (Lines.Count == 1 && line.Quantity == 1)
            return;

        if (line.Quantity > 1)
        {
            line.Quantity--;
            return;
        }

        Lines.Remove(line);

        if (SelectedLine == line)
            SelectedLine = null;

        _ = FocusBarcodeInput();
    }

    void RemoveSelected()
    {
        if (SelectedLine != null)
        {
            Lines.Remove(SelectedLine);
            SelectedLine = null;
        }
        _ = FocusBarcodeInput();
    }

    void Reset()
    {
        Lines.Clear();
        SelectedLine = null;
        SelectedCustomer = null;
        _ = FocusBarcodeInput();
    }

