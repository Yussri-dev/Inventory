    private async Task SavePendingSaleAsync()
    {
        if (IsSaving)
        {
            return;
        }
        if (Lines.Count == 0)
        {
            await ShowErrorAsync(
                "Add at least one product before saving a pending ticket.");

            return;
        }

        try
        {
            IsSaving =
                true;

            var pendingSale =
                BuildLocalSale(
                    includePayments: false);

            var savedSale =
                await LocalSaleService
                    .SavePendingAsync(
                        pendingSale);

            var invoiceNumber =
                savedSale.LocalInvoiceNumber;

            Logger.LogInformation(
                "Local pending sale {InvoiceNumber} saved.",
                invoiceNumber);

            ResetSale();

            await LoadPendingSalesAsync();

            await ShowSuccessAsync(
                $"Pending ticket {invoiceNumber} saved locally.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save the local pending sale.");

            await ShowErrorAsync(
                exception
                    .GetBaseException()
                    .Message);
        }
        finally
        {
            IsSaving =
                false;
        }
