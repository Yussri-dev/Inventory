    private async Task ShowSuccessAsync(
        string message)
    {
        errorMessage =
            null;

        successMessage =
            message;

        await StartToastTimerAsync(
            clearSuccess: true);
    }

    private async Task ShowErrorAsync(
        string message)
    {
        successMessage =
            null;

        errorMessage =
            message;

        await StartToastTimerAsync(
            clearSuccess: false);
    }

    private async Task StartToastTimerAsync(
        bool clearSuccess)
    {
        toastCancellation?.Cancel();
        toastCancellation?.Dispose();

        toastCancellation =
            new CancellationTokenSource();

        var source =
            toastCancellation;

        await InvokeAsync(
            StateHasChanged);

        try
        {
            await Task.Delay(
                3000,
                source.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (!ReferenceEquals(
                toastCancellation,
                source))
        {
            return;
        }

        if (clearSuccess)
        {
            successMessage =
                null;
        }
        else
        {
            errorMessage =
                null;
        }

        await InvokeAsync(
            StateHasChanged);
    }

    private static bool Contains(
        string? source,
        string value)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(
                   value,
                   StringComparison.OrdinalIgnoreCase);
    }

    private static decimal RoundMoney(
        decimal value)
    {
        return Math.Round(
            value,
            2,
            MidpointRounding.AwayFromZero);
    }

    private static decimal RoundQuantity(
        decimal value)
    {
        return Math.Round(
            value,
            3,
            MidpointRounding.AwayFromZero);
    }

    private static decimal RoundPercentage(
        decimal value)
    {
        return Math.Round(
            value,
            2,
            MidpointRounding.AwayFromZero);
    }

    private static string FormatQuantity(
        decimal value)
    {
        return value.ToString(
            "0.###",
            CultureInfo.InvariantCulture);
    }

    private enum PaymentType
    {
        Cash,
        Card,
        Credit
    }

    private enum AdjustmentType
    {
        PriceOverride,
        DiscountPercent,
        DiscountAmount
    }

    private sealed class PaymentEntry
    {
        public PaymentType Type { get; init; }

        public decimal AppliedAmount { get; init; }

        public decimal ReceivedAmount { get; init; }

        public DateTime TimestampUtc { get; init; }
    }

    private sealed class CartAdjustment
    {
        public CartAdjustment(
            AdjustmentType type,
            decimal value)
        {
            Type =
                type;

            Value =
                value;
        }

        public AdjustmentType Type { get; }

        public decimal Value { get; }

        public string Display =>
            Type switch
            {
                AdjustmentType.PriceOverride =>
                    $"Price changed → €{Value:0.00}",

                AdjustmentType.DiscountPercent =>
                    $"Discount → -{Value:0.##}%",

                AdjustmentType.DiscountAmount =>
                    $"Discount → -€{Value:0.00} per unit",

                _ =>
                    string.Empty
            };
    }

    private sealed class CartLine
    {
        public CartLine(
            LocalProduct product)
        {
            Product =
                product;
        }

        public LocalProduct Product { get; }

        public decimal Quantity { get; set; }

        public bool IsExpanded { get; set; }

        public List<CartAdjustment> Adjustments { get; } =
            new();

        public decimal PriceBeforeDiscount
        {
            get
            {
                var priceOverride =
                    Adjustments
                        .LastOrDefault(adjustment =>
                            adjustment.Type ==
                                AdjustmentType.PriceOverride);

                return RoundMoney(
                    priceOverride?.Value ??
                    Product.SalePrice);
            }
        }

        public decimal DiscountPercent =>
            Adjustments
                .LastOrDefault(adjustment =>
                    adjustment.Type ==
                        AdjustmentType.DiscountPercent)
                ?.Value ??
            0m;

        public decimal DiscountAmountPerUnit =>
            Adjustments
                .LastOrDefault(adjustment =>
                    adjustment.Type ==
                        AdjustmentType.DiscountAmount)
                ?.Value ??
            0m;

        public decimal GrossAmountInclVat =>
            RoundMoney(
                Quantity *
                PriceBeforeDiscount);

        public decimal TotalDiscount =>
            RoundMoney(
                Math.Clamp(
                    GrossAmountInclVat *
                    DiscountPercent /
                    100m +
                    DiscountAmountPerUnit *
                    Quantity,
                    0m,
                    GrossAmountInclVat));

        public decimal NetAmountInclVat =>
            RoundMoney(
                GrossAmountInclVat -
                TotalDiscount);

        public decimal NetAmountExclVat
        {
            get
            {
                var divisor =
                    1m +
                    Product.VatRate /
                    100m;

                return divisor > 0m
                    ? RoundMoney(
                        NetAmountInclVat /
                        divisor)
                    : NetAmountInclVat;
            }
        }

        public decimal VatAmount =>
            RoundMoney(
                NetAmountInclVat -
                NetAmountExclVat);

        public decimal StockQuantity =>
            Product.IsPack
                ? RoundQuantity(
                    Quantity *
                    Math.Max(
                        0m,
                        Product.UnitsPerPack))
                : RoundQuantity(
                    Quantity);
    }
}
