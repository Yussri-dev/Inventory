    async Task AddPayment()
    {
        if (remainingAmount <= 0)
            return;

        if (string.IsNullOrWhiteSpace(currentPaymentInput))
            return;

        if (!decimal.TryParse(
            currentPaymentInput,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var amount))
            return;


        if (amount <= 0)
        {

            ShowError($"amount is under 0 !");
            return;
        }

        if (currentPaymentType != PaymentType.Cash && amount > remainingAmount)
        {
            // await JS.InvokeVoidAsync("alert", "Payment exceeds remaining balance.");
            ShowError($"Payment exceeds remaining balance !");

            return;
        }
        showPaymentPreview = false;

        // paiement cash avec rendu monnaie
        if (currentPaymentType == PaymentType.Cash && amount > remainingAmount)
        {
            await AddPaymentWithChange(amount);
        }
        else
        {
            AddNormalPayment(amount);
        }

        if (!ValidatePaymentState())
        {
            errorMessage = "Payment state validation failed.";
            // throw new InvalidOperationException("Payment state validation failed.");
        }
    }

    void AddNormalPayment(decimal amount)
    {
        var paymentEntry = new PaymentEntry
        {
            Type = currentPaymentType,
            Amount = amount,
            AmountReceived = amount,
            Timestamp = DateTime.UtcNow
        };

        paymentEntries.Add(paymentEntry);

        RecalculateAll();

        currentPaymentInput = "";
        showPaymentPreview = false;
        StateHasChanged();
    }

    async Task AddPaymentWithChange(decimal amountGiven)
    {
        var applied = remainingAmount;

        var paymentEntry = new PaymentEntry
        {
            Type = currentPaymentType,
            Amount = applied,
            AmountReceived = amountGiven,
            Timestamp = DateTime.UtcNow
        };

        paymentEntries.Add(paymentEntry);

        RecalculateAll();

        if (SelectedCustomer == null && changeAmount > 0)
        {
            isChangeValidated = true;
        }

        if (changeAmount > 0)
        {
            var denominations = CalculateChangeDenominations(changeAmount);
            var denominationText = string.Join(", ",
                denominations.Where(d => d.Value > 0)
                             .Select(d => $"{d.Value} × €{d.Key}"));

            await ShowChangeAlert(changeAmount, denominationText);
        }

        currentPaymentInput = "";
        showPaymentPreview = false;
        StateHasChanged();
    }

