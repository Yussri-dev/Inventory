    private async Task ResumePendingSaleAsync(
        Guid pendingSaleId)
    {
        try
        {
            var pendingSale =
                await LocalSaleService
                    .GetByIdAsync(
                        pendingSaleId);

            if (pendingSale == null ||
                !string.Equals(
                    pendingSale.Status,
                    "Pending",
                    StringComparison.OrdinalIgnoreCase))
            {
                await ShowErrorAsync(
                    "The pending ticket was not found.");

                return;
            }

            Lines.Clear();
            PaymentEntries.Clear();

            foreach (var saleLine in pendingSale.Lines)
            {
                if (!ProductMap.TryGetValue(
                        saleLine.ProductLocalId,
                        out var product))
                {
                    throw new InvalidOperationException(
                        $"Product '{saleLine.ProductName}' is no longer " +
                        "available locally.");
                }

                var cartLine =
                    new CartLine(product)
                    {
                        Quantity =
                            RoundQuantity(
                                saleLine.Quantity)
                    };

                if (Math.Abs(
                        saleLine.UnitPrice -
                        product.SalePrice) >
                    0.005m)
                {
                    cartLine.Adjustments.Add(
                        new CartAdjustment(
                            AdjustmentType.PriceOverride,
                            RoundMoney(
                                saleLine.UnitPrice)));
                }

                if (saleLine.DiscountPercent > 0m)
                {
                    cartLine.Adjustments.Add(
                        new CartAdjustment(
                            AdjustmentType.DiscountPercent,
                            RoundPercentage(
                                saleLine.DiscountPercent)));
                }
                else if (saleLine.DiscountAmount > 0m &&
                         saleLine.Quantity > 0m)
                {
                    cartLine.Adjustments.Add(
                        new CartAdjustment(
                            AdjustmentType.DiscountAmount,
                            RoundMoney(
                                saleLine.DiscountAmount /
                                saleLine.Quantity)));
                }

                Lines.Add(
                    cartLine);
            }

            SelectedCustomer =
                pendingSale.CustomerLocalId.HasValue &&
                pendingSale.CustomerLocalId.Value != Guid.Empty
                    ? Customers.FirstOrDefault(customer =>
                        customer.Id ==
                            pendingSale.CustomerLocalId.Value)
                    : null;

            CurrentPendingSaleId =
                pendingSale.Id;

            SelectedLine =
                null;

            ShowPendingModal =
                false;

            await ShowSuccessAsync(
                $"Pending ticket {pendingSale.LocalInvoiceNumber} loaded.");

            await FocusBarcodeInput();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to resume pending sale {PendingSaleId}.",
                pendingSaleId);

            await ShowErrorAsync(
                exception
                    .GetBaseException()
                    .Message);
        }
    }

    private async Task DeletePendingSaleAsync(
