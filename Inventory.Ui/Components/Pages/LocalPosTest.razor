@page "/local-pos-test"

@using Inventory.LocalDB.Context
@using Inventory.LocalDB.Models
@using Inventory.LocalDB.Services.Interfaces
@using Microsoft.EntityFrameworkCore

@inject PosLocalDbContext Db
@inject ILocalProductService LocalProductService
@inject ILocalSaleService LocalSaleService
@inject NavigationManager Nav

<div style="padding:24px;max-width:900px;margin:auto;">

    <h2>Offline POS Test</h2>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div style="padding:12px;margin-bottom:16px;background:#d1fae5;color:#065f46;border-radius:8px;">
            @Message
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div style="padding:12px;margin-bottom:16px;background:#fee2e2;color:#991b1b;border-radius:8px;">
            @Error
        </div>
    }

    <div style="display:flex;gap:12px;margin-bottom:20px;">
      @*   <button @onclick="SeedProduct" style="padding:12px 18px;">
            1. Seed Test Product
        </button> *@

        <button @onclick="ScanProduct" style="padding:12px 18px;">
            2. Scan Product
        </button>

        <button @onclick="CreateOfflineSale" style="padding:12px 18px;">
            3. Create Offline Sale
        </button>

        <button @onclick="GoCashSession" style="padding:12px 18px;">
            Cash Session
        </button>
    </div>

    <hr />

    <h3>Test Barcode</h3>
    <input value="@Barcode"
           @oninput="e => Barcode = e.Value?.ToString() ?? string.Empty"
           style="padding:10px;width:300px;" />

    <h3>Scanned Product</h3>

    @if (ScanResult != null)
    {
        <div style="border:1px solid #ddd;padding:16px;border-radius:8px;">
            <p><strong>Name:</strong> @ScanResult.ProductName</p>
            <p><strong>Barcode:</strong> @ScanResult.ProductBarcode</p>
            <p><strong>Price:</strong> €@ScanResult.UnitPrice.ToString("F2")</p>
            <p><strong>VAT:</strong> @ScanResult.VatRate.ToString("F2")%</p>
            <p><strong>Is Pack:</strong> @ScanResult.IsPack</p>
            <p><strong>Stock Quantity To Remove:</strong> @ScanResult.UnitQuantity</p>
        </div>
    }
    else
    {
        <p>No product scanned yet.</p>
    }

    <h3>Local Stock</h3>

    @if (Stock != null)
    {
        <div style="border:1px solid #ddd;padding:16px;border-radius:8px;">
            <p><strong>Product:</strong> @Stock.ProductName</p>
            <p><strong>Quantity:</strong> @Stock.Quantity</p>
            <p><strong>Reserved:</strong> @Stock.ReservedQuantity</p>
            <p><strong>Available:</strong> @Stock.AvailableQuantity</p>
        </div>
    }
    else
    {
        <p>No stock loaded.</p>
    }

    <h3>Last Sale</h3>

    @if (LastSale != null)
    {
        <div style="border:1px solid #ddd;padding:16px;border-radius:8px;">
            <p><strong>Invoice:</strong> @LastSale.LocalInvoiceNumber</p>
            <p><strong>Total:</strong> €@LastSale.TotalAmount.ToString("F2")</p>
            <p><strong>Paid:</strong> €@LastSale.PaidAmount.ToString("F2")</p>
            <p><strong>Change:</strong> €@LastSale.ChangeAmount.ToString("F2")</p>
            <p><strong>Payment Status:</strong> @LastSale.PaymentStatus</p>
            <p><strong>Sync Status:</strong> @LastSale.SyncStatus</p>
        </div>
    }
    else
    {
        <p>No sale created yet.</p>
    }

</div>

