    private async Task ScanProduct()
    {
        ClearMessages();

        try
        {
            ScanResult = await LocalProductService.ResolveBarcodeAsync(Barcode);

            if (ScanResult == null)
            {
                Error = $"No local product found for barcode '{Barcode}'. Click Seed Test Product first.";
                return;
            }

            Message = $"Product scanned locally: {ScanResult.ProductName}";
            await LoadStock();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private async Task CreateOfflineSale()
    {
        ClearMessages();

        try
        {
            if (ScanResult == null)
            {
                await ScanProduct();

                if (ScanResult == null)
                    return;
            }

            var openSession = await Db.CashSessions
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Status == LocalCashSessionStatus.Open);

            if (openSession == null)
            {
                Error = "No open local cash session. Open a cash session first.";
                return;
            }

            var sale = new LocalSale
            {
                Id = Guid.NewGuid(),
                ClientOperationId = Guid.NewGuid(),
                LocalInvoiceNumber = string.Empty,
                LocalCashSessionId = openSession.Id,
                CashSessionServerId = openSession.ServerId,
                SaleDateUtc = DateTime.UtcNow,
                Status = LocalSaleStatus.Completed,
                PaymentStatus = LocalPaymentStatus.Paid,
                SyncStatus = SyncQueueStatus.Pending,
                Notes = "Offline test sale",

                Lines = new List<LocalSaleLine>
                {
                    new LocalSaleLine
                    {
                        Id = Guid.NewGuid(),

                        ProductLocalId = ScanResult.ProductLocalId,
                        ProductServerId = ScanResult.ProductServerId,

                        ProductName = ScanResult.ProductName,
                        ProductBarcode = ScanResult.ProductBarcode,

                        UnitProductLocalId = ScanResult.UnitProductLocalId,
                        UnitProductServerId = ScanResult.UnitProductServerId ?? Guid.Empty,

                        Quantity = 1,
                        UnitQuantity = ScanResult.UnitQuantity,

                        IsPack = ScanResult.IsPack,
                        UnitsPerPack = ScanResult.UnitQuantity,

                        UnitPrice = ScanResult.UnitPrice,
                        VatRate = ScanResult.VatRate,
                        DiscountPercent = 0,
                        DiscountAmount = 0,
                        UnitCostPrice = ScanResult.PurchasePrice,

                        Notes = "Offline test line"
                    }
                },

                Payments = new List<LocalPayment>
                {
                    new LocalPayment
                    {
                        Id = Guid.NewGuid(),
                        Method = "Cash",
                        Amount = ScanResult.UnitPrice,
                        PaidAtUtc = DateTime.UtcNow,
                        Notes = "Offline test cash payment",
                        SyncStatus = SyncQueueStatus.Pending
                    }
                }
            };

            LastSale = await LocalSaleService.CreateAsync(sale);

            Message = $"Offline sale created: {LastSale.LocalInvoiceNumber}";

            await LoadStock();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private async Task LoadStock()
    {
        Stock = await Db.Stocks
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.ProductBarcode == Barcode);
    }

    private void GoCashSession()
    {
        Nav.NavigateTo("/cashSessions");
    }

    private void ClearMessages()
    {
        Error = null;
        Message = null;
    }
}