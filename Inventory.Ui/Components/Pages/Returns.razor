@code {
    // STATE
    List<ReturnCartLine> ReturnLines = new();
    List<SaleResult> SearchedSales = new();
    List<SaleLineWithReturnsResult> OriginalSaleLines = new();
    Dictionary<Guid, string> ProductNames = new(); // Cache for product names

    SaleResult? OriginalSale;
    ReturnCartLine? SelectedReturnLine;

    string SaleSearchText = string.Empty;
    string RefundNotes = string.Empty;

    bool IsSaving;
    bool IsSearchingSales;
    bool ShowRefundModal;

    RefundMethod CurrentRefundMethod = RefundMethod.Cash;

    ElementReference saleSearchInputRef;

    private ReturnReceiptModel returnReceipt = new();

    readonly string[] ReturnReasons = new[]
    {
        "Defective",
        "Wrong Item",
        "Changed Mind",
        "Not as Described",
        "Damaged",
        "Other"
    };

    // COMPUTED PROPERTIES
    decimal TotalReturnQuantity => ReturnLines.Sum(l => l.Quantity);
    decimal TotalRefundAmount => ReturnLines.Sum(l => l.Amount);
    decimal TotalRefundTax => ReturnLines.Sum(l => l.TaxAmount);

    // INIT
    protected override async Task OnInitializedAsync()
    {
        await FocusSaleSearchInput();
    }

    // SALE SEARCH
    async Task OnSaleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(SaleSearchText))
        {
            await SearchSales();
        }
    }

    async Task SearchSales()
    {
        if (string.IsNullOrWhiteSpace(SaleSearchText))
            return;

        IsSearchingSales = true;
        StateHasChanged();

        try
        {
            var result = await SaleApi.Search(new SaleQuery
            {
                Search = SaleSearchText.Trim(),
                PageSize = 10
            });

            SearchedSales = result.Items.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error searching sales: {ex.Message}");
        }
        finally
        {
            IsSearchingSales = false;
            StateHasChanged();
        }
    }

    async Task SelectSale(SaleResult sale)
    {
        try
        {
            // Load full sale details
            var fullSale = await SaleApi.GetById(sale.Id);
            OriginalSale = fullSale;

            // Get sale lines - you may need to call a separate endpoint depending on your API
            // Assuming SaleApi has a method to get lines by sale ID
            // If not, you may need to create one or modify this
            try
            {
                // Option 1: If your SaleResult includes Lines
                // OriginalSaleLines = new List<SaleLineWithReturnsResult>(); // Replace with actual line loading

                // Option 2: If you need to call SaleLineApi separately
                var lines = await SaleLineApi.GetBySaleWithReturnsAsync(sale.Id);

                OriginalSaleLines = lines;

                // var saleLines = await SaleLineApi.GetAllAsync();
                // OriginalSaleLines = saleLines.ToList();

                // For now, we'll assume you need to implement this
                // await JS.InvokeVoidAsync("alert", "Note: Sale line loading needs to be implemented based on your API structure");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading sale lines: {ex.Message}");
            }

            // Load product names for the lines
            await LoadProductNames();

            // Clear existing return lines
            ReturnLines.Clear();
            SelectedReturnLine = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sale: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error loading sale details: {ex.Message}");
        }
    }

    async Task LoadProductNames()
    {
        foreach (var line in OriginalSaleLines)
        {
            if (!ProductNames.ContainsKey(line.ProductId))
            {
                try
                {
                    var product = await ProductApi.GetById(line.ProductId);
                    ProductNames[line.ProductId] = product.CatalogName;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading product {line.ProductId}: {ex.Message}");
                    ProductNames[line.ProductId] = $"Product {line.ProductId}";
                }
            }
        }
    }

    string GetProductName(Guid productId)
    {
        return ProductNames.TryGetValue(productId, out var name) ? name : $"Product {productId}";
    }

    // RETURN CART OPERATIONS
    void AddToReturn(SaleLineWithReturnsResult saleLine)
    {
        if (saleLine.AvailableQuantity <= 0)
            return;

        var existingLine = ReturnLines.FirstOrDefault(l => l.SaleLineId == saleLine.Id);

        if (existingLine != null)
        {
            SelectedReturnLine = existingLine;
            return;
        }

        ReturnLines.Add(new ReturnCartLine
        {
            SaleLineId = saleLine.Id,
            ProductId = saleLine.ProductId,
            ProductName = GetProductName(saleLine.ProductId),
            UnitPrice = saleLine.UnitPrice,
            TaxRate = saleLine.VatRate,
            Quantity = 1,
            MaxQuantity = (int)saleLine.AvailableQuantity,
            Reason = string.Empty
        });
    }


    // void AddAllToReturn()
    // {
    //     foreach (var saleLine in OriginalSaleLines)
    //     {
    //         if (!IsLineInReturn(saleLine))
    //         {
    //             ReturnLines.Add(new ReturnCartLine
    //             {
    //                 SaleLineId = saleLine.Id,
    //                 ProductId = saleLine.ProductId,
    //                 ProductName = GetProductName(saleLine.ProductId),
    //                 UnitPrice = saleLine.UnitPrice,
    //                 TaxRate = saleLine.VatRate,
    //                 Quantity = (decimal)saleLine.Quantity,
    //                 MaxQuantity = (decimal)saleLine.Quantity,
    //                 Reason = string.Empty
    //             });
    //         }
    //     }
    //     StateHasChanged();

    // }

    void AddAllToReturn()
    {
        foreach (var saleLine in OriginalSaleLines)
        {
            if (saleLine.AvailableQuantity <= 0)
                continue;

            if (IsLineInReturn(saleLine))
                continue;

            ReturnLines.Add(new ReturnCartLine
            {
                SaleLineId = saleLine.Id,
                ProductId = saleLine.ProductId,
                ProductName = GetProductName(saleLine.ProductId),
                UnitPrice = saleLine.UnitPrice,
                TaxRate = saleLine.VatRate,
                Quantity = (int)saleLine.AvailableQuantity,
                MaxQuantity = (int)saleLine.AvailableQuantity,
                Reason = string.Empty
            });
        }
        // StateHasChanged();
    }


    bool IsLineInReturn(SaleLineWithReturnsResult saleLine)
    {
        return ReturnLines.Any(r => r.SaleLineId == saleLine.Id);
    }

    void IncrementReturn(ReturnCartLine line)
    {
        if (line.Quantity < line.MaxQuantity)
        {
            line.Quantity++;
            StateHasChanged();
        }
    }

    void DecrementReturn(ReturnCartLine line)
    {
        if (line.Quantity > 1)
        {
            line.Quantity--;
        }
        else
        {
            ReturnLines.Remove(line);
            if (SelectedReturnLine == line)
                SelectedReturnLine = null;
        }

        StateHasChanged();
    }

    void OnReturnLineClicked(ReturnCartLine line)
    {
        SelectedReturnLine = line;
        StateHasChanged();
    }

    void RemoveSelectedReturnLine()
    {
        if (SelectedReturnLine != null)
        {
            ReturnLines.Remove(SelectedReturnLine);
            SelectedReturnLine = null;
            StateHasChanged();
        }
    }

    void ResetReturn()
    {
        ReturnLines.Clear();
        SelectedReturnLine = null;
        OriginalSale = null;
        OriginalSaleLines.Clear();
        SearchedSales.Clear();
        SaleSearchText = string.Empty;
        ProductNames.Clear();
        StateHasChanged();
        _ = FocusSaleSearchInput();
    }

    // REFUND MODAL
    void OpenRefundModal()
    {
        if (ReturnLines.Count == 0)
            return;

        ShowRefundModal = true;
        CurrentRefundMethod = RefundMethod.Cash;
        RefundNotes = string.Empty;
        StateHasChanged();
    }

    void CloseRefundModal()
    {
        ShowRefundModal = false;
        StateHasChanged();
    }

    bool HasMissingReasons()
    {
        return ReturnLines.Any(l => string.IsNullOrWhiteSpace(l.Reason));
    }


    // COMPLETE REFUND
    async Task CompleteRefund()
    {
        if (HasMissingReasons())
        {
            await JS.InvokeVoidAsync("alert", "Please select a reason for all items.");
            return;
        }

        if (CurrentRefundMethod == RefundMethod.Original)
        {
            await JS.InvokeVoidAsync("alert", "Original payment method refunds are not currently supported. Please select Cash, Card, Credit, or Exchange.");
            return;
        }
        IsSaving = true;
        StateHasChanged();

        try
        {
            var returnNumber = await GenerateReturnNumber();
            var request = new CreateCompleteReturnRequest
            {
                SaleId = OriginalSale!.Id,
                ReturnDate = DateTime.UtcNow,
                RefundType = CurrentRefundMethod,
                Lines = ReturnLines.Select(l => new ReturnLineItem
                {
                    ProductId = l.ProductId,
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice,
                    VatRate = l.TaxRate,
                    Reason = l.Reason,
                    RestockItem = l.RestockItem
                }).ToList()
            };


            var result = await ReturnApi.CreateComplete(request);

            // Create receipt
            var receiptData = new ReturnReceiptModel
            {
                ReturnNumber = result.ReturnNumber ?? "N/A",
                OriginalSaleNumber = OriginalSale.InvoiceNumber,
                Date = result.ReturnDate,
                Total = TotalRefundAmount,
                Tax = TotalRefundTax,
                RefundMethod = GetRefundMethodName(CurrentRefundMethod),
                Notes = RefundNotes,
                Lines = ReturnLines.Select(l => new ReturnReceiptLine
                {
                    Name = l.ProductName,
                    Quantity = l.Quantity,
                    UnitPrice = l.UnitPrice,
                    Amount = l.Amount,
                    Reason = l.Reason
                }).ToList()
            };

            await PrintReturnReceipt(receiptData);

            await JS.InvokeVoidAsync("alert", $"Return processed successfully!\nRefund: €{TotalRefundAmount:F2}");

            ResetReturn();
            CloseRefundModal();
        }
        catch (ValidationApiException ex)
        {
            var errors = ex.Content?.Errors;
            var message = "Validation failed:\n";
            
            if (errors != null)
            {
                foreach (var error in errors)
                {
                    message += $"- {error.Key}: {string.Join(", ", error.Value)}\n";
                }
            }
            else
            {
                message += ex.Message;
            }

            Console.WriteLine($"Validation error completion return: {message}");
            await JS.InvokeVoidAsync("alert", message);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error completing return: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error processing return: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    // UTILITY METHODS
    string GetRefundMethodIcon(RefundMethod type)
    {
        return type switch
        {
            RefundMethod.Cash => "💵",
            RefundMethod.Card => "💳",
            RefundMethod.Credit => "📝",
            RefundMethod.Exchange => "🔄",
            RefundMethod.Original => "🔙",
            _ => "💰"
        };
    }

    string GetRefundMethodName(RefundMethod type)
    {
        return type switch
        {
            RefundMethod.Cash => "Cash",
            RefundMethod.Card => "Card",
            RefundMethod.Credit => "Store Credit",
            RefundMethod.Exchange => "Exchange",
            RefundMethod.Original => "Original Payment",
            _ => "Other"
        };
    }

    async Task<string> GenerateReturnNumber()
    {
        // Generate a unique return number based on timestamp
        // Format: RET-YYYYMMDD-HHMMSS
        return $"RET-{DateTime.Now:yyyyMMdd-HHmmss}";
    }

    string BuildReturnReason()
    {
        var reasons = new List<string>();

        // Add refund method
        reasons.Add($"Refund Method: {GetRefundMethodName(CurrentRefundMethod)}");

        // Add user notes if any
        if (!string.IsNullOrWhiteSpace(RefundNotes))
        {
            reasons.Add($"Notes: {RefundNotes}");
        }

        // Add summary of item reasons
        var reasonGroups = ReturnLines
            .GroupBy(l => l.Reason)
            .Select(g => $"{g.Key}: {g.Count()} item(s)");

        if (reasonGroups.Any())
        {
            reasons.Add($"Items: {string.Join(", ", reasonGroups)}");
        }

        return string.Join(" | ", reasons);
    }

    void NavigateToDashboard()
    {
        Navigation.NavigateTo("/");
    }

    async Task FocusSaleSearchInput()
    {
        try
        {
            await Task.Delay(100); // Small delay to ensure DOM is ready
            await saleSearchInputRef.FocusAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Focus error: {ex.Message}");
            // Silently fail - focus is not critical
        }
    }

    async Task PrintReturnReceipt(ReturnReceiptModel receipt)
    {
        this.returnReceipt = receipt;
        await JS.InvokeVoidAsync("printReceipt");
    }

    // MODELS
    class ReturnCartLine
    {
        public Guid SaleLineId { get; set; }
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal Quantity { get; set; }
        public decimal MaxQuantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TaxRate { get; set; }
        public string Reason { get; set; } = "";
        public bool RestockItem { get; set; } = true; // Default to true

        public decimal Amount => Quantity * UnitPrice;
        public decimal TaxAmount => Amount * (TaxRate / 100);
    }

    class ReturnReceiptModel
    {
        public string ReturnNumber { get; set; } = "";
        public string OriginalSaleNumber { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal Total { get; set; }
        public decimal Tax { get; set; }
        public string RefundMethod { get; set; } = "";
        public string Notes { get; set; } = "";
        public List<ReturnReceiptLine> Lines { get; set; } = new();
    }

    class ReturnReceiptLine
    {
        public string Name { get; set; } = "";
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal Amount { get; set; }
        public string Reason { get; set; } = "";
    }
}