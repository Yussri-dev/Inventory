@page "/returns"
@using Inventory.Dto.Enums
@using Inventory.Dto.Receipts
@using Inventory.Dto.SaleLines.Results
@using Inventory.Dto.Sales.Results
@using Inventory.Dto.Returns.Requests

@inject IJSRuntime JS
@inject IProductApi ProductApi
@inject ISaleApi SaleApi
@inject ISaleLineApi SaleLineApi
@inject IReturnApi ReturnApi
@inject ICustomerApi CustomerApi
@inject NavigationManager Navigation

<div class="sale-container">
    <!-- LEFT COLUMN: Return Cart & Totals -->
    <div class="sale-left" @onclick="() => FocusSaleSearchInput()">
        <!-- Header: Return Info -->
        <div class="card header-section">
            <div class="sale-info">
                <div>
                    <strong class="title">Return</strong>
                    <span class="muted">Lines: @ReturnLines.Count</span>
                </div>
            </div>
            @if (OriginalSale != null)
            {
                <div class="customer-section">
                    <label>Original Sale</label>
                    <div class="original-sale-info">
                        <strong>@OriginalSale.InvoiceNumber</strong>
                        <span class="muted">@OriginalSale.SaleDate.ToString("dd/MM/yyyy")</span>
                        @if (OriginalSale.CustomerId.HasValue)
                        {
                            <span class="muted">Customer ID: @OriginalSale.CustomerId</span>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Return Cart Table -->
        <div class="card cart-table">
            @if (ReturnLines.Count == 0)
            {
                <div class="empty-state">
                    <p>No items selected for return</p>
                    <p class="muted">Search for a sale and select items to return</p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 150px;">Quantity</th>
                            <th>Product</th>
                            <th style="width: 120px;">Unit Price</th>
                            <th style="width: 120px;">Amount</th>
                            <th style="width: 100px;">Tax</th>
                            <th style="width: 200px;">Reason</th>
                            <th style="width: 100px;">Restock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in ReturnLines)
                        {
                            <tr class="@(line == SelectedReturnLine ? "selected" : "")"
                                @onclick="() => OnReturnLineClicked(line)">
                                <td>
                                    <div class="qty-controls">
                                        <button class="qty-btn"
                                                @onclick="() => DecrementReturn(line)"
                                                @onclick:stopPropagation="true">
                                            −
                                        </button>
                                        <span class="qty-value">@line.Quantity / @line.MaxQuantity</span>
                                        <button class="qty-btn"
                                                @onclick="() => IncrementReturn(line)"
                                                @onclick:stopPropagation="true">
                                            +
                                        </button>
                                    </div>
                                </td>
                                <td>@line.ProductName</td>
                                <td class="text-right">€@line.UnitPrice.ToString("F2")</td>
                                <td class="text-right">€@line.Amount.ToString("F2")</td>
                                <td class="text-right">€@line.TaxAmount.ToString("F2")</td>
                                <td>
                                    <select class="reason-select"
                                            @bind="line.Reason"
                                            @onclick:stopPropagation="true">
                                        <option value="">-- Select reason --</option>
                                        @foreach (var reason in ReturnReasons)
                                        {
                                            <option value="@reason">@reason</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="checkbox"
                                           @bind="line.RestockItem"
                                           @onclick:stopPropagation="true"
                                           title="Restock this item?" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Totals Row -->
        <div class="totals-row">
            <div class="total-item">
                <span class="total-label">Total Qty</span>
                <strong class="total-value primary">@TotalReturnQuantity</strong>
            </div>
            <div class="total-item">
                <span class="total-label">Number of Lines</span>
                <strong class="total-value primary">@ReturnLines.Count</strong>
            </div>
            <div class="total-item">
                <span class="total-label">Refund Total</span>
                <strong class="total-value primary">€@TotalRefundAmount.ToString("F2")</strong>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="actions-footer">
            <div class="tax-info">
                <strong>Tax Refund: €@TotalRefundTax.ToString("F2")</strong>
            </div>
            <button class="btn btn-secondary" @onclick="ResetReturn">Reset</button>
            <button class="btn btn-secondary" @onclick="RemoveSelectedReturnLine" disabled="@(SelectedReturnLine == null)">
                Delete
            </button>
            <button class="btn btn-primary" @onclick="OpenRefundModal" disabled="@(IsSaving || ReturnLines.Count == 0)">
                @(IsSaving ? "Processing..." : "Process Refund")
            </button>
            <button class="btn btn-secondary" @onclick="NavigateToDashboard">Close</button>
        </div>
    </div>

    <!-- RIGHT COLUMN: Sale Search & Products -->
    <div class="sale-right">
        <!-- Sale Search Section -->
        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Search sale by invoice number..."
                       @bind="SaleSearchText"
                       @bind:event="oninput"
                       @onkeydown="OnSaleSearchKeyDown"
                       @ref="saleSearchInputRef"
                       autofocus />
                <span class="search-icon">🔍</span>
            </div>
            @if (IsSearchingSales)
            {
                <div class="loading-state">Searching sales...</div>
            }
        </div>

        <!-- Sale Results -->
        @if (SearchedSales.Count > 0)
        {
            <div class="card sale-results-container">
                <h4>Sales Found (@SearchedSales.Count)</h4>
                <ul class="sale-list">
                    @foreach (var sale in SearchedSales)
                    {
                        <li class="sale-item @(OriginalSale?.Id == sale.Id ? "selected" : "")"
                            @onclick="() => SelectSale(sale)">
                            <div class="sale-item-header">
                                <strong>@sale.InvoiceNumber</strong>
                                <span class="muted">@sale.SaleDate.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            @if (sale.CustomerId.HasValue)
                            {
                                <div class="sale-item-customer">
                                    <span class="muted">Customer ID: @sale.CustomerId</span>
                                </div>
                            }
                            <div class="sale-item-total">
                                <span class="muted">Total: €@sale.TotalAmount.ToString("F2")</span>
                                <span class="muted">Status: @sale.Status</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- Original Sale Products -->
        @if (OriginalSale != null && OriginalSaleLines.Count > 0)
        {
            <div class="card product-list-container">
                <h4>Products from Sale</h4>
                <ul class="product-list">
                    @foreach (var line in OriginalSaleLines)
                    {
                        <li class="product-item @(IsLineInReturn(line) ? "in-cart" : "")"
                            @onclick="() => AddToReturn(line)">
                            <strong>Product ID: @line.ProductId</strong>
                            <div class="product-details">
                                <span class="muted">Qty: @line.AvailableQuantity</span>
                                <span class="muted">€@line.UnitPrice.ToString("F2")</span>
                                <span class="price">Total: €@line.LineAmountInclVat.ToString("F2")</span>
                            </div>
                            @if (IsLineInReturn(line))
                            {
                                <span class="badge">In return</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        else if (OriginalSale != null)
        {
            <div class="card empty-state">
                <p>No products found in this sale</p>
            </div>
        }

        <!-- Quick Actions -->
        @if (OriginalSale != null && OriginalSaleLines.Count > 0)
        {
            <div class="card">
                <button class="btn btn-secondary" style="width: 100%;" @onclick="AddAllToReturn">
                    Add All Products to Return
                </button>
            </div>
        }
    </div>
</div>

<!-- REFUND MODAL -->
@if (ShowRefundModal)
{
    <div class="modal-overlay" @onclick="CloseRefundModal">
        <div class="modal-content refund-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Process Refund</h3>
                <button class="modal-close" @onclick="CloseRefundModal">×</button>
            </div>

            <div class="modal-body">
                <div class="refund-summary">
                    <div class="summary-item">
                        <span class="label">Refund Amount:</span>
                        <span class="value total">€@TotalRefundAmount.ToString("F2")</span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Tax Refund:</span>
                        <span class="value">€@TotalRefundTax.ToString("F2")</span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Items:</span>
                        <span class="value">@TotalReturnQuantity units (@ReturnLines.Count lines)</span>
                    </div>
                </div>

                <div class="refund-method-section">
                    <h4>Refund Method:</h4>
                    <div class="method-buttons">
                        @foreach (RefundMethod type in Enum.GetValues(typeof(RefundMethod)))
                        {
                            @if (type != RefundMethod.Original)
                            {
                                <button class="method-btn @(CurrentRefundMethod == type ? "active" : "")"
                                        @onclick="@(() => CurrentRefundMethod = type)">
                                    <span class="method-icon">@GetRefundMethodIcon(type)</span>
                                    <span class="method-name">@GetRefundMethodName(type)</span>
                                </button>
                            }
                        }
                    </div>
                </div>

                <div class="return-items-section">
                    <h4>Items Being Returned:</h4>
                    <div class="return-items-list">
                        @foreach (var line in ReturnLines)
                        {
                            <div class="return-item">
                                <div class="item-details">
                                    <strong>@line.ProductName</strong>
                                    <span class="muted">Qty: @line.Quantity × €@line.UnitPrice.ToString("F2")</span>
                                </div>
                                <div class="item-reason">
                                    @if (!string.IsNullOrEmpty(line.Reason))
                                    {
                                        <span class="badge reason-badge">@line.Reason</span>
                                    }
                                    else
                                    {
                                        <span class="badge warning">No reason</span>
                                    }
                                </div>
                                <span class="item-amount">€@line.Amount.ToString("F2")</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="notes-section">
                    <label>Additional Notes (Optional):</label>
                    <textarea class="notes-input"
                              @bind="RefundNotes"
                              placeholder="Enter any additional notes about this return..."
                              rows="3"></textarea>
                </div>

                @if (HasMissingReasons())
                {
                    <div class="alert alert-warning">
                        ⚠️ Some items are missing return reasons. Please select a reason for all items.
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseRefundModal">
                    Cancel
                </button>
                <button class="btn btn-success btn-complete"
                        @onclick="CompleteRefund"
                        disabled="@(IsSaving || HasMissingReasons())">
                    @if (IsSaving)
                    {
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Complete Refund €@TotalRefundAmount.ToString("F2")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
