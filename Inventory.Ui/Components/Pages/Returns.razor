    private static decimal RoundMoney(
        decimal value)
    {
        return Math.Round(
            value,
            2,
            MidpointRounding.AwayFromZero);
    }

    private static decimal RoundQuantity(
        decimal value)
    {
        return Math.Round(
            value,
            3,
            MidpointRounding.AwayFromZero);
    }

    private static string FormatQuantity(
        decimal value)
    {
        return value.ToString(
            "0.###",
            System.Globalization.CultureInfo.InvariantCulture);
    }

    private sealed class ReturnCartLine
    {
        public ReturnCartLine(
            LocalReturnableSaleLineResult source)
        {
            Source =
                source;
        }

        public LocalReturnableSaleLineResult Source { get; }

        public decimal Quantity { get; set; }

        public decimal MaximumQuantity =>
            Source.AvailableQuantity;

        public string Reason { get; set; } =
            string.Empty;

        public bool RestockItem { get; set; } =
            true;

        public decimal Amount =>
            RoundMoney(
                Quantity *
                Source.EffectiveUnitPrice);

        public decimal TaxAmount
        {
            get
            {
                if (Source.VatRate <=
                    0m)
                {
                    return 0m;
                }

                var amountExclVat =
                    Amount /
                    (1m + Source.VatRate / 100m);

                return RoundMoney(
                    Amount -
                    amountExclVat);
            }
        }
    }

    private sealed class ReturnReceiptModel
    {
        public string ReturnNumber { get; set; } =
            string.Empty;

        public string OriginalSaleNumber { get; set; } =
            string.Empty;

        public DateTime Date { get; set; }

        public decimal Total { get; set; }

        public decimal Tax { get; set; }

        public string RefundMethod { get; set; } =
            string.Empty;

        public string Notes { get; set; } =
            string.Empty;

        public List<ReturnReceiptLine> Lines { get; set; } =
            new();
    }

    private sealed class ReturnReceiptLine
    {
        public string Name { get; set; } =
            string.Empty;

        public decimal Quantity { get; set; }

        public decimal UnitPrice { get; set; }

        public decimal Amount { get; set; }

        public string Reason { get; set; } =
            string.Empty;
    }
