@page "/returns"

@using Inventory.Dto.Enums
@using Inventory.LocalDB.Models
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.LocalDB.Services.Results

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ILocalReturnService LocalReturnService
@inject IJSRuntime JS
@inject AppState State
@inject NavigationManager Navigation
@inject ILogger<Returns> Logger

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="toast-success">
        <span>@SuccessMessage</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="toast-error">
        <span>@ErrorMessage</span>
    </div>
}

<div class="sale-container">

    <!-- LEFT: RETURN CART -->
    <div class="sale-left"
         @onclick="FocusSaleSearchInputAsync">

        <div class="card header-section">
            <div class="sale-info">
                <div>
                    <strong class="title">Local return</strong>

                    <span class="muted">
                        Lines: @ReturnLines.Count
                    </span>
                </div>
            </div>

            @if (OriginalSale != null)
            {
                <div class="customer-section">
                    <label>Original sale</label>

                    <div class="original-sale-info">
                        <strong>
                            @OriginalSale.LocalInvoiceNumber
                        </strong>

                        @if (!string.IsNullOrWhiteSpace(
                                OriginalSale.ServerInvoiceNumber))
                        {
                            <span class="muted">
                                Server:
                                @OriginalSale.ServerInvoiceNumber
                            </span>
                        }

                        <span class="muted">
                            @OriginalSale.SaleDateUtc
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm")
                        </span>

                        @if (!string.IsNullOrWhiteSpace(
                                OriginalSale.CustomerName))
                        {
                            <span class="muted">
                                Customer:
                                @OriginalSale.CustomerName
                            </span>
                        }

                        @if (!OriginalSale.ServerSaleId.HasValue)
                        {
                            <span class="badge warning">
                                Sale waiting for synchronization
                            </span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="card cart-table">
            @if (ReturnLines.Count == 0)
            {
                <div class="empty-state">
                    <p>No items selected for return</p>

                    <p class="muted">
                        Search a local sale and select its products.
                    </p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width:180px;">Quantity</th>
                            <th>Product</th>
                            <th style="width:110px;">Unit price</th>
                            <th style="width:110px;">Amount</th>
                            <th style="width:100px;">VAT</th>
                            <th style="width:190px;">Reason</th>
                            <th style="width:90px;">Restock</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in ReturnLines)
                        {
                            <tr class="@(ReferenceEquals(
                                    line,
                                    SelectedReturnLine)
                                    ? "selected"
                                    : string.Empty)"
                                @onclick="() => SelectReturnLine(line)">

                                <td>
                                    <div class="qty-controls">
                                        <button type="button"
                                                class="qty-btn"
                                                @onclick="() => DecrementReturn(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            −
                                        </button>

                                        <span class="qty-value">
                                            @FormatQuantity(line.Quantity)
                                            /
                                            @FormatQuantity(line.MaximumQuantity)
                                        </span>

                                        <button type="button"
                                                class="qty-btn"
                                                @onclick="() => IncrementReturn(line)"
                                                @onclick:stopPropagation="true"
                                                disabled="@IsSaving">
                                            +
                                        </button>
                                    </div>
                                </td>

                                <td>
                                    @line.Source.ProductName

                                    @if (line.Source.IsPack)
                                    {
                                        <span class="muted"
                                              style="display:block;font-size:11px;">
                                            Pack ×
                                            @FormatQuantity(
                                                line.Source.UnitsPerPack)
                                            stock units
                                        </span>
                                    }
                                </td>

                                <td class="text-right">
                                    €@line.Source.EffectiveUnitPrice.ToString("F2")
                                </td>

                                <td class="text-right">
                                    €@line.Amount.ToString("F2")
                                </td>

                                <td class="text-right">
                                    €@line.TaxAmount.ToString("F2")
                                </td>

                                <td>
                                    <select class="reason-select"
                                            @bind="line.Reason"
                                            @onclick:stopPropagation="true"
                                            disabled="@IsSaving">

                                        <option value="">
                                            -- Select reason --
                                        </option>

                                        @foreach (var reason in ReturnReasons)
                                        {
                                            <option value="@reason">
                                                @reason
                                            </option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input type="checkbox"
                                           @bind="line.RestockItem"
                                           @onclick:stopPropagation="true"
                                           disabled="@IsSaving"
                                           title="Restock this item?" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="totals-row">
            <div class="total-item">
                <span class="total-label">Total quantity</span>

                <strong class="total-value primary">
                    @FormatQuantity(TotalReturnQuantity)
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Number of lines</span>

                <strong class="total-value primary">
                    @ReturnLines.Count
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Refund total</span>

                <strong class="total-value primary">
                    €@TotalRefundAmount.ToString("F2")
                </strong>
            </div>
        </div>

        <div class="actions-footer">
            <div class="tax-info">
                <strong>
                    VAT refund:
                    €@TotalRefundTax.ToString("F2")
                </strong>
            </div>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="ResetReturn"
                    disabled="@IsSaving">
                Reset
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="RemoveSelectedReturnLine"
                    disabled="@(IsSaving ||
                                SelectedReturnLine == null)">
                Delete
            </button>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="OpenRefundModal"
                    disabled="@(IsSaving ||
                                ReturnLines.Count == 0)">
                Process refund
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="NavigateToDashboard"
                    disabled="@IsSaving">
                Close
            </button>
        </div>
    </div>

    <!-- RIGHT: LOCAL SALE SEARCH -->
    <div class="sale-right">

        <div class="card search-section">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Search local sale by invoice..."
                       @bind="SaleSearchText"
                       @bind:event="oninput"
                       @onkeydown="OnSaleSearchKeyDown"
                       @ref="saleSearchInputRef"
                       disabled="@IsBusy"
                       autofocus />

                <span class="search-icon">🔍</span>
            </div>

            @if (IsSearchingSales)
            {
                <div class="loading-state">
                    Searching local sales...
                </div>
            }
        </div>

        @if (SearchedSales.Count > 0)
        {
            <div class="card sale-results-container">
                <h4>
                    Local sales found (@SearchedSales.Count)
                </h4>

                <ul class="sale-list">
                    @foreach (var sale in SearchedSales)
                    {
                        <li class="sale-item @(OriginalSale?.LocalSaleId ==
                                                sale.LocalSaleId
                                                ? "selected"
                                                : string.Empty)"
                            @onclick="() => SelectSaleAsync(sale.LocalSaleId)">

                            <div class="sale-item-header">
                                <strong>
                                    @sale.LocalInvoiceNumber
                                </strong>

                                <span class="muted">
                                    @sale.SaleDateUtc
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                    sale.CustomerName))
                            {
                                <div class="sale-item-customer">
                                    <span class="muted">
                                        @sale.CustomerName
                                    </span>
                                </div>
                            }

                            <div class="sale-item-total">
                                <span class="muted">
                                    Total:
                                    €@sale.TotalAmount.ToString("F2")
                                </span>

                                <span class="muted">
                                    Returnable lines:
                                    @sale.Lines.Count
                                </span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (OriginalSale != null &&
             OriginalSale.Lines.Count > 0)
        {
            <div class="card product-list-container">
                <h4>Returnable products</h4>

                <ul class="product-list">
                    @foreach (var line in OriginalSale.Lines)
                    {
                        <li class="product-item @(IsLineInReturn(line)
                                ? "in-cart"
                                : string.Empty)"
                            @onclick="() => AddToReturn(line)">

                            <strong>
                                @line.ProductName
                            </strong>

                            <div class="product-details">
                                <span class="muted">
                                    Sold:
                                    @FormatQuantity(line.SoldQuantity)
                                </span>

                                <span class="muted">
                                    Already returned:
                                    @FormatQuantity(line.ReturnedQuantity)
                                </span>

                                <span class="muted">
                                    Available:
                                    @FormatQuantity(line.AvailableQuantity)
                                </span>

                                <span class="muted">
                                    €@line.EffectiveUnitPrice.ToString("F2")
                                </span>
                            </div>

                            @if (IsLineInReturn(line))
                            {
                                <span class="badge">
                                    In return
                                </span>
                            }
                        </li>
                    }
                </ul>
            </div>

            <div class="card">
                <button type="button"
                        class="btn btn-secondary"
                        style="width:100%;"
                        @onclick="AddAllToReturn"
                        disabled="@IsSaving">
                    Add all returnable products
                </button>
            </div>
        }
        else if (OriginalSale != null)
        {
            <div class="card empty-state">
                <p>
                    No remaining product can be returned from this sale.
                </p>
            </div>
        }
    </div>
</div>

@if (ShowRefundModal)
{
    <div class="modal-overlay"
         @onclick="CloseRefundModal">

        <div class="modal-content refund-modal"
             @onclick:stopPropagation="true">

            <div class="modal-header">
                <h3>Process local refund</h3>

                <button type="button"
                        class="modal-close"
                        @onclick="CloseRefundModal"
                        disabled="@IsSaving">
                    ×
                </button>
            </div>

            <div class="modal-body">
                <div class="refund-summary">
                    <div class="summary-item">
                        <span class="label">Refund amount:</span>

                        <span class="value total">
                            €@TotalRefundAmount.ToString("F2")
                        </span>
                    </div>

                    <div class="summary-item">
                        <span class="label">VAT refund:</span>

                        <span class="value">
                            €@TotalRefundTax.ToString("F2")
                        </span>
                    </div>

                    <div class="summary-item">
                        <span class="label">Items:</span>

                        <span class="value">
                            @FormatQuantity(TotalReturnQuantity)
                            (@ReturnLines.Count lines)
                        </span>
                    </div>
                </div>

                <div class="refund-method-section">
                    <h4>Refund method</h4>

                    <div class="method-buttons">
                        @foreach (var method in
                            Enum.GetValues<RefundMethod>())
                        {
                            if (method == RefundMethod.Original)
                            {
                                continue;
                            }

                            var creditDisabled =
                                method == RefundMethod.Credit &&
                                OriginalSale?.CustomerLocalId == null;

                            <button type="button"
                                    class="method-btn @(CurrentRefundMethod ==
                                                        method
                                                        ? "active"
                                                        : string.Empty)"
                                    @onclick="() => CurrentRefundMethod = method"
                                    disabled="@(IsSaving || creditDisabled)">

                                <span class="method-icon">
                                    @GetRefundMethodIcon(method)
                                </span>

                                <span class="method-name">
                                    @GetRefundMethodName(method)
                                </span>
                            </button>
                        }
                    </div>
                </div>

                <div class="return-items-section">
                    <h4>Items being returned</h4>

                    <div class="return-items-list">
                        @foreach (var line in ReturnLines)
                        {
                            <div class="return-item">
                                <div class="item-details">
                                    <strong>
                                        @line.Source.ProductName
                                    </strong>

                                    <span class="muted">
                                        @FormatQuantity(line.Quantity)
                                        ×
                                        €@line.Source.EffectiveUnitPrice.ToString("F2")
                                    </span>
                                </div>

                                <div class="item-reason">
                                    <select class="reason-select"
                                            @bind="line.Reason"
                                            @onclick:stopPropagation="true"
                                            disabled="@IsSaving">

                                        <option value="">-- Select reason --</option>

                                        @foreach (var reason in ReturnReasons)
                                        {
                                            <option value="@reason">
                                                @reason
                                            </option>
                                        }
                                    </select>
                                </div>

                                <span class="item-amount">
                                    €@line.Amount.ToString("F2")
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="notes-section">
                    <label>Additional notes</label>

                    <textarea class="notes-input"
                              @bind="RefundNotes"
                              maxlength="1000"
                              rows="3"
                              disabled="@IsSaving"
                              placeholder="Optional return notes...">
                    </textarea>
                </div>

                @if (HasMissingReasons)
                {
                    <div class="alert alert-warning">
                        Select a reason for every returned item.
                    </div>
                }

                @if (CurrentRefundMethod ==
                        RefundMethod.Credit &&
                    OriginalSale?.CustomerLocalId == null)
                {
                    <div class="alert alert-warning">
                        A credit refund requires a customer.
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CloseRefundModal"
                        disabled="@IsSaving">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-success btn-complete"
                        @onclick="CompleteRefundAsync"
                        disabled="@(IsSaving ||
                                    HasMissingReasons ||
                                    ReturnLines.Count == 0)">
                    @(IsSaving
                        ? "Saving locally..."
                        : $"Complete refund €{TotalRefundAmount:F2}")
                </button>
            </div>
        </div>
    </div>
}

<div id="receipt"
     style="display:none">

    <h3>RETURN RECEIPT</h3>

    <p>
        Return:
        @Receipt.ReturnNumber
    </p>

    <p>
        @Receipt.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
    </p>

    <p>
        Original sale:
        @Receipt.OriginalSaleNumber
    </p>

    <hr />

    @foreach (var line in Receipt.Lines)
    {
        <div>
            @line.Name<br />
            @FormatQuantity(line.Quantity)
            ×
            €@line.UnitPrice.ToString("F2")
            =
            €@line.Amount.ToString("F2")
            <br />
            Reason:
            @line.Reason
        </div>
    }

    <hr />

    <strong>
        Refund total:
        €@Receipt.Total.ToString("F2")
    </strong>

    <p>
        VAT refund:
        €@Receipt.Tax.ToString("F2")
    </p>

    <p>
        Method:
        @Receipt.RefundMethod
    </p>

    @if (!string.IsNullOrWhiteSpace(
            Receipt.Notes))
    {
        <p>
            Notes:
            @Receipt.Notes
        </p>
    }
</div>

@code {
    private readonly List<ReturnCartLine> ReturnLines =
        new();

    private List<LocalReturnableSaleResult> SearchedSales =
        new();

    private LocalReturnableSaleResult? OriginalSale;

    private ReturnCartLine? SelectedReturnLine;

    private string SaleSearchText =
        string.Empty;

    private string RefundNotes =
        string.Empty;

    private string? SuccessMessage;
    private string? ErrorMessage;

    private bool IsSaving;
    private bool IsSearchingSales;
    private bool ShowRefundModal;

    private bool IsBusy =>
        IsSaving ||
        IsSearchingSales;

    private RefundMethod CurrentRefundMethod =
        RefundMethod.Cash;

    private ElementReference saleSearchInputRef;

    private ReturnReceiptModel Receipt =
        new();

    private readonly string[] ReturnReasons =
    {
        "Defective",
        "Wrong Item",
        "Changed Mind",
        "Not as Described",
        "Damaged",
        "Other"
    };

    private decimal TotalReturnQuantity =>
        ReturnLines.Sum(line =>
            line.Quantity);

    private decimal TotalRefundAmount =>
        RoundMoney(
            ReturnLines.Sum(line =>
                line.Amount));

    private decimal TotalRefundTax =>
        RoundMoney(
            ReturnLines.Sum(line =>
                line.TaxAmount));

    private bool HasMissingReasons =>
        ReturnLines.Any(line =>
            string.IsNullOrWhiteSpace(
                line.Reason));

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            await FocusSaleSearchInputAsync();
        }
    }

    private async Task OnSaleSearchKeyDown(
        KeyboardEventArgs args)
    {
        if (string.Equals(
                args.Key,
                "Enter",
                StringComparison.OrdinalIgnoreCase))
        {
            await SearchSalesAsync();
        }
    }

    private async Task SearchSalesAsync()
    {
        if (string.IsNullOrWhiteSpace(
                SaleSearchText))
        {
            return;
        }

        try
        {
            IsSearchingSales =
                true;

            ErrorMessage =
                null;

            SearchedSales =
                (await LocalReturnService
                    .SearchSalesAsync(
                        SaleSearchText.Trim(),
                        20))
                .ToList();

            if (SearchedSales.Count == 0)
            {
                ErrorMessage =
                    "No returnable local sale was found.";

                return;
            }

            if (SearchedSales.Count == 1)
            {
                await SelectSaleAsync(
                    SearchedSales[0].LocalSaleId);
            }

            if (SearchedSales.Count ==
                0)
            {
                ErrorMessage =
                    "No returnable local sale was found.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to search local sales for return.");

            ErrorMessage =
                exception
                    .GetBaseException()
                    .Message;
        }
        finally
        {
            IsSearchingSales =
                false;
        }
    }

    private async Task SelectSaleAsync(
        Guid localSaleId)
    {
        try
        {
            OriginalSale =
                await LocalReturnService
                    .GetReturnableSaleAsync(
                        localSaleId)
                ?? throw new KeyNotFoundException(
                    "The local sale was not found.");

            ReturnLines.Clear();

            SelectedReturnLine =
                null;

            await FocusSaleSearchInputAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load local sale {SaleId} for return.",
                localSaleId);

            ErrorMessage =
                exception
                    .GetBaseException()
                    .Message;
        }
    }

    private void AddToReturn(
        LocalReturnableSaleLineResult source)
    {
        if (source.AvailableQuantity <=
            0m)
        {
            return;
        }

        var existing =
            ReturnLines.FirstOrDefault(line =>
                line.Source.LocalSaleLineId ==
                    source.LocalSaleLineId);

        if (existing !=
            null)
        {
            SelectedReturnLine =
                existing;

            return;
        }

        var line =
            new ReturnCartLine(source)
            {
                Quantity =
                    Math.Min(
                        1m,
                        source.AvailableQuantity),

                Reason =
                    string.Empty,

                RestockItem =
                    true
            };

        ReturnLines.Add(
            line);

        SelectedReturnLine =
            line;
    }

    private void AddAllToReturn()
    {
        if (OriginalSale ==
            null)
        {
            return;
        }

        foreach (var source in OriginalSale.Lines)
        {
            if (source.AvailableQuantity <=
                    0m ||
                IsLineInReturn(
                    source))
            {
                continue;
            }

            ReturnLines.Add(
                new ReturnCartLine(source)
                {
                    Quantity =
                        source.AvailableQuantity,

                    Reason =
                        string.Empty,

                    RestockItem =
                        true
                });
        }
    }

    private bool IsLineInReturn(
        LocalReturnableSaleLineResult source)
    {
        return ReturnLines.Any(line =>
            line.Source.LocalSaleLineId ==
                source.LocalSaleLineId);
    }

    private void IncrementReturn(
        ReturnCartLine line)
    {
        if (line.Quantity <
            line.MaximumQuantity)
        {
            line.Quantity =
                RoundQuantity(
                    Math.Min(
                        line.MaximumQuantity,
                        line.Quantity +
                        1m));
        }
    }

    private void DecrementReturn(
        ReturnCartLine line)
    {
        if (line.Quantity >
            1m)
        {
            line.Quantity =
                RoundQuantity(
                    line.Quantity -
                    1m);

            return;
        }

        ReturnLines.Remove(
            line);

        if (ReferenceEquals(
                SelectedReturnLine,
                line))
        {
            SelectedReturnLine =
                null;
        }
    }

    private void SelectReturnLine(
        ReturnCartLine line)
    {
        SelectedReturnLine =
            line;
    }

    private void RemoveSelectedReturnLine()
    {
        if (SelectedReturnLine ==
            null)
        {
            return;
        }

        ReturnLines.Remove(
            SelectedReturnLine);

        SelectedReturnLine =
            null;
    }

    private void ResetReturn()
    {
        ReturnLines.Clear();

        SearchedSales.Clear();

        OriginalSale =
            null;

        SelectedReturnLine =
            null;

        SaleSearchText =
            string.Empty;

        RefundNotes =
            string.Empty;

        CurrentRefundMethod =
            RefundMethod.Cash;

        _ = FocusSaleSearchInputAsync();
    }

    private void OpenRefundModal()
    {
        if (OriginalSale ==
                null ||
            ReturnLines.Count ==
                0)
        {
            return;
        }

        ShowRefundModal =
            true;

        CurrentRefundMethod =
            RefundMethod.Cash;

        RefundNotes =
            string.Empty;
    }

    private void CloseRefundModal()
    {
        if (IsSaving)
        {
            return;
        }

        ShowRefundModal =
            false;
    }

    private async Task CompleteRefundAsync()
    {
        if (OriginalSale ==
            null)
        {
            ErrorMessage =
                "Select an original sale.";

            return;
        }

        if (ReturnLines.Count ==
            0)
        {
            ErrorMessage =
                "Select at least one return line.";

            return;
        }

        if (HasMissingReasons)
        {
            ErrorMessage =
                "Select a reason for every return line.";

            return;
        }

        if (CurrentRefundMethod ==
            RefundMethod.Original)
        {
            ErrorMessage =
                "Original refund method is not supported.";

            return;
        }

        if (CurrentRefundMethod ==
                RefundMethod.Credit &&
            !OriginalSale.CustomerLocalId.HasValue)
        {
            ErrorMessage =
                "A credit refund requires a customer.";

            return;
        }

        try
        {
            IsSaving =
                true;

            ErrorMessage =
                null;

            SuccessMessage =
                null;

            var localReturn =
                BuildLocalReturn();

            var savedReturn =
                await LocalReturnService
                    .CreateAsync(
                        localReturn);

            State.InvalidatePos();

            Receipt =
                BuildReceipt(
                    savedReturn);

            await JS.InvokeVoidAsync(
                "printReceipt");

            var localNumber =
                savedReturn.LocalReturnNumber;

            ShowRefundModal =
                false;

            ResetReturn();

            SuccessMessage =
                $"Return {localNumber} was processed locally and " +
                "queued for synchronization.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to process the local return.");

            ErrorMessage =
                exception
                    .GetBaseException()
                    .Message;
        }
        finally
        {
            IsSaving =
                false;
        }
    }

    private LocalReturn BuildLocalReturn()
    {
        var originalSale =
            OriginalSale
            ?? throw new InvalidOperationException(
                "Original sale is required.");

        var now =
            DateTime.UtcNow;

        var localReturn =
            new LocalReturn
            {
                Id =
                    Guid.NewGuid(),

                ServerId =
                    null,

                ClientOperationId =
                    Guid.NewGuid(),

                LocalReturnNumber =
                    string.Empty,

                LocalSaleId =
                    originalSale.LocalSaleId,

                ServerSaleId =
                    originalSale.ServerSaleId,

                CustomerLocalId =
                    originalSale.CustomerLocalId,

                CustomerServerId =
                    originalSale.CustomerServerId,

                OriginalLocalInvoiceNumber =
                    originalSale.LocalInvoiceNumber,

                OriginalServerInvoiceNumber =
                    originalSale.ServerInvoiceNumber,

                RefundMethod =
                    CurrentRefundMethod.ToString(),

                Reason =
                    BuildReturnReason(),

                ReturnDateUtc =
                    now,

                IsProcessed =
                    false,

                SyncStatus =
                    SyncQueueStatus.Pending,

                CreatedAtUtc =
                    now
            };

        foreach (var cartLine in ReturnLines)
        {
            var source =
                cartLine.Source;

            localReturn.Lines.Add(
                new LocalReturnLine
                {
                    Id =
                        Guid.NewGuid(),

                    LocalSaleLineId =
                        source.LocalSaleLineId,

                    ProductLocalId =
                        source.ProductLocalId,

                    ProductServerId =
                        source.ProductServerId,

                    ProductName =
                        source.ProductName,

                    ProductBarcode =
                        source.ProductBarcode,

                    Quantity =
                        RoundQuantity(
                            cartLine.Quantity),

                    UnitProductLocalId =
                        source.UnitProductLocalId,

                    UnitProductServerId =
                        source.UnitProductServerId,

                    UnitQuantity =
                        source.IsPack
                            ? RoundQuantity(
                                cartLine.Quantity *
                                source.UnitsPerPack)
                            : RoundQuantity(
                                cartLine.Quantity),

                    IsPack =
                        source.IsPack,

                    UnitsPerPack =
                        source.IsPack
                            ? source.UnitsPerPack
                            : 1m,

                    UnitPrice =
                        source.EffectiveUnitPrice,

                    VatRate =
                        source.VatRate,

                    UnitCostPrice =
                        source.UnitCostPrice,

                    Reason =
                        cartLine.Reason,

                    RestockItem =
                        cartLine.RestockItem
                });
        }

        return localReturn;
    }

    private ReturnReceiptModel BuildReceipt(
        LocalReturn localReturn)
    {
        return new ReturnReceiptModel
        {
            ReturnNumber =
                localReturn.LocalReturnNumber,

            OriginalSaleNumber =
                localReturn.OriginalLocalInvoiceNumber ??
                OriginalSale?.LocalInvoiceNumber ??
                string.Empty,

            Date =
                localReturn.ReturnDateUtc,

            Total =
                localReturn.TotalAmount,

            Tax =
                localReturn.Lines.Sum(line =>
                    line.TaxAmount),

            RefundMethod =
                GetRefundMethodName(
                    CurrentRefundMethod),

            Notes =
                RefundNotes,

            Lines =
                localReturn.Lines
                    .Select(line =>
                        new ReturnReceiptLine
                        {
                            Name =
                                line.ProductName,

                            Quantity =
                                line.Quantity,

                            UnitPrice =
                                line.UnitPrice,

                            Amount =
                                line.LineAmount,

                            Reason =
                                line.Reason ??
                                string.Empty
                        })
                    .ToList()
        };
    }

    private string BuildReturnReason()
    {
        var parts =
            new List<string>
            {
                $"Refund method: " +
                $"{GetRefundMethodName(CurrentRefundMethod)}"
            };

        if (!string.IsNullOrWhiteSpace(
                RefundNotes))
        {
            parts.Add(
                $"Notes: {RefundNotes.Trim()}");
        }

        var reasonSummary =
            ReturnLines
                .GroupBy(line =>
                    line.Reason)
                .Select(group =>
                    $"{group.Key}: {group.Count()} line(s)");

        parts.Add(
            $"Items: {string.Join(", ", reasonSummary)}");

        var value =
            string.Join(
                " | ",
                parts);

        return value.Length <=
               1000
            ? value
            : value[..1000];
    }

    private static string GetRefundMethodIcon(
        RefundMethod method)
    {
        return method switch
        {
            RefundMethod.Cash =>
                "💵",

            RefundMethod.Card =>
                "💳",

            RefundMethod.Credit =>
                "📝",

            RefundMethod.Exchange =>
                "🔄",

            RefundMethod.Original =>
                "🔙",

            _ =>
                "💰"
        };
    }

    private static string GetRefundMethodName(
        RefundMethod method)
    {
        return method switch
        {
            RefundMethod.Cash =>
                "Cash",

            RefundMethod.Card =>
                "Card",

            RefundMethod.Credit =>
                "Customer account",

            RefundMethod.Exchange =>
                "Exchange",

            RefundMethod.Original =>
                "Original payment",

            _ =>
                "Other"
        };
    }

