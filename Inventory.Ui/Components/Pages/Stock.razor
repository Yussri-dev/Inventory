@page "/stock"
@using Inventory.Dto.Stock.Results
@using Inventory.Dto.StockMouvements.Requests
@using Inventory.Dto.Enums
@using Inventory.Dto.StockMouvements.Results

@inject IStockApi StockApi
@inject IStockMovementApi StockMovementApi

<h2>Stock</h2>

<div class="pager">
    <button class="btn ghost" disabled="@(Page == 1)"
            @onclick="() => ChangePage(Page - 1)">
        Prev
    </button>

    <span class="muted">
        Page @Page / @(Math.Ceiling((double)TotalCount / PageSize))
    </span>

    <button class="btn ghost"
            disabled="@(Page* PageSize >= TotalCount)"
            @onclick="() => ChangePage(Page + 1)">
        Next
    </button>
</div>

<div class="card stock-card">

    <table class="table stock-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Product</th>
                <th>Total</th>
                <th>Reserved</th>
                <th>Available</th>
                <th>Last Update</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var stock in Stocks)
            {
                <tr class="@(SelectedStock?.Id == stock.Id ? "selected" : "")"
                    @onclick="() => Select(stock)">

                    <td class="mono muted">@stock.ProductId</td>
                    <td>@stock.Name</td>
                    <td>@stock.Quantity</td>
                    <td>@stock.ReservedQuantity</td>
                    <td class="available @(stock.AvailableQuantity <= 0 ? "danger" : stock.AvailableQuantity < 10 ? "warning" : "ok")">
                        @stock.AvailableQuantity
                    </td>
                    <td>@stock.LastUpdated.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <button class="btn small ghost"
                            @onclick="() => OpenAdjust(stock)"
                                @onclick:stopPropagation="true">
                            Adjust
                        </button>
                       @*  <button class="btn small ghost"
                                @onclick="() => OpenHistory(stock)"
                                @onclick:stopPropagation="true">
                            History
                        </button> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

@if (ShowHistory && SelectedStock != null)
{
    <div class="side-drawer">
        <div class="drawer-header">
            <h3>Stock history</h3>
            <button class="btn ghost" @onclick="CloseHistory">✕</button>
        </div>

        <p class="muted">@SelectedStock.Name</p>

        <table class="table history-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Δ</th>
                    <th>Before</th>
                    <th>After</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Movements)
                {
                    <tr>
                        <td>@m.MovementDate.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td>@m.Type</td>
                        <td class="@(m.QuantityChange > 0 ? "ok" : "danger")">
                            @m.QuantityChange
                        </td>
                        <td>@m.QuantityBefore</td>
                        <td>@m.QuantityAfter</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


<!-- ADJUSTMENT MODAL -->
@if (ShowAdjustModal && SelectedStock != null)
{
    <div class="modal-overlay" @onclick="CloseAdjust">
        <div class="modal-content" @onclick:stopPropagation="true">

            <h3>Adjust stock</h3>

            <p><strong>Product: @SelectedStock.Name</strong></p>

            <div class="form-group">
                <label>Current quantity</label>
                <input class="form-input" value="@SelectedStock.Quantity" disabled />
            </div>

            <div class="form-group">
                <label>New quantity</label>
                <input type="number"
                       class="form-input"
                       step="0.001"
                       @bind="NewQuantity" />
            </div>

            <div class="form-group">
                <label>Notes</label>
                <input class="form-input"
                       @bind="Notes" />
            </div>

            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseAdjust">Cancel</button>
                <button class="btn primary" @onclick="ConfirmAdjust">Confirm</button>
            </div>

        </div>
    </div>
}

@code {
    int Page = 1;
    int PageSize = 25;
    int TotalCount;

    bool ShowHistory;
    List<StockMouvementResult> Movements = new();
    List<StockResult> Stocks = new();
    StockResult? SelectedStock;

    bool ShowAdjustModal;
    decimal NewQuantity;
    string Notes = "Manual stock adjustment";

    protected override async Task OnInitializedAsync()
    {
        await LoadStock();
    }

    async Task LoadStock()
    {
        var result = await StockApi.Search(new StockQuery
        {
            Page = Page,
            PageSize = PageSize
        });

        Stocks = result.Items;
        TotalCount = result.TotalCount;
    }


    void Select(StockResult stock)
    {
        SelectedStock = stock;
    }

    void OpenAdjust(StockResult stock)
    {
        SelectedStock = stock;
        NewQuantity = stock.Quantity;
        Notes = "Manual stock adjustment";
        ShowAdjustModal = true;
    }

    void CloseAdjust()
    {
        ShowAdjustModal = false;
        SelectedStock = null;
    }

    async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadStock();
    }

    async Task ConfirmAdjust()
    {
        if (SelectedStock == null)
            return;

        var delta = NewQuantity - SelectedStock.Quantity;

        if (delta == 0)
        {
            CloseAdjust();
            return;
        }

        // FULLY VALID REQUEST — matches DTO exactly
        // await StockMovementApi.Create(new CreateStockMouvementRequest
        // {
        //     ProductId = SelectedStock.ProductId,
        //     QuantityChange = delta,
        //     QuantityBefore = SelectedStock.Quantity,
        //     QuantityAfter = NewQuantity,
        //     Type = StockMovementType.Adjustment,
        //     Notes = Notes,
        //     MovementDate = DateTime.UtcNow
        // });
        await StockMovementApi.Create(new CreateStockMouvementRequest
        {
            ProductId = SelectedStock.ProductId,
            QuantityChange = delta,
            Type = StockMovementType.Adjustment,
            Notes = Notes
        });


        await LoadStock();
        CloseAdjust();
    }

    // async Task OpenHistory(StockResult stock)
    // {
    //     SelectedStock = stock;

    //     var result = await StockMovementApi.Search(new StockMouvementQuery
    //     {
    //         ProductId = stock.ProductId,
    //         Page = 1,
    //         PageSize = 50
    //     });

    //     Movements = result.Items;
    //     ShowHistory = true;
    // }


    void CloseHistory()
    {
        ShowHistory = false;
        Movements.Clear();
    }
}
