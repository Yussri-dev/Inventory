@page "/stock"
@using Inventory.Dto.Stock.Results
@using Inventory.Dto.StockMouvements.Requests
@using Inventory.Dto.Enums
@using Inventory.Dto.StockMouvements.Results

@inject IStockApi StockApi
@inject IStockMovementApi StockMovementApi

<h2>Stock</h2>
<div class="page-container">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert error">
            <span>@errorMessage</span>
            <button @onclick="ClearError">x</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert success">
            <span>@successMessage</span>
            <button @onclick="ClearSuccess">x</button>
        </div>
    }

    <div class="card">
        <h4>Search Product</h4>
        <div class="search-grid">
            <input type="text"
                   placeholder="Search by name or barcode..."
                   class="search-input"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp"
                   disabled="@isLoading" />
            <div class="search-actions">
                <button class="btn primary" @onclick="Search" disabled="@isLoading">
                    Search
                </button>
                <button class="btn ghost" @onclick="ClearSearch" disabled="@isLoading">
                    Clear
                </button>
            </div>
        </div>
    </div>

    @if (isLoadingData)
    {
        <div class="loading-container">
            <p>Loading Stock ...</p>
        </div>
    }
    else if (Stocks == null || Stocks.Count == 0)
    {
        <p>@(isSearching ? "No Product found matching your search." : "No Products")</p>
    }
    else
    {
        <div class="pager">
            <button class="btn ghost" disabled="@(Page == 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>

            <span class="muted">
                Page @Page / @(Math.Ceiling((double)TotalCount / PageSize))
            </span>

            <button class="btn ghost"
                    disabled="@(Page* PageSize >= TotalCount)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>
        </div>

        <div class="card stock-card">

            <table class="table stock-table">
                <thead>
                    <tr>
                        @* <th>#</th> *@
                        <th>Product</th>
                        <th>Total</th>
                        <th>Reserved</th>
                        <th>Available</th>
                        <th>Last Update</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var stock in Stocks)
                    {
                        <tr class="@(SelectedStock?.Id == stock.Id ? "selected" : "")"
                            @onclick="() => Select(stock)">

                            @* <td class="mono muted">@stock.ProductId</td> *@
                            <td>@stock.Name</td>
                            <td>@stock.Quantity</td>
                            <td>@stock.ReservedQuantity</td>
                            <td class="available @(stock.AvailableQuantity <= 0 ? "danger" : stock.AvailableQuantity < 10 ? "warning" : "ok")">
                                @stock.AvailableQuantity
                            </td>
                            <td>@stock.LastUpdated.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <button class="btn small ghost"
                                        @onclick="() => OpenAdjust(stock)"
                                        @onclick:stopPropagation="true">
                                    Adjust
                                </button>
                              @*   <button class="btn small ghost"
                                        @onclick="() => OpenHistory(stock)"
                                        @onclick:stopPropagation="true">
                                    History
                                </button> *@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }


    @if (ShowHistory && SelectedStock != null)
    {
        <div class="side-drawer">
            <div class="drawer-header">
                <h3>Stock history</h3>
                <button class="btn ghost" @onclick="CloseHistory">✕</button>
            </div>

            <p class="muted">@SelectedStock.Name</p>

            <table class="table history-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Δ</th>
                        <th>Before</th>
                        <th>After</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Movements)
                    {
                        <tr>
                            <td>@m.MovementDate.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td>@m.Type</td>
                            <td class="@(m.QuantityChange > 0 ? "ok" : "danger")">
                                @m.QuantityChange
                            </td>
                            <td>@m.QuantityBefore</td>
                            <td>@m.QuantityAfter</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

<!-- ADJUSTMENT MODAL -->
@if (ShowAdjustModal && SelectedStock != null)
{
    <div class="modal-overlay" @onclick="CloseAdjust">
        <div class="modal-content" @onclick:stopPropagation="true">

            <h3>Adjust stock</h3>

            <p><strong>Product: @SelectedStock.Name</strong></p>

            <div class="form-group">
                <label>Current quantity</label>
                <input class="form-input" value="@SelectedStock.Quantity" disabled />
            </div>

            <div class="form-group">
                <label>New quantity</label>
                <input type="number"
                       class="form-input"
                       step="0.001"
                       @bind="NewQuantity" />
            </div>

            <div class="form-group">
                <label>Notes</label>
                <input class="form-input"
                       @bind="Notes" />
            </div>

            <div class="modal-footer">
                <button class="btn secondary" @onclick="CloseAdjust">Cancel</button>
                <button class="btn primary" @onclick="ConfirmAdjust">Confirm</button>
            </div>

        </div>
    </div>
}

@code {

    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;
    private bool isLoadingData;
    private string searchTerm = string.Empty;
    private bool isSearching;

    int Page = 1;
    int PageSize = 25;
    int TotalCount;

    bool ShowHistory;

    private List<StockResult>? Stocks;

    List<StockMouvementResult> Movements = new();
    StockResult? SelectedStock;

    bool ShowAdjustModal;
    decimal NewQuantity;
    string Notes = "Manual stock adjustment";

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }
    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        isSearching = false;
        Page = 1;
        await LoadData();
    }

    private void ClearError()
    {
        errorMessage = null;
    }

    private void ClearSuccess()
    {
        successMessage = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new StockQuery
            {
                Page = Page,
                PageSize = PageSize,
                Search = isSearching ? searchTerm : null
            };

            var response = await StockApi.Search(query);

            Stocks = response.Items?.ToList() ?? new List<StockResult>();
            TotalCount = response.TotalCount;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading stock: {ex.Message}";
            Stocks = new List<StockResult>();
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            isSearching = false;
            Page = 1;
            await LoadData();
            return;
        }
        isSearching = true;
        Page = 1;
        await LoadData();
    }
    void Select(StockResult stock)
    {
        SelectedStock = stock;
    }

    void OpenAdjust(StockResult stock)
    {
        SelectedStock = stock;
        NewQuantity = stock.Quantity;
        Notes = "Manual stock adjustment";
        ShowAdjustModal = true;
    }

    void CloseAdjust()
    {
        ShowAdjustModal = false;
        SelectedStock = null;
    }

    async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadData();
    }

    async Task ConfirmAdjust()
    {
        if (SelectedStock == null)
            return;

        var delta = NewQuantity - SelectedStock.Quantity;

        if (delta == 0)
        {
            CloseAdjust();
            return;
        }

        // FULLY VALID REQUEST — matches DTO exactly
        // await StockMovementApi.Create(new CreateStockMouvementRequest
        // {
        //     ProductId = SelectedStock.ProductId,
        //     QuantityChange = delta,
        //     QuantityBefore = SelectedStock.Quantity,
        //     QuantityAfter = NewQuantity,
        //     Type = StockMovementType.Adjustment,
        //     Notes = Notes,
        //     MovementDate = DateTime.UtcNow
        // });
        await StockMovementApi.Create(new CreateStockMouvementRequest
        {
            ProductId = SelectedStock.ProductId,
            QuantityChange = delta,
            Type = StockMovementType.Adjustment,
            Notes = Notes
        });


        await LoadData();
        CloseAdjust();
    }

    // async Task OpenHistory(StockResult stock)
    // {
    //     SelectedStock = stock;

    //     var result = await StockMovementApi.Search(new StockMouvementQuery
    //     {
    //         ProductId = stock.ProductId,
    //         Page = 1,
    //         PageSize = 50
    //     });

    //     Movements = result.Items;
    //     ShowHistory = true;
    // }


    void CloseHistory()
    {
        ShowHistory = false;
        Movements.Clear();
    }
}
