@page "/stock"

@using Inventory.LocalDB.Models
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.Ui.Services.Sync

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ILocalStockAdjustmentService LocalStockService
@inject ILocalSyncUploader SyncUploader
@inject ILocalStockSyncService StockSyncService
@inject AppState State
@inject ILogger<Stock> Logger

<h2>Stock</h2>

<div class="page-container">

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert error">
            <span>@ErrorMessage</span>

            <button type="button"
                    @onclick="ClearError">
                x
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert success">
            <span>@SuccessMessage</span>

            <button type="button"
                    @onclick="ClearSuccess">
                x
            </button>
        </div>
    }

    <div class="card">
        <div class="stock-toolbar">
            <div>
                <h4>Local stock</h4>

                <p class="muted">
                    Adjustments are saved to SQLite first and synchronized later.
                </p>
            </div>

            <button type="button"
                    class="btn primary"
                    @onclick="SynchronizeAsync"
                    disabled="@IsBusy">
                @(IsSynchronizing
                    ? "Synchronizing..."
                    : "Synchronize")
            </button>
        </div>
    </div>

    <div class="card">
        <h4>Search product</h4>

        <div class="search-grid">
            <input type="text"
                   placeholder="Search by name or barcode..."
                   class="search-input"
                   @bind="SearchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp"
                   disabled="@IsBusy" />

            <div class="search-actions">
                <button type="button"
                        class="btn primary"
                        @onclick="SearchAsync"
                        disabled="@IsBusy">
                    Search
                </button>

                <button type="button"
                        class="btn ghost"
                        @onclick="ClearSearchAsync"
                        disabled="@IsBusy">
                    Clear
                </button>
            </div>
        </div>
    </div>

    @if (IsLoadingData)
    {
        <div class="loading-container">
            <p>Loading local stock...</p>
        </div>
    }
    else if (Stocks.Count == 0)
    {
        <p>
            @(IsSearching
                ? "No local product matched your search."
                : "No local stock is available.")
        </p>
    }
    else
    {
        <div class="pager">
            <button type="button"
                    class="btn ghost"
                    disabled="@(Page <= 1 || IsBusy)"
                    @onclick="() => ChangePageAsync(Page - 1)">
                Prev
            </button>

            <span class="muted">
                Page @Page / @TotalPages
            </span>

            <button type="button"
                    class="btn ghost"
                    disabled="@(Page >= TotalPages || IsBusy)"
                    @onclick="() => ChangePageAsync(Page + 1)">
                Next
            </button>
        </div>

        <div class="card stock-card">
            <table class="table stock-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Barcode</th>
                        <th>Total</th>
                        <th>Reserved</th>
                        <th>Available</th>
                        <th>Last update</th>
                        <th>Sync</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var stock in Stocks)
                    {
                        <tr class="@(SelectedStock?.Id == stock.Id
                                ? "selected"
                                : string.Empty)"
                            @onclick="() => Select(stock)">

                            <td>@stock.ProductName</td>

                            <td class="mono muted">
                                @(stock.ProductBarcode ?? "-")
                            </td>

                            <td>
                                @FormatQuantity(stock.Quantity)
                            </td>

                            <td>
                                @FormatQuantity(stock.ReservedQuantity)
                            </td>

                            <td class="available @GetAvailabilityClass(stock)">
                                @FormatQuantity(stock.AvailableQuantity)
                            </td>

                            <td>
                                @stock.LastUpdatedUtc
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @if (stock.LastSyncedAtUtc.HasValue)
                                {
                                    <span class="status-badge synced">
                                        Synced
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge local">
                                        Local
                                    </span>
                                }
                            </td>

                            <td>
                                <button type="button"
                                        class="btn small ghost"
                                        @onclick="() => OpenAdjust(stock)"
                                        @onclick:stopPropagation="true"
                                        disabled="@IsBusy">
                                    Adjust
                                </button>

                                <button type="button"
                                        class="btn small ghost"
                                        @onclick="() => OpenHistoryAsync(stock)"
                                        @onclick:stopPropagation="true"
                                        disabled="@IsBusy">
                                    History
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (ShowHistory &&
         SelectedStock != null)
    {
        <div class="side-drawer">
            <div class="drawer-header">
                <h3>Local stock history</h3>

                <button type="button"
                        class="btn ghost"
                        @onclick="CloseHistory">
                    ✕
                </button>
            </div>

            <p class="muted">
                @SelectedStock.ProductName
            </p>

            @if (IsLoadingHistory)
            {
                <p>Loading history...</p>
            }
            else if (Movements.Count == 0)
            {
                <p>No local movement found.</p>
            }
            else
            {
                <table class="table history-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Δ</th>
                            <th>Before</th>
                            <th>After</th>
                            <th>Sync</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var movement in Movements)
                        {
                            <tr>
                                <td>
                                    @movement.MovementDateUtc
                                        .ToLocalTime()
                                        .ToString("dd/MM HH:mm")
                                </td>

                                <td>@movement.Type</td>

                                <td class="@(movement.QuantityChange >= 0m
                                        ? "ok"
                                        : "danger")">
                                    @FormatSignedQuantity(
                                        movement.QuantityChange)
                                </td>

                                <td>
                                    @FormatQuantity(
                                        movement.QuantityBefore)
                                </td>

                                <td>
                                    @FormatQuantity(
                                        movement.QuantityAfter)
                                </td>

                                <td>
                                    @movement.SyncStatus
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

@if (ShowAdjustModal &&
     SelectedStock != null)
{
    <div class="modal-overlay"
         @onclick="CloseAdjust">

        <div class="modal-content"
             @onclick:stopPropagation="true">

            <h3>Adjust local stock</h3>

            <p>
                <strong>
                    Product: @SelectedStock.ProductName
                </strong>
            </p>

            <div class="form-group">
                <label>Current quantity</label>

                <input class="form-input"
                       value="@FormatQuantity(SelectedStock.Quantity)"
                       disabled />
            </div>

            <div class="form-group">
                <label>Reserved quantity</label>

                <input class="form-input"
                       value="@FormatQuantity(SelectedStock.ReservedQuantity)"
                       disabled />
            </div>

            <div class="form-group">
                <label>New quantity</label>

                <input type="number"
                       class="form-input"
                       step="0.001"
                       min="@SelectedStock.ReservedQuantity"
                       @bind="NewQuantity"
                       disabled="@IsSavingAdjustment" />
            </div>

            <div class="form-group">
                <label>Difference</label>

                <input class="form-input"
                       value="@FormatSignedQuantity(AdjustmentDelta)"
                       disabled />
            </div>

            <div class="form-group">
                <label>Notes</label>

                <input class="form-input"
                       maxlength="500"
                       @bind="Notes"
                       disabled="@IsSavingAdjustment" />
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn secondary"
                        @onclick="CloseAdjust"
                        disabled="@IsSavingAdjustment">
                    Cancel
                </button>

                <button type="button"
                        class="btn primary"
                        @onclick="ConfirmAdjustAsync"
                        disabled="@(IsSavingAdjustment ||
                                    AdjustmentDelta == 0m)">
                    @(IsSavingAdjustment
                        ? "Saving..."
                        : "Confirm")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string? ErrorMessage;
    private string? SuccessMessage;

    private bool IsLoadingData;
    private bool IsLoadingHistory;
    private bool IsSavingAdjustment;
    private bool IsSynchronizing;

    private bool IsBusy =>
        IsLoadingData ||
        IsLoadingHistory ||
        IsSavingAdjustment ||
        IsSynchronizing;

    private string SearchTerm =
        string.Empty;

    private bool IsSearching;

    private int Page =
        1;

    private int PageSize =
        25;

    private int TotalCount;

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                TotalCount /
                (double)PageSize));

    private List<LocalStock> Stocks =
        new();

    private List<LocalStockMovement> Movements =
        new();

    private LocalStock? SelectedStock;

    private bool ShowHistory;
    private bool ShowAdjustModal;

    private decimal NewQuantity;

    private decimal AdjustmentDelta =>
        SelectedStock == null
            ? 0m
            : RoundQuantity(
                NewQuantity -
                SelectedStock.Quantity);

    private string Notes =
        "Manual stock adjustment";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task OnSearchKeyUp(
        KeyboardEventArgs args)
    {
        if (string.Equals(
                args.Key,
                "Enter",
                StringComparison.OrdinalIgnoreCase))
        {
            await SearchAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            IsLoadingData =
                true;

            ErrorMessage =
                null;

            var effectiveSearch =
                IsSearching
                    ? SearchTerm
                    : null;

            TotalCount =
                await LocalStockService
                    .CountAsync(
                        effectiveSearch);

            if (Page >
                TotalPages)
            {
                Page =
                    TotalPages;
            }

            Stocks =
                (await LocalStockService
                    .SearchAsync(
                        effectiveSearch,
                        Page,
                        PageSize))
                .ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load local stocks.");

            ErrorMessage =
                $"Error loading local stock: " +
                $"{exception.GetBaseException().Message}";

            Stocks =
                new List<LocalStock>();

            TotalCount =
                0;
        }
        finally
        {
            IsLoadingData =
                false;
        }
    }

    private async Task SearchAsync()
    {
        IsSearching =
            !string.IsNullOrWhiteSpace(
                SearchTerm);

        Page =
            1;

        await LoadDataAsync();
    }

    private async Task ClearSearchAsync()
    {
        SearchTerm =
            string.Empty;

        IsSearching =
            false;

        Page =
            1;

        await LoadDataAsync();
    }

    private async Task ChangePageAsync(
        int newPage)
    {
        Page =
            Math.Clamp(
                newPage,
                1,
                TotalPages);

        await LoadDataAsync();
    }

    private void Select(
        LocalStock stock)
    {
        SelectedStock =
            stock;
    }

    private void OpenAdjust(
        LocalStock stock)
    {
        SelectedStock =
            stock;

        NewQuantity =
            stock.Quantity;

        Notes =
            "Manual stock adjustment";

        ShowAdjustModal =
            true;
    }

    private void CloseAdjust()
    {
        if (IsSavingAdjustment)
        {
            return;
        }

        ShowAdjustModal =
            false;

        SelectedStock =
            null;

        NewQuantity =
            0m;

        Notes =
            "Manual stock adjustment";
    }

    private async Task ConfirmAdjustAsync()
    {
        if (SelectedStock ==
            null)
        {
            return;
        }

        if (NewQuantity <
            0m)
        {
            ErrorMessage =
                "The new quantity cannot be negative.";

            return;
        }

        if (NewQuantity <
            SelectedStock.ReservedQuantity)
        {
            ErrorMessage =
                "The new quantity cannot be lower than " +
                "the reserved quantity.";

            return;
        }

        if (AdjustmentDelta ==
            0m)
        {
            CloseAdjust();

            return;
        }

        try
        {
            IsSavingAdjustment =
                true;

            var productName =
                SelectedStock.ProductName;

            await LocalStockService
                .AdjustAsync(
                    SelectedStock.Id,
                    NewQuantity,
                    Notes);

            CloseAdjustAfterSave();

            State.InvalidatePos();

            await LoadDataAsync();

            SuccessMessage =
                $"Stock for '{productName}' was updated locally. " +
                "The adjustment is waiting for synchronization.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to adjust local stock {StockId}.",
                SelectedStock.Id);

            ErrorMessage =
                exception
                    .GetBaseException()
                    .Message;
        }
        finally
        {
            IsSavingAdjustment =
                false;
        }
    }

    private void CloseAdjustAfterSave()
    {
        ShowAdjustModal =
            false;

        SelectedStock =
            null;

        NewQuantity =
            0m;

        Notes =
            "Manual stock adjustment";
    }

    private async Task OpenHistoryAsync(
        LocalStock stock)
    {
        try
        {
            SelectedStock =
                stock;

            ShowHistory =
                true;

            IsLoadingHistory =
                true;

            Movements =
                (await LocalStockService
                    .GetHistoryAsync(
                        stock.ProductLocalId,
                        100))
                .ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load local stock history.");

            ErrorMessage =
                exception
                    .GetBaseException()
                    .Message;

            Movements =
                new List<LocalStockMovement>();
        }
        finally
        {
            IsLoadingHistory =
                false;
        }
    }

    private void CloseHistory()
    {
        ShowHistory =
            false;

        Movements.Clear();

        SelectedStock =
            null;
    }

    private async Task SynchronizeAsync()
    {
        try
        {
            IsSynchronizing =
                true;

            ErrorMessage =
                null;

            SuccessMessage =
                null;

            /*
             * 1. Push every general pending operation first:
             * products, purchases, sales, damages, etc.
             */
            var uploadResult =
                await SyncUploader
                    .SyncPendingAsync();

            /*
             * Do not pull server stock when one of the general
             * operations failed. A pending sale/purchase could have
             * already changed SQLite stock.
             */
            if (uploadResult.Failed >
                0)
            {
                ErrorMessage =
                    $"Synchronization stopped before stock pull. " +
                    $"{uploadResult.Failed} upload operation(s) failed.";

                return;
            }

            /*
             * 2. LocalStockSyncService pushes manual stock
             * adjustments and then pulls authoritative server stock.
             */
            await StockSyncService
                .FullSyncAsync();

            State.InvalidatePos();

            await LoadDataAsync();

            SuccessMessage =
                $"Synchronization completed. " +
                $"{uploadResult.Synced} general operation(s) uploaded.";
        }
        catch (HttpRequestException)
        {
            ErrorMessage =
                "The API is offline. Local changes remain queued.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Stock synchronization failed.");

            ErrorMessage =
                exception
                    .GetBaseException()
                    .Message;
        }
        finally
        {
            IsSynchronizing =
                false;
        }
    }

    private static string GetAvailabilityClass(
        LocalStock stock)
    {
        return stock.AvailableQuantity <= 0m
            ? "danger"
            : stock.AvailableQuantity < 10m
                ? "warning"
                : "ok";
    }

    private static string FormatQuantity(
        decimal value)
    {
        return value.ToString(
            "0.###",
            System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string FormatSignedQuantity(
        decimal value)
    {
        return value.ToString(
            "+0.###;-0.###;0",
            System.Globalization.CultureInfo.InvariantCulture);
    }

    private static decimal RoundQuantity(
        decimal value)
    {
        return Math.Round(
            value,
            3,
            MidpointRounding.AwayFromZero);
    }

    private void ClearError()
    {
        ErrorMessage =
            null;
    }

    private void ClearSuccess()
    {
        SuccessMessage =
            null;
    }
}
