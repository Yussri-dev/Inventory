@page "/damages"

@using Inventory.LocalDB.Services.Interfaces
@using Inventory.LocalDB.Services.Results

@inject ILocalDamageService LocalDamageService

<h3>Damages</h3>

<div class="page-container">

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert error">
            <span>@errorMessage</span>
            <button @onclick="ClearError">×</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert success">
            <span>@successMessage</span>
            <button @onclick="ClearSuccess">×</button>
        </div>
    }

    <div class="card">
        <h4>Scan damaged products</h4>

        <div class="form-grid">

            <label>Scan or Search Product</label>

            <input class="input"
                   placeholder="Scan barcode or type product name…"
                   @bind="productSearch"
                   @bind:event="oninput"
                   @onkeydown="OnProductSearchKeyDown"
                   @ref="barcodeInputRef"
                   disabled="@isBusy" />

            @if (searchingProducts)
            {
                <div class="muted">
                    Searching local products…
                </div>
            }

            @if (searchResults.Count > 0)
            {
                <ul class="product-search-results">
                    @foreach (var product in searchResults)
                    {
                        <li @onclick="() => SelectProduct(product)">
                            <strong>@product.Name</strong>
                            <br />

                            <span class="muted">
                                @(product.Barcode ?? "No barcode")
                                · Available:
                                @product.AvailableQuantity.ToString("0.###")
                            </span>
                        </li>
                    }
                </ul>
            }

            @if (selectedProduct != null)
            {
                <div class="selected-product">
                    <strong>@selectedProduct.Name</strong>
                    <br />

                    <span class="muted">
                        Available:
                        @selectedProduct.AvailableQuantity.ToString("0.###")

                        · Cost:
                        @selectedProduct.PurchasePrice.ToString("C")
                    </span>
                </div>

                <div class="damage-row">
                    <div class="damage-field">
                        <label>Quantity</label>

                        <input type="number"
                               step="0.001"
                               min="0.001"
                               max="@selectedProduct.AvailableQuantity"
                               @bind="quantity"
                               disabled="@isBusy" />
                    </div>

                    <div class="damage-field">
                        <label>Estimated value</label>

                        <input type="text"
                               value="@EstimatedValue.ToString("C")"
                               readonly
                               class="readonly-input" />
                    </div>

                    <div class="damage-field reason-wide">
                        <label>Reason</label>

                        <input type="text"
                               @bind="reason"
                               placeholder="Describe the damage…"
                               disabled="@isBusy" />
                    </div>
                </div>

                <button class="btn btn-danger"
                        @onclick="AddDraft"
                        disabled="@(!CanAddDraft || isBusy)">
                    Add to draft list
                </button>
            }
        </div>
    </div>

    <hr />

    <div class="card">
        <h4>Draft Damages</h4>

        @if (loading)
        {
            <p>Loading local drafts…</p>
        }
        else if (drafts.Count == 0)
        {
            <p class="muted">
                No draft damages yet.
            </p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Estimated</th>
                        <th>Reason</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var damage in drafts)
                    {
                        <tr>
                            <td>@damage.DamageNumber</td>
                            <td>@damage.ProductName</td>
                            <td>@damage.Quantity.ToString("0.###")</td>
                            <td>@damage.EstimatedValue.ToString("C")</td>
                            <td>@(damage.Reason ?? "-")</td>
                            <td>
                                @damage.DamageDateUtc
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <button class="btn btn-secondary"
                                        @onclick="() => RemoveLine(damage)"
                                        disabled="@isBusy">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
            </tbody>
        </table>

        <div class="actions-end">
            <button class="btn btn-primary"
                    @onclick="ValidateAll"
                    disabled="@isBusy">
                @(isBusy
                                ? "Validating…"
                                : "Validate all damages")
            </button>
        </div>
                }
    </div>
</div>

@code {
    private readonly List<LocalDamageProductResult>
        searchResults = new();

    private IReadOnlyList<LocalDamageDraftResult>
        drafts = Array.Empty<LocalDamageDraftResult>();

    private LocalDamageProductResult?
        selectedProduct;

    private bool loading;
    private bool searchingProducts;
    private bool isBusy;

    private string productSearch =
        string.Empty;

    private string? reason;

    private decimal quantity = 1m;

    private string? errorMessage;
    private string? successMessage;

    private ElementReference barcodeInputRef;

    private bool CanAddDraft =>
        selectedProduct != null &&
        quantity > 0 &&
        quantity <= selectedProduct.AvailableQuantity;

    private decimal EstimatedValue =>
        selectedProduct == null
            ? 0
            : Math.Round(
                quantity *
                selectedProduct.PurchasePrice,
                2);

    protected override async Task OnInitializedAsync()
    {
        await LoadDrafts();
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            await FocusBarcode();
        }
    }

    private async Task LoadDrafts()
    {
        try
        {
            loading = true;
            errorMessage = null;

            drafts =
                await LocalDamageService
                    .GetDraftsAsync();
        }
        catch (Exception exception)
        {
            errorMessage =
                $"Failed to load local damages: " +
                $"{exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnProductSearchKeyDown(
        KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter")
        {
            await SearchProduct();
        }
    }

    private async Task SearchProduct()
    {
        if (string.IsNullOrWhiteSpace(productSearch))
            return;

        try
        {
            searchingProducts = true;
            errorMessage = null;

            searchResults.Clear();

            var results =
                await LocalDamageService
                    .SearchProductsAsync(
                        productSearch,
                        10);

            if (results.Count == 1)
            {
                SelectProduct(results[0]);
            }
            else
            {
                searchResults.AddRange(results);
            }
        }
        catch (Exception exception)
        {
            errorMessage =
                $"Product search failed: {exception.Message}";
        }
        finally
        {
            searchingProducts = false;
        }
    }

    private void SelectProduct(
        LocalDamageProductResult product)
    {
        selectedProduct = product;
        productSearch = product.Name;
        quantity = 1m;
        reason = null;

        searchResults.Clear();
    }

    private async Task AddDraft()
    {
        if (selectedProduct == null ||
            !CanAddDraft)
        {
            return;
        }

        try
        {
            isBusy = true;
            errorMessage = null;

            await LocalDamageService.AddDraftAsync(
                selectedProduct.ProductLocalId,
                quantity,
                reason);

            successMessage =
                "Damage added to the local draft list.";

            ResetProductSelection();

            await LoadDrafts();
            await FocusBarcode();
        }
        catch (Exception exception)
        {
            errorMessage =
                exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RemoveLine(
        LocalDamageDraftResult damage)
    {
        try
        {
            isBusy = true;
            errorMessage = null;

            await LocalDamageService
                .RemoveDraftAsync(damage.Id);

            successMessage =
                "Damage draft deleted.";

            await LoadDrafts();
            await FocusBarcode();
        }
        catch (Exception exception)
        {
            errorMessage =
                exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ValidateAll()
    {
        try
        {
            isBusy = true;
            errorMessage = null;

            var validatedCount =
                await LocalDamageService
                    .ValidateAllDraftsAsync();

            successMessage =
                $"{validatedCount} damage(s) validated locally. " +
                "They will be synchronized when the server is available.";

            await LoadDrafts();
            ResetProductSelection();
            await FocusBarcode();
        }
        catch (Exception exception)
        {
            errorMessage =
                exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ResetProductSelection()
    {
        selectedProduct = null;
        productSearch = string.Empty;
        quantity = 1m;
        reason = null;
        searchResults.Clear();
    }

    private async Task FocusBarcode()
    {
        await Task.Delay(100);

        try
        {
            await barcodeInputRef.FocusAsync();
        }
        catch
        {
            // Le composant peut être en cours de fermeture.
        }
    }

    private void ClearError()
    {
        errorMessage = null;
    }

    private void ClearSuccess()
    {
        successMessage = null;
    }
}