@page "/customer-credits"
@using Inventory.Dto.CustomerTransactions.Requests
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.LocalDB.Services.Results

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable

@inject ILocalCustomerCreditService LocalCustomerCreditService

<div class="credits-page">
    <div class="page-header">
        <div class="header-content">
            <h1>💳 Customer Credit Management</h1>
            <p class="subtitle">Manage customer balances, payments, and purchase history</p>
        </div>
        <div class="header-actions">
            <button class="btn-icon" @onclick="LoadCustomersAsync" disabled="@isLoading">
                <span class="icon">@(isLoading ? "⏳" : "🔄")</span>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-error" role="alert">
            <span class="alert-icon">!</span>
            <div class="alert-content">
                <strong>Error</strong>
                <p>@errorMessage</p>
            </div>

            <button type="button"
                    class="alert-close"
                    aria-label="Dismiss error"
                    @onclick="ClearError">
                &times;
            </button>
        </div>
    }

    @if (isLoading && customers == null)
    {
        <div class="loading-overlay">
            <div class="spinner-large"></div>
            <p>Loading customer data...</p>
        </div>
    }
    else if (customers == null || !customers.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">📋</span>
            <h3>No Customers Found</h3>
            <p>There are no customer transactions to display.</p>
        </div>
    }
    else
    {
        <div class="main-content">
            <!-- Left Sidebar for History -->
            <div class="history-sidebar">
                @if (isLoadingDetail)
                {
                    <div class="loading-overlay">
                        <div class="spinner-large"></div>
                        <p>Loading customer history...</p>
                    </div>
                }
                else if (expandedCustomerId != null && customerDetail != null)
                {
                    <div class="sidebar-header">
                        <h2>@customerDetail.Name - History</h2>
                    </div>

                    <div class="detail-tabs">
                        <button class="detail-tab @(activeTab == "purchases" ? "active" : "")"
                                @onclick='() => activeTab = "purchases"'>
                            🛒 Purchases (@customerDetail.Sales.Count)
                        </button>
                        <button class="detail-tab @(activeTab == "transactions" ? "active" : "")"
                                @onclick='() => activeTab = "transactions"'>
                            📊 Transactions (@customerDetail.Transactions.Count)
                        </button>
                        <button class="detail-tab @(activeTab == "summary" ? "active" : "")"
                                @onclick='() => activeTab = "summary"'>
                            📈 Summary
                        </button>
                    </div>

                    <div class="detail-content">
                        @if (activeTab == "purchases")
                        {
                            <div class="purchases-list">
                                @if (!customerDetail.Sales.Any())
                                {
                                    <div class="empty-state small">
                                        <p>No purchases yet</p>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var sale in customerDetail.Sales)
                                    {
                                        <div class="purchase-item">
                                            <div class="purchase-header">
                                                <div class="purchase-info">
                                                    <strong class="invoice-number">@sale.InvoiceNumber</strong>
                                                    <span class="purchase-date">@sale.SaleDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                                <div class="purchase-badges">
                                                    <span class="badge @(sale.PaymentStatus == "Paid" ? "badge-success" : "badge-warning")">
                                                        @sale.PaymentStatus
                                                    </span>
                                                    <span class="badge badge-info">@sale.Status</span>
                                                </div>
                                            </div>
                                            <div class="purchase-amounts">
                                                <div class="amount-item">
                                                    <span class="amount-label">Total:</span>
                                                    <span class="amount-value">€@sale.TotalAmount.ToString("N2")</span>
                                                </div>
                                                <div class="amount-item">
                                                    <span class="amount-label">Recorded payments:</span>
                                                    <span class="amount-value success">€@sale.PaidAmount.ToString("N2")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else if (activeTab == "transactions")
                        {
                            <div class="transactions-list">
                                @if (!customerDetail.Transactions.Any())
                                {
                                    <div class="empty-state small">
                                        <p>No transactions yet</p>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var tx in customerDetail.Transactions)
                                    {
                                        <div class="transaction-item @GetTransactionTypeClass(tx.Type)">
                                            <div class="transaction-icon">
                                                @GetTransactionIcon(tx.Type)
                                            </div>
                                            <div class="transaction-info">
                                                <strong>@tx.Type</strong>
                                                <span class="transaction-date">@tx.TransactionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                                @if (!string.IsNullOrEmpty(tx.Description))
                                                {
                                                    <p class="transaction-desc">@tx.Description</p>
                                                }
                                            </div>
                                            <div class="transaction-amounts">
                                                <div class="transaction-amount">€@tx.Amount.ToString("N2")</div>
                                                <div class="transaction-balance">
                                                    <span class="balance-label">Balance:</span>
                                                    <span class="balance-value @(tx.BalanceAfter > 0 ? "debt" : tx.BalanceAfter < 0 ? "credit" : "")">
                                                        €@Math.Abs(tx.BalanceAfter).ToString("N2")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="summary-grid">
                                <div class="summary-item">
                                    <div class="summary-icon">🛒</div>
                                    <div class="summary-data">
                                        <div class="summary-label">Total Sales</div>
                                        <div class="summary-value">€@customerDetail.TotalSales.ToString("N2")</div>
                                    </div>
                                </div>
                                <div class="summary-item">
                                    <div class="summary-icon">💰</div>
                                    <div class="summary-data">
                                        <div class="summary-label">Total Paid</div>
                                        <div class="summary-value">€@customerDetail.TotalPaid.ToString("N2")</div>
                                    </div>
                                </div>
                                <div class="summary-item">
                                    <div class="summary-icon">⚖️</div>
                                    <div class="summary-data">
                                        <div class="summary-label">Current Balance</div>
                                        <div class="summary-value @GetBalanceClass(customerDetail.CurrentBalance)">
                                            €@Math.Abs(customerDetail.CurrentBalance).ToString("N2")
                                        </div>
                                    </div>
                                </div>
                                <div class="summary-item">
                                    <div class="summary-icon">📅</div>
                                    <div class="summary-data">
                                        <div class="summary-label">Customer Since</div>
                                        <div class="summary-value small">@customerDetail.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-icon">👤</span>
                        <h3>Select a Customer</h3>
                        <p>Click on a customer to view their purchase history and transactions</p>
                    </div>
                }
            </div>

            <!-- Right Main Area for Credits -->
            <div class="credits-main">
                <!-- Summary Dashboard -->
                <div class="dashboard-grid">
                    <div class="stat-card red">
                        <div class="stat-icon">💰</div>
                        <div class="stat-content">
                            <div class="stat-label">Customers Owe Us</div>
                            <div class="stat-value">€@totalDebt.ToString("N2")</div>
                            <div class="stat-meta">@customersWithDebt customers</div>
                        </div>
                    </div>

                    <div class="stat-card green">
                        <div class="stat-icon">✅</div>
                        <div class="stat-content">
                            <div class="stat-label">We Owe Customers</div>
                            <div class="stat-value">€@totalCredit.ToString("N2")</div>
                            <div class="stat-meta">@customersWithCredit customers</div>
                        </div>
                    </div>

                    <div class="stat-card blue">
                        <div class="stat-icon">⚖️</div>
                        <div class="stat-content">
                            <div class="stat-label">Balanced</div>
                            <div class="stat-value">@customersBalanced</div>
                            <div class="stat-meta">No outstanding balance</div>
                        </div>
                    </div>

                    <div class="stat-card purple">
                        <div class="stat-icon">👥</div>
                        <div class="stat-content">
                            <div class="stat-label">Total Customers</div>
                            <div class="stat-value">@customers.Count</div>
                            <div class="stat-meta">All customers</div>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="filters-bar">
                    <div class="search-container">
                        <span class="search-icon">🔍</span>
                        <input type="text"
                               placeholder="Search by customer name..."
                               @bind="searchTerm"
                               @bind:event="oninput"
                               class="search-input" />
                    </div>

                    <div class="filter-tabs">
                        <button class="filter-tab @(filterType == "all" ? "active" : "")"
                                @onclick='() => filterType = "all"'>
                            <span class="tab-label">All</span>
                            <span class="tab-count">@customers.Count</span>
                        </button>
                        <button class="filter-tab debt-tab @(filterType == "debt" ? "active" : "")"
                                @onclick='() => filterType = "debt"'>
                            <span class="tab-label">Owe Us</span>
                            <span class="tab-count">@customersWithDebt</span>
                        </button>
                        <button class="filter-tab credit-tab @(filterType == "credit" ? "active" : "")"
                                @onclick='() => filterType = "credit"'>
                            <span class="tab-label">We Owe</span>
                            <span class="tab-count">@customersWithCredit</span>
                        </button>
                        <button class="filter-tab zero-tab @(filterType == "zero" ? "active" : "")"
                                @onclick='() => filterType = "zero"'>
                            <span class="tab-label">Balanced</span>
                            <span class="tab-count">@customersBalanced</span>
                        </button>
                    </div>
                </div>

                <!-- Customers Table -->
                <div class="customers-container">
                    @if (!FilteredCustomers.Any())
                    {
                        <div class="empty-state small">
                            <span class="empty-icon">🔍</span>
                            <p>No customers match your search</p>
                        </div>
                    }
                    else
                    {
                        <div class="customers-list">
                            @foreach (var customer in FilteredCustomers)
                            {
                                <div class="customer-card @GetBalanceClass(customer.Balance) @(expandedCustomerId == customer.CustomerId ? "expanded" : "")">
                                    <div class="customer-header" @onclick="() => ToggleCustomerDetail(customer.CustomerId)">
                                        <div class="customer-info">
                                            <div class="customer-avatar">
                                                @GetInitial(customer.Name)
                                            </div>
                                            <div class="customer-details">
                                                <h3 class="customer-name">@customer.Name</h3>
                                                <div class="customer-meta">
                                                    <span class="status-badge @GetStatusClass(customer.Balance)">
                                                        @GetStatusText(customer.Balance)
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="customer-balance-section">
                                            <div class="balance-amount @GetBalanceClass(customer.Balance)">
                                                @if (customer.Balance > 0)
                                                {
                                                    <span class="balance-label">Owes:</span>
                                                }
                                                else if (customer.Balance < 0)
                                                {
                                                    <span class="balance-label">Credit:</span>
                                                }
                                                <span class="balance-value">€@Math.Abs(customer.Balance).ToString("N2")</span>
                                            </div>
                                            <div class="customer-actions">
                                                @if (customer.Balance > 0)
                                                {
                                                    <button class="btn-primary small" @onclick="() => OpenPaymentModal(customer)" @onclick:stopPropagation="true">
                                                        💵 Payment
                                                    </button>
                                                }
                                                else if (customer.Balance < 0)
                                                {
                                                    <button class="btn-warning small" @onclick="() => OpenRefundModal(customer)" @onclick:stopPropagation="true">
                                                        💸 Refund
                                                    </button>
                                                }
                                                <button type="button"
                                                        class="btn-ghost small"
                                                        @onclick="() => ToggleCustomerDetail(customer.CustomerId)"
                                                        @onclick:stopPropagation="true">
                                                    <span>@(expandedCustomerId == customer.CustomerId ? "▲" : "▼")</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Payment/Refund Modal -->
    @if (showPaymentModal && selectedCustomer != null)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-container"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="credit-transaction-title"
                 @onclick:stopPropagation="true">
                <div class="modal-header @(selectedCustomer.Balance < 0 ? "refund" : "payment")">
                    <h2 id="credit-transaction-title">
                        @if (selectedCustomer.Balance > 0)
                        {
                            <span>💵 Register Payment</span>
                        }
                        else
                        {
                            <span>💸 Issue Refund</span>
                        }
                    </h2>
                    <button type="button"
                            class="btn-close"
                            disabled="@isProcessing"
                            aria-label="Close"
                            @onclick="CloseModal">
                        &times;
                    </button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(modalErrorMessage))
                    {
                        <div class="alert alert-error" role="alert">
                            <span class="alert-icon">!</span>
                            <div class="alert-content">
                                <strong>Transaction rejected</strong>
                                <p>@modalErrorMessage</p>
                            </div>
                        </div>
                    }

                    <div class="customer-info-box">
                        <div class="info-row">
                            <span class="info-label">Customer:</span>
                            <strong>@selectedCustomer.Name</strong>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Current Balance:</span>
                            <strong class="@GetBalanceClass(selectedCustomer.Balance)">
                                €@Math.Abs(selectedCustomer.Balance).ToString("N2")
                            </strong>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            @(selectedCustomer.Balance > 0 ? "Payment Amount" : "Refund Amount")
                        </label>
                        <div class="input-group">
                            <span class="input-prefix">€</span>
                            <input type="number"
                                   step="0.01"
                                   min="0.01"
                                   max="@Math.Abs(selectedCustomer.Balance)"
                                   placeholder="0.00"
                                   @bind="paymentAmount"
                                   @bind:event="oninput"
                                   disabled="@isProcessing"
                                   class="form-input-large" />
                        </div>
                        <div class="form-hint">
                            Maximum: €@Math.Abs(selectedCustomer.Balance).ToString("N2")
                        </div>
                    </div>

                    <div class="quick-amounts-grid">
                        <button type="button"
                                class="quick-amount-btn"
                                disabled="@isProcessing"
                                @onclick="() => SetQuickAmount(0.25m)">
                            <span class="quick-label">25%</span>
                            <span class="quick-value">€@(RoundMoney(Math.Abs(selectedCustomer.Balance) * 0.25m).ToString("N2"))</span>
                        </button>
                        <button type="button"
                                class="quick-amount-btn"
                                disabled="@isProcessing"
                                @onclick="() => SetQuickAmount(0.50m)">
                            <span class="quick-label">50%</span>
                            <span class="quick-value">€@(RoundMoney(Math.Abs(selectedCustomer.Balance) * 0.50m).ToString("N2"))</span>
                        </button>
                        <button type="button"
                                class="quick-amount-btn"
                                disabled="@isProcessing"
                                @onclick="() => SetQuickAmount(0.75m)">
                            <span class="quick-label">75%</span>
                            <span class="quick-value">€@(RoundMoney(Math.Abs(selectedCustomer.Balance) * 0.75m).ToString("N2"))</span>
                        </button>
                        <button type="button"
                                class="quick-amount-btn primary"
                                disabled="@isProcessing"
                                @onclick="() => SetQuickAmount(1m)">
                            <span class="quick-label">Full</span>
                            <span class="quick-value">€@Math.Abs(selectedCustomer.Balance).ToString("N2")</span>
                        </button>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Description (Optional)</label>
                        <textarea placeholder="@(selectedCustomer.Balance > 0 ? "Payment notes..." : "Refund reason...")"
                                  @bind="paymentDescription"
                                  disabled="@isProcessing"
                                  rows="3"
                                  class="form-textarea"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="checkbox-container">
                            <input type="checkbox"
                                   @bind="isCash"
                                   disabled="@isProcessing" />
                            <span class="checkmark"></span>
                            <span class="checkbox-label">
                                Cash @(selectedCustomer.Balance > 0 ? "Payment" : "Refund")
                                <span class="checkbox-hint">(This will affect cash drawer balance)</span>
                            </span>
                        </label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-secondary"
                            @onclick="CloseModal"
                            disabled="@isProcessing">
                        Cancel
                    </button>
                    <button type="button"
                            class="btn-primary @(selectedCustomer.Balance < 0 ? "refund" : "")"
                            @onclick="ProcessTransactionAsync"
                            disabled="@(isProcessing || !CanProcessTransaction)">
                        @if (isProcessing)
                        {
                            <span class="spinner-small"></span>
                            <span>Processing...</span>
                        }
                        else if (selectedCustomer.Balance > 0)
                        {
                            <span>💵 Register €@paymentAmount.ToString("N2")</span>
                        }
                        else
                        {
                            <span>💸 Refund €@paymentAmount.ToString("N2")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Success Toast -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="toast-success">
            <span class="toast-icon"></span>
            <span>@successMessage</span>
        </div>
    }
</div>
@code {
    private List<LocalCustomerCreditResult>? customers;
    private LocalCustomerCreditResult? selectedCustomer;
    private LocalCustomerDetailResult? customerDetail;

    private bool showPaymentModal;
    private bool isProcessing;
    private bool isLoadingDetail;
    private bool isLoading;
    private bool isCash = true;

    private decimal paymentAmount;
    private string paymentDescription = string.Empty;
    private string searchTerm = string.Empty;
    private string filterType = "debt";
    private string activeTab = "purchases";

    private string? errorMessage;
    private string? modalErrorMessage;
    private string? successMessage;
    private Guid? expandedCustomerId;
    private CancellationTokenSource? toastCancellation;

    private int customersWithDebt =>
        customers?.Count(customer =>
            customer.Balance > 0m) ??
        0;

    private int customersWithCredit =>
        customers?.Count(customer =>
            customer.Balance < 0m) ??
        0;

    private int customersBalanced =>
        customers?.Count(customer =>
            customer.Balance == 0m) ??
        0;

    private decimal totalDebt =>
        customers?
            .Where(customer =>
                customer.Balance > 0m)
            .Sum(customer =>
                customer.Balance) ??
        0m;

    private decimal totalCredit =>
        customers?
            .Where(customer =>
                customer.Balance < 0m)
            .Sum(customer =>
                Math.Abs(customer.Balance)) ??
        0m;

    private bool CanProcessTransaction
    {
        get
        {
            if (selectedCustomer is null)
            {
                return false;
            }

            var amount =
                RoundMoney(paymentAmount);

            var maximumAmount =
                RoundMoney(
                    Math.Abs(
                        selectedCustomer.Balance));

            return
                amount > 0m &&
                amount <= maximumAmount;
        }
    }

    private IEnumerable<LocalCustomerCreditResult>
        FilteredCustomers
    {
        get
        {
            if (customers is null)
            {
                return Enumerable.Empty<LocalCustomerCreditResult>();
            }

            var filtered = customers.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(
                    searchTerm))
            {
                filtered =
                    filtered.Where(customer =>
                        customer.Name.Contains(
                            searchTerm.Trim(),
                            StringComparison.OrdinalIgnoreCase));
            }

            filtered =
                filterType switch
                {
                    "debt" =>
                        filtered.Where(customer =>
                            customer.Balance > 0m),

                    "credit" =>
                        filtered.Where(customer =>
                            customer.Balance < 0m),

                    "zero" =>
                        filtered.Where(customer =>
                            customer.Balance == 0m),

                    _ =>
                        filtered
                };

            return filtered
                .OrderByDescending(customer =>
                    Math.Abs(customer.Balance))
                .ThenBy(customer =>
                    customer.Name,
                    StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading =
            true;

        errorMessage =
            null;

        try
        {
            customers =
                await LocalCustomerCreditService
                    .GetCustomersWithBalanceAsync();

            if (expandedCustomerId.HasValue)
            {
                customerDetail =
                    await LocalCustomerCreditService
                        .GetCustomerDetailAsync(
                            expandedCustomerId.Value);

                if (customerDetail is null)
                {
                    expandedCustomerId =
                        null;
                }
            }
        }
        catch (Exception exception)
        {
            errorMessage =
                $"Failed to load customer credits: " +
                exception
                    .GetBaseException()
                    .Message;
        }
        finally
        {
            isLoading =
                false;
        }
    }

    private async Task ToggleCustomerDetail(
        Guid customerId)
    {
        if (isLoadingDetail)
        {
            return;
        }

        if (expandedCustomerId == customerId)
        {
            expandedCustomerId =
                null;

            customerDetail =
                null;

            return;
        }

        expandedCustomerId =
            customerId;

        customerDetail =
            null;

        activeTab =
            "purchases";

        errorMessage =
            null;

        isLoadingDetail =
            true;

        try
        {
            customerDetail =
                await LocalCustomerCreditService
                    .GetCustomerDetailAsync(
                        customerId);

            if (customerDetail is null)
            {
                expandedCustomerId =
                    null;

                errorMessage =
                    "The selected local customer was not found.";
            }
        }
        catch (Exception exception)
        {
            expandedCustomerId =
                null;

            customerDetail =
                null;

            errorMessage =
                $"Failed to load customer details: " +
                exception
                    .GetBaseException()
                    .Message;
        }
        finally
        {
            isLoadingDetail =
                false;
        }
    }

    private void OpenPaymentModal(
        LocalCustomerCreditResult customer)
    {
        if (customer.Balance <= 0m)
        {
            return;
        }

        OpenTransactionModal(
            customer);
    }

    private void OpenRefundModal(
        LocalCustomerCreditResult customer)
    {
        if (customer.Balance >= 0m)
        {
            return;
        }

        OpenTransactionModal(
            customer);
    }

    private void OpenTransactionModal(
        LocalCustomerCreditResult customer)
    {
        selectedCustomer =
            customer;

        showPaymentModal =
            true;

        paymentAmount =
            0m;

        paymentDescription =
            string.Empty;

        modalErrorMessage =
            null;

        isCash =
            true;
    }

    private void CloseModal()
    {
        if (isProcessing)
        {
            return;
        }

        ResetTransactionModal();
    }

    private void ResetTransactionModal()
    {
        showPaymentModal =
            false;

        selectedCustomer =
            null;

        paymentAmount =
            0m;

        paymentDescription =
            string.Empty;

        modalErrorMessage =
            null;

        isCash =
            true;
    }

    private void SetQuickAmount(
        decimal percentage)
    {
        if (selectedCustomer is null ||
            isProcessing)
        {
            return;
        }

        paymentAmount =
            RoundMoney(
                Math.Abs(
                    selectedCustomer.Balance) *
                Math.Clamp(
                    percentage,
                    0m,
                    1m));

        modalErrorMessage =
            null;
    }

    private async Task ProcessTransactionAsync()
    {
        if (selectedCustomer is null ||
            isProcessing)
        {
            return;
        }

        var customer =
            selectedCustomer;

        var isPayment =
            customer.Balance > 0m;

        var isRefund =
            customer.Balance < 0m;

        var amount =
            RoundMoney(
                paymentAmount);

        var maximumAmount =
            RoundMoney(
                Math.Abs(
                    customer.Balance));

        modalErrorMessage =
            null;

        errorMessage =
            null;

        if (!isPayment && !isRefund)
        {
            modalErrorMessage =
                "The customer balance is already settled.";

            return;
        }

        if (amount <= 0m)
        {
            modalErrorMessage =
                $"{(isPayment ? "Payment" : "Refund")} " +
                "amount must be greater than zero.";

            return;
        }

        if (amount > maximumAmount)
        {
            modalErrorMessage =
                $"{(isPayment ? "Payment" : "Refund")} amount " +
                $"cannot exceed €{maximumAmount:N2}.";

            return;
        }

        isProcessing =
            true;

        try
        {
            var clientOperationId =
                Guid.NewGuid();

            var transactionDateUtc =
                DateTime.UtcNow;

            var description =
                NormalizeNullable(
                    paymentDescription);

            if (isPayment)
            {
                await LocalCustomerCreditService
                    .RegisterPaymentAsync(
                        new RegisterCustomerPaymentRequest
                        {
                            ClientOperationId =
                                clientOperationId,

                            CustomerId =
                                customer.CustomerId,

                            Amount =
                                amount,

                            Description =
                                description,

                            IsCash =
                                isCash,

                            TransactionDateUtc =
                                transactionDateUtc
                        });
            }
            else
            {
                await LocalCustomerCreditService
                    .RegisterRefundAsync(
                        new RegisterCustomerRefundRequest
                        {
                            ClientOperationId =
                                clientOperationId,

                            CustomerId =
                                customer.CustomerId,

                            Amount =
                                amount,

                            Description =
                                description,

                            IsCash =
                                isCash,

                            TransactionDateUtc =
                                transactionDateUtc
                        });
            }

            var customerName =
                customer.Name;

            ResetTransactionModal();

            await LoadCustomersAsync();

            ShowSuccess(
                isPayment
                    ? $"Payment of €{amount:N2} registered locally " +
                      $"for {customerName}."
                    : $"Refund of €{amount:N2} registered locally " +
                      $"for {customerName}.");
        }
        catch (Exception exception)
        {
            modalErrorMessage =
                $"Failed to process the transaction: " +
                exception
                    .GetBaseException()
                    .Message;
        }
        finally
        {
            isProcessing =
                false;
        }
    }

    private void ShowSuccess(
        string message)
    {
        successMessage =
            message;

        toastCancellation?
            .Cancel();

        toastCancellation?
            .Dispose();

        toastCancellation =
            new CancellationTokenSource();

        _ = ClearSuccessAfterDelayAsync(
            toastCancellation.Token);
    }

    private async Task ClearSuccessAfterDelayAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(
                TimeSpan.FromSeconds(3),
                cancellationToken);

            await InvokeAsync(() =>
            {
                successMessage =
                    null;

                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // A newer notification replaced this one.
        }
    }

    private void ClearError()
    {
        errorMessage =
            null;
    }

    private static string GetBalanceClass(
        decimal balance)
    {
        if (balance > 0m)
        {
            return "debt";
        }

        if (balance < 0m)
        {
            return "credit";
        }

        return "zero";
    }

    private static string GetStatusClass(
        decimal balance)
    {
        if (balance > 0m)
        {
            return "status-debt";
        }

        if (balance < 0m)
        {
            return "status-credit";
        }

        return "status-zero";
    }

    private static string GetStatusText(
        decimal balance)
    {
        if (balance > 0m)
        {
            return "Owes Us";
        }

        if (balance < 0m)
        {
            return "We Owe";
        }

        return "Balanced";
    }

    private static string GetTransactionTypeClass(
        string? type)
    {
        return type?.Trim()
            .ToLowerInvariant() switch
        {
            "payment" =>
                "type-payment",

            "refund" =>
                "type-refund",

            "credit" =>
                "type-credit",

            _ =>
                string.Empty
        };
    }

    private static string GetTransactionIcon(
        string? type)
    {
        return type?.Trim()
            .ToLowerInvariant() switch
        {
            "payment" =>
                "💵",

            "refund" =>
                "💸",

            "credit" =>
                "🛒",

            _ =>
                "📝"
        };
    }

    private static string GetInitial(
        string? name)
    {
        return string.IsNullOrWhiteSpace(name)
            ? "?"
            : name.Trim()[0]
                .ToString()
                .ToUpperInvariant();
    }

    private static string? NormalizeNullable(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

    private static decimal RoundMoney(
        decimal value)
    {
        return Math.Round(
            value,
            2,
            MidpointRounding.AwayFromZero);
    }

    public void Dispose()
    {
        toastCancellation?
            .Cancel();

        toastCancellation?
            .Dispose();
    }
}
