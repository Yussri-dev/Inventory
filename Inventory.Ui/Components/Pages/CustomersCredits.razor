@page "/customer-credits"
@using Inventory.Dto.CustomerTransactions.Requests
@using Inventory.Dto.CustomerTransactions.Results
@using Inventory.Ui.Interfaces

<div class="page-container">
    <div class="header">
        <h1>Customer Credit Management</h1>
        <button class="btn-refresh" @onclick="LoadCustomersAsync">
            <span class="icon">🔄</span> Refresh
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading customers...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">
            <strong>Error:</strong> @errorMessage
        </div>
    }
    else if (customers == null || !customers.Any())
    {
        <div class="empty-state">
            <p>No customer transactions found.</p>
        </div>
    }
    else
    {
        <div class="summary-cards">
            <div class="summary-card debt">
                <div class="summary-header">
                    <span class="icon">💰</span>
                    <h3>Customers Owe Us</h3>
                </div>
                <div class="summary-body">
                    <div class="summary-value">@customersWithDebt</div>
                    <div class="summary-label">Customers</div>
                    <div class="summary-amount debt-amount">@totalDebt.ToString("C2")</div>
                </div>
            </div>

            <div class="summary-card credit">
                <div class="summary-header">
                    <span class="icon">✅</span>
                    <h3>We Owe Customers</h3>
                </div>
                <div class="summary-body">
                    <div class="summary-value">@customersWithCredit</div>
                    <div class="summary-label">Customers</div>
                    <div class="summary-amount credit-amount">@totalCredit.ToString("C2")</div>
                </div>
            </div>

            <div class="summary-card zero">
                <div class="summary-header">
                    <span class="icon">⚖️</span>
                    <h3>Balanced</h3>
                </div>
                <div class="summary-body">
                    <div class="summary-value">@customersBalanced</div>
                    <div class="summary-label">Customers</div>
                </div>
            </div>
        </div>

        <div class="filters">
            <div class="search-box">
                <input type="text"
                       placeholder="Search by customer name..."
                       @bind="searchTerm"
                       @bind:event="oninput"
                       class="search-input" />
            </div>

            <div class="filter-buttons">
                <button class="filter-btn @(filterType == "all" ? "active" : "")"
                        @onclick='() => filterType = "all"'>
                    All (@customers.Count)
                </button>
                <button class="filter-btn debt @(filterType == "debt" ? "active" : "")"
                        @onclick='() => filterType = "debt"'>
                    Owe Us (@customersWithDebt)
                </button>
                <button class="filter-btn credit @(filterType == "credit" ? "active" : "")"
                        @onclick='() => filterType = "credit"'>
                    We Owe (@customersWithCredit)
                </button>
                <button class="filter-btn zero @(filterType == "zero" ? "active" : "")"
                        @onclick='() => filterType = "zero"'>
                    Balanced (@customersBalanced)
                </button>
            </div>
        </div>

        <div class="customers-list">
            <table class="customers-table">
                <thead>
                    <tr>
                        <th>Customer Name</th>
                        <th class="text-right">Balance</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in FilteredCustomers)
                    {
                        <tr class="customer-row">
                            <td class="customer-name">
                                <strong>@customer.Name</strong>
                            </td>
                            <td class="text-right">
                                <span class="balance @GetBalanceClass(customer.Balance)">
                                    @customer.Balance.ToString("C2")
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="status-badge @GetStatusClass(customer.Balance)">
                                    @GetStatusText(customer.Balance)
                                </span>
                            </td>
                            <td class="text-center">
                                @if (customer.Balance > 0)
                                {
                                    <button class="btn-action" @onclick="() => OpenPaymentModal(customer)">
                                        Register Payment
                                    </button>
                                }
                                else if (customer.Balance < 0)
                                {
                                    <button class="btn-action refund" @onclick="() => OpenRefundModal(customer)">
                                        Issue Refund
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">No action needed</span>
                                }
                            </td>
                        </tr>
                        @if (selectedCustomer?.CustomerId == customer.CustomerId && showPaymentModal)
                        {
                            <tr class="payment-row">
                                <td colspan="4">
                                    <div class="payment-form @(customer.Balance < 0 ? "refund-form" : "")">
                                        <h4>
                                            @if (customer.Balance > 0)
                                            {
                                                <span>Register Payment for @customer.Name</span>
                                            }
                                            else
                                            {
                                                <span>Issue Refund to @customer.Name</span>
                                            }
                                        </h4>

                                        <div class="balance-info">
                                            @if (customer.Balance > 0)
                                            {
                                                <p>Customer owes: <strong class="debt">@customer.Balance.ToString("C2")</strong></p>
                                            }
                                            else
                                            {
                                                <p>We owe customer: <strong class="credit">@Math.Abs(customer.Balance).ToString("C2")</strong></p>
                                            }
                                        </div>

                                        <div class="form-row">
                                            <div class="form-group">
                                                <label>
                                                    @(customer.Balance > 0 ? "Payment Amount" : "Refund Amount")
                                                </label>
                                                <input type="number"
                                                       step="0.01"
                                                       min="0.01"
                                                       max="@Math.Abs(customer.Balance)"
                                                       placeholder="0.00"
                                                       @bind="paymentAmount"
                                                       @bind:event="oninput"
                                                       class="form-input" />
                                            </div>

                                            <div class="form-group">
                                                <label>Description (Optional)</label>
                                                <input type="text"
                                                       placeholder="@(customer.Balance > 0 ? "Payment description..." : "Refund reason...")"
                                                       @bind="paymentDescription"
                                                       class="form-input" />
                                            </div>
                                        </div>

                                        <div class="form-row">
                                            <div class="form-group">
                                                <label class="checkbox-label">
                                                    <input type="checkbox" @bind="isCash" />
                                                    <span>Cash @(customer.Balance > 0 ? "Payment" : "Refund")</span>
                                                </label>
                                            </div>
                                        </div>

                                        <div class="quick-amounts">
                                            <button class="btn-quick" @onclick="() => paymentAmount = Math.Round(Math.Abs(customer.Balance) * 0.25m, 2)">
                                                25% (@(Math.Round(Math.Abs(customer.Balance) * 0.25m, 2).ToString("C2")))
                                            </button>
                                            <button class="btn-quick" @onclick="() => paymentAmount = Math.Round(Math.Abs(customer.Balance) * 0.5m, 2)">
                                                50% (@(Math.Round(Math.Abs(customer.Balance) * 0.5m, 2).ToString("C2")))
                                            </button>
                                            <button class="btn-quick" @onclick="() => paymentAmount = Math.Round(Math.Abs(customer.Balance) * 0.75m, 2)">
                                                75% (@(Math.Round(Math.Abs(customer.Balance) * 0.75m, 2).ToString("C2")))
                                            </button>
                                            <button class="btn-quick" @onclick="() => paymentAmount = Math.Abs(customer.Balance)">
                                                Full (@Math.Abs(customer.Balance).ToString("C2"))
                                            </button>
                                        </div>

                                        <div class="form-actions">
                                            <button class="btn-cancel" @onclick="CloseModal">
                                                Cancel
                                            </button>
                                            <button class="btn-submit @(customer.Balance < 0 ? "refund-btn" : "")"
                                                    @onclick="() => ProcessTransactionAsync(customer.Balance > 0)"
                                                    disabled="@isProcessing">
                                                @if (isProcessing)
                                                {
                                                    <span>Processing...</span>
                                                }
                                                else if (customer.Balance > 0)
                                                {
                                                    <span>Register Payment</span>
                                                }
                                                else
                                                {
                                                    <span>Issue Refund</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }
</div>

@code {
    [Inject] private ICustomerTransactionsApi CustomerTransactionsApi { get; set; } = default!;

    private List<CustomerCreditResult>? customers;
    private CustomerCreditResult? selectedCustomer;
    private bool showPaymentModal = false;

    private decimal paymentAmount = 0;
    private string paymentDescription = string.Empty;
    private bool isCash = true;
    private bool isProcessing = false;

    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;
    private string searchTerm = string.Empty;
    private string filterType = "debt";

    private int customersWithDebt => customers?.Count(c => c.Balance > 0) ?? 0;
    private int customersWithCredit => customers?.Count(c => c.Balance < 0) ?? 0;
    private int customersBalanced => customers?.Count(c => c.Balance == 0) ?? 0;
    private decimal totalDebt => customers?.Where(c => c.Balance > 0).Sum(c => c.Balance) ?? 0;
    private decimal totalCredit => customers?.Where(c => c.Balance < 0).Sum(c => Math.Abs(c.Balance)) ?? 0;

    private IEnumerable<CustomerCreditResult> FilteredCustomers
    {
        get
        {
            if (customers == null) return Enumerable.Empty<CustomerCreditResult>();

            var filtered = customers.AsEnumerable();

            // Apply search filter
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(c => c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            // Apply type filter
            filtered = filterType switch
            {
                "debt" => filtered.Where(c => c.Balance > 0),
                "credit" => filtered.Where(c => c.Balance < 0),
                "zero" => filtered.Where(c => c.Balance == 0),
                _ => filtered
            };

            return filtered.OrderByDescending(c => Math.Abs(c.Balance));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            customers = await CustomerTransactionsApi.GetCustomersWithBalance();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load customers: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenPaymentModal(CustomerCreditResult customer)
    {
        selectedCustomer = customer;
        showPaymentModal = true;
        paymentAmount = 0;
        paymentDescription = string.Empty;
        isCash = true;
    }

    private void OpenRefundModal(CustomerCreditResult customer)
    {
        selectedCustomer = customer;
        showPaymentModal = true;
        paymentAmount = 0;
        paymentDescription = string.Empty;
        isCash = true;
    }

    private void CloseModal()
    {
        selectedCustomer = null;
        showPaymentModal = false;
        paymentAmount = 0;
        paymentDescription = string.Empty;
    }

    private async Task ProcessTransactionAsync(bool isPayment)
    {
        if (selectedCustomer == null) return;

        errorMessage = null;
        successMessage = null;
        isProcessing = true;

        try
        {
            if (paymentAmount <= 0)
            {
                errorMessage = $"{(isPayment ? "Payment" : "Refund")} amount must be greater than zero.";
                isProcessing = false;
                return;
            }

            var maxAmount = Math.Abs(selectedCustomer.Balance);
            if (paymentAmount > maxAmount)
            {
                errorMessage = $"{(isPayment ? "Payment" : "Refund")} amount cannot exceed {maxAmount:C2}.";
                isProcessing = false;
                return;
            }

            if (isPayment)
            {
                var request = new RegisterCustomerPaymentRequest
                {
                    CustomerId = selectedCustomer.CustomerId,
                    Amount = paymentAmount,
                    Description = string.IsNullOrWhiteSpace(paymentDescription) ? null : paymentDescription,
                    IsCash = isCash
                };

                await CustomerTransactionsApi.RegisterPayment(request);
                successMessage = $"Payment of {paymentAmount:C2} registered successfully for {selectedCustomer.Name}!";
            }
            else
            {
                var request = new RegisterCustomerRefundRequest
                {
                    CustomerId = selectedCustomer.CustomerId,
                    Amount = paymentAmount,
                    Description = string.IsNullOrWhiteSpace(paymentDescription) ? null : paymentDescription,
                    IsCash = isCash
                };

                await CustomerTransactionsApi.RegisterRefund(request);
                successMessage = $"Refund of {paymentAmount:C2} issued successfully to {selectedCustomer.Name}!";
            }

            CloseModal();

            await Task.Delay(1500);
            successMessage = null;
            await LoadCustomersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to process transaction: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetBalanceClass(decimal balance)
    {
        if (balance > 0) return "debt";
        if (balance < 0) return "credit";
        return "zero";
    }

    private string GetStatusClass(decimal balance)
    {
        if (balance > 0) return "status-debt";
        if (balance < 0) return "status-credit";
        return "status-zero";
    }

    private string GetStatusText(decimal balance)
    {
        if (balance > 0) return "Owes Us";
        if (balance < 0) return "We Owe";
        return "Balanced";
    }
}