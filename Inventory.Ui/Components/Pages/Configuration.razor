            ErrorMessage = "Le nom complet est obligatoire.")]
        [MaxLength(
            200,
            ErrorMessage = "Le nom ne peut pas dépasser 200 caractères.")]
        public string FullName { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "L’adresse email est obligatoire.")]
        [EmailAddress(
            ErrorMessage = "L’adresse email n’est pas valide.")]
        public string Email { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Le mot de passe est obligatoire.")]
        [MinLength(
            8,
            ErrorMessage =
                "Le mot de passe doit contenir au moins 8 caractères.")]
        public string Password { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "La confirmation est obligatoire.")]
        [Compare(
            nameof(Password),
            ErrorMessage = "Les mots de passe ne correspondent pas.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Le rôle est obligatoire.")]
        public UserRole Role { get; set; } = UserRole.Cashier;
    }

