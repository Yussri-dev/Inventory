@page "/saleshistory"

@using Inventory.LocalDB.Models
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.LocalDB.Services.Results
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging

@inject ILocalSalesHistoryService LocalHistory
@inject ILogger<SalesHistory> Logger

<div class="sale-container">

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert error" style="margin:0.5rem 0;">
            <span>@errorMessage</span>
            <button @onclick="() => errorMessage = null">×</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(infoMessage))
    {
        <div class="alert success" style="margin:0.5rem 0;">
            <span>@infoMessage</span>
            <button @onclick="() => infoMessage = null">×</button>
        </div>
    }

    <div class="card local-source-banner">
        <div>
            <strong>Local-first sales history</strong>
            <span class="muted">
                The page always reads from SQLite and remains available offline.
            </span>
        </div>

        <button class="btn btn-secondary"
                disabled="@isLoadingData"
                @onclick="ReloadAsync">
            @(isLoadingData ? "Loading..." : "Refresh local data")
        </button>
    </div>

    <div class="sale-left">

        <div class="card header-section">
            <div class="pager">
                <button class="btn ghost"
                        disabled="@(currentPage <= 1 || isLoadingData)"
                        @onclick="PreviousPageAsync">
                    Prev
                </button>

                <span class="muted">
                    Page @currentPage of @DisplayedTotalPages
                </span>

                <button class="btn ghost"
                        disabled="@(currentPage >= TotalPages || isLoadingData)"
                        @onclick="NextPageAsync">
                    Next
                </button>
            </div>
        </div>

        <div class="card cart-table">
            @if (isLoadingData)
            {
                <div class="loading-state">
                    Loading sales from SQLite...
                </div>
            }
            else if (sales.Count == 0)
            {
                <div class="empty-state">
                    <p>No local sales found</p>
                    <p class="muted">
                        Adjust the filters or synchronize sales on this device.
                    </p>
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th style="width:110px;">Total</th>
                                <th style="width:110px;">Paid</th>
                                <th style="width:110px;">Change</th>
                                <th style="width:110px;">Status</th>
                                <th style="width:110px;">Payment</th>
                                <th style="width:110px;">Sync</th>
                                <th style="width:100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in sales)
                            {
                                <tr class="clickable-sale-row"
                                    @onclick="() => OpenSaleDetailsAsync(sale.LocalId)"
                                    title="Open sale details">
                                    <td>
                                        <strong>@sale.InvoiceNumber</strong>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        sale.ServerInvoiceNumber) &&
                                                                        !string.Equals(
                                                                        sale.ServerInvoiceNumber,
                                                                        sale.LocalInvoiceNumber,
                                                                        StringComparison.OrdinalIgnoreCase))
                                        {
                                            <small class="muted invoice-local">
                                                Local: @sale.LocalInvoiceNumber
                                            </small>
                                        }
                                </td>

                                <td>
                                    @(sale.SaleDateUtc
                                                                    .ToLocalTime()
                                                                    .ToString("dd/MM/yyyy HH:mm"))
                            </td>

                                    <td>
                                @if (!sale.CustomerLocalId.HasValue)
                                        {
                                            <span class="muted">Walk-in</span>
                                        }
                                        else
                                        {
                                            <span>
                                                @(sale.CustomerName ?? "Local customer")
                                            </span>
                                        }
                                    </td>

                                    <td class="text-right">
                                        €@sale.TotalAmount.ToString("F2")
                                    </td>

                                    <td class="text-right">
                                        €@sale.PaidAmount.ToString("F2")
                                    </td>

                                    <td class="text-right">
                                        €@sale.ChangeAmount.ToString("F2")
                                    </td>

                                    <td>
                                        <span class="status-badge @GetSaleStatusClass(sale.Status)">
                                            @sale.Status
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-badge @GetPaymentStatusClass(sale.PaymentStatus)">
                                            @sale.PaymentStatus
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-badge @GetSyncStatusClass(sale.SyncStatus)">
                                            @GetSyncStatusLabel(sale.SyncStatus)
                                        </span>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn ghost"
                                                @onclick="() => OpenSaleDetailsAsync(sale.LocalId)"
                                                @onclick:stopPropagation="true">
                                            Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="totals-row">
            <div class="total-item">
                <span class="total-label">Total sales</span>
                <strong class="total-value primary">@totalCount</strong>
            </div>

            <div class="total-item">
                <span class="total-label">Revenue on page</span>
                <strong class="total-value primary">
                    €@PageRevenue.ToString("F2")
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Pending sync on page</span>
                <strong class="total-value primary">
                    @PendingSyncOnPage
                </strong>
            </div>

            <div class="total-item">
                <span class="total-label">Page</span>
                <strong class="total-value primary">
                    @currentPage / @DisplayedTotalPages
                </strong>
            </div>
        </div>
    </div>

    <div class="sale-right">

        <div class="card search-section">
            <label class="filter-title">📅 Date range</label>

            <div class="filter-column">
                <div>
                    <label class="muted filter-label">From</label>
                    <input type="date"
                           class="search-input"
                           @bind="dateFrom"
                           style="width:100%;" />
                </div>

                <div>
                    <label class="muted filter-label">To</label>
                    <input type="date"
                           class="search-input"
                           @bind="dateTo"
                           style="width:100%;" />
                </div>

                <div class="quick-filter-row">
                    <button class="btn btn-secondary"
                            @onclick="SetToday">
                        Today
                    </button>

                    <button class="btn btn-secondary"
                            @onclick="SetThisWeek">
                        This week
                    </button>

                    <button class="btn btn-secondary"
                            @onclick="SetThisMonth">
                        This month
                    </button>
                </div>
            </div>
        </div>

        <div class="card search-section">
            <label class="filter-title">👤 Customer</label>

            <div class="quick-filter-row customer-filter-row">
                <button class="btn @(customerFilter == CustomerFilter.All ? "btn-primary" : "btn-secondary")"
                        @onclick="() => SetCustomerFilter(CustomerFilter.All)">
                    All
                </button>

                <button class="btn @(customerFilter == CustomerFilter.WalkIn ? "btn-primary" : "btn-secondary")"
                        @onclick="() => SetCustomerFilter(CustomerFilter.WalkIn)">
                    Walk-in
                </button>

                <button class="btn @(customerFilter == CustomerFilter.WithCustomer ? "btn-primary" : "btn-secondary")"
                        @onclick="() => SetCustomerFilter(CustomerFilter.WithCustomer)">
                    Customers
                </button>
            </div>

            @if (customerFilter == CustomerFilter.WithCustomer)
            {
                <div class="search-box customer-search-box">
                    <input type="text"
                           class="search-input"
                           placeholder="Search a local customer..."
                           @bind="customerSearchTerm"
                           @bind:event="oninput"
                           @onkeyup="OnCustomerKeyUp" />

                    <span class="search-icon">🔍</span>
                </div>

                <button class="btn btn-secondary full-width"
                        @onclick="SearchCustomersAsync"
                        disabled="@isSearchingCustomer">
                    @(isSearchingCustomer
                                    ? "Searching SQLite..."
                                    : "Find local customer")
            </button>

            @if (customerResults != null)
                {
                    <ul class="product-list local-customer-list">
                        @foreach (var customer in customerResults)
                        {
                            <li class="product-item @(selectedCustomer?.LocalId == customer.LocalId ? "selected-customer" : "")"
                                @onclick="() => SelectCustomer(customer)">
                                <strong>@customer.Name</strong>

                                @if (!string.IsNullOrWhiteSpace(customer.Phone))
                                {
                                    <span class="muted">
                                        @customer.Phone
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (selectedCustomer != null)
                {
                    <div class="selected-local-customer">
                        <span>@selectedCustomer.Name</span>

                        <button class="btn btn-secondary compact-button"
                                @onclick="ClearSelectedCustomer">
                            ×
                        </button>
                    </div>
                }
            }
        </div>

        <div class="card search-section">
            <div>
                <strong class="title">Sales history</strong>
                <span class="muted">@totalCount result(s)</span>
            </div>

            <div class="filter-actions">
                @if (IsFiltered)
                {
                    <span class="stock-indicator low">
                        Filtered
                    </span>
                }

                <button class="btn btn-secondary"
                        @onclick="ResetFiltersAsync"
                        disabled="@isLoadingData">
                    Reset
                </button>

                <button class="btn btn-primary"
                        @onclick="ApplyFiltersAsync"
                        disabled="@isLoadingData">
                    @(isLoadingData ? "Loading..." : "Search SQLite")
                </button>
            </div>
        </div>

        <div class="card search-section">
            <label class="filter-title">💳 Payment status</label>

            <div class="filter-column">
                @foreach (var option in paymentStatusOptions)
                {
                    <label class="checkbox-label">
                        <input type="checkbox"
                               checked="@selectedPaymentStatuses.Contains(option)"
                               @onchange="eventArgs => TogglePaymentStatus(option, eventArgs)" />

                        <span class="status-badge @GetPaymentStatusClass(option)">
                            @option
                        </span>
                    </label>
                }
            </div>
        </div>

        <div class="card search-section">
            <label class="filter-title">📋 Sale status</label>

            <div class="filter-column">
                @foreach (var option in saleStatusOptions)
                {
                    <label class="checkbox-label">
                        <input type="checkbox"
                               checked="@selectedSaleStatuses.Contains(option)"
                               @onchange="eventArgs => ToggleSaleStatus(option, eventArgs)" />

                        <span class="status-badge @GetSaleStatusClass(option)">
                            @option
                        </span>
                    </label>
                }
            </div>
        </div>

        <div class="card search-section">
            <label class="filter-title">🔎 Invoice number</label>

            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Local or server invoice..."
                       @bind="invoiceSearch"
                       @bind:event="oninput"
                       @onkeyup="OnInvoiceKeyUp" />

                <span class="search-icon">🔍</span>
            </div>
        </div>
    </div>
</div>

@if (isLoadingDetails)
{
    <div class="details-loading-overlay">
        <div class="details-loading-card">
            <div class="details-spinner"></div>
            <strong>Loading sale details...</strong>
        </div>
    </div>
}

@if (selectedSaleDetails != null)
{
    <div class="modal-overlay sale-details-overlay"
         @onclick="CloseSaleDetails">

        <div class="modal-content sale-details-modal"
             @onclick:stopPropagation="true">

            <div class="modal-header sale-details-header">
                <div>
                    <span class="details-eyebrow">
                        Local sale
                    </span>

                    <h2>
                        @selectedSaleDetails.InvoiceNumber
                    </h2>

                    <span class="muted">
                        @(selectedSaleDetails.SaleDateUtc
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))
                                                                      </span>
                                                                  </div>

                <button type="button"
                        class="modal-close"
                        title="Close"
                        aria-label="Close sale details"
                        @onclick="CloseSaleDetails">
                    ×
                </button>
            </div>

            <div class="modal-body sale-details-body">
                <div class="sale-detail-summary">
                    <div class="detail-summary-item">
                        <span>Customer</span>
                        <strong>
                            @(selectedSaleDetails.CustomerName ??
                                                    "Walk-in customer")
                    </strong>
                </div>

                    <div class="detail-summary-item">
                        <span>Sale status</span>
                        <strong>
                            <span class="status-badge @GetSaleStatusClass(selectedSaleDetails.Status)">
                                @selectedSaleDetails.Status
                            </span>
                        </strong>
                    </div>

                    <div class="detail-summary-item">
                        <span>Payment</span>
                        <strong>
                            <span class="status-badge @GetPaymentStatusClass(selectedSaleDetails.PaymentStatus)">
                                @selectedSaleDetails.PaymentStatus
                            </span>
                        </strong>
                    </div>

                    <div class="detail-summary-item">
                        <span>Synchronization</span>
                        <strong>
                            <span class="status-badge @GetSyncStatusClass(selectedSaleDetails.SyncStatus)">
                                @GetSyncStatusLabel(selectedSaleDetails.SyncStatus)
                            </span>
                        </strong>
                    </div>
                </div>

                <section class="details-section">
                    <div class="details-section-header">
                        <div>
                            <span class="details-eyebrow">
                                Purchased items
                            </span>

                            <h3>Products</h3>
                        </div>

                        <span class="details-count">
                            @selectedSaleDetails.Lines.Count line(s)
                        </span>
                    </div>

                @if (selectedSaleDetails.Lines.Count == 0)
                    {
                        <div class="details-empty-state">
                            This sale contains no local sale lines.
                        </div>
                    }
                    else
                    {
                        <div class="details-table-scroll">
                            <table class="table details-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Unit price</th>
                                        <th>Discount</th>
                                        <th>VAT</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var line in
                                                                selectedSaleDetails.Lines)
                                    {
                                        <tr>
                                            <td>
                                                <strong>
                                                    @line.ProductName
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(
                                                                                    line.ProductBarcode))
                                                {
                                                    <small class="muted detail-product-barcode">
                                                        @line.ProductBarcode
                                                    </small>
                                                }
                                            </td>

                                            <td>
                                                @line.Quantity.ToString("0.###")
                                            </td>

                                            <td>
                                                €@line.UnitPrice.ToString("F2")
                                            </td>

                                            <td>
                                                @if (line.DiscountAmount > 0m)
                                                {
                                                    <span class="detail-discount">
                                                        − €@line.DiscountAmount.ToString("F2")
                                                    </span>

                                                    @if (line.DiscountPercent > 0m)
                                                    {
                                                        <small class="muted detail-product-barcode">
                                                            @line.DiscountPercent.ToString("0.##")%
                                                        </small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="muted">—</span>
                                                }
                                            </td>

                                            <td>
                                                €@line.VatAmount.ToString("F2")

                                                <small class="muted detail-product-barcode">
                                                    @line.VatRate.ToString("0.##")%
                                                </small>
                                            </td>

                                            <td>
                                                <strong>
                                                    €@line.LineTotal.ToString("F2")
                                                </strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <div class="details-bottom-grid">
                    <section class="details-section payments-section">
                        <div class="details-section-header">
                            <div>
                                <span class="details-eyebrow">
                                    Transaction
                                </span>

                                <h3>Payments</h3>
                            </div>

                            <span class="details-count">
                                @selectedSaleDetails.Payments.Count
                            </span>
                        </div>

                        @if (selectedSaleDetails.Payments.Count == 0)
                        {
                            <div class="details-empty-state">
                                No local payment registered.
                            </div>
                        }
                        else
                        {
                            <div class="payment-details-list">
                                @foreach (var payment in
                                                        selectedSaleDetails.Payments)
                                {
                                    <div class="payment-detail-row">
                                        <div>
                                            <strong>
                                                @payment.Method
                                            </strong>

                                            <span class="muted">
                                                @(payment.PaidAtUtc
                                                                                    .ToLocalTime()
                                                                                    .ToString("dd/MM/yyyy HH:mm"))
                                </span>

                                @if (!string.IsNullOrWhiteSpace(
                                                                payment.TransactionReference))
                                            {
                                                <small class="muted">
                                                    @payment.TransactionReference
                                                </small>
                                            }
                                        </div>

                                        <strong class="payment-detail-amount">
                                            €@payment.Amount.ToString("F2")
                                        </strong>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="details-totals-card">
                        <div class="details-total-row">
                            <span>Subtotal</span>
                            <strong>
                                €@selectedSaleDetails.SubtotalAmount.ToString("F2")
                            </strong>
                        </div>

                        <div class="details-total-row">
                            <span>Discount</span>
                            <strong class="detail-discount">
                                − €@selectedSaleDetails.DiscountAmount.ToString("F2")
                            </strong>
                        </div>

                        <div class="details-total-row">
                            <span>VAT</span>
                            <strong>
                                €@selectedSaleDetails.VatAmount.ToString("F2")
                            </strong>
                        </div>

                        <div class="details-total-row details-grand-total">
                            <span>Total</span>
                            <strong>
                                €@selectedSaleDetails.TotalAmount.ToString("F2")
                            </strong>
                        </div>

                        <div class="details-total-row">
                            <span>Paid</span>
                            <strong>
                                €@selectedSaleDetails.PaidAmount.ToString("F2")
                            </strong>
                        </div>

                        <div class="details-total-row">
                            <span>Change</span>
                            <strong>
                                €@selectedSaleDetails.ChangeAmount.ToString("F2")
                            </strong>
                        </div>
                    </section>
                </div>
            </div>

            <div class="modal-footer sale-details-footer">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CloseSaleDetails">
                    Close
                </button>
            </div>
        </div>
    </div>
}


@code {
    private string? errorMessage;
    private string? infoMessage;

    private bool isLoadingData;
    private bool isSearchingCustomer;

    private List<LocalSalesHistoryItemResult> sales = new();

    private int currentPage = 1;
    private const int PageSize = 25;
    private int totalCount;

    private DateTime? dateFrom;
    private DateTime? dateTo;

    private CustomerFilter customerFilter =
        CustomerFilter.All;

    private string customerSearchTerm =
        string.Empty;

    private List<LocalSalesHistoryCustomerResult>? customerResults;

    private LocalSalesHistoryCustomerResult? selectedCustomer;

    private LocalSalesHistoryDetailsResult? selectedSaleDetails;

    private bool isLoadingDetails;

    private async Task OpenSaleDetailsAsync(
        Guid localSaleId)
    {
        if (isLoadingDetails)
        {
            return;
        }

        isLoadingDetails = true;
        errorMessage = null;

        try
        {
            selectedSaleDetails =
                await LocalHistory.GetByIdAsync(
                    localSaleId);

            if (selectedSaleDetails == null)
            {
                errorMessage =
                    "The selected local sale was not found.";
            }
        }
        catch (Exception exception)
        {
            errorMessage =
                "Error loading sale details: " +
                exception.GetBaseException().Message;

            Logger.LogError(
                exception,
                "Failed to load local sale {LocalSaleId}.",
                localSaleId);
        }
        finally
        {
            isLoadingDetails = false;
        }
    }

    private void CloseSaleDetails()
    {
        selectedSaleDetails = null;
    }
    private readonly List<string> paymentStatusOptions =
        new()
        {
            "Paid",
            "Partial",
            "Unpaid",
            "Refunded",
            "Cancelled"
        };

    private readonly List<string> saleStatusOptions =
        new()
        {
            "Completed",
            "Pending",
            "Cancelled"
        };

    private readonly HashSet<string> selectedPaymentStatuses =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly HashSet<string> selectedSaleStatuses =
        new(StringComparer.OrdinalIgnoreCase);

    private string invoiceSearch =
        string.Empty;

    private int TotalPages =>
        totalCount == 0
            ? 0
            : (int)Math.Ceiling(
                (double)totalCount /
                PageSize);

    private int DisplayedTotalPages =>
        Math.Max(
            1,
            TotalPages);

    private decimal PageRevenue =>
        sales.Sum(sale =>
            sale.TotalAmount);

    private int PendingSyncOnPage =>
        sales.Count(sale =>
            !string.Equals(
                sale.SyncStatus,
                SyncQueueStatus.Done,
                StringComparison.OrdinalIgnoreCase));

    private bool IsFiltered =>
        dateFrom.HasValue ||
        dateTo.HasValue ||
        customerFilter != CustomerFilter.All ||
        selectedPaymentStatuses.Count > 0 ||
        selectedSaleStatuses.Count > 0 ||
        !string.IsNullOrWhiteSpace(invoiceSearch);

    protected override async Task OnInitializedAsync()
    {
        SetThisMonth();

        await LoadSalesAsync();
    }

    private void SetToday()
    {
        dateFrom =
            DateTime.Today;

        dateTo =
            DateTime.Today;
    }

    private void SetThisWeek()
    {
        var today =
            DateTime.Today;

        var daysSinceMonday =
            ((int)today.DayOfWeek + 6) % 7;

        dateFrom =
            today.AddDays(
                -daysSinceMonday);

        dateTo =
            today;
    }

    private void SetThisMonth()
    {
        var today =
            DateTime.Today;

        dateFrom =
            new DateTime(
                today.Year,
                today.Month,
                1);

        dateTo =
            today;
    }

    private void SetCustomerFilter(
        CustomerFilter filter)
    {
        customerFilter =
            filter;

        selectedCustomer =
            null;

        customerResults =
            null;

        customerSearchTerm =
            string.Empty;
    }

    private async Task OnCustomerKeyUp(
        KeyboardEventArgs eventArgs)
    {
        if (string.Equals(
                eventArgs.Key,
                "Enter",
                StringComparison.OrdinalIgnoreCase))
        {
            await SearchCustomersAsync();
        }
    }

    private async Task SearchCustomersAsync()
    {
        isSearchingCustomer =
            true;

        errorMessage =
            null;

        try
        {
            customerResults =
                (await LocalHistory
                    .SearchCustomersAsync(
                        customerSearchTerm,
                        maximumResults: 20))
                    .ToList();
        }
        catch (Exception exception)
        {
            errorMessage =
                $"Error searching local customers: " +
                $"{exception.GetBaseException().Message}";

            Logger.LogError(
                exception,
                "Error searching customers in local SQLite.");
        }
        finally
        {
            isSearchingCustomer =
                false;
        }
    }

    private void SelectCustomer(
        LocalSalesHistoryCustomerResult customer)
    {
        selectedCustomer =
            customer;

        customerResults =
            null;
    }

    private void ClearSelectedCustomer()
    {
        selectedCustomer =
            null;

        customerSearchTerm =
            string.Empty;
    }

    private void TogglePaymentStatus(
        string status,
        ChangeEventArgs eventArgs)
    {
        ToggleStatus(
            selectedPaymentStatuses,
            status,
            ReadCheckedValue(eventArgs));
    }

    private void ToggleSaleStatus(
        string status,
        ChangeEventArgs eventArgs)
    {
        ToggleStatus(
            selectedSaleStatuses,
            status,
            ReadCheckedValue(eventArgs));
    }

    private static void ToggleStatus(
        HashSet<string> values,
        string value,
        bool isChecked)
    {
        if (isChecked)
        {
            values.Add(value);
        }
        else
        {
            values.Remove(value);
        }
    }

    private static bool ReadCheckedValue(
        ChangeEventArgs eventArgs)
    {
        return eventArgs.Value switch
        {
            bool booleanValue =>
                booleanValue,

            string stringValue =>
                bool.TryParse(
                    stringValue,
                    out var parsed) &&
                parsed,

            _ =>
                false
        };
    }

    private async Task OnInvoiceKeyUp(
        KeyboardEventArgs eventArgs)
    {
        if (string.Equals(
                eventArgs.Key,
                "Enter",
                StringComparison.OrdinalIgnoreCase))
        {
            await ApplyFiltersAsync();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        currentPage =
            1;

        await LoadSalesAsync();
    }

    private async Task ResetFiltersAsync()
    {
        dateFrom =
            null;

        dateTo =
            null;

        customerFilter =
            CustomerFilter.All;

        selectedCustomer =
            null;

        customerResults =
            null;

        customerSearchTerm =
            string.Empty;

        selectedPaymentStatuses.Clear();
        selectedSaleStatuses.Clear();

        invoiceSearch =
            string.Empty;

        currentPage =
            1;

        await LoadSalesAsync();
    }

    private async Task ReloadAsync()
    {
        infoMessage =
            "Local SQLite data refreshed.";

        await LoadSalesAsync();
    }

    private async Task LoadSalesAsync()
    {
        isLoadingData =
            true;

        errorMessage =
            null;

        try
        {
            var result =
                await LocalHistory.SearchAsync(
                    new LocalSalesHistoryQuery
                    {
                        Page =
                            currentPage,

                        PageSize =
                            PageSize,

                        DateFromUtc =
                            ToUtcStart(
                                dateFrom),

                        DateToExclusiveUtc =
                            ToUtcExclusiveEnd(
                                dateTo),

                        InvoiceSearch =
                            string.IsNullOrWhiteSpace(
                                invoiceSearch)
                                ? null
                                : invoiceSearch.Trim(),

                        CustomerLocalId =
                            customerFilter ==
                            CustomerFilter.WithCustomer
                                ? selectedCustomer?.LocalId
                                : null,

                        WalkInOnly =
                            customerFilter ==
                            CustomerFilter.WalkIn,

                        PaymentStatuses =
                            selectedPaymentStatuses.Count == 0
                                ? null
                                : selectedPaymentStatuses.ToList(),

                        SaleStatuses =
                            selectedSaleStatuses.Count == 0
                                ? null
                                : selectedSaleStatuses.ToList()
                    });

            sales =
                result.Items.ToList();

            totalCount =
                result.TotalCount;

            if (TotalPages > 0 &&
                currentPage > TotalPages)
            {
                currentPage =
                    TotalPages;

                await LoadSalesAsync();

                return;
            }
        }
        catch (Exception exception)
        {
            sales.Clear();

            totalCount =
                0;

            errorMessage =
                $"Error loading local sales: " +
                $"{exception.GetBaseException().Message}";

            Logger.LogError(
                exception,
                "Error loading sales history from SQLite.");
        }
        finally
        {
            isLoadingData =
                false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage <= 1 ||
            isLoadingData)
        {
            return;
        }

        currentPage--;

        await LoadSalesAsync();
    }

    private async Task NextPageAsync()
    {
        if (currentPage >= TotalPages ||
            isLoadingData)
        {
            return;
        }

        currentPage++;

        await LoadSalesAsync();
    }

    private static DateTime? ToUtcStart(
        DateTime? localDate)
    {
        if (!localDate.HasValue)
        {
            return null;
        }

        var localStart =
            DateTime.SpecifyKind(
                localDate.Value.Date,
                DateTimeKind.Local);

        return localStart.ToUniversalTime();
    }

    private static DateTime? ToUtcExclusiveEnd(
        DateTime? localDate)
    {
        if (!localDate.HasValue)
        {
            return null;
        }

        var localExclusiveEnd =
            DateTime.SpecifyKind(
                localDate.Value.Date.AddDays(1),
                DateTimeKind.Local);

        return localExclusiveEnd.ToUniversalTime();
    }

    private static string GetPaymentStatusClass(
        string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "paid" =>
                "status-paid",

            "partial" or
            "partiallypaid" or
            "partially paid" =>
                "status-partial",

            "unpaid" or
            "pending" =>
                "status-pending",

            "refunded" =>
                "status-refunded",

            "cancelled" or
            "canceled" =>
                "status-cancelled",

            _ =>
                string.Empty
        };
    }

    private static string GetSaleStatusClass(
        string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "completed" =>
                "status-paid",

            "pending" =>
                "status-pending",

            "cancelled" or
            "canceled" =>
                "status-cancelled",

            _ =>
                string.Empty
        };
    }

    private static string GetSyncStatusClass(
        string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "done" =>
                "status-paid",

            "pending" or
            "processing" =>
                "status-pending",

            "conflict" or
            "failed" =>
                "status-cancelled",

            _ =>
                "status-partial"
        };
    }

    private static string GetSyncStatusLabel(
        string? status)
    {
        return status?.Trim().ToLowerInvariant() switch
        {
            "done" =>
                "Synced",

            "processing" =>
                "Syncing",

            "pending" =>
                "Pending",

            "conflict" =>
                "Conflict",

            "failed" =>
                "Failed",

            _ =>
                status ?? "Unknown"
        };
    }

    private enum CustomerFilter
    {
        All,
        WalkIn,
        WithCustomer
    }
}