    private List<CreatePackComponentRequest>
        BuildPackComponents()
    {
        if (!form.IsPack ||
            form.SellingMode != SellingMode.Unit ||
            form.ComponentCatalogId == Guid.Empty ||
            form.PackQuantity <= 0)
        {
            return new List<CreatePackComponentRequest>();
        }

        return new List<CreatePackComponentRequest>
        {
            new()
            {
                ComponentCatalogId =
                    form.ComponentCatalogId,

                Quantity =
                    form.PackQuantity
            }
        };
    }

    private void ConfirmDelete(
        ProductCatalogResult product)
    {
        if (isLoading)
            return;

        if (!CanUseServer)
        {
            ShowError(
                "Delete is unavailable in offline mode.");

            return;
        }

        productToDelete = product;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        if (isLoading)
            return;

        productToDelete = null;
        showDeleteConfirm = false;
    }

    private async Task ConfirmDeleteAction()
    {
        if (productToDelete == null || isLoading)
            return;

        if (!CanUseServer)
        {
            showDeleteConfirm = false;

            ShowError(
                "Delete is unavailable in offline mode.");

            return;
        }

        var productId = productToDelete.Id;
        var productName = productToDelete.Name;

        try
        {
            isLoading = true;
            showDeleteConfirm = false;

            ClearMessages();

            await Api.Delete(productId);

            var localSyncSucceeded = true;

            try
            {
                await RefreshAfterServerMutationAsync();
            }
            catch (Exception exception)
            {
                localSyncSucceeded = false;

                System.Diagnostics.Debug.WriteLine(
                    $"Local refresh after delete failed: {exception}");
            }

            productToDelete = null;

            if (items.Count == 1 && Page > 1)
            {
                Page--;
            }

            await LoadData();

            if (localSyncSucceeded)
            {
                ShowSuccess(
                    $"Product '{productName}' deleted successfully.");
            }
            else
            {
                ShowError(
                    $"Product '{productName}' was deleted on the server, " +
                    "but SQLite was not refreshed.");
            }
        }
        catch (HttpRequestException exception)
        {
            isOfflineMode = true;
            showDeleteConfirm = false;

            ShowError(
                $"Server unavailable: " +
                $"{exception.GetBaseException().Message}");
        }
        catch (Exception exception)
        {
            showDeleteConfirm = true;

            ShowError(
                $"Failed to delete product: " +
                $"{exception.GetBaseException().Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task<ProductCatalogResult?>
        FindCatalogByIdAsync(
            Guid id)
    {
        if (id == Guid.Empty)
        {
            return Task.FromResult<ProductCatalogResult?>(
                null);
        }

        return LocalCatalogQuery.GetByIdAsync(id);
    }

    private async Task StartEditAsync(
        ProductCatalogResult product)
    {
        if (isLoading)
            return;

        if (!CanUseServer)
        {
            ShowError(
                "Edit is unavailable in offline mode.");

            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;

            editingId = product.Id;

            form = new ProductCatalogForm
            {
                Name = product.Name,
                Barcode = product.Barcode ?? string.Empty,
                InternalCode = product.InternalCode,
                Brand = product.Brand,
                Manufacturer = product.Manufacturer,
                Description = product.Description,

                UnitOfMeasure =
                    string.IsNullOrWhiteSpace(
                        product.UnitOfMeasure)
                        ? "pcs"
                        : product.UnitOfMeasure,

                CategoryId = product.CategoryId,
                IsPack = product.IsPack,
                SellingMode = product.SellingMode,
                ComponentCatalogId = Guid.Empty,
                PackQuantity = 0
            };

            selectedComponentCatalog = null;

            var packComponent =
                product.PackComponents?
                    .FirstOrDefault();

            if (product.IsPack &&
                packComponent != null)
            {
                form.ComponentCatalogId =
                    packComponent.ComponentCatalogId;

                form.PackQuantity =
                    packComponent.Quantity;

                selectedComponentCatalog =
                    await FindCatalogByIdAsync(
                        packComponent.ComponentCatalogId);
            }

            showProduct = true;
        }
        catch (Exception exception)
        {
            ResetForm();

            ShowError(
                $"Failed to load product: " +
                $"{exception.GetBaseException().Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CancelEdit()
    {
        if (isLoading)
            return;

        ResetForm();
    }

    private void ResetForm()
    {
        editingId = null;
        showProduct = false;
        selectedComponentCatalog = null;

        form = CreateEmptyForm();
    }

    private static ProductCatalogForm CreateEmptyForm()
    {
        return new ProductCatalogForm
        {
            SellingMode = SellingMode.Unit,
            UnitOfMeasure = "pcs",
            CategoryId = Guid.Empty,
            IsPack = false,
            ComponentCatalogId = Guid.Empty,
            PackQuantity = 0
        };
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    private void ShowSuccess(
        string message)
    {
        var version = ++messageVersion;

        successMessage = message;
        errorMessage = null;

        _ = ClearMessageLaterAsync(version);
    }

    private void ShowError(
        string message)
    {
        var version = ++messageVersion;

        errorMessage = message;
        successMessage = null;

        _ = ClearMessageLaterAsync(version);
    }

    private async Task ClearMessageLaterAsync(
        int version)
    {
        await Task.Delay(3000);

        if (version != messageVersion)
            return;

        successMessage = null;
        errorMessage = null;

        await InvokeAsync(StateHasChanged);
    }

