@page "/productCatalogs"
@inject IProductCatalogApi Api
@inject IProductCategoryApi CategoryApi
@using Inventory.Dto.Enums
@using Inventory.Dto.PackComponent.Requests
@using Inventory.Dto.ProductCatalogs.Results
@using Inventory.Dto.ProductCatalogs.Requests
@using Inventory.Dto.ProductCategory.Results
@using Inventory.Ui.State
@using Inventory.Ui.Services
@inject AppState State
@inject PosBootstrapService Bootstrap
@implements IDisposable

<h3>Product Catalogs</h3>
<div class="page-container">

    @if (showProduct)
    {
        <div class="product-modal-overlay" @onclick="CloseProductModel">
            <div class="product-modal" @onclick:stopPropagation="true">
                <div class="card">
                    <h4>@(editingId == null ? "Create product" : "Edit product")</h4>
                    <EditForm Model="form" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="form-grid">

                            <!-- BASE FIELDS -->
                            <div class="form-row">
                                <div class="form-field">
                                    <label>Name *</label>
                                    <InputText placeholder="Product name"
                                               class="inputText"
                                               @bind-Value="form.Name"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Name)" />
                                </div>

                                <div class="form-field">
                                    <label>Unit of Measure</label>
                                    <InputSelect @bind-Value="form.UnitOfMeasure"
                                                 class="inputText"
                                                 disabled="@isLoading">
                                        <option value="pcs">Pieces</option>
                                        <option value="kg">Kilogram</option>
                                        <option value="g">Gram</option>
                                        <option value="l">Litre</option>
                                    </InputSelect>

                                    <ValidationMessage For="@(() => form.UnitOfMeasure)" />

                                    @if (form.SellingMode == SellingMode.Weight && form.UnitOfMeasure == "pcs")
                                    {
                                        <small style="color:red;">
                                            Weight products must use kg, g or l
                                        </small>
                                    }
                                </div>

                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Brand</label>
                                    <InputText placeholder="Brand (optional)"
                                               class="inputText"
                                               @bind-Value="form.Brand"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Brand)" />
                                </div>
                                <div class="form-field">
                                    <label>Selling Mode</label>
                                    <InputSelect @bind-Value="form.SellingMode" class="inputText">
                                        <option value="Unit">Unit (pcs)</option>
                                        <option value="Weight">Weight (kg / g / l)</option>
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Barcode *</label>
                                    <InputText placeholder="Barcode"
                                               class="inputText"
                                               @bind-Value="form.Barcode"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Barcode)" />
                                </div>

                                <div class="form-field">
                                    <label>Internal Code *</label>
                                    <InputText placeholder="Internal code"
                                               class="inputText"
                                               @bind-Value="form.InternalCode"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.InternalCode)" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Category</label>
                                    <InputSelect @bind-Value="form.CategoryId" class="inputText" disabled="@isLoading">
                                        <option value="@Guid.Empty">-- No category --</option>
                                        @foreach (var cat in categories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="form-field">
                                <label>Description</label>
                                <InputTextArea placeholder="Product description (optional)"
                                               class="inputText"
                                               rows="3"
                                               @bind-Value="form.Description"
                                               disabled="@isLoading" />
                                <ValidationMessage For="@(() => form.Description)" />
                            </div>

                            <!-- PACK SECTION -->
                            <div class="form-field">
                                <label>
                                    <InputCheckbox @bind-Value="form.IsPack"
                                                   disabled="@(form.SellingMode != SellingMode.Unit)" />
                                    This product is a pack
                                </label>
                            </div>

                            @if (form.IsPack && form.SellingMode == SellingMode.Unit)
                            {
                                <div class="card" style="background: #f8f9fa; padding: 12px;">
                                    <h5>📦 Pack Configuration</h5>

                                    <div class="form-row">
                                        <div class="form-field">
                                            <label>Unit product (contained in this pack) *</label>
                                            <MudAutocomplete T="ProductCatalogResult"
                                                             Label="Unit product (contained in this pack)"
                                                             Value="selectedComponentCatalog"
                                                             ValueChanged="OnComponentCatalogChanged"
                                                             SearchFunc="SearchUnitCatalogServer"
                                                             ToStringFunc="FormatCatalog"
                                                             Clearable="true"
                                                             Dense="true"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="false"
                                                             CoerceValue="false"
                                                             MinCharacters="0"
                                                             MaxItems="30"
                                                             Disabled="@isLoading"
                                                             Placeholder="Search unit product by name, barcode or internal code" />

                                            @if (form.IsPack && form.ComponentCatalogId == Guid.Empty)
                                            {
                                                <small style="color: red;">Please select the unit product</small>
                                            }
                                        </div>
                                        <div class="form-field">
                                            <label>Quantity of units in this pack *</label>
                                            <InputNumber @bind-Value="form.PackQuantity"
                                                         class="inputText"
                                                         placeholder="ex: 6"
                                                         disabled="@isLoading" />
                                            @if (form.IsPack && form.PackQuantity <= 0)
                                            {
                                                <small style="color: red;">Quantity must be greater than 0</small>
                                            }
                                        </div>
                                    </div>

                                    @if (selectedComponentCatalog != null && form.PackQuantity > 0)
                                    {
                                        <div style="margin-top: 8px; padding: 8px; background: #e8f5e9; border-radius: 4px; font-size: 13px;">
                                            <strong>@form.Name</strong> contains
                                            <strong>@form.PackQuantity</strong> × <strong>@selectedComponentCatalog.Name</strong>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="actions-end">
                                @if (editingId == null)
                                {
                                    <button type="submit" class="btn primary" disabled="@isLoading">
                                        @(isLoading ? "Creating..." : "Create")
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn primary" disabled="@isLoading">
                                        @(isLoading ? "Updating..." : "Update")
                                    </button>
                                    <button type="button" class="btn ghost" @onclick="CancelEdit" disabled="@isLoading">
                                        Cancel
                                    </button>
                                }
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <h4>Search Products</h4>
        <div class="search-grid">
            <input type="text"
                   placeholder="Search by name or barcode..."
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp"
                   disabled="@isLoading" />
            <div class="search-actions">
                <button class="btn primary" @onclick="Search" disabled="@isLoading">Search</button>
                <button class="btn ghost" @onclick="ClearSearch" disabled="@isLoading">Clear</button>
                <button class="btn btn-warning" @onclick="AddProduct">Add</button>
            </div>
        </div>
    </div>

    @if (isLoadingData)
    {
        <div class="loading-container">
            <p>Loading products...</p>
        </div>
    }
    else if (items == null || items.Count == 0)
    {
        <p>@(isSearching ? "No products found matching your search." : "No products.")</p>
    }
    else
    {
        <div class="pager">
            <button class="btn ghost" disabled="@(Page == 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>
            <span class="muted">
                Page @Page / @(Math.Ceiling((double)TotalCount / PageSize))
            </span>
            <button class="btn ghost"
                    disabled="@(Page* PageSize >= TotalCount)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>
        </div>

        <div class="results-header">
            <span>@ItemsCount / @TotalCount Product(s) found.</span>
            @if (isSearching)
            {
                <button class="btn small ghost" @onclick="ClearSearch">Show All</button>
            }
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Barcode</th>
                    <th>Int. Code</th>
                    <th>Brand</th>
                    <th>Unit</th>
                    <th>Pack</th>
                    <th>Mode</th>
                    <th style="width:160px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in items)
                {
                    <tr>
                        <td>
                            <div class="product-name">
                                @p.Name
                                @if (p.IsPack)
                                {
                                    <span class="badge" style="background:#6f42c1; color:white; font-size:10px; padding:2px 6px; border-radius:4px; margin-left:6px;">
                                        PACK
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Description))
                            {
                                <div class="product-desc">@p.Description</div>
                            }
                        </td>
                        <td><code>@p.Barcode</code></td>
                        <td><code>@p.InternalCode</code></td>
                        <td>@(p.Brand ?? "-")</td>
                        <td>@(p.UnitOfMeasure ?? "-")</td>
                        <td>
                            @if (p.IsPack && p.PackComponents.Any())
                            {
                                var comp = p.PackComponents.First();
                                <span style="font-size:12px;">
                                    📦 @comp.Quantity × @comp.ComponentName
                                </span>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td>@p.SellingMode</td>
                        <td class="actions-end">
                            <button class="btn small ghost"
                                    @onclick="() => StartEditAsync(p)"
                                    disabled="@isLoading">
                                Edit
                            </button>
                            <button class="btn small danger"
                                    @onclick="() => ConfirmDelete(p)"
                                    disabled="@isLoading">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (showDeleteConfirm && productToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h4>Confirm Delete</h4>
            <p>Are you sure you want to delete <strong>@productToDelete.Name</strong>?</p>
            <p class="text-muted">This action cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn ghost" @onclick="CancelDelete">Cancel</button>
                <button class="btn danger" @onclick="ConfirmDeleteAction">Delete</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="toast-success">
        <span class="toast-icon"></span>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="toast-error">
        <span class="toast-icon"></span>
        <span>@errorMessage</span>
    </div>
}

@code {
    // ── Page-local display state ─────────────────────────────────────────────
    private List<ProductCatalogResult>? items;
    // allCatalogs and categories now come from AppState cache
    private List<ProductCategoryResult> categories = new();

    private ProductCatalogResult? selectedComponentCatalog;

    private Guid? editingId;
    private ProductCatalogForm form = new();
    private bool isLoading;
    private bool isLoadingData;
    private string? errorMessage;
    private string? successMessage;
    private bool showDeleteConfirm;
    private ProductCatalogResult? productToDelete;
    private string searchTerm = string.Empty;
    private bool isSearching;
    private string sortBy = "DisplayOrder";
    private bool sortDescending = false;

    int Page = 1;
    int PageSize = 10;
    int TotalCount;
    int ItemsCount;

    bool showProduct;

    // ── Derived from AppState cache (no extra API call needed) ───────────────
    // All catalogs for the pack dropdown — read directly from the singleton cache
    private List<ProductCatalogResult> UnitCatalogs =>
    State.ProductsCatalog?
        .Where(c => !c.IsPack && c.SellingMode == SellingMode.Unit)
        .OrderBy(c => c.Name)
        .ToList()
    ?? new List<ProductCatalogResult>();
    // ── Lifecycle ────────────────────────────────────────────────────────────
    private Task<IEnumerable<ProductCatalogResult>> SearchUnitCatalogLocal(
        string? value,
        CancellationToken cancellationToken)
    {
        var source = UnitCatalogs;

        if (source.Count == 0)
            return Task.FromResult(Enumerable.Empty<ProductCatalogResult>());

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(source.Take(20).AsEnumerable());

        value = value.Trim();

        var result = source
            .Where(c =>
                (!string.IsNullOrWhiteSpace(c.Name) &&
                 c.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(c.Barcode) &&
                 c.Barcode.Contains(value, StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(c.Brand) &&
                 c.Brand.Contains(value, StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(c.InternalCode) &&
                 c.InternalCode.Contains(value, StringComparison.OrdinalIgnoreCase)))
            .Take(30);

        return Task.FromResult(result);
    }

    private async Task<IEnumerable<ProductCatalogResult>> SearchUnitCatalogServer(
    string? value,
    CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            value = string.Empty;
        }

        var query = new ProductCatalogQuery
        {
            Page = 1,
            PageSize = 30,
            Search = value.Trim(),
            SortBy = "Name",
            Desc = false
        };

        var response = await Api.Search(query);

        var result = response.Items?
            .Where(c =>
                !c.IsPack &&
                c.SellingMode == SellingMode.Unit &&
                c.Id != editingId)
            .OrderBy(c => c.Name)
            .ToList()
            ?? new List<ProductCatalogResult>();

        return result;
    }

    private string FormatCatalog(ProductCatalogResult? catalog)
    {
        if (catalog == null)
            return string.Empty;

        if (!string.IsNullOrWhiteSpace(catalog.Barcode))
            return $"{catalog.Name} [{catalog.Barcode}]";

        return catalog.Name;
    }

    private Task OnComponentCatalogChanged(ProductCatalogResult? catalog)
    {
        selectedComponentCatalog = catalog;
        form.ComponentCatalogId = catalog?.Id ?? Guid.Empty;

        return Task.CompletedTask;
    }

    // CHANGE 1: Subscribe to AppState.OnChange so this page re-renders when
    // another page (e.g. POS) calls InvalidatePos() or SetPosDataAsync().
    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChange;
    }

    protected override async Task OnInitializedAsync()
    {
        Page = 1;

        await Bootstrap.EnsureLoadedAsync();

        await LoadCategoriesFromCacheOrApi();
        await LoadData();
    }
    // CHANGE 3: Must unsubscribe to prevent memory leaks when the page is disposed.
    public void Dispose()
    {
        State.OnChange -= HandleStateChange;
    }

    // Called by AppState when any cache entry changes (e.g. after InvalidatePos)
    private void HandleStateChange()
    {
        // Refresh the categories binding from the updated cache
        if (State.ProductsCategory != null)
            categories = State.ProductsCategory;

        InvokeAsync(StateHasChanged);
    }

    // ── Data loading ─────────────────────────────────────────────────────────

    // CHANGE 4: Categories are now read from AppState cache if available.
    // This avoids a redundant CategoryApi.GetAll() call on every page visit.
    private async Task LoadCategoriesFromCacheOrApi()
    {
        if (State.ProductsCategory != null)
        {
            // Already in cache — use it instantly, no network call
            categories = State.ProductsCategory;
            return;
        }

        // Not in cache yet — fall back to direct API call
        try
        {
            var result = await CategoryApi.GetAll();
            categories = result?.ToList() ?? new();
        }
        catch
        {
            categories = new();
        }
    }

    // CHANGE 5: LoadData() no longer calls LoadAllCatalogsForSelect() separately.
    // UnitCatalogs is now a computed property reading State.ProductsCatalog,
    // which Bootstrap keeps up to date. After Create/Update/Delete we call
    // Bootstrap.EnsureLoadedAsync() to refresh the cache in the background.
    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new ProductCatalogQuery
            {
                Page = Page,
                PageSize = PageSize,
                Search = isSearching ? searchTerm : null,
                SortBy = sortBy,
                Desc = sortDescending
            };

            var response = await Api.Search(query);
            items = response.Items?.ToList() ?? new();
            TotalCount = response.TotalCount;
            ItemsCount = ((Page - 1) * PageSize) + items.Count;
        }
        catch
        {
            ShowError("Failed to load products!");
            items = new();
            TotalCount = 0;
            ItemsCount = 0;
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task Sort(string column)
    {
        if (sortBy == column)
            sortDescending = !sortDescending;
        else
        {
            sortBy = column;
            sortDescending = false;
        }

        Page = 1;
        await LoadData();
    }

    private string GetSortIcon(string column)
    {
        if (sortBy != column) return string.Empty;
        return sortDescending ? "DESC" : "ASC";
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            isSearching = false;
            Page = 1;
            await LoadData();
            return;
        }

        isSearching = true;
        Page = 1;
        await LoadData();
    }

    async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadData();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Search();
    }

    private async Task AddProduct()
    {
        await Bootstrap.EnsureLoadedAsync();

        if (State.ProductsCatalog == null || State.ProductsCatalog.Count == 0)
        {
            ShowError("Product catalog cache is empty.");
            return;
        }

        showProduct = true;
    }

    private void CloseProductModel() => showProduct = false;

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        isSearching = false;
        Page = 1;
        await LoadData();
    }

    // ── Form submit ──────────────────────────────────────────────────────────

    private async Task HandleSubmit()
    {
        if (form.SellingMode == SellingMode.Weight && form.UnitOfMeasure == "pcs")
        {
            ShowError("Weight products must use kg, g or l.");
            return;
        }

        if (form.SellingMode == SellingMode.Unit && form.UnitOfMeasure != "pcs")
        {
            ShowError("Unit products must use pcs.");
            return;
        }

        if (form.IsPack)
        {
            if (form.ComponentCatalogId == Guid.Empty)
            {
                ShowError("Please select the unit product for this pack.");
                return;
            }
            if (form.PackQuantity <= 0)
            {
                ShowError("Pack quantity must be greater than 0.");
                return;
            }
        }

        if (editingId == null)
            await Create();
        else
            await Update();
    }

    private async Task Create()
    {
        try
        {
            isLoading = true;

            var request = new CreateProductCatalogRequest
            {
                Name = form.Name,
                Barcode = form.Barcode,
                InternalCode = form.InternalCode,
                Brand = form.Brand,
                Manufacturer = form.Manufacturer,
                Description = form.Description,
                UnitOfMeasure = form.UnitOfMeasure,
                CategoryId = form.CategoryId,
                CreatedAt = DateTime.UtcNow,
                IsPack = form.IsPack,
                SellingMode = form.SellingMode,
                PackComponents = form.IsPack && form.ComponentCatalogId != Guid.Empty
                    ? new List<CreatePackComponentRequest>
                    {
                        new() { ComponentCatalogId = form.ComponentCatalogId, Quantity = form.PackQuantity }
                    }
                    : new List<CreatePackComponentRequest>()
            };

            await Api.Create(request);

            // CHANGE 6: Invalidate then eagerly reload so the pack dropdown
            // and any other page using the cache are immediately up to date.
            State.InvalidatePos();
            await Bootstrap.EnsureLoadedAsync();

            ShowSuccess($"Product '{form.Name}' created successfully!");
            ResetForm();

            if (isSearching) await Search();
            else await LoadData();
        }
        catch
        {
            ShowError("Failed to create product.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Update()
    {
        if (editingId == null) return;

        try
        {
            isLoading = true;

            var request = new UpdateProductCatalogRequest
            {
                Name = form.Name,
                Barcode = form.Barcode,
                InternalCode = form.InternalCode,
                Brand = form.Brand,
                Manufacturer = form.Manufacturer,
                Description = form.Description,
                ModifiedAt = DateTime.UtcNow,
                UnitOfMeasure = form.UnitOfMeasure,
                CategoryId = form.CategoryId,
                IsPack = form.IsPack,
                SellingMode = form.SellingMode,
                PackComponents = form.IsPack && form.ComponentCatalogId != Guid.Empty
                    ? new List<CreatePackComponentRequest>
                    {
                        new() { ComponentCatalogId = form.ComponentCatalogId, Quantity = form.PackQuantity }
                    }
                    : new List<CreatePackComponentRequest>()
            };

            await Api.Update(editingId.Value, request);

            State.InvalidatePos();
            await Bootstrap.EnsureLoadedAsync();

            ShowSuccess($"Product '{form.Name}' updated successfully.");
            ResetForm();

            await LoadData();
        }
        catch
        {
            ShowError("Failed to update product.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmDelete(ProductCatalogResult product)
    {
        productToDelete = product;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        productToDelete = null;
        showDeleteConfirm = false;
    }

    private async Task ConfirmDeleteAction()
    {
        if (productToDelete == null) return;

        try
        {
            isLoading = true;
            showDeleteConfirm = false;

            var productName = productToDelete.Name;
            await Api.Delete(productToDelete.Id);

            // CHANGE 6 (same pattern): invalidate + background reload
            State.InvalidatePos();
            await Bootstrap.EnsureLoadedAsync();

            ShowSuccess($"Product '{productName}' deleted successfully.");
            productToDelete = null;

            if (isSearching) await Search();
            else await LoadData();
        }
        catch
        {
            ShowError("Failed to delete product!");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<ProductCatalogResult?> FindCatalogByIdAsync(Guid id, string? fallbackName = null)
    {
        if (id == Guid.Empty)
            return null;

        var fromCache = State.ProductsCatalog?
            .FirstOrDefault(x => x.Id == id);

        if (fromCache != null)
            return fromCache;

        if (!string.IsNullOrWhiteSpace(fallbackName))
        {
            var response = await Api.Search(new ProductCatalogQuery
            {
                Page = 1,
                PageSize = 30,
                Search = fallbackName,
                SortBy = "Name",
                Desc = false
            });

            var fromApi = response.Items?
                .FirstOrDefault(x => x.Id == id);

            if (fromApi != null)
                return fromApi;
        }

        var fallbackResponse = await Api.Search(new ProductCatalogQuery
        {
            Page = 1,
            PageSize = 200,
            Search = null,
            SortBy = "Name",
            Desc = false
        });

        return fallbackResponse.Items?
            .FirstOrDefault(x => x.Id == id);
    }

    private async Task StartEditAsync(ProductCatalogResult p)
    {
        await Bootstrap.EnsureLoadedAsync();

        showProduct = true;
        editingId = p.Id;

        form.Name = p.Name;
        form.Barcode = p.Barcode;
        form.InternalCode = p.InternalCode;
        form.Brand = p.Brand;
        form.Manufacturer = p.Manufacturer;
        form.Description = p.Description;
        form.UnitOfMeasure = p.UnitOfMeasure;
        form.CategoryId = p.CategoryId;
        form.IsPack = p.IsPack;
        form.SellingMode = p.SellingMode;

        selectedComponentCatalog = null;

        if (p.IsPack && p.PackComponents.Any())
        {
            var comp = p.PackComponents.First();

            form.ComponentCatalogId = comp.ComponentCatalogId;
            form.PackQuantity = comp.Quantity;

            selectedComponentCatalog = await FindCatalogByIdAsync(
                comp.ComponentCatalogId,
                comp.ComponentName);
        }
        else
        {
            form.ComponentCatalogId = Guid.Empty;
            form.PackQuantity = 0;
        }

        StateHasChanged();
    }

    private void CancelEdit() => ResetForm();

    private void ResetForm()
    {
        editingId = null;
        showProduct = false;
        form = new ProductCatalogForm();
        selectedComponentCatalog = null;
    }

    // ── Toast helpers ────────────────────────────────────────────────────────

    void ShowError(string message)
    {
        errorMessage = null;
        StateHasChanged();
        errorMessage = message;
        StateHasChanged();
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            errorMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    void ShowSuccess(string message)
    {
        successMessage = null;
        StateHasChanged();
        successMessage = message;
        StateHasChanged();
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            successMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    // ── Form model ───────────────────────────────────────────────────────────

    private sealed class ProductCatalogForm
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Barcode is required")]
        [StringLength(100, ErrorMessage = "Barcode cannot exceed 100 characters")]
        public string Barcode { get; set; } = string.Empty;

        [StringLength(100)]
        public string? Brand { get; set; }

        [StringLength(100)]
        public string? Manufacturer { get; set; }

        public SellingMode SellingMode { get; set; }

        public Guid CategoryId { get; set; }

        [StringLength(1000)]
        public string? Description { get; set; }

        [StringLength(10)]
        public string UnitOfMeasure { get; set; } = "pcs";

        [StringLength(50)]
        [Required(ErrorMessage = "Internal code is required")]
        public string InternalCode { get; set; } = string.Empty;

        public bool IsPack { get; set; } = false;
        public Guid ComponentCatalogId { get; set; } = Guid.Empty;
        public decimal PackQuantity { get; set; } = 0;
    }
}
