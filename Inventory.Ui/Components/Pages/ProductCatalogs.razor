@page "/productCatalogs"
@inject IProductCatalogApi Api
@using Inventory.Dto.Enums
@using Inventory.Dto.PackComponent.Requests
@using Inventory.Dto.ProductCatalogs.Results
@using Inventory.Dto.ProductCatalogs.Requests
@using Inventory.Ui.State
@inject AppState State

<h3>Product Catalogs</h3>
<div class="page-container">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert error">
            <span>@errorMessage</span>
            <button @onclick="ClearError">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert success">
            <span>@successMessage</span>
            <button @onclick="ClearSuccess">×</button>
        </div>
    }

    <div class="card">
        <h4>@(editingId == null ? "Create product" : "Edit product")</h4>
        <EditForm Model="form" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <div class="form-grid">

                <!-- BASE FIELDS -->
                <div class="form-row">
                    <div class="form-field">
                        <label>Name *</label>
                        <InputText placeholder="Product name"
                                   class="inputText"
                                   @bind-Value="form.Name"
                                   disabled="@isLoading" />
                        <ValidationMessage For="@(() => form.Name)" />
                    </div>
                    <div class="form-field">
                        <label>Barcode *</label>
                        <InputText placeholder="Barcode"
                                   class="inputText"
                                   @bind-Value="form.Barcode"
                                   disabled="@isLoading" />
                        <ValidationMessage For="@(() => form.Barcode)" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label>Brand</label>
                        <InputText placeholder="Brand (optional)"
                                   class="inputText"
                                   @bind-Value="form.Brand"
                                   disabled="@isLoading" />
                        <ValidationMessage For="@(() => form.Brand)" />
                    </div>
                    <div class="form-field">
                        <label>Manufacturer</label>
                        <InputText placeholder="Manufacturer (optional)"
                                   class="inputText"
                                   @bind-Value="form.Manufacturer"
                                   disabled="@isLoading" />
                        <ValidationMessage For="@(() => form.Manufacturer)" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label>Unit of Measure</label>
                        <InputSelect @bind-Value="form.UnitOfMeasure"
                                     class="inputText"
                                     disabled="@isLoading">
                            <option value="@UnitOfMeasure.pcs">Pieces</option>
                            <option value="@UnitOfMeasure.l">Litre</option>
                            <option value="@UnitOfMeasure.m">Metre</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => form.UnitOfMeasure)" />
                    </div>
                </div>

                <div class="form-field">
                    <label>Description</label>
                    <InputTextArea placeholder="Product description (optional)"
                                   class="inputText"
                                   rows="3"
                                   @bind-Value="form.Description"
                                   disabled="@isLoading" />
                    <ValidationMessage For="@(() => form.Description)" />
                </div>

                <!-- PACK SECTION -->
                <div class="form-field">
                    <label>
                        <InputCheckbox @bind-Value="form.IsPack" disabled="@isLoading" />
                        This product is a pack
                    </label>
                </div>

                @if (form.IsPack)
                {
                    <div class="card" style="background: #f8f9fa; padding: 12px;">
                        <h5>📦 Pack Configuration</h5>

                        <div class="form-row">
                            <div class="form-field">
                                <label>Unit product (contained in this pack) *</label>
                                <InputSelect @bind-Value="form.ComponentCatalogId"
                                             class="inputText"
                                             disabled="@isLoading">
                                    <option value="@Guid.Empty">-- Select unit product --</option>
                                    @foreach (var cat in UnitCatalogs)
                                    {
                                        <option value="@cat.Id">
                                            @cat.Name
                                            @if (!string.IsNullOrEmpty(cat.Barcode))
                                            {
                                                <text> [@cat.Barcode]</text>
                                            }
                                        </option>
                                    }
                                </InputSelect>
                                @if (form.IsPack && form.ComponentCatalogId == Guid.Empty)
                                {
                                    <small style="color: red;">Please select the unit product</small>
                                }
                            </div>
                            <div class="form-field">
                                <label>Quantity of units in this pack *</label>
                                <InputNumber @bind-Value="form.PackQuantity"
                                             class="inputText"
                                             placeholder="ex: 6"
                                             disabled="@isLoading" />
                                @if (form.IsPack && form.PackQuantity <= 0)
                                {
                                    <small style="color: red;">Quantity must be greater than 0</small>
                                }
                            </div>
                        </div>

                        @if (form.ComponentCatalogId != Guid.Empty && form.PackQuantity > 0)
                        {
                            var unit = UnitCatalogs.FirstOrDefault(c => c.Id == form.ComponentCatalogId);
                            <div style="margin-top: 8px; padding: 8px; background: #e8f5e9; border-radius: 4px; font-size: 13px;">
                                ✅ <strong>@form.Name</strong> contains
                                <strong>@form.PackQuantity</strong> × <strong>@(unit?.Name ?? "")</strong>
                            </div>
                        }
                    </div>
                }

                <div class="actions-end">
                    @if (editingId == null)
                    {
                        <button type="submit" class="btn primary" disabled="@isLoading">
                            @(isLoading ? "Creating..." : "Create")
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn primary" disabled="@isLoading">
                            @(isLoading ? "Updating..." : "Update")
                        </button>
                        <button type="button" class="btn ghost" @onclick="CancelEdit" disabled="@isLoading">
                            Cancel
                        </button>
                    }
                </div>
            </div>
        </EditForm>
    </div>

    <div class="card">
        <h4>Search Products</h4>
        <div class="search-grid">
            <input type="text"
                   placeholder="Search by name or barcode..."
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp"
                   disabled="@isLoading" />
            <div class="search-actions">
                <button class="btn primary" @onclick="Search" disabled="@isLoading">Search</button>
                <button class="btn ghost" @onclick="ClearSearch" disabled="@isLoading">Clear</button>
            </div>
        </div>
    </div>

    @if (isLoadingData)
    {
        <div class="loading-container">
            <p>Loading products...</p>
        </div>
    }
    else if (items == null || items.Count == 0)
    {
        <p>@(isSearching ? "No products found matching your search." : "No products.")</p>
    }
    else
    {
        <div class="pager">
            <button class="btn ghost" disabled="@(Page == 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>
            <span class="muted">
                Page @Page / @(Math.Ceiling((double)TotalCount / PageSize))
            </span>
            <button class="btn ghost"
                    disabled="@(Page* PageSize >= TotalCount)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>
        </div>

        <div class="results-header">
            <span>@items.Count product(s) found</span>
            @if (isSearching)
            {
                <button class="btn small ghost" @onclick="ClearSearch">Show All</button>
            }
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Barcode</th>
                    <th>Brand</th>
                    <th>Manufacturer</th>
                    <th>Unit</th>
                    <th>Pack</th>
                    <th style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in items)
                {
                    <tr>
                        <td>
                            <div class="product-name">
                                @p.Name
                                @if (p.IsPack)
                                {
                                    <span class="badge" style="background:#6f42c1; color:white; font-size:10px; padding:2px 6px; border-radius:4px; margin-left:6px;">
                                        PACK
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Description))
                            {
                                <div class="product-desc">@p.Description</div>
                            }
                        </td>
                        <td><code>@p.Barcode</code></td>
                        <td>@(p.Brand ?? "-")</td>
                        <td>@(p.Manufacturer ?? "-")</td>
                        <td>@(p.UnitOfMeasure ?? "-")</td>
                        <td>
                            @if (p.IsPack && p.PackComponents.Any())
                            {
                                var comp = p.PackComponents.First();
                                <span style="font-size:12px;">
                                    📦 @comp.Quantity × @comp.ComponentName
                                </span>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td class="actions-end">
                            <button class="btn small ghost"
                                    @onclick="() => StartEdit(p)"
                                    disabled="@isLoading">
                                Edit
                            </button>
                            <button class="btn small danger"
                                    @onclick="() => ConfirmDelete(p)"
                                    disabled="@isLoading">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (showDeleteConfirm && productToDelete != null)
    {
        <div class="modal-overlay" @onclick="CancelDelete">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h4>Confirm Delete</h4>
                <p>Are you sure you want to delete <strong>@productToDelete.Name</strong>?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <div class="modal-actions">
                    <button class="btn ghost" @onclick="CancelDelete">Cancel</button>
                    <button class="btn danger" @onclick="ConfirmDeleteAction">Delete</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductCatalogResult>? items;
    private List<ProductCatalogResult> allCatalogs = new(); // pour le select des unités
    private Guid? editingId;
    private ProductCatalogForm form = new();
    private bool isLoading;
    private bool isLoadingData;
    private string? errorMessage;
    private string? successMessage;
    private bool showDeleteConfirm;
    private ProductCatalogResult? productToDelete;
    private string searchTerm = string.Empty;
    private bool isSearching;

    int Page = 1;
    int PageSize = 10;
    int TotalCount;

    // Catalogues unitaires disponibles pour le select pack (exclus les packs eux-mêmes)
    List<ProductCatalogResult> UnitCatalogs =>
        allCatalogs.Where(c => !c.IsPack).ToList();

    protected override async Task OnInitializedAsync()
    {
        Page = 1;
        await LoadAllCatalogsForSelect();
        await LoadData();
    }

    // Charger tous les catalogs pour le select (sans pagination)
    private async Task LoadAllCatalogsForSelect()
    {
        try
        {
            var response = await Api.Search(new ProductCatalogQuery
            {
                Page = 1,
                PageSize = 1000
            });
            allCatalogs = response.Items?.ToList() ?? new();
        }
        catch
        {
            allCatalogs = new();
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new ProductCatalogQuery
            {
                Page = Page,
                PageSize = PageSize,
                Search = isSearching ? searchTerm : null
            };

            var response = await Api.Search(query);
            items = response.Items?.ToList() ?? new();
            TotalCount = response.TotalCount;

            // Mettre à jour le cache local aussi
            await LoadAllCatalogsForSelect();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load products: {ex.Message}";
            items = new();
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            isSearching = false;
            Page = 1;
            await LoadData();
            return;
        }

        isSearching = true;
        Page = 1;
        await LoadData();
    }

    async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadData();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Search();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        isSearching = false;
        Page = 1;
        await LoadData();
    }

    private async Task HandleSubmit()
    {
        // Validation pack
        if (form.IsPack)
        {
            if (form.ComponentCatalogId == Guid.Empty)
            {
                errorMessage = "Please select the unit product for this pack.";
                return;
            }
            if (form.PackQuantity <= 0)
            {
                errorMessage = "Pack quantity must be greater than 0.";
                return;
            }
        }

        if (editingId == null)
            await Create();
        else
            await Update();
    }

    private async Task Create()
    {
        try
        {
            isLoading = true;
            ClearMessages();

            var request = new CreateProductCatalogRequest
            {
                Name = form.Name,
                Barcode = form.Barcode,
                Brand = form.Brand,
                Manufacturer = form.Manufacturer,
                Description = form.Description,
                UnitOfMeasure = form.UnitOfMeasure,
                CreatedAt = DateTime.UtcNow,
                IsPack = form.IsPack,
                PackComponents = form.IsPack && form.ComponentCatalogId != Guid.Empty
                    ? new List<CreatePackComponentRequest>
                    {
                        new()
                        {
                            ComponentCatalogId = form.ComponentCatalogId,
                            Quantity = form.PackQuantity
                        }
                    }
                    : new List<CreatePackComponentRequest>()
            };

            await Api.Create(request);
            InvalidatePosCache();
            successMessage = $"Product '{form.Name}' created successfully.";
            ResetForm();

            if (isSearching) await Search();
            else await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create product: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Update()
    {
        if (editingId == null)
            return;

        try
        {
            isLoading = true;
            ClearMessages();

            var request = new UpdateProductCatalogRequest
            {
                Name = form.Name,
                Barcode = form.Barcode,
                Brand = form.Brand,
                Manufacturer = form.Manufacturer,
                Description = form.Description,
                ModifiedAt = DateTime.UtcNow,
                UnitOfMeasure = form.UnitOfMeasure,
                IsPack = form.IsPack,
                PackComponents = form.IsPack && form.ComponentCatalogId != Guid.Empty
                    ? new List<CreatePackComponentRequest>
                    {
                        new()
                        {
                            ComponentCatalogId = form.ComponentCatalogId,
                            Quantity = form.PackQuantity
                        }
                    }
                    : new List<CreatePackComponentRequest>()
            };

            await Api.Update(editingId.Value, request);
            InvalidatePosCache();
            successMessage = $"Product '{form.Name}' updated successfully.";
            ResetForm();

            if (isSearching) await Search();
            else await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update product: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void InvalidatePosCache()
    {
        State.InvalidatePos();
    }

    private void ConfirmDelete(ProductCatalogResult product)
    {
        productToDelete = product;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        productToDelete = null;
        showDeleteConfirm = false;
    }

    private async Task ConfirmDeleteAction()
    {
        if (productToDelete == null)
            return;

        try
        {
            isLoading = true;
            showDeleteConfirm = false;
            ClearMessages();

            var productName = productToDelete.Name;
            await Api.Delete(productToDelete.Id);
            InvalidatePosCache();
            successMessage = $"Product '{productName}' deleted successfully.";
            productToDelete = null;

            if (isSearching) await Search();
            else await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete product: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit(ProductCatalogResult p)
    {
        editingId = p.Id;
        form.Name = p.Name;
        form.Barcode = p.Barcode;
        form.Brand = p.Brand;
        form.Manufacturer = p.Manufacturer;
        form.Description = p.Description;
        form.UnitOfMeasure = p.UnitOfMeasure;
        form.IsPack = p.IsPack;

        // Restaurer le composant si c'est un pack
        if (p.IsPack && p.PackComponents.Any())
        {
            var comp = p.PackComponents.First();
            form.ComponentCatalogId = comp.ComponentCatalogId;
            form.PackQuantity = comp.Quantity;
        }
        else
        {
            form.ComponentCatalogId = Guid.Empty;
            form.PackQuantity = 0;
        }

        ClearMessages();
    }

    private void CancelEdit() => ResetForm();

    private void ResetForm()
    {
        editingId = null;
        form = new ProductCatalogForm();
    }

    private void ClearError() => errorMessage = null;
    private void ClearSuccess() => successMessage = null;
    private void ClearMessages() { errorMessage = null; successMessage = null; }

    private sealed class ProductCatalogForm
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Barcode is required")]
        [StringLength(100, ErrorMessage = "Barcode cannot exceed 100 characters")]
        public string Barcode { get; set; } = string.Empty;

        [StringLength(100)]
        public string? Brand { get; set; }

        [StringLength(100)]
        public string? Manufacturer { get; set; }

        [StringLength(1000)]
        public string? Description { get; set; }

        [StringLength(10)]
        public string UnitOfMeasure { get; set; } = "pcs";

        // Pack fields
        public bool IsPack { get; set; } = false;
        public Guid ComponentCatalogId { get; set; } = Guid.Empty;
        public decimal PackQuantity { get; set; } = 0;
    }
}