@page "/productCatalogs"

@using System.ComponentModel.DataAnnotations
@using System.Net.Http
@using Inventory.Dto.Enums
@using Inventory.Dto.PackComponent.Requests
@using Inventory.Dto.ProductCatalogs.Requests
@using Inventory.Dto.ProductCatalogs.Results
@using Inventory.Dto.ProductCategory.Results
@using Inventory.Dto.Queries
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.Ui.Services.Sync
@using Inventory.Ui.State
@using Microsoft.AspNetCore.Components.Web

@inject ILocalProductCategoryQueryService LocalCategoryQuery
@inject ILocalProductCatalogQueryService LocalCatalogQuery

@inject ILocalProductCatalogSyncService ProductCatalogSync
@inject ILocalProductCategorySyncService ProductCategorySync

@inject IProductCatalogApi Api
@inject AppState State

<h3>Product Catalogs</h3>

<div class="page-container">

    @if (isOfflineMode)
    {
        <div class="alert warning">
            Offline mode — products, categories and packs are loaded from SQLite.
            Create, edit and delete are unavailable.
        </div>
    }

    @if (isSynchronizing)
    {
        <div class="alert">
            Synchronizing categories, products and packs...
        </div>
    }

    @if (showProduct)
    {
        <div class="product-modal-overlay"
             @onclick="CloseProductModal">

            <div class="product-modal"
                 @onclick:stopPropagation="true">

                <div class="card">
                    <h4>
                        @(editingId == null
                            ? "Create product"
                            : "Edit product")
                    </h4>

                    <EditForm Model="form"
                              OnValidSubmit="HandleSubmit">

                        <DataAnnotationsValidator />

                        <div class="form-grid">

                            <!-- NAME / UNIT -->
                            <div class="form-row">

                                <div class="form-field">
                                    <label>Name *</label>

                                    <InputText placeholder="Product name"
                                               class="inputText"
                                               @bind-Value="form.Name"
                                               disabled="@(isLoading || isOfflineMode)" />

                                    <ValidationMessage For="@(() => form.Name)" />
                                </div>

                                <div class="form-field">
                                    <label>Unit of Measure *</label>

                                    <InputSelect @bind-Value="form.UnitOfMeasure"
                                                 class="inputText"
                                                 disabled="@(isLoading || isOfflineMode)">

                                        <option value="pcs">Pieces</option>
                                        <option value="kg">Kilogram</option>
                                        <option value="g">Gram</option>
                                        <option value="l">Litre</option>

                                    </InputSelect>

                                    <ValidationMessage For="@(() => form.UnitOfMeasure)" />

                                    @if (form.SellingMode == SellingMode.Weight &&
                                         form.UnitOfMeasure == "pcs")
                                    {
                                        <small style="color:red;">
                                            Weight products must use kg, g or l.
                                        </small>
                                    }
                                </div>

                            </div>

                            <!-- BRAND / SELLING MODE -->
                            <div class="form-row">

                                <div class="form-field">
                                    <label>Brand</label>

                                    <InputText placeholder="Brand"
                                               class="inputText"
                                               @bind-Value="form.Brand"
                                               disabled="@(isLoading || isOfflineMode)" />

                                    <ValidationMessage For="@(() => form.Brand)" />
                                </div>

                                <div class="form-field">
                                    <label>Selling Mode</label>

                                    <InputSelect @bind-Value="form.SellingMode"
                                                 class="inputText"
                                                 disabled="@(isLoading || isOfflineMode)">

                                        <option value="Unit">
                                            Unit (pcs)
                                        </option>

                                        <option value="Weight">
                                            Weight (kg / g / l)
                                        </option>

                                    </InputSelect>
                                </div>

                            </div>

                            <!-- BARCODE / INTERNAL CODE -->
                            <div class="form-row">

                                <div class="form-field">
                                    <label>Barcode *</label>

                                    <InputText placeholder="Barcode"
                                               class="inputText"
                                               @bind-Value="form.Barcode"
                                               disabled="@(isLoading || isOfflineMode)" />

                                    <ValidationMessage For="@(() => form.Barcode)" />
                                </div>

                                <div class="form-field">
                                    <label>Internal Code *</label>

                                    <InputText placeholder="Internal code"
                                               class="inputText"
                                               @bind-Value="form.InternalCode"
                                               disabled="@(isLoading || isOfflineMode)" />

                                    <ValidationMessage For="@(() => form.InternalCode)" />
                                </div>

                            </div>

                            <!-- MANUFACTURER / CATEGORY -->
                            <div class="form-row">

                                <div class="form-field">
                                    <label>Manufacturer</label>

                                    <InputText placeholder="Manufacturer"
                                               class="inputText"
                                               @bind-Value="form.Manufacturer"
                                               disabled="@(isLoading || isOfflineMode)" />

                                    <ValidationMessage For="@(() => form.Manufacturer)" />
                                </div>

                                <div class="form-field">
                                    <label>Category</label>

                                    <InputSelect @bind-Value="form.CategoryId"
                                                 class="inputText"
                                                 disabled="@(isLoading || isOfflineMode)">

                                        <option value="@Guid.Empty">
                                            -- No category --
                                        </option>

                                        @foreach (var category in categories)
                                        {
                                            <option value="@category.Id">
                                                @category.Name
                                            </option>
                                        }

                                    </InputSelect>
                                </div>

                            </div>

                            <!-- DESCRIPTION -->
                            <div class="form-field">
                                <label>Description</label>

                                <InputTextArea placeholder="Product description"
                                               class="inputText"
                                               rows="3"
                                               @bind-Value="form.Description"
                                               disabled="@(isLoading || isOfflineMode)" />

                                <ValidationMessage For="@(() => form.Description)" />
                            </div>

                            <!-- PACK -->
                            <div class="form-field">
                                <label>
                                    <InputCheckbox
                                        @bind-Value="form.IsPack"
                                        disabled="@(
                                            isLoading ||
                                            isOfflineMode ||
                                            form.SellingMode != SellingMode.Unit)" />

                                    This product is a pack
                                </label>
                            </div>

                            @if (form.IsPack &&
                                 form.SellingMode == SellingMode.Unit)
                            {
                                <div class="card"
                                     style="
                                         background:#f8f9fa;
                                         padding:12px;">

                                    <h5>Pack Configuration</h5>

                                    <div class="form-row">

                                        <div class="form-field">
                                            <label>
                                                Unit product contained in this pack *
                                            </label>

                                            <MudAutocomplete
                                                T="ProductCatalogResult"
                                                Label="Unit product"
                                                Value="selectedComponentCatalog"
                                                ValueChanged="OnComponentCatalogChanged"
                                                SearchFunc="SearchUnitCatalogLocal"
                                                ToStringFunc="FormatCatalog"
                                                Clearable="true"
                                                Dense="true"
                                                ResetValueOnEmptyText="true"
                                                CoerceText="false"
                                                CoerceValue="false"
                                                MinCharacters="0"
                                                MaxItems="30"
                                                Disabled="@(isLoading || isOfflineMode)"
                                                Placeholder="Search by name, barcode or internal code" />

                                            @if (form.ComponentCatalogId == Guid.Empty)
                                            {
                                                <small style="color:red;">
                                                    Please select the unit product.
                                                </small>
                                            }
                                        </div>

                                        <div class="form-field">
                                            <label>
                                                Quantity of units in this pack *
                                            </label>

                                            <InputNumber
                                                @bind-Value="form.PackQuantity"
                                                class="inputText"
                                                placeholder="Example: 6"
                                                disabled="@(isLoading || isOfflineMode)" />

                                            @if (form.PackQuantity <= 0)
                                            {
                                                <small style="color:red;">
                                                    Quantity must be greater than zero.
                                                </small>
                                            }
                                        </div>

                                    </div>

                                    @if (selectedComponentCatalog != null &&
                                         form.PackQuantity > 0)
                                    {
                                        <div style="
                                                margin-top:8px;
                                                padding:8px;
                                                background:#e8f5e9;
                                                border-radius:4px;
                                                font-size:13px;">

                                            <strong>@form.Name</strong>
                                            contains

                                            <strong>
                                                @form.PackQuantity
                                            </strong>

                                            ×

                                            <strong>
                                                @selectedComponentCatalog.Name
                                            </strong>
                                        </div>
                                    }

                                </div>
                            }

                            <!-- ACTIONS -->
                            <div class="actions-end">

                                <button type="submit"
                                        class="btn primary"
                                        disabled="@(
                                            isLoading ||
                                            isOfflineMode ||
                                            isSynchronizing)">

                                    @if (isLoading)
                                    {
                                        <span>Saving...</span>
                                    }
                                    else if (editingId == null)
                                    {
                                        <span>Create</span>
                                    }
                                    else
                                    {
                                        <span>Update</span>
                                    }

                                </button>

                                @if (editingId != null)
                                {
                                    <button type="button"
                                            class="btn ghost"
                                            @onclick="CancelEdit"
                                            disabled="@isLoading">
                                        Cancel
                                    </button>
                                }

                            </div>

                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <!-- SEARCH -->
    <div class="card">
        <h4>Search Products</h4>

        <div class="search-grid">

            <input type="text"
                   placeholder="Search by name, barcode or internal code"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp"
                   disabled="@(isLoading || isLoadingData)" />

            <div class="search-actions">

                <button class="btn primary"
                        @onclick="Search"
                        disabled="@isLoadingData">
                    Search
                </button>

                <button class="btn ghost"
                        @onclick="ClearSearch"
                        disabled="@isLoadingData">
                    Clear
                </button>

                <button class="btn ghost"
                        @onclick="SynchronizeManuallyAsync"
                        disabled="@isSynchronizing">
                    @(isSynchronizing ? "Syncing..." : "Sync")
                </button>

                <button class="btn btn-warning"
                        @onclick="AddProduct"
                        disabled="@(
                            isLoading ||
                            isOfflineMode ||
                            isSynchronizing)">
                    Add
                </button>

            </div>
        </div>
    </div>

    <!-- DATA -->
    @if (isLoadingData)
    {
        <div class="loading-container">
            <p>Loading products from SQLite...</p>
        </div>
    }
    else if (items.Count == 0)
    {
        <p>
            @(isSearching
                ? "No products match your search."
                : "No products are stored locally.")
        </p>
    }
    else
    {
        <div class="pager">

            <button class="btn ghost"
                    disabled="@(Page <= 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>

            <span class="muted">
                Page @Page / @TotalPages
            </span>

            <button class="btn ghost"
                    disabled="@(Page >= TotalPages)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>

        </div>

        <div class="results-header">

            <span>
                @ItemsCount / @TotalCount product(s) found
            </span>

            @if (isSearching)
            {
                <button class="btn small ghost"
                        @onclick="ClearSearch">
                    Show All
                </button>
            }

        </div>

        <table class="table">
            <thead>
                <tr>
                    <th @onclick="() => Sort(nameof(ProductCatalogResult.Name))">
                        Name
                        @GetSortIcon(nameof(ProductCatalogResult.Name))
                    </th>

                    <th @onclick="() => Sort(nameof(ProductCatalogResult.Barcode))">
                        Barcode
                        @GetSortIcon(nameof(ProductCatalogResult.Barcode))
                    </th>

                    <th @onclick="() => Sort(nameof(ProductCatalogResult.InternalCode))">
                        Int. Code
                        @GetSortIcon(nameof(ProductCatalogResult.InternalCode))
                    </th>

                    <th @onclick="() => Sort(nameof(ProductCatalogResult.Brand))">
                        Brand
                        @GetSortIcon(nameof(ProductCatalogResult.Brand))
                    </th>

                    <th>Unit</th>
                    <th>Pack</th>
                    <th>Mode</th>
                    <th style="width:160px">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var product in items)
                {
                    <tr>
                        <td>
                            <div class="product-name">
                                @product.Name

                                @if (product.IsPack)
                                {
                                    <span class="badge"
                                          style="
                                              background:#6f42c1;
                                              color:white;
                                              font-size:10px;
                                              padding:2px 6px;
                                              border-radius:4px;
                                              margin-left:6px;">
                                        PACK
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(product.Description))
                            {
                                <div class="product-desc">
                                    @product.Description
                                </div>
                            }
                        </td>

                        <td>
                            <code>@product.Barcode</code>
                        </td>

                        <td>
                            <code>@product.InternalCode</code>
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(product.Brand)
                                ? "-"
                                : product.Brand)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(product.UnitOfMeasure)
                                ? "-"
                                : product.UnitOfMeasure)
                        </td>

                        <td>
                            @if (product.IsPack &&
                                 product.PackComponents?.Any() == true)
                            {
                                var component =
                                    product.PackComponents.First();

                                <span style="font-size:12px;">
                                    @component.Quantity
                                    ×
                                    @(string.IsNullOrWhiteSpace(
                                        component.ComponentName)
                                        ? "Unknown product"
                                        : component.ComponentName)
                                </span>
                            }
                            else if (product.IsPack)
                            {
                                <span class="muted">
                                    Pack without component details
                                </span>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>

                        <td>
                            @product.SellingMode
                        </td>

                        <td class="actions-end">

                            <button class="btn small ghost"
                                    @onclick="() => StartEditAsync(product)"
                                    disabled="@(
                                        isLoading ||
                                        isOfflineMode ||
                                        isSynchronizing)">
                                Edit
                            </button>

                            <button class="btn small danger"
                                    @onclick="() => ConfirmDelete(product)"
                                    disabled="@(
                                        isLoading ||
                                        isOfflineMode ||
                                        isSynchronizing)">
                                Delete
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>

<!-- DELETE CONFIRMATION -->
@if (showDeleteConfirm &&
     productToDelete != null)
{
    <div class="modal-overlay"
         @onclick="CancelDelete">

        <div class="modal-content"
             @onclick:stopPropagation="true">

            <h4>Confirm Delete</h4>

            <p>
                Are you sure you want to delete
                <strong>@productToDelete.Name</strong>?
            </p>

            <p class="text-muted">
                This action cannot be undone.
            </p>

            <div class="modal-actions">

                <button class="btn ghost"
                        @onclick="CancelDelete"
                        disabled="@isLoading">
                    Cancel
                </button>

                <button class="btn danger"
                        @onclick="ConfirmDeleteAction"
                        disabled="@isLoading">
                    @(isLoading ? "Deleting..." : "Delete")
                </button>

            </div>
        </div>
    </div>
}

<!-- SUCCESS -->
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="toast-success">
        <span class="toast-icon"></span>
        <span>@successMessage</span>
    </div>
}

<!-- ERROR -->
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="toast-error">
        <span class="toast-icon"></span>
        <span>@errorMessage</span>
    </div>
}

@code {
    private List<ProductCatalogResult> items = new();
    private List<ProductCategoryResult> categories = new();

    private ProductCatalogResult? selectedComponentCatalog;
    private ProductCatalogResult? productToDelete;

    private ProductCatalogForm form = new();

    private Guid? editingId;

    private bool showProduct;
    private bool showDeleteConfirm;

    private bool isLoading;
    private bool isLoadingData;

    private bool isOfflineMode = true;
    private bool isSynchronizing;
    private bool syncAttempted;

    private bool isSearching;

    private string searchTerm = string.Empty;
    private string sortBy = nameof(ProductCatalogResult.Name);

    private bool sortDescending;

    private string? errorMessage;
    private string? successMessage;

    private int messageVersion;

    private int Page = 1;
    private int PageSize = 10;
    private int TotalCount;
    private int ItemsCount;

    private bool CanUseServer =>
        !isOfflineMode &&
        !isSynchronizing;

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                TotalCount / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        Page = 1;
        errorMessage = null;
        isOfflineMode = true;

        // Toujours lire SQLite avant toute tentative réseau.
        await LoadCategoriesFromLocalAsync();
        await LoadData();
    }

    protected override Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender || syncAttempted)
            return Task.CompletedTask;

        syncAttempted = true;

        // La page est déjà affichée depuis SQLite.
        _ = InvokeAsync(
            () => TrySynchronizeWithServerAsync());

        return Task.CompletedTask;
    }

    private async Task TrySynchronizeWithServerAsync(
        bool showFeedback = false)
    {
        if (isSynchronizing)
            return;

        try
        {
            isSynchronizing = true;

            await InvokeAsync(StateHasChanged);

            // Les catégories doivent être enregistrées avant les produits.
            await ProductCategorySync.FullSyncAsync();
            await ProductCatalogSync.FullSyncAsync();

            isOfflineMode = false;

            // Relire les données réellement enregistrées dans SQLite.
            await LoadCategoriesFromLocalAsync();
            await LoadData();

            State.InvalidatePos();

            if (showFeedback)
            {
                ShowSuccess(
                    "Categories, products and packs synchronized successfully.");
            }
        }
        catch (HttpRequestException exception)
        {
            isOfflineMode = true;

            System.Diagnostics.Debug.WriteLine(
                $"Inventory server unavailable: {exception}");

            if (showFeedback)
            {
                ShowError(
                    $"Server unavailable: " +
                    $"{exception.GetBaseException().Message}");
            }
        }
        catch (TaskCanceledException exception)
        {
            isOfflineMode = true;

            System.Diagnostics.Debug.WriteLine(
                $"Inventory server timeout: {exception}");

            if (showFeedback)
            {
                ShowError(
                    "The synchronization request timed out.");
            }
        }
        catch (Exception exception)
        {
            isOfflineMode = true;

            System.Diagnostics.Debug.WriteLine(
                $"Product synchronization failed: {exception}");

            if (showFeedback)
            {
                ShowError(
                    $"Synchronization failed: " +
                    $"{exception.GetBaseException().Message}");
            }
        }
        finally
        {
            isSynchronizing = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SynchronizeManuallyAsync()
    {
        return TrySynchronizeWithServerAsync(
            showFeedback: true);
    }

    private async Task LoadCategoriesFromLocalAsync()
    {
        try
        {
            categories = await LocalCategoryQuery
                .GetAllAsync();
        }
        catch (Exception exception)
        {
            categories = new List<ProductCategoryResult>();

            System.Diagnostics.Debug.WriteLine(
                $"Local category loading failed: {exception}");
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new ProductCatalogQuery
            {
                Page = Page,
                PageSize = PageSize,

                Search = isSearching
                    ? searchTerm.Trim()
                    : null,

                SortBy = sortBy,
                Desc = sortDescending
            };

            var response = await LocalCatalogQuery
                .QueryAsync(query);

            items = response.Items?.ToList()
                ?? new List<ProductCatalogResult>();

            TotalCount = response.TotalCount;

            ItemsCount = items.Count == 0
                ? 0
                : Math.Min(
                    ((Page - 1) * PageSize) + items.Count,
                    TotalCount);
        }
        catch (Exception exception)
        {
            items = new List<ProductCatalogResult>();

            TotalCount = 0;
            ItemsCount = 0;

            ShowError(
                $"Failed to load local products: " +
                $"{exception.GetBaseException().Message}");

            System.Diagnostics.Debug.WriteLine(exception);
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task RefreshAfterServerMutationAsync(
        CancellationToken cancellationToken = default)
    {
        try
        {
            await ProductCatalogSync.FullSyncAsync(
                cancellationToken);

            isOfflineMode = false;

            await LoadData();

            State.InvalidatePos();
        }
        catch
        {
            isOfflineMode = true;
            throw;
        }
    }

    private async Task<IEnumerable<ProductCatalogResult>>
        SearchUnitCatalogLocal(
            string? value,
            CancellationToken cancellationToken)
    {
        return await LocalCatalogQuery
            .SearchUnitCatalogsAsync(
                value,
                editingId,
                30,
                cancellationToken);
    }

    private static string FormatCatalog(
        ProductCatalogResult? catalog)
    {
        if (catalog == null)
            return string.Empty;

        if (!string.IsNullOrWhiteSpace(catalog.Barcode))
        {
            return $"{catalog.Name} [{catalog.Barcode}]";
        }

        if (!string.IsNullOrWhiteSpace(catalog.InternalCode))
        {
            return $"{catalog.Name} [{catalog.InternalCode}]";
        }

        return catalog.Name;
    }

    private Task OnComponentCatalogChanged(
        ProductCatalogResult? catalog)
    {
        selectedComponentCatalog = catalog;

        form.ComponentCatalogId =
            catalog?.Id ?? Guid.Empty;

        if (catalog == null)
        {
            form.PackQuantity = 0;
        }

        return Task.CompletedTask;
    }

    private async Task Sort(
        string column)
    {
        if (sortBy == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortBy = column;
            sortDescending = false;
        }

        Page = 1;

        await LoadData();
    }

    private string GetSortIcon(
        string column)
    {
        if (sortBy != column)
            return "↕";

        return sortDescending
            ? "▼"
            : "▲";
    }

    private async Task Search()
    {
        searchTerm = searchTerm.Trim();

        isSearching =
            !string.IsNullOrWhiteSpace(searchTerm);

        Page = 1;

        await LoadData();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        isSearching = false;
        Page = 1;

        await LoadData();
    }

    private async Task ChangePage(
        int newPage)
    {
        Page = Math.Clamp(
            newPage,
            1,
            TotalPages);

        await LoadData();
    }

    private async Task OnSearchKeyUp(
        KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await Search();
        }
    }

    private void AddProduct()
    {
        if (!CanUseServer)
        {
            ShowError(
                "Create is unavailable in offline mode.");

            return;
        }

        editingId = null;
        selectedComponentCatalog = null;

        form = CreateEmptyForm();

        showProduct = true;
    }

    private void CloseProductModal()
    {
        if (isLoading)
            return;

        ResetForm();
    }

    private Task HandleSubmit()
    {
        PrepareFormValues();

        if (!ValidateBusinessRules())
            return Task.CompletedTask;

        return editingId == null
            ? Create()
            : Update();
    }

    private void PrepareFormValues()
    {
        form.Name = form.Name.Trim();
        form.Barcode = form.Barcode.Trim();
        form.InternalCode = form.InternalCode.Trim();
        form.UnitOfMeasure = form.UnitOfMeasure.Trim();

        form.Brand = string.IsNullOrWhiteSpace(form.Brand)
            ? null
            : form.Brand.Trim();

        form.Manufacturer =
            string.IsNullOrWhiteSpace(form.Manufacturer)
                ? null
                : form.Manufacturer.Trim();

        form.Description =
            string.IsNullOrWhiteSpace(form.Description)
                ? null
                : form.Description.Trim();
    }

    private bool ValidateBusinessRules()
    {
        if (form.SellingMode == SellingMode.Weight &&
            form.UnitOfMeasure == "pcs")
        {
            ShowError(
                "Weight products must use kg, g or l.");

            return false;
        }

        if (form.SellingMode == SellingMode.Unit &&
            form.UnitOfMeasure != "pcs")
        {
            ShowError(
                "Unit products must use pcs.");

            return false;
        }

        if (form.SellingMode == SellingMode.Weight)
        {
            form.IsPack = false;
            form.ComponentCatalogId = Guid.Empty;
            form.PackQuantity = 0;

            selectedComponentCatalog = null;
        }

        if (!form.IsPack)
            return true;

        if (form.ComponentCatalogId == Guid.Empty)
        {
            ShowError(
                "Please select the unit product for this pack.");

            return false;
        }

        if (form.PackQuantity <= 0)
        {
            ShowError(
                "Pack quantity must be greater than zero.");

            return false;
        }

        if (editingId.HasValue &&
            form.ComponentCatalogId == editingId.Value)
        {
            ShowError(
                "A product cannot contain itself.");

            return false;
        }

        return true;
    }

    private async Task Create()
    {
        if (isLoading)
            return;

        if (!CanUseServer)
        {
            ShowError(
                "Create is unavailable in offline mode.");

            return;
        }

        var productName = form.Name;

        try
        {
            isLoading = true;

            ClearMessages();

            var request = new CreateProductCatalogRequest
            {
                Name = form.Name,
                Barcode = form.Barcode,
                InternalCode = form.InternalCode,
                Brand = form.Brand,
                Manufacturer = form.Manufacturer,
                Description = form.Description,
                UnitOfMeasure = form.UnitOfMeasure,
                CategoryId = form.CategoryId,
                CreatedAt = DateTime.UtcNow,
                IsPack = form.IsPack,
                SellingMode = form.SellingMode,
                PackComponents = BuildPackComponents()
            };

            await Api.Create(request);

            var localSyncSucceeded = true;

            try
            {
                await RefreshAfterServerMutationAsync();
            }
            catch (Exception exception)
            {
                localSyncSucceeded = false;

                System.Diagnostics.Debug.WriteLine(
                    $"Local refresh after create failed: {exception}");
            }

            ResetForm();

            Page = 1;

            await LoadData();

            if (localSyncSucceeded)
            {
                ShowSuccess(
                    $"Product '{productName}' created successfully.");
            }
            else
            {
                ShowError(
                    $"Product '{productName}' was created on the server, " +
                    "but SQLite was not refreshed.");
            }
        }
        catch (HttpRequestException exception)
        {
            isOfflineMode = true;

            ShowError(
                $"Server unavailable: " +
                $"{exception.GetBaseException().Message}");
        }
        catch (Exception exception)
        {
            ShowError(
                $"Failed to create product: " +
                $"{exception.GetBaseException().Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

