@page "/customers"
@using Inventory.Dto.Customers.Requests
@using Inventory.Dto.Customers.Results
@using Inventory.Ui.Services

@inject ICustomerApi Api
@inject NavigationManager Nav
@inject ICashSessionApi CashSessionApi
@inject AppState State
@inject PosBootstrapService Bootstrap
@implements IDisposable

<h3>Customers</h3>

<div class="page-container">

    @if (ShowCustomer)
    {
        <div class="customer-modal-overlay" @onclick="CloseCustomerModal">
            <div class="customer-modal" @onclick:stopPropagation="true">
                <!-- CREATE / EDIT -->
                <div class="card">
                    <h4>@(editingId == null ? "Create customer" : "Edit customer")</h4>

                    <EditForm Model="form" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="form-grid">
                            <div class="form-row">
                                <div class="form-field">
                                    <label>Name *</label>
                                    <InputText @bind-Value="form.Name"
                                               class="inputText"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Name)" />
                                </div>

                                <div class="form-field">
                                    <label>Email</label>
                                    <InputText type="email" @bind-Value="form.Email"
                                               class="inputText"
                                               disabled="@isLoading" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Phone</label>
                                    <InputText @bind-Value="form.Phone"
                                               class="inputText"
                                               disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label>Tax Number</label>
                                    <InputText @bind-Value="form.TaxNumber"
                                               class="inputText"
                                               disabled="@isLoading" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Address</label>
                                    <InputText @bind-Value="form.Address"
                                               class="inputText"
                                               disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label>Credit Limit</label>
                                    <InputNumber @bind-Value="form.CreditLimit"
                                                 class="inputText"
                                                 disabled="@isLoading" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Notes</label>
                                    <InputTextArea @bind-Value="form.Notes"
                                                   class="inputText"
                                                   disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label class="checkbox-label">
                                        <InputCheckbox @bind-Value="form.IsActive" />
                                        <span>Active</span>
                                    </label>
                                </div>
                            </div>

                            <div class="actions-end">
                                <button class="btn primary" type="submit" disabled="@isLoading">
                                    @(editingId == null ? "Create" : "Update")
                                </button>

                                @if (editingId != null)
                                {
                                    <button class="btn ghost" type="button" @onclick="CancelEdit">Cancel</button>
                                }
                            </div>
                        </div>
                    </EditForm>
                </div>

            </div>
        </div>
    }
    <!-- SEARCH -->
    <div class="card">
        <h4>Search Customers</h4>

        <div class="search-grid">
            <input type="text"
                   placeholder="Search by name"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp" />

            <div class="search-actions">
                <button class="btn primary" @onclick="Search">Search</button>
                <button class="btn ghost" @onclick="ClearSearch">Clear</button>
                <button class="btn danger" @onclick="AddCustomer">Add</button>
            </div>
        </div>
    </div>

    @if (isLoadingData)
    {
        <p>Loading customers...</p>
    }
    else if (items is null || items.Count == 0)
    {
        <p>@(isSearching ? "No Customer found matching your search." : "No Customer.")</p>
    }
    else
    {
        <div class="pager">
            <button class="btn ghost" disabled="@(Page == 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>

            <span class="muted">
                Page @Page / @(Math.Ceiling((double)TotalCount / PageSize))
            </span>

            <button class="btn ghost"
                    disabled="@(Page* PageSize >= TotalCount)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>
        </div>
        <div class="results-header">
            <span>@items.Count product(s) found</span>
            @if (isSearching)
            {
                <button class="btn small ghost" @onclick="ClearSearch">Show All</button>
            }
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in items)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@(c.Email ?? "-")</td>
                        <td>@(c.Phone ?? "-")</td>
                        <td>@c.CurrentBalance</td>
                        <td>
                            <span class="badge @(c.IsActive ? "badge-success" : "badge-inactive")">
                                @(c.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="actions-end">
                            <button class="btn small ghost" @onclick="() => StartEdit(c)">Edit</button>
                            <button class="btn small danger" @onclick="() => AskDelete(c)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (showDelete && customerToDelete != null)
    {
        <div class="modal-overlay" @onclick="CancelDelete">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h4>Confirm Delete</h4>
                <p>Delete <strong>@customerToDelete.Name</strong>?</p>
                <div class="modal-actions">
                    <button class="btn ghost" @onclick="CancelDelete">Cancel</button>
                    <button class="btn danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    }



    <!-- Success Toast -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="toast-success">
            <span class="toast-icon"></span>
            <span>@successMessage</span>
        </div>
    }

    @* Error Toast *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="toast-error">
            <span class="toast-icon"></span>
            <span>@errorMessage</span>
        </div>
    }
</div>

@code {
    private List<CustomerResult>? items;
    private CustomerForm form = new();
    private Guid? editingId;

    private bool isLoading;
    private bool isLoadingData;
    private bool isSearching;
    private bool showDelete;
    private bool ShowCustomer;

    private string? errorMessage;
    private string? successMessage;
    private string searchTerm = string.Empty;

    int Page = 1;
    int PageSize = 10;
    int TotalCount;

    private CustomerResult? customerToDelete;

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChange;
    }

    private void HandleStateChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= HandleStateChange;
    }

    protected override async Task OnInitializedAsync()
        => await LoadData();


    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            isSearching = false;
            Page = 1;
            await LoadData();
            return;
        }
        isSearching = true;
        Page = 1;
        await LoadData();
    }

    async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadData();
    }
    private void AddCustomer()
    {
        ShowCustomer = true;
    }

    private void CloseCustomerModal()
    {
        ShowCustomer = false;
    }

    private async Task ShowError(string message)
    {
        errorMessage = null;
        StateHasChanged();

        errorMessage = message;
        StateHasChanged();

        await Task.Delay(3000).ContinueWith(_ =>
        {
            errorMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ShowSuccess(string message)
    {
        successMessage = null;
        StateHasChanged();

        successMessage = message;
        StateHasChanged();

        await Task.Delay(3000).ContinueWith(_ =>
        {
            successMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task LoadData()
    {
        try
        {
            if (!State.IsCashSessionLoaded)
            {
                try
                {
                    var active = await CashSessionApi.GetActive();
                    await State.SetCashSessionAsync(active);
                }
                catch
                {
                    await ShowError("No active cash session.");
                    Nav.NavigateTo("/cashsessions");
                    return;
                }
            }

            isLoadingData = true;
            errorMessage = null;

            var query = new CustomerQuery
            {
                Page = Page,
                PageSize = PageSize,
                Search = isSearching ? searchTerm : null
            };

            var response = await Api.Search(query);

            items = response.Items?.ToList() ?? new List<CustomerResult>();
            TotalCount = response.TotalCount;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load Customers : {ex.Message}";
            items = new List<CustomerResult>();
            throw;
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (editingId == null)
            await Api.Create(form.ToCreate());
        else
            await Api.Update(editingId.Value, form.ToUpdate(editingId.Value));

        // Invalide le cache customers pour que Sales/POS voient les nouveaux clients
        State.InvalidateCustomers();
        _ = Bootstrap.EnsureLoadedAsync();

        Reset();
        ShowCustomer = false;
        await LoadData();
    }

    private void StartEdit(CustomerResult c)
    {
        editingId = c.Id;
        form = CustomerForm.From(c);
    }

    private void AskDelete(CustomerResult c)
    {
        customerToDelete = c;
        showDelete = true;
    }

    private async Task ConfirmDelete()
    {
        await Api.Delete(customerToDelete!.Id);
        showDelete = false;

        State.InvalidateCustomers();
        _ = Bootstrap.EnsureLoadedAsync();

        await LoadData();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        await LoadData();
    }

    private void CancelDelete() => showDelete = false;
    private void CancelEdit() => Reset();
    private void Reset() { editingId = null; form = new(); }
    private void ClearError() => errorMessage = null;
    private void ClearSuccess() => successMessage = null;

    private sealed class CustomerForm
    {
        [Required] public string Name { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? Address { get; set; }
        public string? TaxNumber { get; set; }
        public decimal CreditLimit { get; set; }
        public bool IsActive { get; set; } = true;
        public string? Notes { get; set; }

        public CreateCustomerRequest ToCreate() => new()
        {
            Name = Name,
            Email = Email,
            Phone = Phone,
            Address = Address,
            TaxNumber = TaxNumber,
            CreditLimit = CreditLimit,
            IsActive = IsActive,
            Notes = Notes
        };

        public UpdateCustomerRequest ToUpdate(Guid id) => new()
        {
            Id = id,
            Name = Name,
            Email = Email,
            Phone = Phone,
            Address = Address,
            TaxNumber = TaxNumber,
            CreditLimit = CreditLimit,
            IsActive = IsActive,
            Notes = Notes
        };

        public static CustomerForm From(CustomerResult c) => new()
        {
            Name = c.Name,
            Email = c.Email,
            Phone = c.Phone,
            TaxNumber = c.TaxNumber,
            CreditLimit = c.CreditLimit,
            IsActive = c.IsActive,
            Notes = c.Notes
        };
    }
}
