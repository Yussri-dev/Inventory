@page "/customers"
@using Inventory.Dto.Customers.Requests
@using Inventory.Dto.Customers.Results
@using Inventory.Ui.Services

@using Inventory.LocalDB.Services.Interfaces
@inject ILocalCustomerService LocalCustomerService

@inject AppState State
@implements IDisposable

<h3>Customers</h3>

<div class="page-container">

    @if (showCustomerModal)
    {
        <div class="customer-modal-overlay" @onclick="CloseCustomerModal">
            <div class="customer-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="customer-modal-title"
                 @onclick:stopPropagation="true">
                <!-- CREATE / EDIT -->
                <div class="card">
                    <div class="customer-modal-header">
                        <h4 id="customer-modal-title">
                            @(editingId == null
                                ? "Create customer"
                                : "Edit customer")
                        </h4>

                        <button type="button"
                                class="btn small ghost"
                                disabled="@isLoading"
                                aria-label="Close customer form"
                                @onclick="CloseCustomerModal">
                            &#10005;
                        </button>
                    </div>

                    <EditForm @key="editorVersion"
                              Model="form"
                              OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="form-grid">
                            <div class="form-row">
                                <div class="form-field">
                                    <label>Name *</label>
                                    <InputText @bind-Value="form.Name"
                                               class="inputText"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Name)" />
                                </div>

                                <div class="form-field">
                                    <label>Email</label>
                                    <InputText type="email" @bind-Value="form.Email"
                                               class="inputText"
                                               disabled="@isLoading" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Phone</label>
                                    <InputText @bind-Value="form.Phone"
                                               class="inputText"
                                               disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label>Tax Number</label>
                                    <InputText @bind-Value="form.TaxNumber"
                                               class="inputText"
                                               disabled="@isLoading" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Address</label>
                                    <InputText @bind-Value="form.Address"
                                               class="inputText"
                                               disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label>Credit Limit</label>
                                    <InputNumber @bind-Value="form.CreditLimit"
                                                 class="inputText"
                                                 min="0"
                                                 disabled="@(isLoading ||
                                                             !form.AllowCredit ||
                                                             form.HasUnlimitedCredit)" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label class="checkbox-label">
                                        <InputCheckbox
                                            @bind-Value="form.AllowCredit"
                                            disabled="@isLoading" />

                                        <span>Allow purchases on credit</span>
                                    </label>
                                </div>

                                <div class="form-field">
                                    <label class="checkbox-label">
                                        <InputCheckbox
                                            @bind-Value="form.HasUnlimitedCredit"
                                            disabled="@(isLoading ||
                                                        !form.AllowCredit)" />

                                        <span>Unlimited credit</span>
                                    </label>
                                </div>
                            </div>

                            @if (form.AllowCredit &&
                                 !form.HasUnlimitedCredit)
                            {
                                <div class="credit-policy-info">
                                    Credit purchases are limited to
                                    @form.CreditLimit.ToString("0.00").
                                </div>
                            }
                            else if (form.AllowCredit)
                            {
                                <div class="credit-policy-info">
                                    This customer has unlimited credit.
                                </div>
                            }

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Notes</label>
                                    <InputTextArea @bind-Value="form.Notes"
                                                   class="inputText"
                                                   disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label class="checkbox-label">
                                        <InputCheckbox @bind-Value="form.IsActive"
                                                       disabled="@isLoading" />
                                        <span>Active</span>
                                    </label>
                                </div>
                            </div>

                            <div class="actions-end">
                                <button class="btn primary"
                                        type="submit"
                                        disabled="@isLoading">
                                    @(editingId == null ? "Create" : "Update")
                                </button>

                                <button class="btn ghost"
                                        type="button"
                                        disabled="@isLoading"
                                        @onclick="CloseCustomerModal">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>

            </div>
        </div>
    }
    <!-- SEARCH -->
    <div class="card">
        <h4>Search Customers</h4>

        <div class="search-grid">
            <input type="text"
                   placeholder="Search by name"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp" />

            <div class="search-actions">
                <button type="button" class="btn primary" @onclick="Search">Search</button>
                <button type="button" class="btn ghost" @onclick="ClearSearch">Clear</button>
                <button type="button" class="btn danger" @onclick="AddCustomer">Add</button>
            </div>
        </div>
    </div>

    @if (isLoadingData)
    {
        <p>Loading customers...</p>
    }
    else if (items is null || items.Count == 0)
    {
        <p>@(isSearching ? "No Customer found matching your search." : "No Customer.")</p>
    }
    else
    {
        <div class="pager">
            <button class="btn ghost" disabled="@(Page == 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>

            <span class="muted">
                Page @Page / @(Math.Ceiling((double)TotalCount / PageSize))
            </span>

            <button class="btn ghost"
                    disabled="@(Page* PageSize >= TotalCount)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>
        </div>
        <div class="results-header">
            <span>@items.Count customer(s) found</span>
            @if (isSearching)
            {
                <button class="btn small ghost" @onclick="ClearSearch">Show All</button>
            }
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in items)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@(c.Email ?? "-")</td>
                        <td>@(c.Phone ?? "-")</td>
                        <td>@c.CurrentBalance</td>
                        <td>
                            <span class="badge @(c.IsActive ? "badge-success" : "badge-inactive")">
                                @(c.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="actions-end">
                            <button type="button"
                                    class="btn small ghost"
                                    @onclick="() => StartEdit(c)">
                                Edit
                            </button>

                            <button type="button"
                                    class="btn small danger"
                                    @onclick="() => AskDelete(c)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (showDelete && customerToDelete != null)
    {
        <div class="modal-overlay" @onclick="CancelDelete">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h4>Confirm Delete</h4>
                <p>Delete <strong>@customerToDelete.Name</strong>?</p>
                <div class="modal-actions">
                    <button type="button"
                            class="btn ghost"
                            disabled="@isDeleting"
                            @onclick="CancelDelete">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn danger"
                            disabled="@isDeleting"
                            @onclick="ConfirmDelete">
                        @(isDeleting ? "Deleting..." : "Delete")
                    </button>
                </div>
            </div>
        </div>
    }



    <!-- Success Toast -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="toast-success">
            <span class="toast-icon"></span>
            <span>@successMessage</span>
        </div>
    }

    @* Error Toast *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="toast-error">
            <span class="toast-icon"></span>
            <span>@errorMessage</span>
        </div>
    }
</div>

@code {
    private List<CustomerResult>? items;
    private CustomerForm form = new();
    private Guid? editingId;

    private bool isLoading;
    private bool isLoadingData;
    private bool isDeleting;
    private bool isSearching;
    private bool showDelete;
    private bool showCustomerModal;

    private int editorVersion;

    private CancellationTokenSource? toastCancellation;

    private string? errorMessage;
    private string? successMessage;
    private string searchTerm = string.Empty;

    private int Page = 1;
    private int PageSize = 10;
    private int TotalCount;

    private CustomerResult? customerToDelete;

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChange;
    }

    private void HandleStateChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.OnChange -= HandleStateChange;

        toastCancellation?.Cancel();
        toastCancellation?.Dispose();
    }

    protected override async Task OnInitializedAsync()
        => await LoadData();


    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            isSearching = false;
            Page = 1;
            await LoadData();
            return;
        }
        isSearching = true;
        Page = 1;
        await LoadData();
    }

    async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadData();
    }
    private void AddCustomer()
    {
        ResetEditor();
        showDelete = false;
        customerToDelete = null;
        showCustomerModal = true;
    }

    private void CloseCustomerModal()
    {
        if (isLoading)
        {
            return;
        }

        showCustomerModal = false;
        ResetEditor();
    }

    private void ShowError(string message)
    {
        successMessage = null;
        errorMessage = message;

        RestartToastTimer();
    }

    private void ShowSuccess(string message)
    {
        errorMessage = null;
        successMessage = message;

        RestartToastTimer();
    }

    private void RestartToastTimer()
    {
        toastCancellation?.Cancel();
        toastCancellation?.Dispose();

        toastCancellation =
            new CancellationTokenSource();

        _ = ClearToastAfterDelayAsync(
            toastCancellation.Token);
    }

    private async Task ClearToastAfterDelayAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(
                TimeSpan.FromSeconds(3),
                cancellationToken);

            await InvokeAsync(() =>
            {
                errorMessage = null;
                successMessage = null;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // A newer message replaced the current toast.
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new CustomerQuery
            {
                Page = Page,
                PageSize = PageSize,
                Search = isSearching ? searchTerm : null
            };

            var response = await LocalCustomerService.QueryAsync(query);

            items = response.Items?.ToList() ?? new List<CustomerResult>();
            TotalCount = response.TotalCount;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load local customers: {ex.Message}";
            items = new List<CustomerResult>();
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task HandleSubmit()
    {
        var isCreate =
            editingId == null;

        try
        {
            isLoading = true;
            errorMessage = null;

            if (isCreate)
            {
                await LocalCustomerService.CreateAsync(form.ToCreate());
            }
            else
            {
                var customerId =
                    editingId!.Value;

                await LocalCustomerService.UpdateAsync(
                    customerId,
                    form.ToUpdate(customerId));
            }

            State.InvalidateCustomers();

            showCustomerModal = false;
            ResetEditor();

            await LoadData();

            ShowSuccess(
                isCreate
                    ? "Customer created locally."
                    : "Customer updated locally.");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit(CustomerResult c)
    {
        ArgumentNullException.ThrowIfNull(c);

        editingId = c.Id;
        form = CustomerForm.From(c);
        editorVersion++;

        showDelete = false;
        customerToDelete = null;
        showCustomerModal = true;
    }

    private void AskDelete(CustomerResult c)
    {
        ArgumentNullException.ThrowIfNull(c);

        customerToDelete = c;
        showDelete = true;
    }

    private async Task ConfirmDelete()
    {
        if (customerToDelete == null ||
            isDeleting)
        {
            return;
        }

        try
        {
            isDeleting = true;

            await LocalCustomerService.DeleteAsync(customerToDelete.Id);

            showDelete = false;
            customerToDelete = null;

            State.InvalidateCustomers();

            await LoadData();

            ShowSuccess("Customer deleted locally.");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        isSearching = false;
        Page = 1;

        await LoadData();
    }

    private void CancelDelete()
    {
        if (isDeleting)
        {
            return;
        }

        showDelete = false;
        customerToDelete = null;
    }

    private void ResetEditor()
    {
        editingId = null;
        form = new CustomerForm();
        editorVersion++;
    }

    private sealed class CustomerForm
    {
        [Required] public string Name { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? Address { get; set; }
        public string? TaxNumber { get; set; }
        public decimal CreditLimit { get; set; }
        public bool AllowCredit { get; set; }
        public bool HasUnlimitedCredit { get; set; }
        public bool IsActive { get; set; } = true;
        public string? Notes { get; set; }

        public CreateCustomerRequest ToCreate() => new()
        {
            Name = Name,
            Email = Email,
            Phone = Phone,
            Address = Address,
            TaxNumber = TaxNumber,
            CreditLimit = EffectiveCreditLimit,
            AllowCredit = AllowCredit,
            HasUnlimitedCredit =
                AllowCredit &&
                HasUnlimitedCredit,
            IsActive = IsActive,
            Notes = Notes
        };

        public UpdateCustomerRequest ToUpdate(Guid id) => new()
        {
            Id = id,
            Name = Name,
            Email = Email,
            Phone = Phone,
            Address = Address,
            TaxNumber = TaxNumber,
            CreditLimit = EffectiveCreditLimit,
            AllowCredit = AllowCredit,
            HasUnlimitedCredit =
                AllowCredit &&
                HasUnlimitedCredit,
            IsActive = IsActive,
            Notes = Notes
        };

        public static CustomerForm From(CustomerResult c) => new()
        {
            Name = c.Name,
            Email = c.Email,
            Phone = c.Phone,
            Address = c.Address,
            TaxNumber = c.TaxNumber,
            CreditLimit = c.CreditLimit,
            AllowCredit = c.AllowCredit,
            HasUnlimitedCredit =
                c.HasUnlimitedCredit,
            IsActive = c.IsActive,
            Notes = c.Notes
        };

        private decimal EffectiveCreditLimit =>
            !AllowCredit ||
            HasUnlimitedCredit
                ? 0m
                : Math.Max(
                    0m,
                    CreditLimit);
    }
}
