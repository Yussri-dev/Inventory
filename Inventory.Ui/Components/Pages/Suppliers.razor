    //     }
    //     catch (Exception ex)
    //     {
    //         await ShowError($"Failed to create supplier locally: {ex.Message}");
    //     }
    //     finally
    //     {
    //         isLoading = false;
    //     }
    // }

    // private async Task Update()
    // {
    //     if (editingId == null)
    //         return;

    //     try
    //     {
    //         isLoading = true;
    //         errorMessage = null;

    //         await LocalSupplierService.UpdateAsync(editingId.Value, form.ToUpdate(editingId.Value));

    //         await ShowSuccess($"Supplier '{form.Name}' updated locally.");

    //         Reset();
    //         showSupplierModal = false;

    //         await LoadData();
    //     }
    //     catch (Exception ex)
    //     {
    //         await ShowError($"Failed to update supplier locally: {ex.Message}");
    //     }
    //     finally
    //     {
    //         isLoading = false;
    //     }
    // }

    private void StartEdit(SupplierResult s)
    {
        editingId = s.Id;

        form = SupplierForm.From(s);

        ShowSupplier = true;
    }

    private void AskDelete(SupplierResult s)
    {
        supplierToDelete = s;
        ShowDelete = true;
    }

    private async Task ConfirmDelete()
    {
        if (supplierToDelete == null)
            return;

        try
        {
            isLoading = true;
            ShowDelete = false;

            var supplierName = supplierToDelete.Name;

            await LocalSupplierService.DeleteAsync(supplierToDelete.Id);

            await ShowSuccess($"Supplier '{supplierName}' deleted locally.");

            supplierToDelete = null;

            await LoadData();
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to delete supplier locally: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CancelDelete()
    {
        ShowDelete = false;
        supplierToDelete = null;
    }

    private void CancelEdit()
    {
        Reset();
        ShowSupplier = false;
    }

    private void Reset()
    {
        editingId = null;
        form = new SupplierForm();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task ShowSuccess(string message)
    {
        successMessage = null;
        StateHasChanged();

        successMessage = message;
        StateHasChanged();

        await Task.Delay(3000).ContinueWith(_ =>
        {
            successMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ShowError(string message)
    {
        errorMessage = null;
        StateHasChanged();

        errorMessage = message;
        StateHasChanged();

        await Task.Delay(3000).ContinueWith(_ =>
        {
            errorMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private sealed class SupplierForm
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        [StringLength(100, ErrorMessage = "Contact person cannot exceed 100 characters")]
        public string? ContactPerson { get; set; }

        [EmailAddress(ErrorMessage = "Invalid email address")]
        [StringLength(100, ErrorMessage = "Email cannot exceed 100 characters")]
        public string? Email { get; set; }

        [StringLength(50, ErrorMessage = "Phone cannot exceed 50 characters")]
        public string? Phone { get; set; }

        [StringLength(500, ErrorMessage = "Address cannot exceed 500 characters")]
        public string? Address { get; set; }

        [StringLength(50, ErrorMessage = "Tax number cannot exceed 50 characters")]
        public string? TaxNumber { get; set; }

        [StringLength(100, ErrorMessage = "Country cannot exceed 100 characters")]
        public string? Country { get; set; }

        [StringLength(100, ErrorMessage = "City cannot exceed 100 characters")]
        public string? City { get; set; }

        [StringLength(20, ErrorMessage = "Postal code cannot exceed 20 characters")]
        public string? PostalCode { get; set; }

        [StringLength(100, ErrorMessage = "Bank account cannot exceed 100 characters")]
        public string? BankAccount { get; set; }

        public int PaymentTermsDays { get; set; }

        public bool IsActive { get; set; } = true;

        [StringLength(1000, ErrorMessage = "Notes cannot exceed 1000 characters")]
        public string? Notes { get; set; }

        public CreateSupplierRequest ToCreate()
        {
            return new CreateSupplierRequest
            {
                Name = Name,
                ContactPerson = ContactPerson,
                Email = Email,
                Phone = Phone,
                Address = Address,
                TaxNumber = TaxNumber,
                Country = Country,
                City = City,
                PostalCode = PostalCode,
                BankAccount = BankAccount,
                PaymentTermsDays = PaymentTermsDays,
                IsActive = IsActive,
                Notes = Notes
            };
        }

        public UpdateSupplierRequest ToUpdate(Guid id)
        {
            return new UpdateSupplierRequest
            {
                Id = id,
                Name = Name,
                ContactPerson = ContactPerson,
                Email = Email,
                Phone = Phone,
                Address = Address,
                TaxNumber = TaxNumber,
                Country = Country,
                City = City,
                PostalCode = PostalCode,
                BankAccount = BankAccount,
                PaymentTermsDays = PaymentTermsDays,
                IsActive = IsActive,
                Notes = Notes
            };
        }

        public static SupplierForm From(SupplierResult supplier)
        {
            return new SupplierForm
            {
                Name = supplier.Name,
                ContactPerson = supplier.ContactPerson,
                Email = supplier.Email,
                Phone = supplier.Phone,
                Address = supplier.Address,
                TaxNumber = supplier.TaxNumber,
                Country = supplier.Country,
                City = supplier.City,
                PostalCode = supplier.PostalCode,
                BankAccount = supplier.BankAccount,
                PaymentTermsDays = supplier.PaymentTermsDays,
                IsActive = supplier.IsActive,
                Notes = supplier.Notes
            };
        }
    }
}