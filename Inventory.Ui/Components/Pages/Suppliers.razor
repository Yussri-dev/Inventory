@page "/suppliers"

@using System.ComponentModel.DataAnnotations
@using Inventory.Dto.Queries
@using Inventory.Dto.Suppliers.Requests
@using Inventory.Dto.Suppliers.Results
@using Inventory.LocalDB.Services.Interfaces

@inject ILocalSupplierService LocalSupplierService
@inject AppState State
@implements IDisposable

<h3>Suppliers</h3>

<div class="page-container">

    @if (ShowSupplier)
    {
        <div class="customer-modal-overlay" @onclick="CloseSupplierModal">
            <div class="customer-modal" @onclick:stopPropagation="true">
                <div class="card">
                    <h4>@(editingId == null ? "Create supplier" : "Edit supplier")</h4>

                    <EditForm Model="form" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="form-grid">
                            <div class="form-row">
                                <div class="form-field">
                                    <label>Name *</label>
                                    <InputText placeholder="Supplier name"
                                               class="inputText"
                                               @bind-Value="form.Name"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Name)" />
                                </div>

                                <div class="form-field">
                                    <label>Contact Person</label>
                                    <InputText placeholder="Contact person"
                                               class="inputText"
                                               @bind-Value="form.ContactPerson"
                                               disabled="@isLoading" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Email</label>
                                    <InputText placeholder="email@example.com"
                                               class="inputText"
                                               type="email"
                                               @bind-Value="form.Email"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Email)" />
                                </div>

                                <div class="form-field">
                                    <label>Phone</label>
                                    <InputText placeholder="+32 ..."
                                               class="inputText"
                                               @bind-Value="form.Phone"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Phone)" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Address</label>
                                    <InputText placeholder="Address"
                                               class="inputText"
                                               @bind-Value="form.Address"
                                               disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label>Tax Number</label>
                                    <InputText placeholder="Tax identification number"
                                               class="inputText"
                                               @bind-Value="form.TaxNumber"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.TaxNumber)" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Country</label>
                                    <InputText placeholder="Country"
                                               class="inputText"
                                               @bind-Value="form.Country"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.Country)" />
                                </div>

                                <div class="form-field">
                                    <label>City</label>
                                    <InputText placeholder="City"
                                               class="inputText"
                                               @bind-Value="form.City"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.City)" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Postal Code</label>
                                    <InputText placeholder="Postal code"
                                               class="inputText"
                                               @bind-Value="form.PostalCode"
                                               disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label>Bank Account</label>
                                    <InputText placeholder="Bank account number"
                                               class="inputText"
                                               @bind-Value="form.BankAccount"
                                               disabled="@isLoading" />
                                    <ValidationMessage For="@(() => form.BankAccount)" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Payment Terms Days</label>
                                    <InputNumber class="inputText"
                                                 @bind-Value="form.PaymentTermsDays"
                                                 disabled="@isLoading" />
                                </div>

                                <div class="form-field">
                                    <label class="checkbox-label">
                                        <InputCheckbox @bind-Value="form.IsActive" disabled="@isLoading" />
                                        <span>Active</span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-field">
                                    <label>Notes</label>
                                    <InputTextArea class="inputText"
                                                   @bind-Value="form.Notes"
                                                   disabled="@isLoading" />
                                </div>
                            </div>

                            <div class="actions-end">
                                <button type="submit" class="btn primary" disabled="@isLoading">
                                    @if (editingId == null)
                                    {
                                        @(isLoading ? "Creating..." : "Create")
                                    }
                                    else
                                    {
                                        @(isLoading ? "Updating..." : "Update")
                                    }
                                </button>

                                @if (editingId != null)
                                {
                                    <button type="button"
                                            class="btn ghost"
                                            @onclick="CancelEdit"
                                            disabled="@isLoading">
                                        Cancel
                                    </button>
                                }
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <h4>Search Suppliers</h4>

        <div class="search-grid">
            <input type="text"
                   placeholder="Search name, email, phone, city…"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp"
                   disabled="@isLoading" />

            <div class="search-actions">
                <button class="btn primary" @onclick="Search" disabled="@isLoading">
                    Search
                </button>
                <button class="btn ghost" @onclick="ClearSearch" disabled="@isLoading">
                    Clear
                </button>
                <button class="btn primary" @onclick="AddSupplier">
                    Add
                </button>
            </div>
        </div>
    </div>

    @if (isLoadingData)
    {
        <div class="loading-container">
            <p>Loading local suppliers...</p>
        </div>
    }
    else if (items is null || items.Count == 0)
    {
        <p>@(isSearching ? "No suppliers found matching your search." : "No suppliers.")</p>
    }
    else
    {
        <div class="pager">
            <button class="btn ghost"
                    disabled="@(Page == 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>

            <span class="muted">
                Page @Page / @(Math.Max(1, Math.Ceiling((double)TotalCount / PageSize)))
            </span>

            <button class="btn ghost"
                    disabled="@(Page* PageSize >= TotalCount)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>
        </div>

        <div class="results-header">
            <span>@items.Count supplier(s) found locally</span>

            @if (isSearching)
            {
                <button class="btn small ghost" @onclick="ClearSearch">Show All</button>
            }
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Tax Number</th>
                    <th>Country</th>
                    <th>City</th>
                    <th>Status</th>
                    <th style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in items)
                {
                    <tr>
                        <td>
                            <div class="product-name">@s.Name</div>

                            @if (!string.IsNullOrWhiteSpace(s.BankAccount))
                            {
                                <div class="product-desc">Account: @s.BankAccount</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(s.ContactPerson))
                            {
                                <div class="product-desc">Contact: @s.ContactPerson</div>
                            }
                        </td>

                        <td>@(s.Email ?? "-")</td>
                        <td>@(s.Phone ?? "-")</td>
                        <td>@(s.TaxNumber ?? "-")</td>
                        <td>@(s.Country ?? "-")</td>
                        <td>@(s.City ?? "-")</td>

                        <td>
                            <span class="badge @(s.IsActive ? "badge-success" : "badge-inactive")">
                                @(s.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <td class="actions-end">
                            <button class="btn small ghost"
                                    @onclick="() => StartEdit(s)"
                                    disabled="@isLoading">
                                Edit
                            </button>

                            <button class="btn small danger"
                                    @onclick="() => AskDelete(s)"
                                    disabled="@isLoading">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (ShowDelete && supplierToDelete != null)
    {
        <div class="modal-overlay" @onclick="CancelDelete">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h4>Confirm Delete</h4>
                <p>Are you sure you want to delete <strong>@supplierToDelete.Name</strong>?</p>
                <p class="text-muted">This action will be saved locally and synced later.</p>

                <div class="modal-actions">
                    <button class="btn ghost" @onclick="CancelDelete">Cancel</button>
                    <button class="btn danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="toast-success">
            <span class="toast-icon"></span>
            <span>@successMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="toast-error">
            <span class="toast-icon"></span>
            <span>@errorMessage</span>
        </div>
    }
</div>

@code {
    private List<SupplierResult>? items;
    private SupplierForm form = new();
    private Guid? editingId;

    private bool isLoading;
    private bool isLoadingData;
    private bool isSearching;
    private bool ShowDelete;

    private string? errorMessage;
    private string? successMessage;

    private string searchTerm = string.Empty;

    private bool ShowSupplier;
    private SupplierResult? supplierToDelete;

    private int Page = 1;
    private int PageSize = 10;
    private int TotalCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new SupplierQuery
            {
                Page = Page,
                PageSize = PageSize,
                Search = isSearching ? searchTerm : null
            };

            var response = await LocalSupplierService.QueryAsync(query);

            items = response.Items?.ToList() ?? new List<SupplierResult>();
            TotalCount = response.TotalCount;
        }
        catch (Exception ex)
        {
            await ShowError($"Failed to load local suppliers: {ex.Message}");
            items = new List<SupplierResult>();
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            isSearching = false;
            Page = 1;
            await LoadData();
            return;
        }

        isSearching = true;
        Page = 1;
        await LoadData();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        isSearching = false;
        Page = 1;
        await LoadData();
    }

    private async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadData();
    }

    private void AddSupplier()
    {
        editingId = null;
        form = new SupplierForm();
        ShowSupplier = true;
    }

    private void CloseSupplierModal()
    {
        ShowSupplier = false;
    }

    // private async Task HandleSubmit()
    // {
    //     if (editingId == null)
    //     {
    //         await Create();
    //     }
    //     else
    //     {
    //         await Update();
    //     }
    // }

    private async Task HandleSubmit()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            if (editingId == null)
            {
                await LocalSupplierService.CreateAsync(form.ToCreate());
                await ShowSuccess("Supplier created locally.");
            }
            else
            {
                await LocalSupplierService.UpdateAsync(editingId.Value, form.ToUpdate(editingId.Value));
                await ShowSuccess("Supplier updated locally.");
            }

            State.InvalidateSuppliers();

            Reset();
            ShowSupplier = false;
            await LoadData();

        }
        catch (Exception ex)
        {
            await ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleStateChange() => InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChange;
    }

    public void Dispose()
    {
        State.OnChange -= HandleStateChange;
    }


