@page "/dashboard"
@using Inventory.Dto.Analytics.Results
@using System.Globalization
@using Inventory.Ui.Services.Analytics
@inject ILocalAnalyticsService LocalAnalyticsService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="dash-page">

    <!-- HEADER -->
    <div class="dash-header">
        <div>
            <h1 class="dash-title">Dashboard</h1>
            <p class="dash-sub">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
        </div>
        <div class="period-pills">
            @foreach (var p in Enum.GetValues<Period>())
            {
                <button class="pill @(period == p ? "active" : "")"
                        disabled="@isLoading" @onclick="() => SelectPeriod(p)">
                    @PeriodLabel(p)
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="dash-loading">
            <div class="spinner"></div>
            <span>Loading analytics...</span>
        </div>
    }
    else if (loadError != null)
    {
        <div role="alert">@loadError</div>
        <button @onclick="LoadAll">Retry</button>
    }
    else
    {
        <!-- KPI ROW -->
        <div class="kpi-row">
            <div class="kpi revenue">
                <div class="kpi-icon">💰</div>
                <div class="kpi-body">
                    <div class="kpi-label">Revenue</div>
                    <div class="kpi-val green">€@(profit?.TotalRevenue.ToString("N2") ?? "0.00")</div>
                </div>
            </div>
            <div class="kpi">
                <div class="kpi-icon">🧾</div>
                <div class="kpi-body">
                    <div class="kpi-label">Cost</div>
                    <div class="kpi-val">€@(profit?.TotalCost.ToString("N2")?? "0.00")</div>
                </div>
            </div>
            <div class="kpi">
                <div class="kpi-icon">↩️</div>
                <div class="kpi-body">
                    <div class="kpi-label">Refunds</div>
                    <div class="kpi-val red">€(@profit?.TotalRefunds.ToString("N2")?? "0.00")</div>
                </div>
            </div>
            <div class="kpi profit">
                <div class="kpi-icon">📈</div>
                <div class="kpi-body">
                    <div class="kpi-label">Gross Profit</div>
                    <div class="kpi-val @((profit?.GrossProfit ?? 0) >= 0 ? "green" : "red")">
                        €(@profit?.GrossProfit.ToString("N2")?? "0.00")
                    </div>
                </div>
            </div>
            <div class="kpi">
                <div class="kpi-icon">%</div>
                <div class="kpi-body">
                    <div class="kpi-label">Margin</div>
                    <div class="kpi-val @((profit?.ProfitMargin ?? 0) >= 0 ? "green" : "red")">
                        @(profit?.ProfitMargin.ToString("N1")?? "0.00")%
                    </div>
                </div>
            </div>
            <div class="kpi">
                <div class="kpi-icon">🛒</div>
                <div class="kpi-body">
                    <div class="kpi-label">Sales</div>
                    <div class="kpi-val">@weekly?.SalesCount</div>
                </div>
            </div>
        </div>

        <!-- CHARTS ROW -->
        <div class="charts-row">

            <!-- Sales per day bar chart -->
            <div class="chart-card wide">
                <div class="chart-header">
                    <span class="chart-title">📊 Daily Revenue</span>
                    <span class="chart-sub">@PeriodLabel(period)</span>
                </div>
                <div class="chart-wrap">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>

            <!-- Payment breakdown pie -->
            <div class="chart-card narrow">
                <div class="chart-header">
                    <span class="chart-title">💳 Payment Methods</span>
                </div>
                <div class="chart-wrap pie-wrap">
                    <canvas id="paymentChart"></canvas>
                </div>
            </div>
        </div>

        <!-- WEEKLY STATS ROW -->
        @if (weekly != null)
        {
            <div class="weekly-row">
                <div class="weekly-header">
                    <span>📅 Weekly Report</span>
                    <span class="week-badge">@weekly.Week</span>
                </div>
                <div class="weekly-stats">
                    <div class="wstat">
                        <div class="wlabel">Revenue</div>
                        <div class="wval green">€@weekly.Revenue.ToString("N2")</div>
                    </div>
                    <div class="wstat">
                        <div class="wlabel">Expenses</div>
                        <div class="wval">€@weekly.Expenses.ToString("N2")</div>
                    </div>
                    <div class="wstat">
                        <div class="wlabel">Profit</div>
                        <div class="wval @(weekly.Profit >= 0 ? "green" : "red")">€@weekly.Profit.ToString("N2")</div>
                    </div>
                    <div class="wstat">
                        <div class="wlabel">Sales</div>
                        <div class="wval">@weekly.SalesCount</div>
                    </div>
                    <div class="wstat">
                        <div class="wlabel">Returns</div>
                        <div class="wval">@weekly.ReturnsCount</div>
                    </div>
                    @* <div class="wstat">
                        <div class="wlabel">Cash Opening</div>
                        <div class="wval">€@weekly.CashOpening.ToString("N2")</div>
                    </div>
                    <div class="wstat">
                        <div class="wlabel">Cash Closing</div>
                        <div class="wval">€@weekly.CashClosing.ToString("N2")</div>
                    </div> *@
                </div>
            </div>
        }

        <!-- LOSS PRODUCTS -->
        <div class="loss-card">
            <div class="chart-header">
                <span class="chart-title">⚠️ Loss Products</span>
                <span class="chart-sub">@PeriodLabel(period)</span>
            </div>
            @if (lossProducts?.Any() == true)
            {
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Qty Returned</th>
                            <th>Lost Revenue</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in lossProducts)
                        {
                            <tr>
                                <td>@p.ProductName</td>
                                <td>@p.ReturnedQuantity</td>
                                <td class="red">€@p.LostRevenue.ToString("N2")</td>
                                <td><span class="reason-tag">@p.LossReason</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="no-loss">✅ No loss products for this period</div>
            }
        </div>
    }
</div>

@code {
    Period period = Period.Month;
    bool isLoading = true;
    string? loadError;

    ProfitAnalyticsResult? profit;
    List<LossProductResult>? lossProducts;
    WeeklyReportResult? weekly;

    // Values calculated from the local store database.
    List<(string Day, decimal Amount)> dailySales = new();
    List<(string Method, decimal Amount)> paymentBreakdown = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private bool chartsRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && loadError == null && !chartsRendered)
        {
            chartsRendered = true;
            await RenderCharts();
        }
    }

    async Task LoadAll()
    {
        if (isLoading && profit != null) return;
        isLoading = true;
        loadError = null;
        chartsRendered = false;
        StateHasChanged();

        var (from, to) = GetPeriod();

        try
        {
            profit = await LocalAnalyticsService.GetProfitAsync(from, to);
            lossProducts = await LocalAnalyticsService.GetLossProductsAsync(from, to);
            weekly = await LocalAnalyticsService.GetWeeklyAsync(from, to);

            await BuildDailyData(from, to);
        }
        catch (Exception ex)
        {
            var details = ex.ToString();
            Console.WriteLine(details);
            loadError = "Unable to load this store's local data. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    async Task BuildDailyData(DateOnly from, DateOnly to)
    {
        var daily = await LocalAnalyticsService.GetDailyRevenueAsync(from, to);
        dailySales = daily.Select(x => (x.Key.ToString("dd/MM"), x.Value)).ToList();
        var summary = await LocalAnalyticsService.GetDashboardSummaryAsync(from, to);
        paymentBreakdown = new()
        {
            ("Cash", summary.CashRevenue), ("Card", summary.CardRevenue), ("Credit", summary.CreditRevenue)
        };
    }

    async Task RenderCharts()
    {
        try
        {
            var labels = dailySales.Select(d => d.Day).ToArray();
            var values = dailySales.Select(d => (double)d.Amount).ToArray();

            await JS.InvokeVoidAsync("dashboardCharts.destroy");

            await JS.InvokeVoidAsync(
                "dashboardCharts.renderRevenue",
                "revenueChart",
                labels,
                values
            );

            var pLabels = paymentBreakdown.Select(p => p.Method).ToArray();
            var pValues = paymentBreakdown.Select(p => (double)p.Amount).ToArray();

            await JS.InvokeVoidAsync(
                "dashboardCharts.renderPayments",
                "paymentChart",
                pLabels,
                pValues
            );
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Chart render error: {ex}");
        }
    }

    async Task SelectPeriod(Period p)
    {
        period = p;
        await LoadAll();
    }

    (DateOnly from, DateOnly to) GetPeriod()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        return period switch
        {
            Period.Today => (today, today),
            Period.Week => (today.AddDays(-(((int)today.DayOfWeek + 6) % 7)), today),
            Period.Month => (new DateOnly(today.Year, today.Month, 1), today),
            Period.Year => (new DateOnly(today.Year, 1, 1), today),
            _ => (today, today)
        };
    }

    string PeriodLabel(Period p) => p switch
    {
        Period.Today => "Today",
        Period.Week => "This Week",
        Period.Month => "This Month",
        Period.Year => "This Year",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("dashboardCharts.destroy"); }
        catch { }
    }

}
