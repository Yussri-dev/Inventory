@page "/cashSessions"

@using Inventory.Dto.CashSessions.Results
@using Inventory.LocalDB.Models
@using Inventory.LocalDB.Services.Interfaces
@using Inventory.Ui.Interfaces
@using Inventory.Ui.Services.Sync
@using Refit

@inject ILocalCashSessionService LocalCashSessionService
@inject ILocalTenantContext LocalTenantContext
@inject ICashSessionReconciliationService CashSessionReconciliation
@inject ILocalSyncUploader LocalSyncUploader
@inject NavigationManager Navigation

<div class="cash-session-container">

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">
            @ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success">
            @SuccessMessage
        </div>
    }

    @if (ReconciliationResult?.ServerSession != null &&
         ReconciliationResult.State is
             CashSessionReconciliationState.Conflict or
             CashSessionReconciliationState.ServerSessionOnly)
    {
        <div class="card session-conflict"
             style="border:2px solid var(--danger, #dc3545); margin-bottom:1rem;">
            <div class="session-header">
                <div class="session-status">
                    <span class="status-badge closed">
                        ⚠ SERVER SESSION OPEN
                    </span>

                    <h2>
                        Server #@ReconciliationResult.ServerSession.SessionNumber
                    </h2>
                </div>
            </div>

            <div class="session-details">
                <p>@ReconciliationResult.Message</p>

                <div class="detail-row">
                    <div class="detail-item">
                        <span class="label">Server opened at</span>
                        <strong>
                            @(ReconciliationResult.ServerSession.OpenedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm"))
                        </strong>
                    </div>

                    <div class="detail-item">
                        <span class="label">Server expected cash</span>
                        <strong class="amount">
                            €@(ReconciliationResult.ServerSession
                                .ClosingAmountExpected
                                .ToString("F2"))
                        </strong>
                    </div>
                </div>

                @if (ReconciliationResult.LocalSession != null)
                {
                    <div class="detail-row">
                        <div class="detail-item">
                            <span class="label">Different local session</span>
                            <strong>
                                @ReconciliationResult.LocalSession.SessionNumber
                            </strong>
                        </div>

                        <div class="detail-item">
                            <span class="label">Local opened at</span>
                            <strong>
                                @(ReconciliationResult.LocalSession.OpenedAtUtc
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm"))
                            </strong>
                        </div>
                    </div>
                }
            </div>

            <div class="quick-actions">
                <button class="btn btn-danger"
                        @onclick="OpenServerCloseModal"
                        disabled="@IsLoading">
                    Count and close server session
                </button>

                <button class="btn btn-secondary"
                        @onclick="ReloadAndReconcile"
                        disabled="@IsLoading">
                    Check again
                </button>
            </div>
        </div>
    }

    @if (IsLoadingData)
    {
        <div class="card session-inactive">
            <div class="empty-state">
                <div class="icon">⏳</div>
                <h2>Loading cash session...</h2>
            </div>
        </div>
    }
    else if (ActiveSession != null)
    {
        <div class="card session-active">
            <div class="session-header">
                <div class="session-status">
                    <span class="status-badge open">● OPEN</span>
                    <h2>Cash Session #@ActiveSession.SessionNumber</h2>
                </div>

                <button class="btn btn-danger" @onclick="OpenCloseModal">
                    Close Session
                </button>
            </div>

            <div class="session-details">
                <div class="detail-row">
                    <div class="detail-item">
                        <span class="label">Opened At</span>
                        <strong>@ActiveSession.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>

                    <div class="detail-item">
                        <span class="label">Duration</span>
                        <strong>@GetSessionDuration(ActiveSession.OpenedAtUtc)</strong>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-item">
                        <span class="label">Opening Balance</span>
                        <strong class="amount">€@ActiveSession.OpeningAmount.ToString("F2")</strong>
                    </div>

                    <div class="detail-item">
                        <span class="label">Expected Cash</span>
                        <strong class="amount success">€@ActiveSession.ClosingAmountExpected.ToString("F2")</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ActiveSession.OpeningNotes))
                {
                    <div class="notes">
                        <span class="label">Opening Notes:</span>
                        <p>@ActiveSession.OpeningNotes</p>
                    </div>
                }
            </div>

            <div class="quick-actions">
                <button class="btn btn-primary" @onclick="NavigateToSales">
                    Start Selling
                </button>

                <button class="btn btn-secondary" @onclick="ViewHistory">
                    View History
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card session-inactive">
            <div class="empty-state">
                <div class="icon">🏪</div>
                <h2>No Active Cash Session</h2>
                <p>Open a new local cash session to start selling offline.</p>

                <button class="btn btn-primary btn-lg"
                        @onclick="OpenCreateModal"
                        disabled="@(ReconciliationResult?.ServerSession != null)">
                    Open New Session
                </button>

                @if (ReconciliationResult?.ServerSession != null)
                {
                    <p class="muted">
                        Resolve the open server session before opening a
                        different local session.
                    </p>
                }
            </div>
        </div>
    }

    @if (RecentSessions.Count > 0)
    {
        <div class="card recent-sessions">
            <h3>Recent Sessions</h3>

            <table class="table">
                <thead>
                    <tr>
                        <th>Session #</th>
                        <th>Opened</th>
                        <th>Closed</th>
                        <th>Expected</th>
                        <th>Actual</th>
                        <th>Difference</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var session in RecentSessions)
                    {
                        <tr>
                            <td><strong>@session.SessionNumber</strong></td>
                            <td>@session.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(session.ClosedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>€@session.ClosingAmountExpected.ToString("F2")</td>
                            <td>€@session.ClosingAmountCounted.ToString("F2")</td>
                            <td class="@GetDifferenceClass(session.Difference)">
                                €@session.Difference.ToString("F2")
                            </td>
                            <td>
                                <span class="status-badge @session.Status.ToLower()">
                                    @session.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (ShowCreateModal)
{
    <div class="modal-overlay" @onclick="CloseCreateModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Open New Cash Session</h3>
                <button class="modal-close" @onclick="CloseCreateModal">×</button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label>Opening Balance (€)</label>
                    <input type="number"
                           class="form-input"
                           @bind="OpeningBalance"
                           step="0.01"
                           min="0"
                           placeholder="0.00" />
                </div>

                <div class="form-group">
                    <label>Opening Notes</label>
                    <textarea class="form-textarea"
                              @bind="OpeningNotes"
                              rows="3"
                              placeholder="Any notes about opening..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseCreateModal">
                    Cancel
                </button>

                <button class="btn btn-primary" @onclick="CreateSession" disabled="@IsLoading">
                    @(IsLoading ? "Opening..." : "Open Session")
                </button>
            </div>
        </div>
    </div>
}

@if (ShowCloseModal)
{
    <div class="modal-overlay" @onclick="CloseCloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>
                    @(CloseTarget == CashSessionCloseTarget.Server
                        ? "Close Server Cash Session"
                        : "Close Local Cash Session")
                </h3>
                <button class="modal-close" @onclick="CloseCloseModal">×</button>
            </div>

            <div class="modal-body">
                <div class="session-summary">
                    <div class="summary-item">
                        <span class="label">Expected Cash</span>
                        <strong class="amount">
                            €@(CloseExpectedAmount.ToString("F2"))
                        </strong>
                    </div>
                </div>

                <div class="form-group">
                    <div class="rouleaux">
                        <h4>Rouleaux</h4>

                        <label>0.01 € * 25</label>
                        <input class="form-input" type="number" @bind="R001" min="0" />

                        <label>0.02 € * 25</label>
                        <input class="form-input" type="number" @bind="R002" min="0" />

                        <label>0.05 € * 25</label>
                        <input class="form-input" type="number" @bind="R005" min="0" />

                        <label>0.10 € * 25</label>
                        <input class="form-input" type="number" @bind="R010" min="0" />

                        <label>0.20 € * 25</label>
                        <input class="form-input" type="number" @bind="R020" min="0" />

                        <label>0.50 € * 25</label>
                        <input class="form-input" type="number" @bind="R050" min="0" />

                        <label>1 € * 25</label>
                        <input class="form-input" type="number" @bind="R1" min="0" />

                        <label>2 € * 25</label>
                        <input class="form-input" type="number" @bind="R2" min="0" />
                    </div>

                    <div class="coins">
                        <h4>Coins</h4>

                        <label>0.01 €</label>
                        <input class="form-input" type="number" @bind="C001" min="0" />

                        <label>0.02 €</label>
                        <input class="form-input" type="number" @bind="C002" min="0" />

                        <label>0.05 €</label>
                        <input class="form-input" type="number" @bind="C005" min="0" />

                        <label>0.10 €</label>
                        <input class="form-input" type="number" @bind="C010" min="0" />

                        <label>0.20 €</label>
                        <input class="form-input" type="number" @bind="C020" min="0" />

                        <label>0.50 €</label>
                        <input class="form-input" type="number" @bind="C050" min="0" />

                        <label>1 €</label>
                        <input class="form-input" type="number" @bind="C1" min="0" />

                        <label>2 €</label>
                        <input class="form-input" type="number" @bind="C2" min="0" />
                    </div>

                    <div class="notes">
                        <h4>Billets</h4>

                        <label>5 €</label>
                        <input class="form-input" type="number" @bind="B5" min="0" />

                        <label>10 €</label>
                        <input class="form-input" type="number" @bind="B10" min="0" />

                        <label>20 €</label>
                        <input class="form-input" type="number" @bind="B20" min="0" />

                        <label>50 €</label>
                        <input class="form-input" type="number" @bind="B50" min="0" />

                        <label>100 €</label>
                        <input class="form-input" type="number" @bind="B100" min="0" />

                        <label>200 €</label>
                        <input class="form-input" type="number" @bind="B200" min="0" />

                        <label>500 €</label>
                        <input class="form-input" type="number" @bind="B500" min="0" />
                    </div>
                </div>

                <div class="session-summary">
                    <div class="summary-item">
                        <div class="label">Rouleaux: €@RouleauxTotal.ToString("F2")</div>
                        <div class="label">Coins: €@CoinsTotal.ToString("F2")</div>
                        <div class="label">Notes: €@NotesTotal.ToString("F2")</div>
                        <div class="amount">
                            <strong>Total Cash: €@ActualCashCalculated.ToString("F2")</strong>
                        </div>
                    </div>
                </div>

                @if (CanDisplayCloseDifference)
                {
                    <div class="difference-preview">
                        <span class="label">Difference:</span>
                        <strong class="@GetDifferenceClass(Difference)">
                            €@Difference.ToString("F2")
                        </strong>
                    </div>
                }

                <div class="form-group">
                    <label>Closing Notes</label>
                    <textarea class="form-textarea"
                              @bind="ClosingNotes"
                              rows="3"
                              placeholder="Any notes about closing..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseCloseModal">
                    Cancel
                </button>

                <button class="btn btn-danger"
                        @onclick="CloseSelectedSession"
                        disabled="@IsLoading">
                    @(IsLoading
                        ? "Closing..."
                        : CloseTarget == CashSessionCloseTarget.Server
                            ? "Close Server Session"
                            : "Close Local Session")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private LocalCashSession? ActiveSession;
    private List<LocalCashSession> RecentSessions = new();

    private CashSessionReconciliationResult? ReconciliationResult;

    private CashSessionCloseTarget CloseTarget =
        CashSessionCloseTarget.Local;

    private bool ShowCreateModal;
    private bool ShowCloseModal;
    private bool IsLoading;
    private bool IsLoadingData;

    private string? ErrorMessage;
    private string? SuccessMessage;

    private decimal OpeningBalance;
    private string OpeningNotes = string.Empty;
    private string ClosingNotes = string.Empty;

    private CashSessionResult? ServerActiveSession =>
        ReconciliationResult?.ServerSession;

    private decimal CloseExpectedAmount =>
        CloseTarget == CashSessionCloseTarget.Server
            ? ServerActiveSession?.ClosingAmountExpected ?? 0m
            : ActiveSession?.ClosingAmountExpected ?? 0m;

    private bool CanDisplayCloseDifference =>
        CloseTarget == CashSessionCloseTarget.Server
            ? ServerActiveSession != null
            : ActiveSession != null;

    private decimal Difference =>
        ActualCashCalculated -
        CloseExpectedAmount;

    private bool HasAnyCashEntered =>
        RouleauxTotal > 0 || CoinsTotal > 0 || NotesTotal > 0;

    private int R001;
    private int R002;
    private int R005;
    private int R010;
    private int R020;
    private int R050;
    private int R1;
    private int R2;

    private decimal RouleauxTotal =>
        R001 * 25 * 0.01m +
        R002 * 25 * 0.02m +
        R005 * 25 * 0.05m +
        R010 * 25 * 0.10m +
        R020 * 25 * 0.20m +
        R050 * 25 * 0.50m +
        R1 * 25 * 1m +
        R2 * 25 * 2m;

    private int C001;
    private int C002;
    private int C005;
    private int C010;
    private int C020;
    private int C050;
    private int C1;
    private int C2;

    private decimal CoinsTotal =>
        C001 * 0.01m +
        C002 * 0.02m +
        C005 * 0.05m +
        C010 * 0.10m +
        C020 * 0.20m +
        C050 * 0.50m +
        C1 * 1m +
        C2 * 2m;

    private int B5;
    private int B10;
    private int B20;
    private int B50;
    private int B100;
    private int B200;
    private int B500;

    private decimal NotesTotal =>
        B5 * 5m +
        B10 * 10m +
        B20 * 20m +
        B50 * 50m +
        B100 * 100m +
        B200 * 200m +
        B500 * 500m;

    private decimal ActualCashCalculated =>
        RouleauxTotal + CoinsTotal + NotesTotal;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoadingData = true;
        ErrorMessage = null;

        try
        {
            var tenantId =
                LocalTenantContext.GetRequiredTenantId();

            var openSession =
                await LocalCashSessionService
                    .GetOpenSessionAsync();

            /*
             * The cash-session screen and the sales screen must use
             * exactly the same tenant. A service that returns the first
             * open session globally can display another tenant's session.
             */
            if (openSession != null &&
                openSession.TenantId != tenantId)
            {
                ActiveSession =
                    null;

                ErrorMessage =
                    "An open local cash session exists, but it belongs " +
                    "to another tenant. Close/remove that invalid local " +
                    "session and open a new session for the current tenant.";
            }
            else
            {
                ActiveSession =
                    openSession;
            }

            RecentSessions =
                (await LocalCashSessionService
                    .GetRecentAsync(5))
                .Where(session =>
                    session.TenantId == tenantId)
                .ToList();

            try
            {
                ReconciliationResult =
                    await CashSessionReconciliation
                        .InspectAsync();

                if (ReconciliationResult.State ==
                    CashSessionReconciliationState.MatchingSessionLinked)
                {
                    ActiveSession =
                        await LocalCashSessionService
                            .GetOpenSessionAsync();

                    RecentSessions =
                        (await LocalCashSessionService
                            .GetRecentAsync(5))
                        .Where(session =>
                            session.TenantId == tenantId)
                        .ToList();
                }
            }
            catch (HttpRequestException)
            {
                ReconciliationResult =
                    new CashSessionReconciliationResult
                    {
                        State =
                            CashSessionReconciliationState.Offline,

                        LocalSession =
                            ActiveSession,

                        Message =
                            "API unavailable. Local cash-session work " +
                            "remains available offline."
                    };
            }
            catch (ApiException exception)
            {
                ReconciliationResult =
                    new CashSessionReconciliationResult
                    {
                        State =
                            CashSessionReconciliationState.Offline,

                        LocalSession =
                            ActiveSession,

                        Message =
                            exception.Content ??
                            exception.Message
                    };
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading cash-session data: {ex.GetBaseException().Message}";
        }
        finally
        {
            IsLoadingData = false;
        }
    }

    private void OpenCreateModal()
    {
        if (ReconciliationResult?.ServerSession != null)
        {
            ErrorMessage =
                "A server cash session is still open. Resolve it before " +
                "opening a different local session.";

            return;
        }

        OpeningBalance = 0;
        OpeningNotes = string.Empty;
        ErrorMessage = null;
        SuccessMessage = null;
        ShowCreateModal = true;
    }

    private void CloseCreateModal()
    {
        ShowCreateModal = false;
    }

    private async Task CreateSession()
    {
        if (OpeningBalance < 0)
        {
            ErrorMessage = "Opening balance cannot be negative.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            ActiveSession = await LocalCashSessionService.OpenAsync(
                openingAmount: OpeningBalance,
                openedByUserId: null,
                openingNotes: OpeningNotes);

            SuccessMessage = $"Cash session {ActiveSession.SessionNumber} opened locally.";
            CloseCreateModal();

            await LoadData();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error opening local cash session: {ex.GetBaseException().Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenCloseModal()
    {
        CloseTarget =
            CashSessionCloseTarget.Local;

        ResetCashCounters();
        ClosingNotes = string.Empty;
        ErrorMessage = null;
        SuccessMessage = null;
        ShowCloseModal = true;
    }

    private void CloseCloseModal()
    {
        ShowCloseModal = false;
    }

    private void OpenServerCloseModal()
    {
        if (ServerActiveSession == null)
        {
            ErrorMessage =
                "No active server cash session was found.";

            return;
        }

        CloseTarget =
            CashSessionCloseTarget.Server;

        ResetCashCounters();

        ClosingNotes =
            "Closed during offline cash-session conflict resolution.";

        ErrorMessage =
            null;

        SuccessMessage =
            null;

        ShowCloseModal =
            true;
    }

    private async Task CloseSelectedSession()
    {
        if (!HasAnyCashEntered)
        {
            ErrorMessage =
                "Enter counted cash before closing the session.";

            return;
        }

        IsLoading =
            true;

        ErrorMessage =
            null;

        SuccessMessage =
            null;

        try
        {
            if (CloseTarget ==
                CashSessionCloseTarget.Server)
            {
                if (ServerActiveSession == null)
                {
                    throw new InvalidOperationException(
                        "No active server cash session was found.");
                }

                var closedServerSession =
                    await CashSessionReconciliation
                        .CloseServerSessionAsync(
                            ServerActiveSession.Id,
                            ActualCashCalculated,
                            ClosingNotes);

                SuccessMessage =
                    $"Server cash session " +
                    $"{closedServerSession.SessionNumber} was closed.";

                CloseCloseModal();

                var syncResult =
                    await LocalSyncUploader
                        .SyncPendingAsync();

                if (syncResult.Failed > 0)
                {
                    ErrorMessage =
                        string.Join(
                            Environment.NewLine,
                            syncResult.Messages);
                }
                else if (syncResult.Messages.Count > 0)
                {
                    SuccessMessage +=
                        " " +
                        string.Join(
                            " ",
                            syncResult.Messages);
                }

                await LoadData();

                return;
            }

            if (ActiveSession == null)
            {
                throw new InvalidOperationException(
                    "No active local cash session was found.");
            }

            var closedLocalSession =
                await LocalCashSessionService.CloseAsync(
                    localCashSessionId:
                        ActiveSession.Id,

                    countedAmount:
                        ActualCashCalculated,

                    closedByUserId:
                        null,

                    closingNotes:
                        ClosingNotes);

            SuccessMessage =
                $"Cash session " +
                $"{closedLocalSession.SessionNumber} closed locally.";

            CloseCloseModal();

            await LoadData();
        }
        catch (Exception exception)
        {
            ErrorMessage =
                $"Error closing cash session: " +
                $"{exception.GetBaseException().Message}";
        }
        finally
        {
            IsLoading =
                false;
        }
    }

    private async Task ReloadAndReconcile()
    {
        await LoadData();
    }

    private void ResetCashCounters()
    {
        R001 = 0;
        R002 = 0;
        R005 = 0;
        R010 = 0;
        R020 = 0;
        R050 = 0;
        R1 = 0;
        R2 = 0;

        C001 = 0;
        C002 = 0;
        C005 = 0;
        C010 = 0;
        C020 = 0;
        C050 = 0;
        C1 = 0;
        C2 = 0;

        B5 = 0;
        B10 = 0;
        B20 = 0;
        B50 = 0;
        B100 = 0;
        B200 = 0;
        B500 = 0;
    }

    private static string GetSessionDuration(DateTime openedAtUtc)
    {
        var duration = DateTime.UtcNow - openedAtUtc;

        if (duration.TotalHours < 1)
            return $"{(int)duration.TotalMinutes} min";

        if (duration.TotalDays < 1)
            return $"{(int)duration.TotalHours}h {duration.Minutes}min";

        return $"{(int)duration.TotalDays}d {duration.Hours}h";
    }

    private static string GetDifferenceClass(decimal difference)
    {
        if (difference == 0)
            return "neutral";

        return difference > 0 ? "success" : "danger";
    }

    private void NavigateToSales()
    {
        Navigation.NavigateTo("/sales");
    }

    private void ViewHistory()
    {
        Navigation.NavigateTo("/cashmovements");
    }

    private enum CashSessionCloseTarget
    {
        Local,
        Server
    }
}