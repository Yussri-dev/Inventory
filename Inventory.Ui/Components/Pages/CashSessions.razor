@page "/cashSessions"

@using Inventory.Dto.CashSessions.Requests
@using Inventory.Dto.CashSessions.Results
@using Inventory.Dto.Enums
@using Inventory.Ui.State

@inject AppState State
@inject ICashSessionApi CashSessionApi
@inject NavigationManager Navigation

<div class="cash-session-container">

    @if (ActiveSession != null)
    {
        <!-- ACTIVE SESSION VIEW -->
        <div class="card session-active">
            <div class="session-header">
                <div class="session-status">
                    <span class="status-badge open">● OPEN</span>
                    <h2>Cash Session #@ActiveSession.SessionNumber</h2>
                </div>
                <button class="btn btn-danger" @onclick="OpenCloseModal">
                    Close Session
                </button>
            </div>

            <div class="session-details">
                <div class="detail-row">
                    <div class="detail-item">
                        <span class="label">Opened At</span>
                        <strong>@ActiveSession.OpenedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div class="detail-item">
                        <span class="label">Duration</span>
                        <strong>@GetSessionDuration(ActiveSession.OpenedAt)</strong>
                    </div>
                </div>

                <div class="detail-row">
                    <div class="detail-item">
                        <span class="label">Opening Balance</span>
                        <strong class="amount">€@ActiveSession.OpeningAmount.ToString("F2")</strong>
                    </div>
                    <div class="detail-item">
                        <span class="label">Expected Cash</span>
                        <strong class="amount success">€@ActiveSession.ClosingAmountExpected.ToString("F2")</strong>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ActiveSession.OpeningNotes))
                {
                    <div class="notes">
                        <span class="label">Opening Notes:</span>
                        <p>@ActiveSession.OpeningNotes</p>
                    </div>
                }
            </div>

            <div class="quick-actions">
                <button class="btn btn-primary" @onclick="NavigateToSales">
                    Start Selling
                </button>
                <button class="btn btn-secondary" @onclick="ViewHistory">
                    View History
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- NO ACTIVE SESSION VIEW -->
        <div class="card session-inactive">
            <div class="empty-state">
                <div class="icon">🏪</div>
                <h2>No Active Cash Session</h2>
                <p>Open a new cash session to start selling</p>
                <button class="btn btn-primary btn-lg" @onclick="OpenCreateModal">
                    Open New Session
                </button>
            </div>
        </div>
    }

    <!-- RECENT SESSIONS -->
    @if (RecentSessions.Count > 0)
    {
        <div class="card recent-sessions">
            <h3>Recent Sessions</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Session #</th>
                        <th>Opened</th>
                        <th>Closed</th>
                        <th>Expected</th>
                        <th>Actual</th>
                        <th>Difference</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in RecentSessions)
                    {
                        <tr>
                            <td><strong>@session.SessionNumber</strong></td>
                            <td>@session.OpenedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(session.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>€@session.ClosingAmountExpected.ToString("F2")</td>
                            <td>€@session.ClosingAmountCounted.ToString("F2")</td>
                            <td class="@GetDifferenceClass(session.Difference)">
                                €@session.Difference.ToString("F2")
                            </td>
                            <td>
                                <span class="status-badge @session.Status.ToString().ToLower()">
                                    @session.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- MODAL: OPEN SESSION -->
@if (ShowCreateModal)
{
    <div class="modal-overlay" @onclick="CloseCreateModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Open New Cash Session</h3>
                <button class="modal-close" @onclick="CloseCreateModal">×</button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label>Opening Balance (€)</label>
                    <input type="number"
                           class="form-input"
                           @bind="OpeningBalance"
                           step="0.01"
                           min="0"
                           placeholder="0.00" />
                </div>

                <div class="form-group">
                    <label>Opening Notes (optional)</label>
                    <textarea class="form-textarea"
                              @bind="OpeningNotes"
                              rows="3"
                              placeholder="Any notes about opening..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                <button class="btn btn-primary" @onclick="CreateSession" disabled="@IsLoading">
                    @(IsLoading ? "Opening..." : "Open Session")
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL: CLOSE SESSION -->
@if (ShowCloseModal)
{
    <div class="modal-overlay" @onclick="CloseCloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Close Cash Session</h3>
                <button class="modal-close" @onclick="CloseCloseModal">×</button>
            </div>

            <div class="modal-body">
                <div class="session-summary">
                    <div class="summary-item">
                        <span class="label">Expected Cash</span>
                        <strong class="amount">€@(ActiveSession?.ClosingAmountExpected.ToString("F2") ?? "0.00")</strong>
                    </div>
                </div>

                <div class="form-group">
                    <div class="rouleaux">
                        <h4>Rouleaux</h4>

                        <label>0.01 € * 25 </label>
                        <input class="form-input"
                               type="number" @bind="R001" min="0" />

                        <label>0.02 € * 25</label>
                        <input class="form-input"
                               type="number" @bind="R002" min="0" />

                        <label>0.05 € * 25</label>
                        <input class="form-input"
                               type="number" @bind="R005" min="0" />

                        <label>0.10 € * 25</label>
                        <input class="form-input"
                               type="number" @bind="R010" min="0" />

                        <label>0.20 € * 25</label>
                        <input class="form-input"
                               type="number" @bind="R020" min="0" />

                        <label>0.50 € * 25</label>
                        <input class="form-input"
                               type="number" @bind="R050" min="0" />

                        <label>1 € * 25</label>
                        <input class="form-input"
                               type="number" @bind="R1" min="0" />

                        <label>2 € * 25</label>
                        <input class="form-input"
                               type="number" @bind="R2" min="0" />
                    </div>

                    <div class="coins">
                        <h4>Coins</h4>

                        <label>0.01 €</label>
                        <input class="form-input"
                               type="number" @bind="C001" min="0" />

                        <label>0.02 €</label>
                        <input class="form-input"
                               type="number" @bind="C002" min="0" />

                        <label>0.05 €</label>
                        <input class="form-input"
                               type="number" @bind="C005" min="0" />

                        <label>0.10 €</label>
                        <input class="form-input"
                               type="number" @bind="C010" min="0" />

                        <label>0.20 €</label>
                        <input class="form-input"
                               type="number" @bind="C020" min="0" />

                        <label>0.50 €</label>
                        <input class="form-input"
                               type="number" @bind="C050" min="0" />

                        <label>1 €</label>
                        <input class="form-input"
                               type="number" @bind="C1" min="0" />

                        <label>2 €</label>
                        <input class="form-input"
                               type="number" @bind="C2" min="0" />
                    </div>
                    
                    <div class="notes">
                        <h4>Billets</h4>

                        <label>5 €</label>
                        <input class="form-input"
                               type="number" @bind="B5" min="0" />

                        <label>10 €</label>
                        <input class="form-input"
                               type="number" @bind="B10" min="0" />

                        <label>20 €</label>
                        <input class="form-input"
                               type="number" @bind="B20" min="0" />

                        <label>50 €</label>
                        <input class="form-input"
                               type="number" @bind="B50" min="0" />

                        <label>100 €</label>
                        <input class="form-input"
                               type="number" @bind="B100" min="0" />

                        <label>200 €</label>
                        <input class="form-input"
                               type="number" @bind="B200" min="0" />

                        <label>500 €</label>
                        <input class="form-input"
                               type="number" @bind="B500" min="0" />
                    </div>
                   

                </div>

             @*    <div class="difference-preview">
                    <div>Coins: €@CoinsTotal</div>
                    <div>Notes: €@NotesTotal</div>
                    <div><strong>Total Cash: €@ActualCashCalculated</strong></div>
                </div> *@

                <div class="session-summary">
                    <div class="summary-item">
                        <di class="label">Rouleaux: €@RouleauxTotal</di>
                        <di class="label">Coins: €@CoinsTotal</di>
                        <di class="label">Notes: €@NotesTotal</di>
                        <div class="amount"><strong>Total Cash: €@ActualCashCalculated</strong></div>
                    </div>
                </div>
                @if (ActiveSession != null)
                {
                    <div class="difference-preview">
                        <span class="label">Difference:</span>
                        <strong class="@GetDifferenceClass(Difference)">
                            €@Difference.ToString("F2")
                        </strong>

                    </div>
                }

                <div class="form-group">
                    <label>Closing Notes (optional)</label>
                    <textarea class="form-textarea"
                              @bind="ClosingNotes"
                              rows="3"
                              placeholder="Any notes about closing..."></textarea>
                </div>
