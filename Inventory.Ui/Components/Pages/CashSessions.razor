                <button class="btn btn-danger" @onclick="CloseSession" disabled="@(IsLoading)">
                    @(IsLoading ? "Closing..." : "Close Session")
                </button>
            </div>
        </div>
    </div>
}

@code {
    CashSessionResult? ActiveSession;
    List<CashSessionResult> RecentSessions = new();

    bool ShowCreateModal;
    bool ShowCloseModal;
    bool IsLoading;

    decimal OpeningBalance;
    string OpeningNotes = "";
    decimal ActualCash => ActualCashCalculated;
    string ClosingNotes = "";

    decimal Difference =>
    ActiveSession == null
        ? 0
        : ActualCashCalculated - ActiveSession.ClosingAmountExpected;

    bool HasAnyCashEntered => RouleauxTotal > 0 ||
    CoinsTotal > 0 || NotesTotal > 0;

    //Rouleaux
    int R001;
    int R002;
    int R005;
    int R010;
    int R020;
    int R050;
    int R1;
    int R2;


    decimal RouleauxTotal =>
    R001 * 25 * 0.01m +
    R002 * 25 * 0.02m +
    R005 * 25 * 0.05m +
    R010 * 25 * 0.10m +
    R020 * 25 * 0.20m +
    R050 * 25 * 0.50m +
    R1 * 25 * 1m +
    R2 * 25 * 2m;

    // PIECES (nombre de pièces)
    int C001;
    int C002;
    int C005;
    int C010;
    int C020;
    int C050;
    int C1;
    int C2;

    //Total Coins
    decimal CoinsTotal =>
    C001 * 0.01m +
    C002 * 0.02m +
    C005 * 0.05m +
    C010 * 0.10m +
    C020 * 0.20m +
    C050 * 0.50m +
    C1 * 1m +
    C2 * 2m;

    // BILLETS (nombre de billets)
    int B5;
    int B10;
    int B20;
    int B50;
    int B100;
    int B200;
    int B500;

    // Total Billets
    decimal NotesTotal =>
    B5 * 5m +
    B10 * 10m +
    B20 * 20m +
    B50 * 50m +
    B100 * 100m +
    B200 * 200m +
    B500 * 500m;

    // Total Cash Calculated
    decimal ActualCashCalculated => RouleauxTotal + CoinsTotal + NotesTotal ;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        try
        {
            if (!State.IsCashSessionLoaded)
            {
                try
                {
                    State.ActiveCashSession = await CashSessionApi.GetActive();
                }
                catch
                {
                    State.ActiveCashSession = null;
                }

                State.IsCashSessionLoaded = true;
            }

            ActiveSession = State.ActiveCashSession;

            var allSessions = await CashSessionApi.GetAll();

            RecentSessions = allSessions
                .Where(s => s.Status == CashSessionStatus.Closed)
                .OrderByDescending(s => s.OpenedAt)
                .Take(5)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
    }

    // OPEN SESSION
    void OpenCreateModal()
    {
        ShowCreateModal = true;
        OpeningBalance = 0;
        OpeningNotes = "";
    }

    void CloseCreateModal()
    {
        ShowCreateModal = false;
    }

    async Task CreateSession()
    {
        if (OpeningBalance < 0)
            return;

        IsLoading = true;

        try
        {
            var request = new CreateCashSessionRequest
            {
                OpeningAmount = OpeningBalance,
                OpeningNotes = OpeningNotes
            };

            ActiveSession = await CashSessionApi.Create(request);

            State.ActiveCashSession = ActiveSession;
            State.IsCashSessionLoaded = true;

            CloseCreateModal();

            RecentSessions = RecentSessions
            .OrderByDescending(s => s.OpenedAt)
            .Take(5)
            .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating session: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    // CLOSE SESSION
    void OpenCloseModal()
    {
        ShowCloseModal = true;
        ResetCashCounters();
        ClosingNotes = "";
    }

    void ResetCashCounters()
    {
        C001 = C002 = C005 = C010 = C020 = C050 = C1 = C2 = 0;
        B5 = B10 = B20 = B50 = B100 = B200 = B500 = 0;
    }


    void CloseCloseModal()
    {
        ShowCloseModal = false;
    }

    async Task CloseSession()
    {
        if (ActiveSession == null || !HasAnyCashEntered)
            return;

        IsLoading = true;

        try
        {
            // Observabilité base (safe prod + debug)
            Console.WriteLine(
                $"CashClose | Rouleaux={RouleauxTotal} |Coins={CoinsTotal} | Notes={NotesTotal} | Total={ActualCashCalculated} | Expected={ActiveSession.ClosingAmountExpected}"
            );

            var request = new CloseCashSessionRequest
            {
                ActualCash = ActualCashCalculated,
                ClosingNotes = ClosingNotes
            };

            await CashSessionApi.Close(ActiveSession.Id, request);

            State.ActiveCashSession = null;
            State.IsCashSessionLoaded = true;

            CloseCloseModal();

            var closedSession = ActiveSession;

            ActiveSession = null;

            if (closedSession != null)
            {
                closedSession.Status = CashSessionStatus.Closed;
                closedSession.ClosedAt = DateTime.UtcNow;

                RecentSessions.Insert(0, closedSession);
                RecentSessions = RecentSessions.Take(5).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error closing session: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }


    // HELPERS
    string GetSessionDuration(DateTime openedAt)
    {
        var duration = DateTime.UtcNow - openedAt;

        if (duration.TotalHours < 1)
            return $"{(int)duration.TotalMinutes} min";

        if (duration.TotalDays < 1)
            return $"{(int)duration.TotalHours}h {duration.Minutes}min";

        return $"{(int)duration.TotalDays}d {duration.Hours}h";
    }

    string GetDifferenceClass(decimal difference)
    {
        if (difference == 0) return "neutral";
        return difference > 0 ? "success" : "danger";
    }

    void NavigateToSales()
    {
        Navigation.NavigateTo("/sales");
    }

    void ViewHistory()
    {
        Navigation.NavigateTo("/cashmovements");
    }

}