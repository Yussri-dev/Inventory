@page "/productcategory"
@using Inventory.Dto.ProductCategory.Requests
@using Inventory.Dto.ProductCategory.Results
@inject IProductCategoryApi Api

<h3>ProductCategorys</h3>

<div class="page-container">

    <!-- CREATE / EDIT -->
    <div class="card">
        <h4>@(editingId == null ? "Create ProductCategory" : "Edit ProductCategory")</h4>

        <EditForm Model="form" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="form-grid">

    <div class="form-row">
        <div class="form-field">
            <label>Name *</label>
            <InputText class="inputText"
                       @bind-Value="form.Name"
                       disabled="@isLoading" />
            <ValidationMessage For="@(() => form.Name)" />
        </div>

        <div class="form-field">
            <label>Display Order</label>
            <InputNumber class="inputText"
                         @bind-Value="form.DisplayOrder"
                         disabled="@isLoading" />
        </div>
    </div>

    <div class="form-row">
        <div class="form-field">
            <label>Color</label>
            <InputText class="inputText"
                       placeholder="#FF0000"
                       @bind-Value="form.Color"
                       disabled="@isLoading" />
        </div>

        <div class="form-field">
            <label>Icon</label>
            <InputText class="inputText"
                       placeholder="fa-apple"
                       @bind-Value="form.Icon"
                       disabled="@isLoading" />
        </div>
    </div>

    <div class="actions-end">
        <button type="submit" class="btn primary" disabled="@isLoading">
            @(editingId == null ? "Create" : "Update")
        </button>

        @if (editingId != null)
        {
            <button type="button" class="btn ghost"
                    @onclick="CancelEdit">
                Cancel
            </button>
        }
    </div>

</div>
        </EditForm>
    </div>

    <!-- SEARCH -->
    <div class="card">
        <h4>Search Product Category</h4>

        <div class="search-grid">
            <input type="text"
                   placeholder="Search category name"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp"
                   disabled="@isLoading" />

            <div class="search-actions">
                <button class="btn primary" @onclick="Search" disabled="@isLoading">
                    Search
                </button>
                <button class="btn ghost" @onclick="ClearSearch" disabled="@isLoading">
                    Clear
                </button>
            </div>
        </div>
    </div>

    @if (isLoadingData)
    {
        <div class="loading-container">
            <p>Loading Product Category...</p>
        </div>
    }
    else if (items is null || items.Count == 0)
    {
        <p>@(isSearching ? "No Product Category found matching your search." : "No Product Category.")</p>
    }
    else
    {
        <div class="pager">
            <button class="btn ghost" disabled="@(Page == 1)"
                    @onclick="() => ChangePage(Page - 1)">
                Prev
            </button>

            <span class="muted">
                Page @Page / @(Math.Ceiling((double)TotalCount / PageSize))
            </span>

            <button class="btn ghost"
                    disabled="@(Page* PageSize >= TotalCount)"
                    @onclick="() => ChangePage(Page + 1)">
                Next
            </button>
        </div>
        <div class="results-header">
            <span>@items.Count ProductCategory(s) found</span>
            @if (isSearching)
            {
                <button class="btn small ghost" @onclick="ClearSearch">Show All</button>
            }
        </div>

        <table class="table">
            <thead>
    <tr>
        <th>Name</th>
        <th>Order</th>
        <th>Color</th>
        <th>Icon</th>
        <th style="width:160px"></th>
    </tr>
</thead>

<tbody>
@foreach (var c in items)
{
    <tr>
        <td>@c.Name</td>
        <td>@c.DisplayOrder</td>
        <td>
            <span style="background:@c.Color; padding:4px 10px; border-radius:4px;">
                @c.Color
            </span>
        </td>
        <td>@c.Icon</td>

        <td class="actions-end">
            <button class="btn small ghost"
                    @onclick="() => StartEdit(c)">
                Edit
            </button>

            <button class="btn small danger"
                    @onclick="() => AskDelete(c)">
                Delete
            </button>
        </td>
    </tr>
}
</tbody>
        </table>
    }

    @if (showDelete && ProductCategoryToDelete != null)
    {
        <div class="modal-overlay" @onclick="CancelDelete">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h4>Confirm Delete</h4>
                <p>Are you sure you want to delete <strong>@ProductCategoryToDelete.Name</strong>?</p>
                <p class="text-muted">This action cannot be undone.</p>
                <div class="modal-actions">
                    <button class="btn ghost" @onclick="CancelDelete">Cancel</button>
                    <button class="btn danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    }

</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="toast-success">
        <span class="toast-icon"></span>
        <span>@successMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="toast-error">
        <span class="toast-icon"></span>
        <span>@errorMessage</span>
    </div>
}

@code {
    private List<ProductCategoryResult>? items;
    private ProductCategoryForm form = new();
    private Guid? editingId;

    private bool isLoading;
    private bool isLoadingData;
    private bool isSearching;

    private string? errorMessage;
    private string? successMessage;

    private string searchTerm = string.Empty;

    private bool showDelete;
    private ProductCategoryResult? ProductCategoryToDelete;


    int Page = 1;
    int PageSize = 10;
    int TotalCount;

    async Task ShowSuccess(string message)
    {
        successMessage = null;
        StateHasChanged();

        successMessage = message;

        StateHasChanged();

        await Task.Delay(3000).ContinueWith(_ =>
        {
            successMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    async Task ShowError(string message)
    {
        errorMessage  =null;
        StateHasChanged();

        errorMessage = message;

        StateHasChanged();

        await Task.Delay(3000).ContinueWith(_ =>
        {
            errorMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = null;

            var query = new ProductCategoryQuery
            {
                Page = Page,
                PageSize = PageSize,
                Search = isSearching ? searchTerm : null
            };

            var response = await Api.Search(query);

            items = response.Items?.ToList() ?? new List<ProductCategoryResult>();
            TotalCount = response.TotalCount;
        }
        catch (Exception ex)
        {
            // errorMessage = $"Failed to load Product Category : {ex.Message}";

            await ShowError("Failed to load Product Category");
            items = new List<ProductCategoryResult>();
        }
        finally
        {
            isLoadingData = false;
        }
    }


    async Task ChangePage(int newPage)
    {
        Page = newPage;
        await LoadData();
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await LoadData();
            return;
        }

        try
        {
            isLoadingData = true;
            errorMessage = null;

            var result = await Api.Search(new ProductCategoryQuery
            {
                Search = searchTerm
            });

            items = result.Items.ToList();
            isSearching = true;
        }
        catch (Exception ex)
        {
            // errorMessage = $"Search failed: {ex.Message}";
            await ShowError("Search Failed ");
            items = new List<ProductCategoryResult>();
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        await LoadData();
    }

    private async Task HandleSubmit()
    {
        if (editingId == null)
        {
            await Create();
        }
        else
        {
            await Update();
        }
    }

    private async Task Create()
    {
        try
        {
            isLoading = true;
            ClearMessages();

            await Api.Create(new CreateProductCategoryRequest
            {
                Name = form.Name,
                DisplayOrder = form.DisplayOrder,
                Color = form.Color,
                Icon = form.Icon
            });

            // successMessage = $"Product Category '{form.Name}' created successfully.";
            await ShowSuccess($"Producr Category {form.Name} created successfully !");
            Reset();

            // Refresh current view
            if (isSearching)
            {
                await Search();
            }
            else
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            // errorMessage = $"Failed to create Product Category: {ex.Message}";
            await ShowError("Failed to create Product Category !");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Update()
    {
        if (editingId == null)
            return;

        try
        {
            isLoading = true;
            ClearMessages();

            await Api.Update(editingId.Value, new UpdateProductCategoryRequest
            {
                Name = form.Name,
                DisplayOrder = form.DisplayOrder,
                Color = form.Color,
                Icon = form.Icon
            });

            // successMessage = $"Product Category '{form.Name}' updated successfully.";
            await ShowSuccess("Product Category {form.Name} updated successfully !");
            Reset();

            // Refresh current view
            if (isSearching)
            {
                await Search();
            }
            else
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            // errorMessage = $"Failed to update Product Category: {ex.Message}";
            await ShowError("Failed to update Product Category");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit(ProductCategoryResult c)
    {
        editingId = c.Id;

        form = new ProductCategoryForm
        {
            Name = c.Name,
            DisplayOrder = c.DisplayOrder,
            Color = c.Color,
            Icon = c.Icon
        };
    }
    private void AskDelete(ProductCategoryResult s)
    {
        ProductCategoryToDelete = s;
        showDelete = true;
    }

    private async Task ConfirmDelete()
    {
        if (ProductCategoryToDelete == null)
            return;

        try
        {
            isLoading = true;
            showDelete = false;
            ClearMessages();

            var ProductCategoryName = ProductCategoryToDelete.Name;
            await Api.Delete(ProductCategoryToDelete.Id);

            // successMessage = $"Product Category '{ProductCategoryName}' deleted successfully.";
            await ShowSuccess($"Product Category {ProductCategoryName} deleted successfully");
            ProductCategoryToDelete = null;

            // Refresh current view
            if (isSearching)
            {
                await Search();
            }
            else
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            // errorMessage = $"Failed to delete Product Category: {ex.Message}";
            await ShowError("Failed to delete Product Category");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CancelDelete()
    {
        showDelete = false;
        ProductCategoryToDelete = null;
    }

    private void CancelEdit()
    {
        Reset();
    }

    private void Reset()
    {
        editingId = null;
        form = new ProductCategoryForm();
    }


    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    private sealed class ProductCategoryForm
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(200, ErrorMessage = "Name cannot exceed 200 characters")]
        public string Name { get; set; } = string.Empty;

        public int DisplayOrder { get; set; }

        [StringLength(200, ErrorMessage = "Color cannot exceed 200 characters")]
        public string Color { get; set; } = string.Empty;

        [StringLength(200, ErrorMessage = "Icon cannot exceed 200 characters")]
        public string Icon { get; set; } = string.Empty;
       
    }
}