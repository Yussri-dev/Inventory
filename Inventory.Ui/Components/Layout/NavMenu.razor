@using Microsoft.AspNetCore.Components.Routing

<aside class="inv-sidebar">
    <div class="inv-brand">
        <div class="logo">INV</div>
        <div class="brand-text">Inventory</div>
    </div>

    <nav class="inv-menu">
        <NavLink href="" Match="NavLinkMatch.All" class="inv-link">🏠 Home</NavLink>

        @if (IsAuthenticated)
        {
            @* <NavLink href="dashboard" class="inv-link">📊 Dashboard</NavLink> *@

            <NavLink href="productCatalogs" class="inv-link">📦 Product Catalogs</NavLink>

            <NavLink href="purchases" class="inv-link">🧾 Purchases</NavLink>
            <NavLink href="sales" class="inv-link">🧾 Sales</NavLink>

            <NavLink href="customers" class="inv-link">👥 Customers</NavLink>
            <NavLink href="customer-credits" class="inv-link">💳 Customer Credits</NavLink>

            <NavLink href="suppliers" class="inv-link">🚚 Suppliers</NavLink>

            <NavLink href="cashSessions" class="inv-link">💰 Cash Sessions</NavLink>

            <NavLink href="inventory" class="inv-link">📊 Inventory</NavLink>
            <NavLink href="stock" class="inv-link">📦 Stock</NavLink>

            <NavLink href="products" class="inv-link">📦 Products</NavLink>
            <NavLink href="returns" class="inv-link">📦 Returns</NavLink>
            <NavLink href="Damages" class="inv-link">📦 Damages</NavLink>
            <NavLink href="LoyaltyCards" class="inv-link">📦 Loyalty</NavLink>
        }
    </nav>

    @if (IsAuthenticated)
    {
        <div class="inv-footer">
            <div class="name">@UserName</div>
            <button class="logout" @onclick="OnLogout">🚪 Logout</button>
        </div>
    }
</aside>

@code {
    [Parameter] public string? UserName { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }
}
