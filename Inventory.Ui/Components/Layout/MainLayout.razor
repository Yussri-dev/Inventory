@using System.Security.Claims
@using Inventory.Ui.Authentification
@using Inventory.Ui.State
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (!IsInitialized)
{
    <div class="loader">
        <div style="text-align:center;padding:40px">
            <div style="font-size:22px;font-weight:700;">Loading...</div>
        </div>
    </div>
}
else
{
    @if (isMobileOverlayOpen)
    {
        <div class="drawer-backdrop show" @onclick="ToggleSidebar"></div>
    }

    <div class="inv-layout @(navMenu?.IsCollapsed == true ? "sidebar-collapsed" : "")">

        <NavMenu @ref="navMenu"
                 UserName="@UserName"
                 IsAuthenticated="@IsLoggedIn"
                 OnLogout="@ConfirmLogout" />

        <main class="inv-content">

            <div class="android-topbar visible-mobile">
                <button class="topbar-menu-btn" @onclick="ToggleSidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>
                <span style="font-weight:700;font-size:15px;">Inventory</span>
                <div style="width:36px"></div>
            </div>

            @Body

        </main>
    </div>
}

@code {
    private bool IsInitialized;
    private bool IsLoggedIn;
    private string? UserName;
    private NavMenu? navMenu;
    private bool isMobileOverlayOpen;

    void ToggleSidebar()
    {
        isMobileOverlayOpen = !isMobileOverlayOpen;
        navMenu?.ToggleSidebar();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            IsLoggedIn = true;
            UserName = user.FindFirst("email")?.Value
                    ?? user.FindFirst("name")?.Value
                    ?? user.Identity.Name
                    ?? "User";
        }

        IsInitialized = true;
    }

    private async Task ConfirmLogout()
    {
        if (await JS.InvokeAsync<bool>("confirm", "Log out?"))
        {
            if (AuthStateProvider is JwtAuthStateProvider jwt)
                await jwt.LogoutAsync();
            else
                NavigationManager.NavigateTo("/login", replace: true);
        }
    }
}