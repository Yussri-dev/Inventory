@using System.Security.Claims
@using Inventory.Ui.Authentification
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (!IsInitialized)
{
    <div class="loader">
        <div style="text-align:center;padding:40px">
            <div style="font-size:22px">⏳</div>
            <div>Loading…</div>
        </div>
    </div>
}
else
{
    <div class="inv-layout">
        <NavMenu UserName="@UserName"
                 IsAuthenticated="@IsLoggedIn"
                 OnLogout="@ConfirmLogout" />
        <main class="inv-content">
            @Body
        </main>
    </div>
}

@code {
    private bool IsInitialized;
    private bool IsLoggedIn;
    private string? UserName;

    protected override async Task OnInitializedAsync()
    {
        // Use the CACHED auth state — no direct storage read, no forceLoad redirect
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            IsLoggedIn = true;
            UserName = user.FindFirst("email")?.Value
                    ?? user.FindFirst("name")?.Value
                    ?? user.Identity.Name
                    ?? "User";
        }
        // If not authenticated, AuthorizeRouteView handles the redirect
        // via <NotAuthorized> — do NOT redirect here

        IsInitialized = true;
    }

    private async Task ConfirmLogout()
    {
        if (await JS.InvokeAsync<bool>("confirm", "Log out?"))
        {
            if (AuthStateProvider is JwtAuthStateProvider jwt)
                await jwt.LogoutAsync();
            else
                NavigationManager.NavigateTo("/login", replace: true);
        }
    }
}